      <data key="d5">1747657080</data>
    </node>
    <node id="consumer protection organisation">
      <data key="d0">consumer protection organisation</data>
      <data key="d1">category</data>
      <data key="d2">Consumer protection organisations advocate for the rights and interests of consumers, involved in the development of performance indicators and standards.</data>
      <data key="d3">chunk-a811acaf13b6420a717f6aa21a6ed331</data>
      <data key="d4">./cached_docs/recital_165.json</data>
      <data key="d5">1747657080</data>
    </node>
    <node id="data access infrastructure">
      <data key="d0">data access infrastructure</data>
      <data key="d1">category</data>
      <data key="d2">Data access infrastructure refers to the technological systems and frameworks that enable the sharing and management of data across different platforms and organizations.</data>
      <data key="d3">chunk-a811acaf13b6420a717f6aa21a6ed331</data>
      <data key="d4">./cached_docs/recital_165.json</data>
      <data key="d5">1747657080</data>
    </node>
    <node id="technical barriers">
      <data key="d0">technical barriers</data>
      <data key="d1">category</data>
      <data key="d2">Technical barriers refer to obstacles in technology that hinder interoperability and the smooth exchange of data for AI development.</data>
