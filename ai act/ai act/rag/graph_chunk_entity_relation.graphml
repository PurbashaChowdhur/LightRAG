      <data key="d0">Initial Model Usage for Research</data>
      <data key="d1">category</data>
      <data key="d2">Initial Model Usage for Research pertains to the use of AI models prior to market placement for the purposes of development and prototyping.</data>
      <data key="d3">chunk-161f3120961644fbdc17c7b09b46e54b</data>
