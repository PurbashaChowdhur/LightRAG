    <node id="European Economic and Social Committee">
      <data key="d0">European Economic and Social Committee</data>
      <data key="d1">organization</data>
      <data key="d2">The European Economic and Social Committee provides a platform for civil society organizations to express their opinions on EU policies, including those affecting AI systems.&lt;SEP&gt;The European Economic and Social Committee provides opinions on EU legislation, including the assessment of AI-related regulations.</data>
      <data key="d3">chunk-b71cdb20a8fa5befb7c30c90163cd416&lt;SEP&gt;chunk-7a69b68c9998277692ac6c6341fcdcac</data>
