      <data key="d5">1747657696</data>
    </node>
    <node id="Civic Discourse">
      <data key="d0">Civic Discourse</data>
      <data key="d1">category</data>
      <data key="d2">Civic discourse pertains to the communication and discussion among citizens, particularly regarding democratic processes and public affairs.</data>
      <data key="d3">chunk-e7e1bc352c7c8d3a7ba58b9b1a4f9f37</data>
