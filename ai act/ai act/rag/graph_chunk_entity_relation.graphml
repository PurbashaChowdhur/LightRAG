      <data key="d5">1747657302</data>
    </node>
    <node id="Digital Elements">
      <data key="d0">Digital Elements</data>
      <data key="d1">category</data>
      <data key="d2">Digital Elements are products that incorporate digital technology and are subject to cybersecurity regulations to protect against potential risks and vulnerabilities.</data>
      <data key="d3">chunk-6370e960da03a6bbdee69f64993cdae6</data>
