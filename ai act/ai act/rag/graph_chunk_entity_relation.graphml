      <data key="d10">./cached_docs/article_6.json</data>
    </edge>
    <edge source="AI System" target="Annex I">
      <data key="d6">8.0</data>
      <data key="d7">Annex I specifies regulations concerning AI systems as either safety components or independent products.</data>
      <data key="d8">regulatory framework, product classification</data>
      <data key="d9">chunk-6b4348ad8873ef2041aca94abc9297ee</data>
      <data key="d10">./cached_docs/article_6.json</data>
    </edge>
    <edge source="AI System" target="Annex III">
      <data key="d6">18.0</data>
      <data key="d7">Annex III categorizes AI systems based on their risk levels and outlines criteria for assessment.&lt;SEP&gt;Annex III details additional high-risk criteria for AI systems, influencing their safety assessment.</data>
      <data key="d8">regulatory criteria, risk assessment&lt;SEP&gt;system classification, regulatory framework</data>
