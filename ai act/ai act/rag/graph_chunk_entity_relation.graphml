    </node>
    <node id="Directive 98/27/EC">
      <data key="d0">Directive 98/27/EC</data>
      <data key="d1">event</data>
      <data key="d2">Council Directive 98/27/EC aims to protect consumers against deceptive commercial practices and harmonize rules across member states.&lt;SEP&gt;Directive 98/27/EC focuses on the injunctions for the protection of consumers' interests against unfair marketing practices.</data>
      <data key="d3">chunk-41d5cbcbecdcfde489e01bbfe08dc447&lt;SEP&gt;chunk-17045c951f494f621b2305960aade53f</data>
      <data key="d4">./cached_docs/recital_29.json</data>
    </node>
