      <data key="d0">Structured Dialogue</data>
      <data key="d1">event</data>
      <data key="d2">The structured dialogue is initiated by the AI Office to gather information about a provider's internal testing of AI models.</data>
      <data key="d3">chunk-23ab4f338bfa06297d4c996d7d54dc70</data>
      <data key="d4">./cached_docs/article_92.json</data>
    </node>
    <node id="Access Request">
      <data key="d0">Access Request</data>
      <data key="d1">event</data>
      <data key="d2">The access request is a formal request made by the AI Office to access AI models for evaluation purposes.</data>
      <data key="d3">chunk-23ab4f338bfa06297d4c996d7d54dc70</data>
      <data key="d4">./cached_docs/article_92.json</data>
    </node>
    <node id="AI model">
      <data key="d0">AI model</data>
      <data key="d1">category</data>
      <data key="d2">An AI model defined as a general-purpose model is designed to perform a variety of tasks across different domains, subject to evaluations and regulatory standards.</data>
      <data key="d3">chunk-075ecb5835777e6044264a23ca0cb20a</data>
