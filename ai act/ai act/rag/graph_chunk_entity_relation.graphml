      <data key="d0">Benchmarks</data>
      <data key="d1">category</data>
      <data key="d2">Benchmarks are standards or points of reference against which the performance of AI systems can be measured or compared.</data>
      <data key="d3">chunk-20ac675fffdeba0fbc242b392d3af8da</data>
