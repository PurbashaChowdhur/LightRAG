    </node>
    <node id="Legal Persons">
      <data key="d0">Legal Persons</data>
      <data key="d1">category</data>
      <data key="d2">Legal persons refer to entities such as companies that can represent the provider in legal matters regarding AI models.</data>
      <data key="d3">chunk-23ab4f338bfa06297d4c996d7d54dc70</data>
      <data key="d4">./cached_docs/article_92.json</data>
    </node>
