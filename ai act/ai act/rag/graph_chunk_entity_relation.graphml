    <node id="OJ L 316">
      <data key="d0">OJ L 316</data>
      <data key="d1">category</data>
      <data key="d2">OJ L 316 refers to the Official Journal of the European Union, where EU laws and decisions are published.</data>
      <data key="d3">chunk-cdc616126c9eed60b2893f6f0c5a24b1</data>
