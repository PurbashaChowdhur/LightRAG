      <data key="d0">Compliance Period</data>
      <data key="d1">category</data>
      <data key="d2">The Compliance Period refers to defined timelines within which AI systems and large-scale IT systems must adhere to stipulated regulations.</data>
      <data key="d3">chunk-f8e23760d52ebfb589b4de63afe8ab83</data>
