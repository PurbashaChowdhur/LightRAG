      <data key="d0">Best Practices</data>
      <data key="d1">category</data>
      <data key="d2">Best Practices represent the ideal procedures and standards that the AI Office evaluates and promotes in public procurement related to AI systems.</data>
      <data key="d3">chunk-e3d60cf6cbe0ae91a9793cb5c98a4a92</data>
      <data key="d4">./cached_docs/article_62.json</data>
