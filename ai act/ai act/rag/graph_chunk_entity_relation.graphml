      <data key="d0">Presumption of Innocence</data>
      <data key="d1">category</data>
      <data key="d2">The Presumption of Innocence is a legal principle that ensures individuals are considered innocent until proven guilty.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_48.json</data>
    </node>
    <node id="Right to Good Administration">
      <data key="d0">Right to Good Administration</data>
      <data key="d1">category</data>
      <data key="d2">The Right to Good Administration ensures that individuals receive fair and competent administrative treatment.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_48.json</data>
    </node>
    <node id="Rights of Children">
      <data key="d0">Rights of Children</data>
      <data key="d1">category</data>
      <data key="d2">The Rights of Children refer to specific protections and entitlements granted to minors to safeguard their well-being and development.</data>
