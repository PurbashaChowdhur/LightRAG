    <node id="Annual Report">
      <data key="d0">Annual Report</data>
      <data key="d1">event</data>
      <data key="d2">The Annual Report is a formal document submitted by the Market Surveillance Authorities and National Data Protection Authorities to the Commission detailing the usage of biometric identification systems.&lt;SEP&gt;The Annual Report summarizes the Advisory Forum's activities each year and is made publicly available.</data>
      <data key="d3">chunk-699c5fa3a4d8d093e6a599637df82443&lt;SEP&gt;chunk-2187eb3476528ac7c75b571eb3844f0e</data>
