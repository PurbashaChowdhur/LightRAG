    <node id="Preparatory Task">
      <data key="d0">Preparatory Task</data>
      <data key="d1">category</data>
      <data key="d2">Preparatory Task refers to tasks that set the stage for further assessments, where AI involvement has minimal impact.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
