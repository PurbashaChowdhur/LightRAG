    </node>
    <node id="Fees">
      <data key="d0">Fees</data>
      <data key="d1">category</data>
      <data key="d2">Fees refer to the financial compensation that Member States may need to pay for the advice and support provided by Experts.</data>
      <data key="d3">chunk-5ea6a588c10ad2fe493ec8cc1913f72d</data>
