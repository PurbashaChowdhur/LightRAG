      <data key="d0">Annex X</data>
      <data key="d1">category</data>
      <data key="d2">Annex X is a part of the legal document that lists legal acts relevant to the establishment and compliance of large-scale IT systems.</data>
      <data key="d3">chunk-f8e23760d52ebfb589b4de63afe8ab83</data>
      <data key="d4">./cached_docs/article_111.json</data>
