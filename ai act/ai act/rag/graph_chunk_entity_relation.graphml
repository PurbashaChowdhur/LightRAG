      <data key="d0">Council Framework Decision 2008/977/JHA</data>
      <data key="d1">event</data>
      <data key="d2">The Council Framework Decision 2008/977/JHA is related to data protection and the movement of personal data within the EU for law enforcement purposes.&lt;SEP&gt;The Council Framework Decision 2008/977/JHA was an earlier framework concerning the processing of personal data by law enforcement authorities in the EU.</data>
      <data key="d3">chunk-15eee417af0ebe299ed66be76a0b845a&lt;SEP&gt;chunk-a3cb5eb81289d4fb565bd824bdc63506</data>
      <data key="d4">./cached_docs/recital_10.json</data>
    </node>
