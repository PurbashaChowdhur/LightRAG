      <data key="d0">Directive 2001/95/EC</data>
      <data key="d1">event</data>
      <data key="d2">Directive 2001/95/EC focuses on product safety, establishing a framework to ensure that consumer products are safe for use.</data>
      <data key="d3">chunk-b3f7d41ecd7ed7ec26e62e63255378cf</data>
