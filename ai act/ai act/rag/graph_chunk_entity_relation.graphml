      <data key="d8">expert guidance, regulatory support</data>
      <data key="d9">chunk-d64a2a65aec35f8304efaaee30e0034d</data>
      <data key="d10">./cached_docs/article_6.json</data>
    </edge>
    <edge source="AI System" target="Downstream Provider">
      <data key="d6">8.0</data>
