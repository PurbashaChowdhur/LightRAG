    <node id="Regulation (EU) No 182/2011">
      <data key="d0">Regulation (EU) No 182/2011</data>
      <data key="d1">event</data>
      <data key="d2">Regulation (EU) No 182/2011 establishes rules and principles concerning the control by Member States over the European Commission's implementing powers.&lt;SEP&gt;Regulation (EU) No 182/2011 is a legislative framework that governs the functioning of committees in the European Union.</data>
      <data key="d3">chunk-3fa5fe9ac042448be58de6c82bb33ea4&lt;SEP&gt;chunk-e37c30ee0e0a87b8ea9630ea20f092fa</data>
