      <data key="d5">1747657080</data>
    </node>
    <node id="cross-border exchange of data">
      <data key="d0">cross-border exchange of data</data>
      <data key="d1">category</data>
      <data key="d2">Cross-border exchange of data involves the transfer of information between different countries, facilitating international cooperation in AI and data usage.</data>
      <data key="d3">chunk-a811acaf13b6420a717f6aa21a6ed331</data>
      <data key="d4">./cached_docs/recital_165.json</data>
      <data key="d5">1747657080</data>
    </node>
    <node id="Stand-Alone AI Systems">
      <data key="d0">Stand-Alone AI Systems</data>
      <data key="d1">category</data>
      <data key="d2">Stand-Alone AI Systems are high-risk AI technologies that are not safety components of other products, requiring classification based on their potential harm.</data>
