      <data key="d8">organizational function, AI implementation</data>
      <data key="d9">chunk-2b28a4b325cc05a6cc4897f58ccdf00f</data>
      <data key="d10">./cached_docs/recital_13.json</data>
    </edge>
    <edge source="AI System" target="National Public Authority">
