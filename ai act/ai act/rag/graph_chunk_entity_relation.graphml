    <edge source="Member State" target="national competent authority">
      <data key="d6">16.0</data>
      <data key="d7">The national competent authority operates within a Member State to oversee the certification process for high-risk AI systems.&lt;SEP&gt;The national competent authority operates within the jurisdiction of each Member State to enforce guidelines and policies.</data>
      <data key="d8">governmental structure,jurisdiction,regulatory role</data>
      <data key="d9">chunk-cdf6e3e080867f88ec52fa9fabbeafd6&lt;SEP&gt;chunk-b341fa074527a308a2434a3c68244d02</data>
