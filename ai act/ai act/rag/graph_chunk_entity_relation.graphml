    <node id="Official Journal of the European Union (OJ)">
      <data key="d0">Official Journal of the European Union (OJ)</data>
      <data key="d1">category</data>
      <data key="d2">The Official Journal of the European Union publishes laws, regulations, and decisions made by EU bodies, providing essential information on EU law.</data>
      <data key="d3">chunk-cdc616126c9eed60b2893f6f0c5a24b1</data>
