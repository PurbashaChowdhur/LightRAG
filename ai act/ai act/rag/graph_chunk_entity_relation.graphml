    <node id="biometric verification">
      <data key="d0">biometric verification</data>
      <data key="d1">category</data>
      <data key="d2">Biometric verification refers to the automated one-to-one verification of an individual's identity through the comparison of their biometric data to pre-existing data.</data>
      <data key="d3">chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1747657195</data>
    </node>
    <node id="sensitive operational data">
      <data key="d0">sensitive operational data</data>
      <data key="d1">category</data>
      <data key="d2">Sensitive operational data pertains to information that relates to the prevention or prosecution of criminal offenses, which is critical for maintaining the integrity of criminal proceedings.</data>
      <data key="d3">chunk-1e726a1ef8f481d54c995afc6a028f60</data>
