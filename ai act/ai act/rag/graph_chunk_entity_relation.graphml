      <data key="d10">./cached_docs/article_99.json</data>
    </edge>
    <edge source="Commission" target="Annual Reports">
      <data key="d6">17.0</data>
      <data key="d7">The Commission compiles and assesses annual reports from Member States to evaluate the use and impact of biometric systems in law enforcement.&lt;SEP&gt;The Commission requires Member States to submit annual reports detailing the administrative fines issued to ensure oversight and transparency.</data>
