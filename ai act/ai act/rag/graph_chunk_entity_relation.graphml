      <data key="d1">category</data>
      <data key="d2">Health and Safety of Persons refers to the rights ensuring the physical well-being and safety of individuals.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_48.json</data>
