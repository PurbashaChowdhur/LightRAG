    </node>
    <node id="European Standardisation Organisations">
      <data key="d0">European Standardisation Organisations</data>
      <data key="d1">organization</data>
      <data key="d2">European standardisation organisations are entities involved in developing and maintaining standards for various sectors, including those related to AI systems.&lt;SEP&gt;European standardisation organisations are groups that develop and maintain standards for various sectors, including AI systems, and in which notified bodies are encouraged to participate.&lt;SEP&gt;European standardisation organisations are responsible for developing and maintaining standards related to various sectors in the European Union, especially regarding high-risk AI systems.</data>
      <data key="d3">chunk-3177468233ec37ad2a71dc38caa17377&lt;SEP&gt;chunk-be2e0f993ca9c4e593e5fcbdd8fc03fe&lt;SEP&gt;chunk-28717558f1bb8bd2fd8b9542f8e2a99c</data>
      <data key="d4">./cached_docs/article_40.json&lt;SEP&gt;./cached_docs/article_31.json</data>
      <data key="d5">1747658017</data>
    </node>
    <node id="Professional Integrity">
      <data key="d0">Professional Integrity</data>
      <data key="d1">category</data>
      <data key="d2">Professional integrity denotes the adherence to ethical standards and practices within the workplace, especially among regulatory bodies.</data>
      <data key="d3">chunk-28717558f1bb8bd2fd8b9542f8e2a99c</data>
