      <data key="d4">./cached_docs/recital_74.json</data>
    </node>
    <node id="Article 68">
      <data key="d0">Article 68</data>
      <data key="d1">category</data>
      <data key="d2">Article 68 pertains to the establishment of a scientific panel and the criteria for appointing independent experts.</data>
      <data key="d3">chunk-23ab4f338bfa06297d4c996d7d54dc70</data>
      <data key="d4">./cached_docs/article_92.json</data>
    </node>
    <node id="Article 101">
      <data key="d0">Article 101</data>
      <data key="d1">event</data>
      <data key="d2">Article 101 details the fines for failure to provide access to information requested regarding general-purpose AI models.&lt;SEP&gt;Article 101 is an exception within the Regulation that is not applicable from 2 August 2025.&lt;SEP&gt;Article 101 outlines the penalties for supplying incorrect, incomplete, or misleading information regarding AI models.</data>
      <data key="d3">chunk-23ab4f338bfa06297d4c996d7d54dc70&lt;SEP&gt;chunk-7c553a0db4b39033e7fcfeddeb912aac&lt;SEP&gt;chunk-e93fbd1f7fc7cbb860b708f989987b57</data>
