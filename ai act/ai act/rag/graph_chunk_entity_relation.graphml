    <node id="Biometric Categorization System">
      <data key="d0">Biometric Categorization System</data>
      <data key="d1">category</data>
      <data key="d2">A biometric categorization system sorts individuals into specific categories based on their biometric data, often linked to commercial services.</data>
      <data key="d3">chunk-3ac98f64f8751ad51246ca16d843f030</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1747657195</data>
    </node>
    <node id="Remote Biometric Identification System">
      <data key="d0">Remote Biometric Identification System</data>
      <data key="d1">category</data>
      <data key="d2">A remote biometric identification system uses biometric data for the recognition of individuals from a distance.</data>
      <data key="d3">chunk-3ac98f64f8751ad51246ca16d843f030</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1747657195</data>
