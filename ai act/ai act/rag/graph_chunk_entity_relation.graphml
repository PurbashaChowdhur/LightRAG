    </node>
    <node id="AI Vulnerabilities">
      <data key="d0">AI Vulnerabilities</data>
      <data key="d1">category</data>
      <data key="d2">AI Vulnerabilities include specific risks associated with artificial intelligence systems, such as data poisoning and adversarial attacks, which pose threats to the performance and security of these systems.</data>
      <data key="d3">chunk-6370e960da03a6bbdee69f64993cdae6</data>
      <data key="d4">./cached_docs/recital_77.json</data>
    </node>
    <node id="Economic Operator">
      <data key="d0">Economic Operator</data>
      <data key="d1">category</data>
      <data key="d2">An economic operator refers to any entity involved in the trade of products, including manufacturers and distributors.</data>
      <data key="d3">chunk-53fb2685a38836a165fa7637bbbadce2</data>
      <data key="d4">./cached_docs/article_74.json</data>
