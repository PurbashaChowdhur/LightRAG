      <data key="d0">Regulation (EC) No 2006/2004</data>
      <data key="d1">event</data>
      <data key="d2">Regulation (EC) No 2006/2004 aims to enhance consumer protection in the digital single market and addresses cross-border enforcement.&lt;SEP&gt;Regulation (EC) No 2006/2004 focuses on cooperation between national authorities responsible for consumer protection, enhancing enforcement across the EU.</data>
      <data key="d3">chunk-41d5cbcbecdcfde489e01bbfe08dc447&lt;SEP&gt;chunk-17045c951f494f621b2305960aade53f</data>
      <data key="d4">./cached_docs/recital_29.json</data>
