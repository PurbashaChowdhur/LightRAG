    <node id="Employers">
      <data key="d0">Employers</data>
      <data key="d1">organization</data>
      <data key="d2">Employers are entities that have obligations to inform and consult workers regarding the use of AI systems in the workplace as per the Regulation.</data>
      <data key="d3">chunk-c664ec81872dda212b64d449aa7a2014</data>
      <data key="d4">./cached_docs/recital_92.json</data>
