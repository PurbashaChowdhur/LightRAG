      <data key="d4">./cached_docs/recital_52.json</data>
      <data key="d5">1747657084</data>
    </node>
    <node id="Technological Development">
      <data key="d0">Technological Development</data>
      <data key="d1">category</data>
      <data key="d2">Technological Development encompasses advancements in AI that may influence the categorization of high-risk systems and their regulation.</data>
      <data key="d3">chunk-37d88f95110db00bbf8230a2632a2035</data>
      <data key="d4">./cached_docs/recital_52.json</data>
      <data key="d5">1747657096</data>
    </node>
    <node id="Recital 85">
      <data key="d0">Recital 85</data>
      <data key="d1">event</data>
      <data key="d2">Recital 85 of the Regulation provides contextual background relevant to the obligations of providers of high-risk AI systems.</data>
      <data key="d3">chunk-b4329be6d4972c392a3a71593d402998</data>
      <data key="d4">./cached_docs/article_25.json</data>
      <data key="d5">1747657107</data>
    </node>
    <node id="Recital 84">
      <data key="d0">Recital 84</data>
      <data key="d1">event</data>
      <data key="d2">Recital 84 offers additional context surrounding categorization and management of high-risk AI systems.</data>
      <data key="d3">chunk-b4329be6d4972c392a3a71593d402998</data>
      <data key="d4">./cached_docs/article_25.json</data>
      <data key="d5">1747657107</data>
    </node>
    <node id="Recital 86">
      <data key="d0">Recital 86</data>
      <data key="d1">event</data>
      <data key="d2">Recital 86 discusses the responsibilities of the initial provider of an AI system when it is modified.</data>
      <data key="d3">chunk-b4329be6d4972c392a3a71593d402998</data>
