    <node id="Artificial Intelligence System">
      <data key="d0">Artificial Intelligence System</data>
      <data key="d1">category</data>
      <data key="d2">An Artificial Intelligence System is a technology designed to perform tasks that typically require human intelligence, including decision-making, problem-solving, and language understanding.</data>
      <data key="d3">chunk-72cfde8a7c3c94fdf1dc93c4253bec9e</data>
