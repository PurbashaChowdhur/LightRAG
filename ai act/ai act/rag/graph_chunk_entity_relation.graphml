    </edge>
    <edge source="AI System" target="European Commission">
      <data key="d6">9.0</data>
      <data key="d7">The European Commission sets the guidelines for assessing AI systems based on their potential risks to individuals and societal norms.</data>
      <data key="d8">governance, risk assessment</data>
      <data key="d9">chunk-d64a2a65aec35f8304efaaee30e0034d</data>
      <data key="d10">./cached_docs/article_6.json</data>
    </edge>
    <edge source="AI System" target="European Artificial Intelligence Board">
      <data key="d6">8.0</data>
