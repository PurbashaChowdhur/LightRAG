      <data key="d0">Provider of General-Purpose AI Model</data>
      <data key="d1">organization</data>
      <data key="d2">The Provider of General-Purpose AI Model is an organization that develops and integrates general-purpose AI models into their systems available on the market.</data>
      <data key="d3">chunk-b89491b02af0a00cbc13f9e8df827a6d</data>
