    </node>
    <node id="Right to an Effective Remedy">
      <data key="d0">Right to an Effective Remedy</data>
      <data key="d1">category</data>
      <data key="d2">The Right to an Effective Remedy ensures that individuals have access to justice and avenues for redress when their rights are violated.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_48.json</data>
    </node>
    <node id="Right to a Fair Trial">
      <data key="d0">Right to a Fair Trial</data>
      <data key="d1">category</data>
      <data key="d2">The Right to a Fair Trial guarantees that individuals receive impartial legal proceedings.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_48.json</data>
    </node>
    <node id="Right of Defence">
      <data key="d0">Right of Defence</data>
      <data key="d1">category</data>
      <data key="d2">The Right of Defence ensures that individuals have the opportunity to contest accusations against them.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_48.json</data>
    </node>
