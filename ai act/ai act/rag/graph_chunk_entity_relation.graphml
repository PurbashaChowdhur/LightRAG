    <node id="EU Member States">
      <data key="d0">EU Member States</data>
      <data key="d1">geo</data>
      <data key="d2">EU Member States are countries that are part of the European Union, involved in the regulation, compliance, and enforcement of AI-related legislation.</data>
      <data key="d3">chunk-9cb2802f1b508b813d06e58ae27a1f77</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1747464220</data>
    </node>
    <node id="Corrective Actions">
      <data key="d0">Corrective Actions</data>
      <data key="d1">category</data>
      <data key="d2">Corrective Actions are steps that providers must take to address issues of non-compliance in high-risk AI systems, including modifications, recalls, or disconnections.&lt;SEP&gt;Corrective Actions encompass the measures that must be taken by operators to address non-compliance issues for AI systems, including withdrawal, recall, or market prohibition.&lt;SEP&gt;Corrective Actions refer to measures that the market surveillance authority can require to bring non-compliant AI systems into compliance with the applicable regulations.&lt;SEP&gt;Corrective actions are steps taken to address non-compliance and ensure that high-risk AI systems meet required safety and regulatory standards.&lt;SEP&gt;Corrective actions refer to measures that must be taken by providers to address compliance issues or deficiencies noted in high-risk AI systems.</data>
      <data key="d3">chunk-73fd7e801c2d8d41361f6b16b45c6ed0&lt;SEP&gt;chunk-9cb2802f1b508b813d06e58ae27a1f77&lt;SEP&gt;chunk-68d6983d829937a84d37118dacc3e39c&lt;SEP&gt;chunk-1ad9c740a10a5c1577e578a593bd61fd&lt;SEP&gt;chunk-1e978e96ac6d99cf448b53260c07dded</data>
      <data key="d4">./cached_docs/article_16.json&lt;SEP&gt;./cached_docs/article_20.json&lt;SEP&gt;./cached_docs/article_24.json&lt;SEP&gt;./cached_docs/article_79.json</data>
      <data key="d5">1747658129</data>
    </node>
    <node id="Article 18">
      <data key="d0">Article 18</data>
      <data key="d1">category</data>
      <data key="d2">Article 18 of Regulation (EU) 2019/1020 outlines specific measures and responsibilities for operators and authorities concerning the evaluation and compliance of products on the market.&lt;SEP&gt;Article 18 of Regulation (EU) 2019/1020 outlines the procedural rights of the concerned operator related to market surveillance actions.</data>
      <data key="d3">chunk-28daf57045ce50f0bd160cddd41ffc14&lt;SEP&gt;chunk-1ad9c740a10a5c1577e578a593bd61fd</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1747464230</data>
    </node>
    <node id="Non-compliant AI System">
      <data key="d0">Non-compliant AI System</data>
      <data key="d1">category</data>
      <data key="d2">Non-compliant AI Systems refer to AI products that fail to meet the established regulatory and safety standards set forth by the EU.</data>
      <data key="d3">chunk-345a8ba89ed0ea3325462384d5e16aaf</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1747464230</data>
    </node>
    <node id="Article 40">
      <data key="d0">Article 40</data>
      <data key="d1">document</data>
      <data key="d2">Article 40 details the harmonised standards and common specifications required for AI systems to ensure compliance with EU regulations.&lt;SEP&gt;Article 40 refers to harmonised standards relevant to the compliance of high-risk AI systems.</data>
      <data key="d3">chunk-345a8ba89ed0ea3325462384d5e16aaf&lt;SEP&gt;chunk-69838403e8b59bb122436a0d25a9fc1e</data>
      <data key="d4">./cached_docs/article_43.json&lt;SEP&gt;./cached_docs/article_79.json</data>
      <data key="d5">1747657895</data>
    </node>
    <node id="Article 41">
      <data key="d0">Article 41</data>
      <data key="d1">event</data>
      <data key="d2">Article 41 complements Article 40 by outlining additional specifications that help define the conformity of AI systems.&lt;SEP&gt;Article 41 pertains to common specifications for assessing compliance of high-risk AI systems.&lt;SEP&gt;Article 41 refers to harmonized standards that manufacturers must apply when opting out of a third-party conformity assessment for high-risk AI systems.</data>
      <data key="d3">chunk-345a8ba89ed0ea3325462384d5e16aaf&lt;SEP&gt;chunk-41e5d20a8e9427a4698b84f758676994&lt;SEP&gt;chunk-69838403e8b59bb122436a0d25a9fc1e</data>
      <data key="d4">./cached_docs/article_43.json&lt;SEP&gt;./cached_docs/article_79.json</data>
      <data key="d5">1747657895</data>
    </node>
    <node id="Paragraph 5">
      <data key="d0">Paragraph 5</data>
      <data key="d1">event</data>
      <data key="d2">Paragraph 5 outlines the notification process for authorities when dealing with non-compliant AI systems, detailing what information must be disclosed.</data>
      <data key="d3">chunk-345a8ba89ed0ea3325462384d5e16aaf</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1747464230</data>
    </node>
    <node id="National Measures">
      <data key="d0">National Measures</data>
      <data key="d1">category</data>
      <data key="d2">National measures refer to the regulations or standards set by individual EU Member States that must comply with EU directives regarding market surveillance and product compliance.</data>
      <data key="d3">chunk-28daf57045ce50f0bd160cddd41ffc14</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1747464230</data>
    </node>
    <node id="Provisional Measure">
      <data key="d0">Provisional Measure</data>
      <data key="d1">event</data>
      <data key="d2">A provisional measure is a temporary action taken by market surveillance authorities to address immediate compliance issues with a product or AI system.</data>
      <data key="d3">chunk-28daf57045ce50f0bd160cddd41ffc14</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1747464230</data>
    </node>
    <node id="Product">
      <data key="d0">Product</data>
      <data key="d1">category</data>
      <data key="d2">A product in this context refers to any item or system that is placed on the market and is subject to compliance with EU regulations, including AI systems.</data>
      <data key="d3">chunk-28daf57045ce50f0bd160cddd41ffc14</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1747464230</data>
    </node>
    <node id="Article 54">
      <data key="d0">Article 54</data>
      <data key="d1">category</data>
      <data key="d2">Article 54 outlines additional obligations that may be required from providers in the context of compliance and risk management.</data>
      <data key="d3">chunk-1a0bef2c1dcc3d7b428c7611732f7ffc</data>
      <data key="d4">./cached_docs/article_93.json</data>
      <data key="d5">1747464244</data>
    </node>
    <node id="Mitigation Measures">
      <data key="d0">Mitigation Measures</data>
      <data key="d1">category</data>
      <data key="d2">Actions or strategies implemented to minimize risks associated with high-risk AI systems, as per the guidelines of the risk-management system.&lt;SEP&gt;Mitigation measures are actions taken to reduce or eliminate risks associated with general-purpose AI, as described in the regulatory framework.</data>
      <data key="d3">chunk-7b5e606b14946a1b388f008868e8e155&lt;SEP&gt;chunk-1a0bef2c1dcc3d7b428c7611732f7ffc</data>
      <data key="d4">./cached_docs/recital_65.json&lt;SEP&gt;./cached_docs/article_93.json</data>
      <data key="d5">1747464807</data>
    </node>
    <node id="Binding Commitments">
      <data key="d0">Binding Commitments</data>
      <data key="d1">category</data>
      <data key="d2">Binding commitments are obligations agreed upon by providers of AI models to address identified risks, making them enforceable by the Commission.</data>
      <data key="d3">chunk-1a0bef2c1dcc3d7b428c7611732f7ffc</data>
      <data key="d4">./cached_docs/article_93.json</data>
      <data key="d5">1747464244</data>
    </node>
    <node id="Necessary Information">
      <data key="d0">Necessary Information</data>
      <data key="d1">category</data>
      <data key="d2">Necessary information refers to the data and documentation that the provider must make available to ensure compliance with regulations for high-risk AI systems.</data>
      <data key="d3">chunk-be61089eed18cfaf2703713378c589a9</data>
      <data key="d4">./cached_docs/recital_86.json</data>
      <data key="d5">1747464253</data>
    </node>
    <node id="AI systems providers">
      <data key="d0">AI systems providers</data>
      <data key="d1">organization</data>
      <data key="d2">AI systems providers are entities that develop and offer artificial intelligence technologies, subject to regulations that ensure their operations do not discriminate against individuals.</data>
      <data key="d3">chunk-714d9f621f6eee9273625419653b083c</data>
      <data key="d4">./cached_docs/recital_21.json</data>
      <data key="d5">1747464262</data>
    </node>
    <node id="deployers of AI systems">
      <data key="d0">deployers of AI systems</data>
      <data key="d1">organization</data>
      <data key="d2">Deployers of AI systems are entities that utilize artificial intelligence technologies in their operations, also required to comply with regulations governing their use.</data>
      <data key="d3">chunk-714d9f621f6eee9273625419653b083c</data>
      <data key="d4">./cached_docs/recital_21.json</data>
      <data key="d5">1747464262</data>
    </node>
    <node id="Single Market For Digital Services">
      <data key="d0">Single Market For Digital Services</data>
      <data key="d1">category</data>
      <data key="d2">The Single Market For Digital Services is aimed at creating a unified framework for digital services across the EU, reducing discrepancies between member states.</data>
      <data key="d3">chunk-74def3a33d9c60f3c11227adf7704a09</data>
      <data key="d4">./cached_docs/recital_11.json</data>
      <data key="d5">1747464265</data>
    </node>
    <node id="Regulation 2022/2065">
      <data key="d0">Regulation 2022/2065</data>
      <data key="d1">event</data>
      <data key="d2">Regulation 2022/2065 is a legislative document from the European Union that addresses the liabilities of providers of intermediary services in the context of digital services.</data>
      <data key="d3">chunk-74def3a33d9c60f3c11227adf7704a09</data>
      <data key="d4">./cached_docs/recital_11.json</data>
      <data key="d5">1747464265</data>
    </node>
    <node id="Directive 2000/31/EC">
      <data key="d0">Directive 2000/31/EC</data>
      <data key="d1">event</data>
      <data key="d2">Directive 2000/31/EC, known as the E-Commerce Directive, lays down rules for electronic commerce in the EU, which the Digital Services Act amends.</data>
      <data key="d3">chunk-74def3a33d9c60f3c11227adf7704a09</data>
      <data key="d4">./cached_docs/recital_11.json</data>
      <data key="d5">1747464265</data>
    </node>
    <node id="Digital Services Act">
      <data key="d0">Digital Services Act</data>
      <data key="d1">category</data>
      <data key="d2">The Digital Services Act regulates digital services across the EU, focusing on the responsibility of intermediary service providers for the content they host.</data>
      <data key="d3">chunk-74def3a33d9c60f3c11227adf7704a09</data>
      <data key="d4">./cached_docs/recital_11.json</data>
      <data key="d5">1747464265</data>
    </node>
    <node id="Publicly Accessible Spaces">
      <data key="d0">Publicly Accessible Spaces</data>
      <data key="d1">geo</data>
      <data key="d2">Publicly Accessible Spaces are areas open to the general public where the use of AI systems for surveillance and biometric identification may occur.&lt;SEP&gt;Publicly Accessible Spaces are locations open to the general public where biometric identification systems may be deployed for law enforcement purposes.&lt;SEP&gt;Publicly accessible spaces include areas that are open to the general public, not restricted by signs or rules indicating otherwise.&lt;SEP&gt;Publicly accessible spaces are areas open to the general public where biometric identification through AI may take place, raising issues of surveillance and privacy.</data>
      <data key="d3">chunk-ee1f186f5aed070bc8e6e813caed9967&lt;SEP&gt;chunk-ab148daacc5693b15ec462635a5502a7&lt;SEP&gt;chunk-4013941d0b165f5643b927164f2ffd1c&lt;SEP&gt;chunk-dc0db03f57b007cfc458657e88e273ae</data>
      <data key="d4">./cached_docs/recital_32.json&lt;SEP&gt;./cached_docs/recital_35.json&lt;SEP&gt;./cached_docs/recital_38.json&lt;SEP&gt;./cached_docs/recital_19.json</data>
      <data key="d5">1747657468</data>
    </node>
    <node id="Urgency Situations">
      <data key="d0">Urgency Situations</data>
      <data key="d1">category</data>
      <data key="d2">Urgency Situations refer to specific circumstances that may require immediate action, allowing law enforcement to use biometric systems without prior authorization.</data>
      <data key="d3">chunk-dc0db03f57b007cfc458657e88e273ae</data>
      <data key="d4">./cached_docs/recital_35.json</data>
      <data key="d5">1747464271</data>
    </node>
    <node id="remote biometric identification system">
      <data key="d0">remote biometric identification system</data>
      <data key="d1">category</data>
      <data key="d2">A remote biometric identification system is an AI system that identifies individuals without their direct involvement, using data from a reference database.&lt;SEP&gt;Remote biometric identification systems are technologies that analyze physical characteristics for identification purposes, often linked to legality in data usage.&lt;SEP&gt;Remote biometric identification systems are AI systems designed for the identification of individuals at a distance using biometric data, typically without their active involvement.</data>
      <data key="d3">chunk-0f62cf38e10f73dd06a997571902c1ef&lt;SEP&gt;chunk-071372b252509d0e29e64264c0511359&lt;SEP&gt;chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/recital_35.json&lt;SEP&gt;./cached_docs/recital_17.json</data>
      <data key="d5">1747658025</data>
    </node>
    <node id="Adverse Legal Effect">
      <data key="d0">Adverse Legal Effect</data>
      <data key="d1">category</data>
      <data key="d2">An adverse legal effect refers to a negative consequence or outcome resulting from a decision made by legal authorities, potentially impacting an individual.</data>
      <data key="d3">chunk-071372b252509d0e29e64264c0511359</data>
      <data key="d4">./cached_docs/recital_35.json</data>
      <data key="d5">1747464271</data>
    </node>
    <node id="Output Data">
      <data key="d0">Output Data</data>
      <data key="d1">category</data>
      <data key="d2">Output data refers to the results or products generated by an AI system after processing input data.</data>
      <data key="d3">chunk-071372b252509d0e29e64264c0511359</data>
      <data key="d4">./cached_docs/recital_35.json</data>
      <data key="d5">1747464271</data>
    </node>
    <node id="Data Acquisition">
      <data key="d0">Data Acquisition</data>
      <data key="d1">category</data>
      <data key="d2">Data acquisition involves obtaining information from various sources for analysis, which may be subject to legal regulations.</data>
      <data key="d3">chunk-071372b252509d0e29e64264c0511359</data>
      <data key="d4">./cached_docs/recital_35.json</data>
      <data key="d5">1747464271</data>
    </node>
    <node id="Deep Fakes">
      <data key="d0">Deep Fakes</data>
      <data key="d1">category</data>
      <data key="d2">Deep fakes are media that have been created or altered using AI to convincingly resemble real people or events, posing challenges to authenticity and transparency.</data>
      <data key="d3">chunk-4acea71d2f59038573b7ec13db4ad10b</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464275</data>
    </node>
    <node id="Transparency Obligation">
      <data key="d0">Transparency Obligation</data>
      <data key="d1">category</data>
      <data key="d2">The transparency obligation requires that content created by AI be labeled to indicate its artificial nature, especially when it resembles existing entities or events.</data>
      <data key="d3">chunk-4acea71d2f59038573b7ec13db4ad10b</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464278</data>
    </node>
    <node id="Public Interest">
      <data key="d0">Public Interest</data>
      <data key="d1">category</data>
      <data key="d2">Public interest encompasses activities and services that prioritize the welfare of the general public, particularly in sectors like healthcare and education.&lt;SEP&gt;Public interest refers to the welfare or well-being of the general public, which can be affected by AI-generated or manipulated content.</data>
      <data key="d3">chunk-4acea71d2f59038573b7ec13db4ad10b&lt;SEP&gt;chunk-3a1d78baf29c07c65edc311f0ca04126</data>
      <data key="d4">./cached_docs/recital_96.json&lt;SEP&gt;./cached_docs/recital_134.json</data>
      <data key="d5">1747657257</data>
    </node>
    <node id="Image Content">
      <data key="d0">Image Content</data>
      <data key="d1">category</data>
      <data key="d2">Image content refers to visual media that can be generated or manipulated by AI systems, often in a manner that resembles real persons or objects.</data>
      <data key="d3">chunk-4acea71d2f59038573b7ec13db4ad10b</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464278</data>
    </node>
    <node id="Audio Content">
      <data key="d0">Audio Content</data>
      <data key="d1">category</data>
      <data key="d2">Audio content encompasses sound media that AI systems can create or alter to appear authentic or truthful.</data>
      <data key="d3">chunk-4acea71d2f59038573b7ec13db4ad10b</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464278</data>
    </node>
    <node id="Video Content">
      <data key="d0">Video Content</data>
      <data key="d1">category</data>
      <data key="d2">Video content is moving image media that can be generated or manipulated by AI systems, raising concerns over its authenticity.</data>
      <data key="d3">chunk-4acea71d2f59038573b7ec13db4ad10b</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464278</data>
    </node>
    <node id="Rights and Freedoms of Third Parties">
      <data key="d0">Rights and Freedoms of Third Parties</data>
      <data key="d1">category</data>
      <data key="d2">Rights and freedoms of third parties refer to the legal protections that must be respected when using AI-generated content.</data>
      <data key="d3">chunk-4acea71d2f59038573b7ec13db4ad10b</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464278</data>
    </node>
    <node id="Editorial Control">
      <data key="d0">Editorial Control</data>
      <data key="d1">category</data>
      <data key="d2">Editorial control pertains to the oversight given to individuals or organizations over the content published, ensuring accountability for the material.</data>
      <data key="d3">chunk-4acea71d2f59038573b7ec13db4ad10b</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464278</data>
    </node>
    <node id="AI-generated content">
      <data key="d0">AI-generated content</data>
      <data key="d1">category</data>
      <data key="d2">AI-generated content refers to material created by artificial intelligence for information dissemination, contingent upon editorial oversight.</data>
      <data key="d3">chunk-03f09b5ce9e149c51cfde2a77cd90759</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464278</data>
    </node>
    <node id="human review">
      <data key="d0">human review</data>
      <data key="d1">category</data>
      <data key="d2">Human review refers to the process where AI-generated content is evaluated or edited by a person to ensure quality and accountability.</data>
      <data key="d3">chunk-03f09b5ce9e149c51cfde2a77cd90759</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464278</data>
    </node>
    <node id="editorial control">
      <data key="d0">editorial control</data>
      <data key="d1">category</data>
      <data key="d2">Editorial control denotes the control exercised over published content to meet ethical or legal standards, ensuring accuracy and responsibility.</data>
      <data key="d3">chunk-03f09b5ce9e149c51cfde2a77cd90759</data>
      <data key="d4">./cached_docs/recital_134.json</data>
      <data key="d5">1747464278</data>
    </node>
    <node id="Code of Conduct for AI Systems">
      <data key="d0">Code of Conduct for AI Systems</data>
      <data key="d1">category</data>
      <data key="d2">The Code of Conduct for AI Systems is a guideline aimed at fostering the voluntary application of ethical standards and governance in AI development and deployment.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240</data>
      <data key="d4">./cached_docs/article_95.json</data>
      <data key="d5">1747464282</data>
    </node>
    <node id="Vulnerable Persons">
      <data key="d0">Vulnerable Persons</data>
      <data key="d1">category</data>
      <data key="d2">Vulnerable persons refer to individuals or groups who may require special consideration and protection due to factors such as disability, socio-economic status, or discrimination.&lt;SEP&gt;Vulnerable persons refers to groups that might be negatively impacted by AI systems, including individuals with disabilities and those facing gender inequality.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240&lt;SEP&gt;chunk-40f3761e589fb7702938fd4fbbecfdcc</data>
      <data key="d4">./cached_docs/article_95.json</data>
      <data key="d5">1747464282</data>
    </node>
    <node id="Union Ethical Guidelines for Trustworthy AI">
      <data key="d0">Union Ethical Guidelines for Trustworthy AI</data>
      <data key="d1">category</data>
      <data key="d2">The Union Ethical Guidelines for Trustworthy AI provide a framework for developing AI systems that adhere to ethical principles, ensuring accountability, transparency, and respect for human rights.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240</data>
      <data key="d4">./cached_docs/article_95.json</data>
      <data key="d5">1747464282</data>
    </node>
    <node id="Governance Mechanisms">
      <data key="d0">Governance Mechanisms</data>
      <data key="d1">category</data>
      <data key="d2">Governance Mechanisms are frameworks or systems implemented to manage and regulate the ethical application of AI technologies and assure compliance with established codes.&lt;SEP&gt;Governance mechanisms are frameworks and practices designed to ensure the responsible development and use of AI systems, incorporating ethical standards and stakeholder involvement.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240&lt;SEP&gt;chunk-0c14e1756e1d8d71ac3ba07125f122da</data>
      <data key="d4">./cached_docs/article_95.json&lt;SEP&gt;./cached_docs/recital_165.json</data>
      <data key="d5">1747657078</data>
    </node>
    <node id="Diversity in AI Design">
      <data key="d0">Diversity in AI Design</data>
      <data key="d1">category</data>
      <data key="d2">Diversity in AI design focuses on creating inclusive and representative development teams to enhance the performance and ethical implications of AI systems.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240</data>
      <data key="d4">./cached_docs/article_95.json</data>
      <data key="d5">1747464282</data>
    </node>
    <node id="Accessibility for Persons with a Disability">
      <data key="d0">Accessibility for Persons with a Disability</data>
      <data key="d1">category</data>
      <data key="d2">Accessibility for Persons with a Disability ensures that AI systems are designed to be usable by individuals with disabilities, promoting equal access and opportunities.</data>
