      <data key="d0">Operators of High-Risk AI Systems</data>
      <data key="d1">organization</data>
      <data key="d2">Operators of High-Risk AI Systems are entities responsible for managing AI systems that are categorized as high-risk and must comply with strict regulations.</data>
      <data key="d3">chunk-f8e23760d52ebfb589b4de63afe8ab83</data>
