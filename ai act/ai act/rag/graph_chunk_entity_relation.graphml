      <data key="d0">Section A</data>
      <data key="d1">category</data>
      <data key="d2">Section A is part of Annex VIII, detailing specific points related to data that is generally applicable in EU regulatory contexts.</data>
      <data key="d3">chunk-d7f74259ac0ec20e9f3989df868f56b4</data>
