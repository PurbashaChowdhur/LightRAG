      <data key="d5">1747658087</data>
    </node>
    <node id="Asylum Management">
      <data key="d0">Asylum Management</data>
      <data key="d1">category</data>
      <data key="d2">Asylum Management refers to the use of AI technologies in the processes related to managing asylum seekers, which often involves high-risk AI systems.</data>
      <data key="d3">chunk-1f116a95954c59b63ce3149e6283ed8e</data>
      <data key="d4">./cached_docs/article_49.json</data>
    </node>
    <node id="Migration Control">
      <data key="d0">Migration Control</data>
      <data key="d1">category</data>
      <data key="d2">Migration Control refers to policies and practices related to managing the flow of individuals entering or leaving a country, potentially using high-risk AI systems.</data>
      <data key="d3">chunk-1f116a95954c59b63ce3149e6283ed8e</data>
      <data key="d4">./cached_docs/article_49.json</data>
    </node>
    <node id="Annex VIII">
      <data key="d0">Annex VIII</data>
      <data key="d1">category</data>
      <data key="d2">Annex VIII outlines the data categories that must be entered into the EU database regarding AI systems as referenced in the regulation.&lt;SEP&gt;Annex VIII refers to a section of EU regulations outlining specific provisions regarding the handling and access to restricted information, detailing points related to the categorization of data.</data>
      <data key="d3">chunk-72498ec90c19419f10373dde7e7b51b3&lt;SEP&gt;chunk-d7f74259ac0ec20e9f3989df868f56b4</data>
