      <data key="d11">1747657580</data>
    </edge>
    <edge source="Commission" target="Article 96">
      <data key="d6">8.0</data>
      <data key="d7">Article 96 stipulates that the Commission must issue guidelines based on the Regulation, indicating the Commission's guiding role.</data>
