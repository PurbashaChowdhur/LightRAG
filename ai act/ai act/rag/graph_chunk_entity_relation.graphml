    </node>
    <node id="Civil Society Organisations">
      <data key="d0">Civil Society Organisations</data>
      <data key="d1">organization</data>
      <data key="d2">Civil Society Organisations are nonprofit groups that advocate for public interests and often participate in discussions around AI regulations and ethics.&lt;SEP&gt;Civil Society Organisations represent a range of non-governmental stakeholders who participate in the development of codes of conduct for AI systems, bringing in diverse perspectives and interests.&lt;SEP&gt;Civil society organisations are groups that could be consulted for diverse perspectives in the development of AI codes of practice.&lt;SEP&gt;Civil Society Organizations play a crucial role in advocating for the rights of those affected by high-risk AI systems and voicing their concerns during assessments.&lt;SEP&gt;Civil society organisations include non-governmental groups that can help in conducting impact assessments and advocating for affected individuals.</data>
      <data key="d3">chunk-ee04f6104a24650416810ede28f3790b&lt;SEP&gt;chunk-40f3761e589fb7702938fd4fbbecfdcc&lt;SEP&gt;chunk-3a1d78baf29c07c65edc311f0ca04126&lt;SEP&gt;chunk-69b5f24963810305f2a7846d54923bf0&lt;SEP&gt;chunk-0c14e1756e1d8d71ac3ba07125f122da</data>
      <data key="d4">./cached_docs/recital_96.json&lt;SEP&gt;./cached_docs/recital_116.json&lt;SEP&gt;./cached_docs/recital_165.json&lt;SEP&gt;./cached_docs/article_95.json</data>
      <data key="d5">1747657257</data>
    </node>
    <node id="European standardisation organisations">
      <data key="d0">European standardisation organisations</data>
      <data key="d1">category</data>
      <data key="d2">European standardisation organisations are bodies involved in drafting harmonised standards as requested by the Commission.&lt;SEP&gt;European standardisation organisations are bodies responsible for developing and maintaining standards in various sectors, including technology and AI, to ensure compliance with EU regulations.&lt;SEP&gt;European standardisation organisations are bodies within the EU responsible for developing and publishing European standards.&lt;SEP&gt;European standardisation organisations are responsible for developing and managing harmonised standards within the EU framework as outlined in Regulation (EU) No 1025/2012.</data>
      <data key="d3">chunk-010f171cc1a7f217689efe00fd8cb656&lt;SEP&gt;chunk-2739984aae71aa27a0af867bc197b730&lt;SEP&gt;chunk-d6fc829d58f1a7bbf3defd5cbe758b8f&lt;SEP&gt;chunk-e24261c10195e33e965bd7e966c33337</data>
      <data key="d4">./cached_docs/article_40.json&lt;SEP&gt;./cached_docs/article_41.json&lt;SEP&gt;./cached_docs/recital_121.json</data>
      <data key="d5">1747658156</data>
    </node>
    <node id="Consumer organisations">
      <data key="d0">Consumer organisations</data>
      <data key="d1">category</data>
      <data key="d2">Consumer organisations advocate for consumer rights and interests in the regulatory processes and standardisation efforts.</data>
      <data key="d3">chunk-e24261c10195e33e965bd7e966c33337</data>
      <data key="d4">./cached_docs/recital_121.json</data>
    </node>
    <node id="Environmental and social stakeholders">
      <data key="d0">Environmental and social stakeholders</data>
      <data key="d1">category</data>
      <data key="d2">Environmental and social stakeholders include groups that influence and advocate for standards that meet fundamental rights concerns.</data>
      <data key="d3">chunk-e24261c10195e33e965bd7e966c33337</data>
      <data key="d4">./cached_docs/recital_121.json</data>
    </node>
    <node id="Standardisation">
      <data key="d0">Standardisation</data>
      <data key="d1">category</data>
      <data key="d2">Standardisation refers to the process of developing and establishing technical standards to ensure compatibility and promote innovation within a market.</data>
      <data key="d3">chunk-e24261c10195e33e965bd7e966c33337</data>
      <data key="d4">./cached_docs/recital_121.json</data>
    </node>
    <node id="Article 2, point (1)(c)">
      <data key="d0">Article 2, point (1)(c)</data>
      <data key="d1">category</data>
      <data key="d2">Article 2, point (1)(c) of Regulation (EU) No 1025/2012 outlines the expectations for harmonised standards to reflect the state of the art for market compliance.</data>
      <data key="d3">chunk-e24261c10195e33e965bd7e966c33337</data>
      <data key="d4">./cached_docs/recital_121.json</data>
    </node>
    <node id="Articles 5 and 6">
      <data key="d0">Articles 5 and 6</data>
      <data key="d1">category</data>
      <data key="d2">Articles 5 and 6 of Regulation (EU) No 1025/2012 emphasize the importance of balanced representation of stakeholders in the development of standards.</data>
      <data key="d3">chunk-e24261c10195e33e965bd7e966c33337</data>
      <data key="d4">./cached_docs/recital_121.json</data>
    </node>
    <node id="Common Specifications">
      <data key="d0">Common Specifications</data>
      <data key="d1">category</data>
      <data key="d2">Common specifications are alternative regulations that the Commission may establish when appropriate harmonised standards are unavailable or inadequate.&lt;SEP&gt;Common specifications are established guidelines that support regulatory compliance and product quality, particularly for high-risk AI systems.&lt;SEP&gt;Common specifications serve as alternative guidelines for compliance assessment when harmonised standards do not exist.&lt;SEP&gt;Common specifications are guidelines or standards that high-risk AI systems must conform to, ensuring they meet regulatory requirements.</data>
      <data key="d3">chunk-4f41337092de45470ab838aff17309ff&lt;SEP&gt;chunk-69838403e8b59bb122436a0d25a9fc1e&lt;SEP&gt;chunk-e24261c10195e33e965bd7e966c33337&lt;SEP&gt;chunk-07b79b1855840c81b5d9079a82c7e9fb</data>
      <data key="d4">./cached_docs/article_43.json&lt;SEP&gt;./cached_docs/article_41.json&lt;SEP&gt;./cached_docs/recital_122.json&lt;SEP&gt;./cached_docs/recital_121.json</data>
      <data key="d5">1747658160</data>
    </node>
    <node id="Advisory Forum">
      <data key="d0">Advisory Forum</data>
      <data key="d1">organization</data>
      <data key="d2">The Advisory Forum is a consultative body referenced in the regulation, tasked with providing expertise on standardisation matters.&lt;SEP&gt;The Advisory Forum is established to facilitate discussions and provide recommendations on regulatory matters, meeting at least twice a year and producing annual reports.&lt;SEP&gt;The advisory forum is established to ensure stakeholder involvement and provide technical expertise in relation to the Regulation.&lt;SEP&gt;The Advisory Forum provides stakeholder input and guidance for implementing AI regulations at both national and Union levels.&lt;SEP&gt;The Advisory Forum is a group referenced in Article 67 of Regulation (EU) No 1025/2012, involved in providing opinions for regulatory matters.</data>
      <data key="d3">chunk-f76666cf495bb0f0810313fe42e2c882&lt;SEP&gt;chunk-4f41337092de45470ab838aff17309ff&lt;SEP&gt;chunk-699c5fa3a4d8d093e6a599637df82443&lt;SEP&gt;chunk-0e6a5cc59273abbe42c743808026477c&lt;SEP&gt;chunk-e24261c10195e33e965bd7e966c33337</data>
      <data key="d4">./cached_docs/recital_148.json&lt;SEP&gt;./cached_docs/article_41.json&lt;SEP&gt;./cached_docs/article_67.json&lt;SEP&gt;./cached_docs/recital_150.json&lt;SEP&gt;./cached_docs/recital_121.json</data>
      <data key="d5">1747658160</data>
    </node>
    <node id="harmonised standards">
      <data key="d0">harmonised standards</data>
      <data key="d1">category</data>
      <data key="d2">Harmonised standards are European standards that facilitate compliance with legislation, especially in addressing fundamental rights and technical requirements.</data>
      <data key="d3">chunk-d6fc829d58f1a7bbf3defd5cbe758b8f</data>
      <data key="d4">./cached_docs/recital_121.json</data>
    </node>
    <node id="standardisation bodies">
      <data key="d0">standardisation bodies</data>
      <data key="d1">category</data>
      <data key="d2">Standardisation bodies are organizations responsible for the development and approval of standards at national and international levels, playing a crucial role in the standardisation process.</data>
      <data key="d3">chunk-d6fc829d58f1a7bbf3defd5cbe758b8f</data>
      <data key="d4">./cached_docs/recital_121.json</data>
    </node>
    <node id="European standardisation">
      <data key="d0">European standardisation</data>
      <data key="d1">category</data>
      <data key="d2">European standardisation involves the development and implementation of standards at the European level to ensure interoperability and safety within the EU market.</data>
      <data key="d3">chunk-d6fc829d58f1a7bbf3defd5cbe758b8f</data>
      <data key="d4">./cached_docs/recital_121.json</data>
    </node>
