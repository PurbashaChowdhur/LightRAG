      <data key="d5">1747464661</data>
    </node>
    <node id="Law Enforcement Cooperation">
      <data key="d0">Law Enforcement Cooperation</data>
      <data key="d1">event</data>
      <data key="d2">Law Enforcement Cooperation details agreements and frameworks established for cooperation between nations concerning crime prevention and judicial processes.&lt;SEP&gt;Law Enforcement Cooperation involves collaborative efforts among various authorities in the Union and third countries to achieve common law and order goals.</data>
      <data key="d3">chunk-3e78bce1eaa5df9c186492b5e1482218&lt;SEP&gt;chunk-6a90a47461f525bba18d74c42ea04f88</data>
      <data key="d4">./cached_docs/recital_22.json</data>
    </node>
    <node id="Data Processing">
      <data key="d0">Data Processing</data>
      <data key="d1">event</data>
      <data key="d2">Data processing refers to the handling and manipulation of data by AI systems or operators for various purposes.</data>
      <data key="d3">chunk-3e78bce1eaa5df9c186492b5e1482218</data>
      <data key="d4">./cached_docs/recital_22.json</data>
    </node>
    <node id="Safeguards">
      <data key="d0">Safeguards</data>
      <data key="d1">category</data>
      <data key="d2">Safeguards are measures put in place to protect fundamental rights and freedoms, ensuring compliance with regulations.</data>
      <data key="d3">chunk-3e78bce1eaa5df9c186492b5e1482218</data>
      <data key="d4">./cached_docs/recital_22.json</data>
    </node>
    <node id="Contracting Parties">
      <data key="d0">Contracting Parties</data>
      <data key="d1">organization</data>
      <data key="d2">Contracting parties are entities or individuals involved in agreements or treaties related to law enforcement and judicial cooperation with the Union.</data>
      <data key="d3">chunk-3e78bce1eaa5df9c186492b5e1482218</data>
      <data key="d4">./cached_docs/recital_22.json</data>
    </node>
    <node id="International Organisations">
      <data key="d0">International Organisations</data>
      <data key="d1">organization</data>
      <data key="d2">International Organisations collaborate on global matters of governance and regulation, including AI.&lt;SEP&gt;International Organisations work collaboratively with Union institutions and competent authorities on regulatory and safety matters.&lt;SEP&gt;International organisations are entities created by treaties between governments to facilitate cooperation in areas such as law enforcement and human rights.</data>
      <data key="d3">chunk-6a90a47461f525bba18d74c42ea04f88&lt;SEP&gt;chunk-00e7606a0fa9d588f18d67d02cfcf654&lt;SEP&gt;chunk-577494efd5ce842563e6974b0da9707b</data>
      <data key="d4">./cached_docs/recital_22.json&lt;SEP&gt;./cached_docs/article_66.json</data>
      <data key="d5">1747464195</data>
    </node>
    <node id="Adequate Safeguards">
      <data key="d0">Adequate Safeguards</data>
      <data key="d1">category</data>
      <data key="d2">Adequate safeguards refer to the measures and policies in place to ensure the protection of fundamental rights and freedoms within law enforcement cooperation.</data>
      <data key="d3">chunk-6a90a47461f525bba18d74c42ea04f88</data>
      <data key="d4">./cached_docs/recital_22.json</data>
    </node>
    <node id="Fundamental Rights and Freedoms">
      <data key="d0">Fundamental Rights and Freedoms</data>
      <data key="d1">category</data>
      <data key="d2">Fundamental rights and freedoms are basic human rights that are guaranteed to individuals, which must be protected during law enforcement activities.&lt;SEP&gt;Fundamental rights and freedoms refer to the basic human rights enshrined in laws and regulations that protect individuals from discrimination and ensure equal treatment.</data>
      <data key="d3">chunk-6a90a47461f525bba18d74c42ea04f88&lt;SEP&gt;chunk-602b68fe088482c0037845fc0b520c30</data>
      <data key="d4">./cached_docs/recital_22.json&lt;SEP&gt;./cached_docs/recital_70.json</data>
      <data key="d5">1747464901</data>
    </node>
    <node id="Recipient National Authorities">
      <data key="d0">Recipient National Authorities</data>
      <data key="d1">category</data>
      <data key="d2">Recipient national authorities are the governmental bodies in charge of implementing cooperation agreements and ensuring compliance with Union law.</data>
      <data key="d3">chunk-6a90a47461f525bba18d74c42ea04f88</data>
      <data key="d4">./cached_docs/recital_22.json</data>
    </node>
    <node id="Law Enforcement and Judicial Cooperation">
      <data key="d0">Law Enforcement and Judicial Cooperation</data>
      <data key="d1">event</data>
      <data key="d2">Law enforcement and judicial cooperation encompasses the agreements and frameworks established for the effective collaboration of legal authorities across borders.</data>
      <data key="d3">chunk-6a90a47461f525bba18d74c42ea04f88</data>
      <data key="d4">./cached_docs/recital_22.json</data>
    </node>
    <node id="Union Economy">
      <data key="d0">Union Economy</data>
      <data key="d1">geo</data>
      <data key="d2">The Union economy refers to the collective economic activities and growth opportunities available within a specified region or community, especially in the context of free and open-source software.</data>
      <data key="d3">chunk-769497b509433ed0e4746ff50bbdec69</data>
      <data key="d4">./cached_docs/recital_102.json</data>
    </node>
    <node id="Open-Source Licence">
      <data key="d0">Open-Source Licence</data>
      <data key="d1">category</data>
      <data key="d2">An open-source licence is a type of software license that allows users to freely access, modify, and share software and data, fostering innovation and collaboration.</data>
      <data key="d3">chunk-769497b509433ed0e4746ff50bbdec69</data>
      <data key="d4">./cached_docs/recital_102.json</data>
    </node>
    <node id="Software and Data">
      <data key="d0">Software and Data</data>
      <data key="d1">category</data>
      <data key="d2">Software and data encompass a broad range of digital resources that can be used, modified, and shared under specific licensing conditions, contributing to innovation and research.</data>
      <data key="d3">chunk-769497b509433ed0e4746ff50bbdec69</data>
      <data key="d4">./cached_docs/recital_102.json</data>
    </node>
    <node id="Research and Innovation">
      <data key="d0">Research and Innovation</data>
      <data key="d1">category</data>
      <data key="d2">Research and innovation refer to activities aimed at creating new knowledge and solutions that can lead to advancements in various fields, driven by available technology and data.</data>
      <data key="d3">chunk-769497b509433ed0e4746ff50bbdec69</data>
      <data key="d4">./cached_docs/recital_102.json</data>
    </node>
    <node id="Market">
      <data key="d0">Market</data>
      <data key="d1">category</data>
      <data key="d2">The market refers to the economic space where goods and services are exchanged, and where innovations can foster growth opportunities for economic development.&lt;SEP&gt;The market refers to the economic space where goods, including AI systems, are made available for purchase or deployment, subject to regulatory standards.</data>
      <data key="d3">chunk-769497b509433ed0e4746ff50bbdec69&lt;SEP&gt;chunk-6a8bd64d122f5a09e9e3859bf77c6931</data>
      <data key="d4">./cached_docs/recital_84.json&lt;SEP&gt;./cached_docs/recital_102.json</data>
      <data key="d5">1747657053</data>
    </node>
    <node id="public law body">
      <data key="d0">public law body</data>
      <data key="d1">organization</data>
      <data key="d2">A public law body is responsible for overseeing the deployment of high-risk AI systems and ensuring compliance with legal standards.</data>
      <data key="d3">chunk-77a0a99b47c288a96d7474c796efb766</data>
      <data key="d4">./cached_docs/article_27.json</data>
    </node>
    <node id="private entities providing public services">
      <data key="d0">private entities providing public services</data>
      <data key="d1">organization</data>
      <data key="d2">Private entities that provide public services are also responsible for implementing assessments and governance measures for high-risk AI systems.</data>
      <data key="d3">chunk-77a0a99b47c288a96d7474c796efb766</data>
      <data key="d4">./cached_docs/article_27.json</data>
    </node>
    <node id="Article 6(2)">
      <data key="d0">Article 6(2)</data>
      <data key="d1">category</data>
      <data key="d2">Article 6(2) refers to a specific provision that outlines the requirements for deploying high-risk AI systems.</data>
      <data key="d3">chunk-77a0a99b47c288a96d7474c796efb766</data>
      <data key="d4">./cached_docs/article_27.json</data>
    </node>
    <node id="High-Risk AI Assessment">
      <data key="d0">High-Risk AI Assessment</data>
      <data key="d1">category</data>
      <data key="d2">The High-Risk AI Assessment is a required evaluation of potential impacts on fundamental rights before AI deployment.</data>
      <data key="d3">chunk-77a0a99b47c288a96d7474c796efb766</data>
      <data key="d4">./cached_docs/article_27.json</data>
    </node>
    <node id="Fundamental Rights Impact Assessments">
      <data key="d0">Fundamental Rights Impact Assessments</data>
      <data key="d1">category</data>
      <data key="d2">Fundamental Rights Impact Assessments evaluate the implications of AI systems on individuals' rights and determine compliance with legal frameworks.</data>
      <data key="d3">chunk-0efde0679d72a2d51e7acdaf09979bfc</data>
      <data key="d4">./cached_docs/article_27.json</data>
    </node>
    <node id="Data Protection Impact Assessment">
      <data key="d0">Data Protection Impact Assessment</data>
      <data key="d1">category</data>
      <data key="d2">Data Protection Impact Assessment is an evaluation that focuses on how data processing activities affect individuals' privacy rights and data protection.</data>
      <data key="d3">chunk-a3f4621c3d73dca675e991da5d0c9317</data>
      <data key="d4">./cached_docs/article_27.json</data>
    </node>
    <node id="Whistleblowers">
      <data key="d0">Whistleblowers</data>
      <data key="d1">category</data>
      <data key="d2">Whistleblowers are individuals who report illicit activity within organizations, and they are protected under regulations such as Directive (EU) 2019/1937.</data>
      <data key="d3">chunk-1265df2d2f07835cf2aadd7299c694a9</data>
      <data key="d4">./cached_docs/article_87.json</data>
    </node>
    <node id="Undertakings">
      <data key="d0">Undertakings</data>
      <data key="d1">organization</data>
      <data key="d2">Undertakings are businesses or enterprises that collect or process personal data and must comply with data protection laws.&lt;SEP&gt;Undertakings refer to businesses or organizations that are subject to the Union's regulations and economic policies.</data>
      <data key="d3">chunk-828a2d9070cae319b764e3b609bc9b81&lt;SEP&gt;chunk-41cdee30f8345bc3690d876d77e6845c</data>
      <data key="d4">./cached_docs/recital_2.json&lt;SEP&gt;./cached_docs/article_100.json</data>
      <data key="d5">1747657789</data>
    </node>
    <node id="Trustworthy AI">
      <data key="d0">Trustworthy AI</data>
      <data key="d1">category</data>
      <data key="d2">Trustworthy AI refers to artificial intelligence technologies developed and deployed in a manner that is ethical, transparent, and respects fundamental rights and safety.&lt;SEP&gt;Trustworthy AI refers to artificial intelligence that aligns with the Union's values, prioritizing safety, ethics, and reliability.&lt;SEP&gt;Trustworthy AI refers to the development and use of artificial intelligence that meets ethical and legal standards, ensuring safety and compliance with fundamental rights.</data>
      <data key="d3">chunk-41cdee30f8345bc3690d876d77e6845c&lt;SEP&gt;chunk-21acb22d994b8f65ea3709a99eb85032&lt;SEP&gt;chunk-ae8bdbb57af24d78fe2313201571bea7</data>
      <data key="d4">./cached_docs/recital_20.json&lt;SEP&gt;./cached_docs/recital_3.json&lt;SEP&gt;./cached_docs/recital_2.json</data>
      <data key="d5">1747464083</data>
    </node>
    <node id="Innovation">
      <data key="d0">Innovation</data>
      <data key="d1">category</data>
      <data key="d2">Innovation refers to the process of developing new technologies or improving existing technologies, which is the primary goal of establishing AI Regulatory Sandboxes.&lt;SEP&gt;Innovation signifies the Union's commitment to fostering new ideas and technologies, particularly in sectors like AI and sustainable practices.</data>
      <data key="d3">chunk-475967c83e624bc711a9ff13e8150163&lt;SEP&gt;chunk-41cdee30f8345bc3690d876d77e6845c</data>
      <data key="d4">./cached_docs/recital_2.json&lt;SEP&gt;./cached_docs/article_57.json</data>
      <data key="d5">1747657689</data>
    </node>
    <node id="Article 114 TFEU">
      <data key="d0">Article 114 TFEU</data>
      <data key="d1">event</data>
      <data key="d2">Article 114 of the Treaty on the Functioning of the European Union outlines processes for establishing and implementing laws that protect the internal market.</data>
      <data key="d3">chunk-ae8bdbb57af24d78fe2313201571bea7</data>
      <data key="d4">./cached_docs/recital_3.json</data>
    </node>
    <node id="Article 16 TFEU">
      <data key="d0">Article 16 TFEU</data>
      <data key="d1">category</data>
      <data key="d2">Article 16 TFEU pertains to the EU Treaties, which addresses the protection of personal data and the implications for law enforcement.&lt;SEP&gt;Article 16 of the Treaty on the Functioning of the European Union addresses the protection of personal data, especially concerning AI systems.&lt;SEP&gt;Article 16 of the Treaty on the Functioning of the European Union (TFEU) addresses the processing of personal data and establishes the legal basis for regulations surrounding biometric data.</data>
      <data key="d3">chunk-ee1f186f5aed070bc8e6e813caed9967&lt;SEP&gt;chunk-ae8bdbb57af24d78fe2313201571bea7&lt;SEP&gt;chunk-d1b92a727425c41637e16da3cb9ac9c7</data>
      <data key="d4">./cached_docs/recital_38.json&lt;SEP&gt;./cached_docs/recital_3.json</data>
      <data key="d5">1747464715</data>
    </node>
    <node id="Internal Market">
      <data key="d0">Internal Market</data>
      <data key="d1">category</data>
      <data key="d2">The Internal Market of the European Union refers to the area where goods, services, capital, and people move freely across member states, guiding regulations like that for AI systems.&lt;SEP&gt;The Internal Market refers to the integrated marketplace within the European Union where goods, services, people, and capital move freely.&lt;SEP&gt;The internal market is an economic space within the EU allowing goods and services, including high-risk AI systems, to circulate freely among member countries.</data>
      <data key="d3">chunk-43942ba7283893ebf128acb858a20c58&lt;SEP&gt;chunk-ae8bdbb57af24d78fe2313201571bea7&lt;SEP&gt;chunk-6c2f867de2be6cb439557f91700b051c</data>
      <data key="d4">./cached_docs/recital_3.json&lt;SEP&gt;./cached_docs/recital_129.json&lt;SEP&gt;./cached_docs/recital_1.json</data>
      <data key="d5">1747658058</data>
    </node>
    <node id="Fundamental Rights Obligations">
      <data key="d0">Fundamental Rights Obligations</data>
      <data key="d1">category</data>
      <data key="d2">Fundamental Rights Obligations pertain to legal standards that protect individual rights and freedoms, essential in the context of AI deployment.</data>
      <data key="d3">chunk-ae8bdbb57af24d78fe2313201571bea7</data>
      <data key="d4">./cached_docs/recital_3.json</data>
    </node>
    <node id="National Rules">
      <data key="d0">National Rules</data>
      <data key="d1">category</data>
      <data key="d2">National Rules are regulations established by individual Member States to govern the deployment and use of AI in accordance with local legal frameworks.</data>
      <data key="d3">chunk-ae8bdbb57af24d78fe2313201571bea7</data>
      <data key="d4">./cached_docs/recital_3.json</data>
    </node>
    <node id="Regulation (EU) 2019/2144">
      <data key="d0">Regulation (EU) 2019/2144</data>
      <data key="d1">event</data>
      <data key="d2">Regulation (EU) 2019/2144 aims to enhance vehicle safety and includes provisions related to AI technologies used within vehicles.&lt;SEP&gt;Regulation (EU) 2019/2144 focuses on type-approval requirements for motor vehicles and enhances safety measures for vehicle occupants.&lt;SEP&gt;Regulation (EU) 2019/2144 is a legal framework that pertains to the implementation of standards for artificial intelligence systems within the EU.&lt;SEP&gt;This regulation outlines type-approval requirements for motor vehicles, focusing on general safety and protection of road users.</data>
      <data key="d3">chunk-b9e2499910b26136c66e6e7a013d8f0b&lt;SEP&gt;chunk-d4ba1d5ee9be6a9378df917d6a467f31&lt;SEP&gt;chunk-2af15b193dbeb2497919d2971657871e&lt;SEP&gt;chunk-be3ac2351d8798fda8093d05f96f97fa</data>
      <data key="d4">./cached_docs/article_109.json&lt;SEP&gt;./cached_docs/recital_49.json</data>
      <data key="d5">1747657302</data>
    </node>
    <node id="Regulation (EU) 2024/1689 of the European Parliament and of the Council">
      <data key="d0">Regulation (EU) 2024/1689 of the European Parliament and of the Council</data>
      <data key="d1">event</data>
      <data key="d2">Regulation (EU) 2024/1689 outlines harmonized rules on artificial intelligence, which amends several existing regulations and directives.</data>
      <data key="d3">chunk-b9e2499910b26136c66e6e7a013d8f0b</data>
      <data key="d4">./cached_docs/article_109.json</data>
    </node>
    <node id="Directives 2014/90/EU">
      <data key="d0">Directives 2014/90/EU</data>
      <data key="d1">category</data>
      <data key="d2">Directive 2014/90/EU relates to marine equipment, which is also affected by the amendments in Regulation (EU) 2024/1689.&lt;SEP&gt;Directives 2014/90/EU are EU legal acts that provide specific regulations within the area of robotics and AI technology.</data>
      <data key="d3">chunk-0a68b7c657291244b183bd644e6df395&lt;SEP&gt;chunk-b9e2499910b26136c66e6e7a013d8f0b</data>
      <data key="d4">./cached_docs/article_109.json&lt;SEP&gt;./cached_docs/article_108.json</data>
      <data key="d5">1747464292</data>
    </node>
    <node id="Directives 2016/797">
      <data key="d0">Directives 2016/797</data>
      <data key="d1">category</data>
      <data key="d2">Directive 2016/797 concerns the interoperability of the European rail system, amended by Regulation (EU) 2024/1689.&lt;SEP&gt;Directives 2016/797 focus on interoperability and safety standards for rail transport.</data>
      <data key="d3">chunk-0a68b7c657291244b183bd644e6df395&lt;SEP&gt;chunk-b9e2499910b26136c66e6e7a013d8f0b</data>
      <data key="d4">./cached_docs/article_109.json&lt;SEP&gt;./cached_docs/article_108.json</data>
      <data key="d5">1747464292</data>
    </node>
    <node id="Directives 2020/1828">
      <data key="d0">Directives 2020/1828</data>
      <data key="d1">category</data>
      <data key="d2">Directive 2020/1828 pertains to the protection of consumers in relation to digital contracts and is included in the amendments of Regulation (EU) 2024/1689.&lt;SEP&gt;Directives 2020/1828 relate to the standardization and management of AI systems and technologies.</data>
      <data key="d3">chunk-0a68b7c657291244b183bd644e6df395&lt;SEP&gt;chunk-b9e2499910b26136c66e6e7a013d8f0b</data>
      <data key="d4">./cached_docs/article_109.json&lt;SEP&gt;./cached_docs/article_108.json</data>
      <data key="d5">1747464292</data>
    </node>
    <node id="Regulation (EC) No 765/2008">
      <data key="d0">Regulation (EC) No 765/2008</data>
      <data key="d1">event</data>
      <data key="d2">Regulation (EC) No 765/2008 establishes harmonised rules for placing high-risk AI systems on the market in the EU, aiming for consumer protection and product safety.&lt;SEP&gt;Regulation (EC) No 765/2008 establishes the requirements for the CE marking, detailing conformity assessment procedures.&lt;SEP&gt;Regulation (EC) No 765/2008 is a legislative act established by the European Parliament and Council regarding accreditation.&lt;SEP&gt;This regulation establishes requirements for accreditation and ensures the credibility of conformity assessments in the EU market.&lt;SEP&gt;Regulation (EC) No 765/2008 establishes the framework for the operation of national accreditation bodies in the EU.</data>
      <data key="d3">chunk-a5ff05678672211287e9053ebcd9c1c6&lt;SEP&gt;chunk-c712c6235ebe0b7ee5102919bbe87d08&lt;SEP&gt;chunk-c28a81721b7de3ef4442495cc499b1cb&lt;SEP&gt;chunk-29241e99bddf5af77eca441d2d8dbc1b&lt;SEP&gt;chunk-8b474f9815c7033ca1ad8daff4012eff</data>
      <data key="d4">./cached_docs/article_48.json&lt;SEP&gt;./cached_docs/article_28.json&lt;SEP&gt;./cached_docs/recital_9.json</data>
      <data key="d5">1747657604</data>
    </node>
    <node id="Article 30">
      <data key="d0">Article 30</data>
      <data key="d1">event</data>
      <data key="d2">Article 30 of Regulation (EC) No 765/2008 outlines the general principles governing the CE marking process.</data>
      <data key="d3">chunk-29241e99bddf5af77eca441d2d8dbc1b</data>
      <data key="d4">./cached_docs/article_48.json</data>
    </node>
    <node id="Digital CE Marking">
      <data key="d0">Digital CE Marking</data>
      <data key="d1">category</data>
      <data key="d2">Digital CE marking is a virtual indication of compliance for high-risk AI systems that are provided digitally, supplementing the physical CE marking.&lt;SEP&gt;Digital CE marking refers to a digitally accessible form of CE marking for high-risk AI systems, ensuring easy validation by users.</data>
      <data key="d3">chunk-43942ba7283893ebf128acb858a20c58&lt;SEP&gt;chunk-29241e99bddf5af77eca441d2d8dbc1b</data>
      <data key="d4">./cached_docs/article_48.json&lt;SEP&gt;./cached_docs/recital_129.json</data>
      <data key="d5">1747658058</data>
    </node>
    <node id="Law">
      <data key="d0">Law</data>
      <data key="d1">category</data>
      <data key="d2">Law involves a system of rules created and enforced through social or governmental institutions to regulate behavior, and is pertinent in supervising fundamental rights.&lt;SEP&gt;Law refers to the system of rules that governs conduct within a community, including regulations on the deployment of AI systems and the handling of AI-generated content.&lt;SEP&gt;The Law indicates a set of legal regulations that govern the operations and safety standards of high-risk AI systems.</data>
      <data key="d3">chunk-50cb89ed7d0d818018d373ebefa65267&lt;SEP&gt;chunk-58a25c0dd884625561b248cf275f154e&lt;SEP&gt;chunk-75ffbd2452fab424919d626f5688692d</data>
      <data key="d4">./cached_docs/article_48.json&lt;SEP&gt;./cached_docs/article_28.json&lt;SEP&gt;./cached_docs/article_50.json</data>
      <data key="d5">1747657604</data>
    </node>
    <node id="UN Convention relating to the Status of Refugees">
      <data key="d0">UN Convention relating to the Status of Refugees</data>
      <data key="d1">event</data>
      <data key="d2">An international treaty that defines the rights of refugees and the responsibilities of nations to protect them, established in Geneva in 1951.&lt;SEP&gt;The UN Convention, established in Geneva in 1951, defines the status of refugees and outlines the rights of refugees and the obligations of states to protect them.</data>
      <data key="d3">chunk-bbb30099cdacdc2f1eb2ed182c6b4491&lt;SEP&gt;chunk-d44e4d07784e334a8ded2c1da49b969e</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="Regulation (EC) No 810/2009">
      <data key="d0">Regulation (EC) No 810/2009</data>
      <data key="d1">event</data>
      <data key="d2">A European regulation establishing a code for issuing visas, which includes procedures and conditions for applicants seeking entry into the EU.&lt;SEP&gt;Regulation (EC) No 810/2009 establishes a Community Code on Visas, governing visa processes in the EU.</data>
      <data key="d3">chunk-bbb30099cdacdc2f1eb2ed182c6b4491&lt;SEP&gt;chunk-d44e4d07784e334a8ded2c1da49b969e</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="Directive 2013/32/EU">
      <data key="d0">Directive 2013/32/EU</data>
      <data key="d1">event</data>
      <data key="d2">A directive from the European Parliament that establishes standards for the procedures for granting and withdrawing international protection.&lt;SEP&gt;Directive 2013/32/EU is a legal document established by the European Parliament and the Council which outlines procedures for international protection.&lt;SEP&gt;Directive 2013/32/EU outlines common procedures for granting and withdrawing international protection in the EU.</data>
      <data key="d3">chunk-bbb30099cdacdc2f1eb2ed182c6b4491&lt;SEP&gt;chunk-d44e4d07784e334a8ded2c1da49b969e&lt;SEP&gt;chunk-511a9744e58c5bca320f1c98646693c6</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="Competent Public Authorities">
      <data key="d0">Competent Public Authorities</data>
      <data key="d1">organization</data>
      <data key="d2">Organizations or entities within Member States that have the legal authority to make decisions regarding migration, asylum, and border control management.</data>
      <data key="d3">chunk-d44e4d07784e334a8ded2c1da49b969e</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="Asylum Applications">
      <data key="d0">Asylum Applications</data>
      <data key="d1">category</data>
      <data key="d2">Asylum applications are petitions filed by individuals seeking international protection based on fears of persecution in their home country.</data>
      <data key="d3">chunk-d44e4d07784e334a8ded2c1da49b969e</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="Visa Applications">
      <data key="d0">Visa Applications</data>
      <data key="d1">category</data>
      <data key="d2">Visa applications are requests made by individuals to enter a country for specific purposes, such as tourism, work, or study, that must comply with established regulations.</data>
      <data key="d3">chunk-d44e4d07784e334a8ded2c1da49b969e</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="UN Convention">
      <data key="d0">UN Convention</data>
      <data key="d1">event</data>
      <data key="d2">The UN Convention relating to the Status of Refugees is an international treaty that outlines the rights of refugees and the obligations of states to protect them.</data>
      <data key="d3">chunk-bbb30099cdacdc2f1eb2ed182c6b4491</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="Geneva">
      <data key="d0">Geneva</data>
      <data key="d1">geo</data>
      <data key="d2">Geneva is the city where the UN Convention relating to the Status of Refugees was done on 28 July 1951.</data>
      <data key="d3">chunk-bbb30099cdacdc2f1eb2ed182c6b4491</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="Non-Refoulement Principle">
      <data key="d0">Non-Refoulement Principle</data>
      <data key="d1">category</data>
      <data key="d2">The Non-Refoulement Principle is a cornerstone of international refugee law, prohibiting countries from returning refugees to countries where they may face danger or persecution.</data>
      <data key="d3">chunk-bbb30099cdacdc2f1eb2ed182c6b4491</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="EU Institutions">
      <data key="d0">EU Institutions</data>
      <data key="d1">organization</data>
      <data key="d2">EU Institutions include various bodies that create and enforce EU laws, such as the European Commission and the European Parliament.</data>
      <data key="d3">chunk-bbb30099cdacdc2f1eb2ed182c6b4491</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="International Protection">
      <data key="d0">International Protection</data>
      <data key="d1">category</data>
      <data key="d2">International protection refers to the legal protections provided to individuals who are seeking asylum or refugee status in other countries.</data>
      <data key="d3">chunk-511a9744e58c5bca320f1c98646693c6</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="Common Procedures">
      <data key="d0">Common Procedures</data>
      <data key="d1">category</data>
      <data key="d2">Common procedures refer to the standardized legal processes established to evaluate and permit or deny requests for international protection.</data>
      <data key="d3">chunk-511a9744e58c5bca320f1c98646693c6</data>
      <data key="d4">./cached_docs/recital_60.json</data>
    </node>
    <node id="Risk-Management Policies">
      <data key="d0">Risk-Management Policies</data>
      <data key="d1">category</data>
      <data key="d2">Risk-management policies are strategies implemented by AI model providers to ensure accountability, governance, and the mitigation of systemic risks.</data>
      <data key="d3">chunk-bee8a141261944c2193bcb00b304b768</data>
      <data key="d4">./cached_docs/recital_114.json</data>
    </node>
    <node id="Model Evaluations">
      <data key="d0">Model Evaluations</data>
      <data key="d1">category</data>
      <data key="d2">Model evaluations involve assessing AI systems to ensure their safety and effectiveness prior to introducing them to the market.</data>
      <data key="d3">chunk-bee8a141261944c2193bcb00b304b768</data>
      <data key="d4">./cached_docs/recital_114.json</data>
    </node>
    <node id="Post-Market Monitoring">
      <data key="d0">Post-Market Monitoring</data>
      <data key="d1">category</data>
      <data key="d2">Post-market monitoring refers to the ongoing observation and assessment of AI models after they have been deployed to ensure they meet regulatory standards.</data>
      <data key="d3">chunk-bee8a141261944c2193bcb00b304b768</data>
      <data key="d4">./cached_docs/recital_114.json</data>
    </node>
    <node id="Cooperation with Relevant Actors">
      <data key="d0">Cooperation with Relevant Actors</data>
      <data key="d1">category</data>
      <data key="d2">Cooperation with relevant actors involves working with other stakeholders in the AI ecosystem to manage risks and enhance the safety of AI technologies.</data>
      <data key="d3">chunk-bee8a141261944c2193bcb00b304b768</data>
      <data key="d4">./cached_docs/recital_114.json</data>
    </node>
    <node id="Notification Application">
      <data key="d0">Notification Application</data>
      <data key="d1">event</data>
      <data key="d2">The notification application is the process through which conformity assessment bodies apply for recognition by submitting required documents to the notifying authority.</data>
      <data key="d3">chunk-ff611ee371ea780574e9c16859c31f2f</data>
      <data key="d4">./cached_docs/article_29.json</data>
    </node>
    <node id="Accreditation Certificate">
      <data key="d0">Accreditation Certificate</data>
      <data key="d1">category</data>
      <data key="d2">An Accreditation Certificate is a document that verifies the competence of Conformity Assessment Bodies as required under Article 29.&lt;SEP&gt;The accreditation certificate is an official document issued by a national accreditation body confirming the competence of a conformity assessment body.</data>
      <data key="d3">chunk-4f94df6da4de89cee24b1bd8f504c377&lt;SEP&gt;chunk-ff611ee371ea780574e9c16859c31f2f</data>
      <data key="d4">./cached_docs/article_30.json&lt;SEP&gt;./cached_docs/article_29.json</data>
      <data key="d5">1747657935</data>
    </node>
    <node id="National Accreditation Body">
      <data key="d0">National Accreditation Body</data>
      <data key="d1">organization</data>
      <data key="d2">A National Accreditation Body is responsible for the assessment and monitoring of conformity assessment bodies as per Regulation (EC) No 765/2008.&lt;SEP&gt;National accreditation bodies are organizations that assess and ensure that conformity assessment bodies meet established standards.</data>
      <data key="d3">chunk-ff611ee371ea780574e9c16859c31f2f&lt;SEP&gt;chunk-c712c6235ebe0b7ee5102919bbe87d08</data>
      <data key="d4">./cached_docs/article_28.json&lt;SEP&gt;./cached_docs/article_29.json</data>
      <data key="d5">1747657604</data>
    </node>
    <node id="EU database">
      <data key="d0">EU database</data>
      <data key="d1">organization</data>
      <data key="d2">The EU database is a centralized digital repository where information related to compliance and market surveillance of various products and services is stored and monitored by authorities.&lt;SEP&gt;The EU database is a regulatory framework for registering high-risk AI systems, ensuring compliance with European Union standards.</data>
      <data key="d3">chunk-610573a7c194ad780ed97782200a740c&lt;SEP&gt;chunk-1f116a95954c59b63ce3149e6283ed8e</data>
      <data key="d4">./cached_docs/article_49.json&lt;SEP&gt;./cached_docs/article_80.json</data>
      <data key="d5">1747658093</data>
    </node>
    <node id="Article 71">
      <data key="d0">Article 71</data>
      <data key="d1">event</data>
      <data key="d2">Article 71 is a provision within EU regulations that specifies the secure handling of sensitive information within the EU database.&lt;SEP&gt;Article 71 outlines the requirements for registration of AI systems in the EU database.&lt;SEP&gt;Article 71 refers to the EU database that is essential for tracking AI activities and compliance.&lt;SEP&gt;Article 71 outlines the requirements for registration in the EU database specific to AI systems that are classified as high-risk.&lt;SEP&gt;Article 71 refers to the establishment of a European Union database that holds relevant information on AI systems as part of regulatory compliance.</data>
      <data key="d3">chunk-a64bfb94635a0df2f808b2f8a494bd3e&lt;SEP&gt;chunk-9bece07e296fce9647a40a0dde904fe4&lt;SEP&gt;chunk-d7f74259ac0ec20e9f3989df868f56b4&lt;SEP&gt;chunk-00e7606a0fa9d588f18d67d02cfcf654&lt;SEP&gt;chunk-1f116a95954c59b63ce3149e6283ed8e</data>
