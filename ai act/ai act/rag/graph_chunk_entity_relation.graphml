    <node id="General Product Safety Regulation">
      <data key="d0">General Product Safety Regulation</data>
      <data key="d1">category</data>
      <data key="d2">This regulation serves as the legal framework for ensuring the safety of products in the EU market, including AI systems not classified as high-risk.</data>
      <data key="d3">chunk-b3f7d41ecd7ed7ec26e62e63255378cf</data>
