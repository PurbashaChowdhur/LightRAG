      <data key="d0">Large-Scale IT Systems</data>
      <data key="d1">category</data>
      <data key="d2">Large-Scale IT Systems are extensive technological infrastructures that support significant operations and require compliance with legal acts as outlined in regulations.</data>
      <data key="d3">chunk-f8e23760d52ebfb589b4de63afe8ab83</data>
      <data key="d4">./cached_docs/article_111.json</data>
