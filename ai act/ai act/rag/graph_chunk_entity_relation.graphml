    <node id="biometric data">
      <data key="d0">biometric data</data>
      <data key="d1">category</data>
      <data key="d2">Biometric data consists of personal data derived from processing physical or behavioral characteristics of individuals.&lt;SEP&gt;Biometric data includes unique physical or behavioral characteristics used for identification, such as fingerprints, facial recognition data, and iris patterns.</data>
      <data key="d3">chunk-0f62cf38e10f73dd06a997571902c1ef&lt;SEP&gt;chunk-43e82a7af456b2ae813a7217f92c2008</data>
