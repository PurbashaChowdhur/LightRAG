      <data key="d11">1747464233</data>
    </edge>
    <edge source="AI System" target="Union Market">
      <data key="d6">8.0</data>
      <data key="d7">The Union market includes various AI systems available to consumers, which are subject to evaluation and regulation for compliance.</data>
      <data key="d8">market availability, compliance</data>
      <data key="d9">chunk-2440fb0070f3198e96bd1ad753ae3e0a</data>
      <data key="d10">./cached_docs/article_82.json</data>
    </edge>
    <edge source="AI System" target="Article 60">
      <data key="d6">8.0</data>
      <data key="d7">The AI System operates under the guidelines established in Article 60 regarding informed consent in testing.</data>
      <data key="d8">legal compliance, ethical guidelines</data>
      <data key="d9">chunk-ba5a4fee300868ea16940c9ea15f534a</data>
