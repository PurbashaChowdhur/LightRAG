    </node>
    <node id="Section B">
      <data key="d0">Section B</data>
      <data key="d1">category</data>
      <data key="d2">Section B is part of Annex VIII, outlining additional points of data access and handling.</data>
      <data key="d3">chunk-d7f74259ac0ec20e9f3989df868f56b4</data>
      <data key="d4">./cached_docs/article_49.json</data>
    </node>
    <node id="Section C">
      <data key="d0">Section C</data>
      <data key="d1">category</data>
      <data key="d2">Section C within Annex VIII describes further points concerning data handling and processing.</data>
      <data key="d3">chunk-d7f74259ac0ec20e9f3989df868f56b4</data>
