      <data key="d1">category</data>
      <data key="d2">Testing data is utilized to provide an independent evaluation of an AI system's performance before deployment or market introduction.</data>
      <data key="d3">chunk-3ac98f64f8751ad51246ca16d843f030</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1747657195</data>
    </node>
    <node id="Input Data">
      <data key="d0">Input Data</data>
      <data key="d1">category</data>
      <data key="d2">Input Data refers to the data fed into high-risk AI systems that must be relevant and sufficiently representative of the intended application.&lt;SEP&gt;Input data includes the information that is provided to an AI system, which it processes to generate outputs.</data>
      <data key="d3">chunk-e8c5a915dca180e1c423cefa27ea6cd3&lt;SEP&gt;chunk-3ac98f64f8751ad51246ca16d843f030</data>
