      <data key="d0">post remote biometric identification system</data>
      <data key="d1">category</data>
      <data key="d2">This refers to a remote biometric identification system that does not operate in real-time.&lt;SEP&gt;This type refers to remote biometric systems that do not operate in real-time.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1747657195</data>
    </node>
    <node id="publicly accessible space">
      <data key="d0">publicly accessible space</data>
      <data key="d1">category</data>
      <data key="d2">A physical location that can be accessed by an undetermined number of natural persons, regardless of access conditions.&lt;SEP&gt;A publicly accessible space is an area where the public has access, regardless of ownership or access conditions, allowing for undetermined numbers of individuals.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1747657195</data>
    </node>
    <node id="law enforcement authority">
      <data key="d0">law enforcement authority</data>
      <data key="d1">category</data>
      <data key="d2">A public authority responsible for preventing and investigating criminal offenses, safeguarding public security, and executing criminal penalties.&lt;SEP&gt;The law enforcement authority includes any public body responsible for the prevention, investigation, and prosecution of criminal offenses, ensuring public security.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1747657195</data>
    </node>
    <node id="national competent authority">
      <data key="d0">national competent authority</data>
      <data key="d1">organization</data>
      <data key="d2">A national competent authority is a designated entity responsible for overseeing compliance with regulations, including those related to high-risk AI systems.&lt;SEP&gt;An authority designated to oversee AI systems and ensure compliance with established regulations within the Union.&lt;SEP&gt;The national competent authority is responsible for confirming the safety and validity of certificates related to high-risk AI systems within Member States.&lt;SEP&gt;The national competent authority is the designated body within each Member State responsible for upholding regulations and certifications.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-cdf6e3e080867f88ec52fa9fabbeafd6&lt;SEP&gt;chunk-c17bf6e803eec807c9fc7299d71d51d6&lt;SEP&gt;chunk-b341fa074527a308a2434a3c68244d02</data>
      <data key="d4">./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/article_36.json&lt;SEP&gt;./cached_docs/article_16.json</data>
      <data key="d5">1747657866</data>
    </node>
    <node id="serious incident">
      <data key="d0">serious incident</data>
      <data key="d1">category</data>
      <data key="d2">A serious incident is described as an event involving malfunctioning AI systems that could cause harm to individuals, critical infrastructure, or the environment.&lt;SEP&gt;An event resulting in severe consequences from an AI system malfunction leading to potential harm or death to individuals.&lt;SEP&gt;A serious incident refers to an event of significant concern or adverse effect related to the deployment of AI systems that must be reported to regulatory authorities.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-78dcdae0f5d22df28405d8ae03e038d0&lt;SEP&gt;chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d</data>
      <data key="d4">./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/article_26.json</data>
      <data key="d5">1747657948</data>
    </node>
    <node id="public security">
      <data key="d0">public security</data>
      <data key="d1">category</data>
      <data key="d2">Public security encompasses measures and activities aimed at preventing threats and ensuring safety against criminal offenses and incidents.</data>
      <data key="d3">chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1747657205</data>
    </node>
    <node id="non-personal data">
      <data key="d0">non-personal data</data>
      <data key="d1">category</data>
      <data key="d2">Non-personal data includes any data that does not pertain to identifiable individuals, also defined under EU regulation.</data>
