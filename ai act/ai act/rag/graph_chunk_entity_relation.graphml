    </node>
    <node id="Judicial Cooperation">
      <data key="d0">Judicial Cooperation</data>
      <data key="d1">category</data>
      <data key="d2">Judicial cooperation encompasses the collaborative actions taken by Member States in legal matters, particularly in criminal cases.</data>
      <data key="d3">chunk-76a2f07f347fedfe788b6636feb212d5</data>
