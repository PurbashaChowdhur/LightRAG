      <data key="d10">./cached_docs/recital_53.json</data>
    </edge>
    <edge source="AI System" target="National Competent Authorities">
      <data key="d6">9.0</data>
      <data key="d7">The AI system must be evaluated and documented by national competent authorities to determine its risk level before being deployed.</data>
      <data key="d8">oversight, risk assessment</data>
      <data key="d9">chunk-4672fd3df7077626af67d20e46d3fcb4</data>
      <data key="d10">./cached_docs/recital_53.json</data>
    </edge>
    <edge source="AI System" target="Third-party Conformity Assessment">
      <data key="d6">8.0</data>
      <data key="d7">High-risk AI systems are required to undergo third-party conformity assessments for safety verification.</data>
