    </node>
    <node id="Directive 2002/58/EC">
      <data key="d0">Directive 2002/58/EC</data>
      <data key="d1">event</data>
      <data key="d2">Directive 2002/58/EC concerns the processing of personal data and privacy in electronic communications.&lt;SEP&gt;Directive 2002/58/EC concerns the processing of personal data in the electronic communications sector, specifically regarding privacy.&lt;SEP&gt;Directive 2002/58/EC relates to the e-Privacy directive and deals with the confidentiality of communications and the protection of personal data.&lt;SEP&gt;Directive 2002/58/EC is an EU directive focusing on privacy and electronic communications.</data>
      <data key="d3">chunk-85605aee8aaac2bf4ad29d80d902148f&lt;SEP&gt;chunk-a3cb5eb81289d4fb565bd824bdc63506&lt;SEP&gt;chunk-15eee417af0ebe299ed66be76a0b845a&lt;SEP&gt;chunk-f8833999c9ef9aa31a007f2e77ffea02</data>
      <data key="d4">./cached_docs/article_2.json&lt;SEP&gt;./cached_docs/recital_10.json</data>
      <data key="d5">1747464661</data>
    </node>
    <node id="Regulations (EU) 2016/679">
      <data key="d0">Regulations (EU) 2016/679</data>
      <data key="d1">organization</data>
      <data key="d2">Regulation (EU) 2016/679, commonly known as the General Data Protection Regulation (GDPR), establishes comprehensive rules for data protection and privacy in the European Union.&lt;SEP&gt;Regulations (EU) 2016/679 is a legal framework that sets guidelines for the collection and processing of personal information within the European Union.&lt;SEP&gt;Regulations (EU) 2016/679, also known as the General Data Protection Regulation (GDPR), is a regulation in EU law on data protection and privacy.</data>
      <data key="d3">chunk-2bccefc944ad0794c75bc69b977c88a1&lt;SEP&gt;chunk-85605aee8aaac2bf4ad29d80d902148f&lt;SEP&gt;chunk-0373d38f7600f51def3b5e5cb5061d17</data>
      <data key="d4">./cached_docs/article_50.json&lt;SEP&gt;./cached_docs/recital_10.json</data>
      <data key="d5">1747464563</data>
    </node>
    <node id="Regulations (EU) 2018/1725">
      <data key="d0">Regulations (EU) 2018/1725</data>
      <data key="d1">organization</data>
      <data key="d2">Regulation (EU) 2018/1725 focuses on the protection of personal data processed by EU institutions and aims to ensure privacy rights within the Union's framework.&lt;SEP&gt;Regulations (EU) 2018/1725 governs the processing of personal data by EU institutions and bodies, focusing on privacy and data protection.&lt;SEP&gt;Regulations (EU) 2018/1725 pertains to the protection of personal data in the EU institutions and bodies.</data>
      <data key="d3">chunk-2bccefc944ad0794c75bc69b977c88a1&lt;SEP&gt;chunk-85605aee8aaac2bf4ad29d80d902148f&lt;SEP&gt;chunk-0373d38f7600f51def3b5e5cb5061d17</data>
      <data key="d4">./cached_docs/article_50.json&lt;SEP&gt;./cached_docs/recital_10.json</data>
      <data key="d5">1747464563</data>
    </node>
    <node id="data subjects">
      <data key="d0">data subjects</data>
      <data key="d1">category</data>
      <data key="d2">Data subjects refer to individuals whose personal data is processed and who retain certain rights under EU data protection regulations.</data>
      <data key="d3">chunk-85605aee8aaac2bf4ad29d80d902148f</data>
      <data key="d4">./cached_docs/recital_10.json</data>
    </node>
    <node id="EU Data Protection Rights">
      <data key="d0">EU Data Protection Rights</data>
      <data key="d1">category</data>
      <data key="d2">EU Data Protection Rights refer to the guarantees and rights provided to individuals regarding the processing of their personal data under various EU regulations and directives.</data>
      <data key="d3">chunk-15eee417af0ebe299ed66be76a0b845a</data>
      <data key="d4">./cached_docs/recital_10.json</data>
    </node>
    <node id="Directive 95/46/EC">
      <data key="d0">Directive 95/46/EC</data>
      <data key="d1">event</data>
      <data key="d2">Directive 95/46/EC was the previous legislation concerning data protection prior to the implementation of Regulation (EU) 2016/679, emphasizing individuals' rights and data processing rules.</data>
      <data key="d3">chunk-15eee417af0ebe299ed66be76a0b845a</data>
      <data key="d4">./cached_docs/recital_10.json</data>
    </node>
