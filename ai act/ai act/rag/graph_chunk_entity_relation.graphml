    </node>
    <node id="Own Model">
      <data key="d0">Own Model</data>
      <data key="d1">category</data>
      <data key="d2">The Own Model refers to an AI model that is created and used by an organization for internal processes and is not intended for external services or products.</data>
      <data key="d3">chunk-b89491b02af0a00cbc13f9e8df827a6d</data>
      <data key="d4">./cached_docs/recital_97.json</data>
    </node>
    <node id="Internal Processes">
      <data key="d0">Internal Processes</data>
      <data key="d1">category</data>
      <data key="d2">Internal Processes are internal activities within an organization that do not affect the rights of natural persons and do not involve providing services to third parties.</data>
      <data key="d3">chunk-b89491b02af0a00cbc13f9e8df827a6d</data>
      <data key="d4">./cached_docs/recital_97.json</data>
    </node>
    <node id="Regulatory Obligations">
      <data key="d0">Regulatory Obligations</data>
      <data key="d1">category</data>
      <data key="d2">Regulatory Obligations are requirements that govern the placement and operational expectations of AI models on the market to ensure safety and compliance.</data>
      <data key="d3">chunk-b89491b02af0a00cbc13f9e8df827a6d</data>
      <data key="d4">./cached_docs/recital_97.json</data>
    </node>
    <node id="Subcontractor">
      <data key="d0">Subcontractor</data>
      <data key="d1">organization</data>
      <data key="d2">A subcontractor is an entity that performs specific tasks under the direction of a notified body for conformity assessment.</data>
      <data key="d3">chunk-9f55b689ece7aa049c38fdc38018dba8</data>
