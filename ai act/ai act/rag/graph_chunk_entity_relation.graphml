    <node id="Freedom of Expression and Information">
      <data key="d0">Freedom of Expression and Information</data>
      <data key="d1">category</data>
      <data key="d2">Freedom of Expression and Information allows individuals to express themselves and obtain information freely.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
