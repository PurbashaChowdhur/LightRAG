      <data key="d0">National Public Authority</data>
      <data key="d1">organization</data>
      <data key="d2">National Public Authorities are entities within Member States that oversee compliance with regulations affecting AI systems and public safety.</data>
      <data key="d3">chunk-2440fb0070f3198e96bd1ad753ae3e0a</data>
