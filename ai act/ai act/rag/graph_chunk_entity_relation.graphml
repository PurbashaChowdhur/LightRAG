      <data key="d4">./cached_docs/article_33.json</data>
    </node>
    <node id="Relevant Documents">
      <data key="d0">Relevant Documents</data>
      <data key="d1">category</data>
      <data key="d2">Relevant documents include all records related to the qualifications and activities of subcontractors and subsidiaries as required by regulatory authorities.</data>
      <data key="d3">chunk-9f55b689ece7aa049c38fdc38018dba8</data>
