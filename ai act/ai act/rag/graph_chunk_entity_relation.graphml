      <data key="d5">1747657747</data>
    </node>
    <node id="Article 73">
      <data key="d0">Article 73</data>
      <data key="d1">category</data>
      <data key="d2">Article 73 mandates reporting and mitigation measures for serious incidents identified during the testing of high-risk AI systems.&lt;SEP&gt;Article 73 mandates reporting procedures for serious incidents identified during AI system testing.&lt;SEP&gt;Article 73 mentions serious incident reports that must be evaluated and reviewed as part of the regulatory process.&lt;SEP&gt;Article 73 refers to a specific legal provision that outlines obligations for reporting in the context of using AI systems.</data>
      <data key="d3">chunk-78dcdae0f5d22df28405d8ae03e038d0&lt;SEP&gt;chunk-6f6e14583352886a741ac1d51eada03a&lt;SEP&gt;chunk-4518ca313d8493e277775e1a9267b84d&lt;SEP&gt;chunk-00e7606a0fa9d588f18d67d02cfcf654</data>
