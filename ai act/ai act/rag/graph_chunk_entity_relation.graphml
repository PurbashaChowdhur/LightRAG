      <data key="d10">./cached_docs/article_6.json</data>
    </edge>
    <edge source="AI System" target="High-risk AI System">
      <data key="d6">10.0</data>
      <data key="d7">An AI system can be classified as high-risk based on its intended use and regulatory requirements, indicating the level of oversight necessary.</data>
      <data key="d8">regulatory classification, AI safety</data>
