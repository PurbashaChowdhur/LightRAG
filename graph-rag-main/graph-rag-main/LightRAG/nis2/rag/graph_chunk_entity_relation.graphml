    <node id="soggetto">
      <data key="d0">soggetto</data>
      <data key="d1">category</data>
      <data key="d2">Soggetto is a term used to refer to entities that could be classified as critical subjects under certain regulations.</data>
      <data key="d3">chunk-d33217045cb72b052be017e5e11b563b</data>
