    </node>
    <node id="sistema dei nomi di dominio">
      <data key="d0">sistema dei nomi di dominio</data>
      <data key="d1">category</data>
      <data key="d2">Il sistema dei nomi di dominio, noto come DNS, è un sistema gerarchico e distribuito che identifica servizi e risorse su internet.</data>
      <data key="d3">chunk-4af16bb9e8cf3419a504f3216b134af5</data>
      <data key="d4">./cached_articles/article_2.json</data>
    </node>
