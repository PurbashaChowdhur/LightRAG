    <node id="Legge">
      <data key="d0">Legge</data>
      <data key="d1">category</data>
      <data key="d2">Legge refers to the overarching law that influences the applicability and enforcement of the articles mentioned in the legislative decree.</data>
      <data key="d3">chunk-41ca6b4dd93e0c17d473199f99238cb9</data>
