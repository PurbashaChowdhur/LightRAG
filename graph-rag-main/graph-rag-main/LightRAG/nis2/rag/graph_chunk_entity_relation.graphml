    <node id="Decreto Legislativo n. 259 del 2003">
      <data key="d0">Decreto Legislativo n. 259 del 2003</data>
      <data key="d1">event</data>
      <data key="d2">The Decreto Legislativo n. 259 del 2003 is a legislative decree that outlines regulatory frameworks, with specified articles that are referred to in the context of legal precedents.</data>
      <data key="d3">chunk-41ca6b4dd93e0c17d473199f99238cb9</data>
      <data key="d4">./cached_articles/article_41.json</data>
    </node>
    <node id="Articolo 30">
      <data key="d0">Articolo 30</data>
      <data key="d1">category</data>
      <data key="d2">Articolo 30 is a specific article mentioned in the legislative context, indicating provisions or regulations that were abrogated.&lt;SEP&gt;Articolo 30 outlines obligations for essential and important subjects in relation to their cybersecurity activities and services.</data>
      <data key="d3">chunk-41ca6b4dd93e0c17d473199f99238cb9&lt;SEP&gt;chunk-cb0751ea9b752da31add0e157217c185</data>
