      <data key="d0">piano tecnico</data>
      <data key="d1">category</data>
      <data key="d2">Piano tecnico refers to the technical plan or framework involving strategies and methods for effective cooperation and project execution.</data>
      <data key="d3">chunk-ab7a77a3520d38cce61e3bab9c0eddb7</data>
