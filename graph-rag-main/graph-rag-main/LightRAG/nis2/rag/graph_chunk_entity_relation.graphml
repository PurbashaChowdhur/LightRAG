    </node>
    <node id="quasi-incidenti">
      <data key="d0">quasi-incidenti</data>
      <data key="d1">category</data>
      <data key="d2">Quasi-incidenti are near-miss cybersecurity incidents that could have led to a significant breach if not handled appropriately.</data>
      <data key="d3">chunk-e86d17c52d9eed39854a6245d94eb672</data>
