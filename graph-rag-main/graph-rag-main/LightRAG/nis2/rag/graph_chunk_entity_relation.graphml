      <data key="d0">Rischi</data>
      <data key="d1">category</data>
      <data key="d2">Risks refer to potential challenges or threats that could affect the security and functionality of critical entities, as identified under the NIS directive.</data>
      <data key="d3">chunk-113a7f129467195a5802770e0a180e02</data>
      <data key="d4">./cached_articles/article_14.json</data>
    </node>
