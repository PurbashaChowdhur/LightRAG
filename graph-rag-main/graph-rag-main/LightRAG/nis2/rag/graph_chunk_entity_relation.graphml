      <data key="d1">category</data>
      <data key="d2">This category encompasses the various types of personnel involved in educational institutions, excluding them from certain provisions.</data>
      <data key="d3">chunk-3fa0ded502e132e4e924284c55cb9c26</data>
      <data key="d4">./cached_articles/article_11.json</data>
    </node>
    <node id="Spesa autorizzata">
      <data key="d0">Spesa autorizzata</data>
      <data key="d1">category</data>
      <data key="d2">La spesa autorizzata di 2.000.000 euro annui per l'attuazione delle misure di sicurezza a partire dal 2025.&lt;SEP&gt;The event refers to the approved expenditure for implementing measures in the educational sector as per legal stipulations.</data>
      <data key="d3">chunk-a09a98f23c165c2285989df098e2deae&lt;SEP&gt;chunk-3fa0ded502e132e4e924284c55cb9c26</data>
