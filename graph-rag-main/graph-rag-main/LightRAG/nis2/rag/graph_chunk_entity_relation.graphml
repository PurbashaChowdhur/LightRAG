      <data key="d1">category</data>
      <data key="d2">Le risorse nazionali si riferiscono ai mezzi economici, tecnici e umani disponibili per implementare e supportare la strategia di cybersicurezza.</data>
      <data key="d3">chunk-70f0567946102de362e38795f66fb304</data>
