    <node id="Collocamento fuori ruolo">
      <data key="d0">Collocamento fuori ruolo</data>
      <data key="d1">event</data>
      <data key="d2">Collocamento fuori ruolo refers to the administrative process affecting staff positions within educational institutions according to specific legal provisions.</data>
