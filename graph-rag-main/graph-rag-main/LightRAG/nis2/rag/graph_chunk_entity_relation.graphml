      <data key="d1">organization</data>
      <data key="d2">L'Agenzia per la cybersicurezza nazionale is the national agency responsible for cybersecurity in Italy, handling personal data in compliance with relevant legislation.</data>
      <data key="d3">chunk-004dccf05c9434c44fb95414cf704e85</data>
