      <data key="d1">organization</data>
      <data key="d2">I Fornitori di Servizi di Sistema DNS sono enti che gestiscono il dominio e le directory di Internet, permettendo la risoluzione dei nomi di dominio.</data>
      <data key="d3">chunk-1c35a9cee97ca2d6904cdecfa96ae491</data>
