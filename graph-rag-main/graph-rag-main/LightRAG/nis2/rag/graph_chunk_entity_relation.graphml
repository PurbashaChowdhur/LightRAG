      <data key="d0">regolamento (UE) 2016/679</data>
      <data key="d1">event</data>
      <data key="d2">Regulation (EU) 2016/679, also known as the GDPR, is a comprehensive regulation on data protection and privacy in the European Union.</data>
      <data key="d3">chunk-004dccf05c9434c44fb95414cf704e85</data>
      <data key="d4">./cached_articles/article_8.json</data>
    </node>
