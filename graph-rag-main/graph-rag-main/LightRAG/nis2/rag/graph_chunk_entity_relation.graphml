    <edge source="Agenzia per la cybersicurezza nazionale" target="Ministero dell'interno">
      <data key="d5">8.0</data>
      <data key="d6">The Ministry of the Interior works alongside the Agenzia per la cybersicurezza nazionale to protect public safety and security from cyber threats.</data>
      <data key="d7">internal security, cybersecurity cooperation</data>
      <data key="d8">chunk-36f036d26b472f0c8e276a34cd467ec0</data>
