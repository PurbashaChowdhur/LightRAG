      <data key="d0">Sicurezza dell'Acquisizione e Sviluppo</data>
      <data key="d1">category</data>
      <data key="d2">Si riferisce alle pratiche di sicurezza necessarie durante l'acquisizione, sviluppo e manutenzione dei sistemi informativi.</data>
      <data key="d3">chunk-31185bea266047e27967ebc4d42a28e1</data>
