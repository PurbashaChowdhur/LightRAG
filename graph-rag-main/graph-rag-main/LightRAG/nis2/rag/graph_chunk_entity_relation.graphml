    <edge source="soggetto essenziale" target="sanzione amministrativa">
      <data key="d5">9.0</data>
      <data key="d6">Soggetti essenziali can face administrative penalties for non-compliance with regulations imposed by the governing bodies.</data>
      <data key="d7">regulatory compliance, penalties</data>
