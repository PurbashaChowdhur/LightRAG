    </node>
    <node id="Pubblico">
      <data key="d0">Pubblico</data>
      <data key="d1">person</data>
      <data key="d2">Pubblico refers to the general public who may need to be informed about significant cybersecurity incidents in the interest of public safety.</data>
      <data key="d3">chunk-59c62341e6dbdcf3426bec3e9017f906</data>
