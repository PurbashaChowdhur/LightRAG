      <data key="d0">Articolo 3, comma 1</data>
      <data key="d1">event</data>
      <data key="d2">Articolo 3, comma 1 refers to a specific legal article within the NIS legislative framework discussing essential and important subjects related to cybersecurity responsibilities.</data>
      <data key="d3">chunk-0038be33f7feedcdeb87d1ba67ddaabe</data>
      <data key="d4">./cached_articles/article_43.json</data>
    </node>
