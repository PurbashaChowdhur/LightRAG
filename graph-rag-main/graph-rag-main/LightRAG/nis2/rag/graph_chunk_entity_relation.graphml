      <data key="d1">category</data>
      <data key="d2">A sistema informativo rappresenta l'insieme di risorse, persone e processi per l'elaborazione e la gestione delle informazioni all'interno di un'organizzazione.</data>
      <data key="d3">chunk-39ec3012d3766a3710bc24e75c085390</data>
