    <node id="Ministro della Difesa">
      <data key="d0">Ministro della Difesa</data>
      <data key="d1">person</data>
      <data key="d2">Il Ministro della difesa è il funzionario governativo responsabile della difesa nazionale e della sicurezza militare dello Stato.</data>
      <data key="d3">chunk-5919b394f61097b3c448dfb4508004c6</data>
      <data key="d4">./cached_articles/article_14.json</data>
    </node>
    <node id="Ministero della Difesa">
      <data key="d0">Ministero della Difesa</data>
      <data key="d1">organization</data>
      <data key="d2">Il Ministero della Difesa è l'organo governativo responsabile delle politiche di difesa e sicurezza nazionale.&lt;SEP&gt;The Ministry of Defense collaborates with the National Cybersecurity Agency in cybersecurity crisis management and national defense.</data>
      <data key="d3">chunk-923745bc8c8ad932bf6f4d0e052b32a1&lt;SEP&gt;chunk-bd252fa1c05426d3e43270f7b9103fd8</data>
