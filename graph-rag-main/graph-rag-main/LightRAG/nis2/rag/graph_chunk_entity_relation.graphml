    <node id="evento">
      <data key="d0">evento</data>
      <data key="d1">category</data>
      <data key="d2">Evento refers to any incident that could compromise the integrity, availability, or authenticity of networks and information systems.</data>
      <data key="d3">chunk-b824e0b89de2a1e27b0589d38a4cd97d</data>
      <data key="d4">./cached_articles/article_2.json</data>
