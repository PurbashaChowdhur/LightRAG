    <node id="Directive (EU) 2022/2555">
      <data key="d0">Directive (EU) 2022/2555</data>
      <data key="d1">category</data>
      <data key="d2">Directive (EU) 2022/2555 outlines the EU's cybersecurity framework and regulations, including peer reviews and self-assessment methodologies for member states.&lt;SEP&gt;Directive (EU) 2022/2555 outlines the legal framework for coordinated vulnerability disclosure among EU member states.</data>
      <data key="d3">chunk-220eea07a2d381346fd66282775c0dfa&lt;SEP&gt;chunk-c7e4324dfac9792a4d9eef15127f75b0</data>
