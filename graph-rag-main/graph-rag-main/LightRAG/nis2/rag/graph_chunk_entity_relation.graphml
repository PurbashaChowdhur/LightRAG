    <node id="Forum di Sorveglianza">
      <data key="d0">Forum di Sorveglianza</data>
      <data key="d1">event</data>
      <data key="d2">Il Forum di Sorveglianza è un'assemblea istituita per monitorare le attuazioni dei poteri di vigilanza e garantire il rispetto delle normative sulla cybersicurezza.</data>
      <data key="d3">chunk-bd252fa1c05426d3e43270f7b9103fd8</data>
      <data key="d4">./cached_articles/article_14.json</data>
    </node>
    <node id="Soggetti Essenziali o Importanti">
