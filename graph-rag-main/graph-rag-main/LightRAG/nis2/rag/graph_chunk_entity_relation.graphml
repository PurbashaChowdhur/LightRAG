      <data key="d4">./cached_articles/article_3.json</data>
    </node>
    <node id="pubbliche amministrazioni">
      <data key="d0">pubbliche amministrazioni</data>
      <data key="d1">category</data>
      <data key="d2">Pubbliche amministrazioni are government entities that must comply with specific regulations set forth in the decreto legislativo.&lt;SEP&gt;Pubbliche amministrazioni includes public administrations subject to specific rules and potential financial penalties under the regulation.</data>
      <data key="d3">chunk-26bbb300d251c26612092b2e60977328&lt;SEP&gt;chunk-d33217045cb72b052be017e5e11b563b</data>
      <data key="d4">./cached_articles/article_3.json&lt;SEP&gt;./cached_articles/article_38.json</data>
