      <data key="d1">organization</data>
      <data key="d2">The Fornitore di Servizi di Sistema dei Nomi di Dominio is an entity offering domain name resolution services to end-users and authoritative domain resolution services.</data>
      <data key="d3">chunk-336882dcda54fe306e031e3c16cc6ddb</data>
