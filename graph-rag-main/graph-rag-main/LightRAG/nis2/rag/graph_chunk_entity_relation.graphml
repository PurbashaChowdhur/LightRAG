      <data key="d0">Riservatezza degli Affari</data>
      <data key="d1">category</data>
      <data key="d2">Riservatezza degli Affari pertains to the confidentiality and protection of business-related information, particularly in the context of state security.</data>
      <data key="d3">chunk-19de381a5517d614701de183ccc97f6f</data>
