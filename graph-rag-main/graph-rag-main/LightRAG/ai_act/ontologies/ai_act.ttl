@prefix : <https://w3id.org/airo#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix aiact: <https://w3id.org/aiact#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix airo: <https://w3id.org/airo#> .

<https://w3id.org/airo> rdf:type owl:Ontology ;
                         owl:versionIRI <https://w3id.org/airo/1.0> ;
                         terms:bibliographicCitation "Delaram Golpayegani, Harshvardhan J. Pandit, and Dave Lewis. AIRO: An ontology for representing AI risks based on the proposed EU AI Act and ISO risk management standards. Towards a Knowledge-Aware AI. IOS Press, 2022. 51-65." ;
                         terms:contributor "Dave Lewis" ,
                                           "Harshvardhan J. Pandit" ;
                         terms:created "2021-09-01"^^xsd:date ;
                         terms:creator "Delaram Golpayegani" ;
                         terms:description "AIRO represents AI risk concepts and relations based on the EU AI Act and ISO/IEC AI and risk management standards."@en ;
                         terms:issued "2023-01-01"^^xsd:date ;
                         terms:license <https://creativecommons.org/licenses/by/4.0/> ;
                         terms:modified "2024-05-25"^^xsd:date ;
                         terms:publisher "ADAPT Centre, Trinity College Dublin" ;
                         terms:source "EU AI Act"@en ,
                                      "ISO 31000 series"@en ;
                         terms:title "AIRO" ;
                         <http://purl.org/ontology/bibo/doi> "10.5281/zenodo.10894750"@en ;
                         <http://purl.org/ontology/bibo/status> "http://purl.org/ontology/bibo/status/published" ;
                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "airo" ;
                         <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/airo#" ;
                         rdfs:label "AI Risk Ontology"@en ;
                         owl:versionInfo "1.0"@en ;
                         <http://xmlns.com/foaf/0.1/logo> <https://github.com/DelaramGlp/airo/blob/main/figures/airo-logo.png?raw=true> .

terms:bibliographicCitation rdf:type owl:AnnotationProperty .
terms:contributor rdf:type owl:AnnotationProperty .
terms:created rdf:type owl:AnnotationProperty .
terms:creator rdf:type owl:AnnotationProperty .
terms:description rdf:type owl:AnnotationProperty .
terms:issued rdf:type owl:AnnotationProperty .
terms:license rdf:type owl:AnnotationProperty .
terms:modified rdf:type owl:AnnotationProperty .
terms:publisher rdf:type owl:AnnotationProperty .
terms:source rdf:type owl:AnnotationProperty .
terms:title rdf:type owl:AnnotationProperty .
<http://purl.org/ontology/bibo/doi> rdf:type owl:AnnotationProperty .
<http://purl.org/ontology/bibo/status> rdf:type owl:AnnotationProperty .
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .
<http://xmlns.com/foaf/0.1/logo> rdf:type owl:AnnotationProperty .
xsd:date rdf:type rdfs:Datatype .
<http://www.w3.org/ns/dqv#expectedDataType> rdf:type owl:ObjectProperty .
<http://www.w3.org/ns/dqv#hasQualityMeasurement> rdf:type owl:ObjectProperty .
<http://www.w3.org/ns/dqv#inDimension> rdf:type owl:ObjectProperty .
<http://www.w3.org/ns/dqv#isMeasurementOf> rdf:type owl:ObjectProperty .
<http://www.w3.org/ns/dqv#value> rdf:type owl:DatatypeProperty .
airo:compliesWithRegulation rdf:type owl:ObjectProperty ;
                            rdfs:range airo:Regulation ;
                            rdfs:comment "Indicates compliance with a specific regulation."@en ;
                            rdfs:label "complies with regulation"@en .
airo:conformsToStandard rdf:type owl:ObjectProperty ;
                        rdfs:range airo:Standard ;
                        rdfs:comment "Indicates conformance of an entity to a standard."@en ;
                        rdfs:label "conforms to standard"@en .
airo:detectsRiskConcept rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf airo:modifiesRiskConcept ;
                        rdfs:domain airo:RiskControl ;
                        rdfs:range airo:RiskConcept ;
                        rdfs:comment "Indicates the control used for detecting risks, risk sources, consequences, and impacts."@en ;
                        rdfs:label "detects risk concept"@en .
airo:eliminatesRiskConcept rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf airo:modifiesRiskConcept ;
                           rdfs:domain airo:RiskControl ;
                           rdfs:range airo:RiskConcept ;
                           rdfs:comment "Indicates the control used for eliminating  risks, risk sources, consequences, and impacts."@en ;
                           rdfs:label "eliminates risk concept"@en .
airo:exploitsVulnerability rdf:type owl:ObjectProperty ;
                           rdfs:domain airo:RiskSource ;
                           rdfs:range airo:Vulnerability ;
                           rdfs:comment "Indicates vulnerabilities exploited by a risk source."@en ;
                           rdfs:label "exploits vulnerability"@en .
airo:followsCodeOfConduct rdf:type owl:ObjectProperty ;
                          rdfs:range airo:CodeOfConduct ;
                          rdfs:comment "Indicates the code of conduct followed."@en ;
                          rdfs:label "follows code of conduct"@en .
airo:hasAISubject rdf:type owl:ObjectProperty ;
                  rdfs:domain airo:AISystem ;
                  rdfs:range airo:AISubject ;
                  rdfs:comment "Indicates the AI subject of an AI system."@en ;
                  rdfs:label "has AI subject"@en .
airo:hasAIUser rdf:type owl:ObjectProperty ;
               rdfs:domain airo:AISystem ;
               rdfs:range airo:AIUser ;
               rdfs:comment "Indicate the end-user of an AI system."@en ;
               rdfs:label "has AI user"@en .
airo:hasAutomationLevel rdf:type owl:ObjectProperty ;
                        rdfs:domain airo:AISystem ;
                        rdfs:range airo:AutomationLevel ;
                        rdfs:comment "Indicates the system's level of automation."@en ;
                        rdfs:label "has automation level"@en .
airo:hasCapability rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( airo:AIComponent
                                               airo:AISystem
                                             )
                               ] ;
                   rdfs:range airo:AICapability ;
                   rdfs:comment "Specifies capabilities implemented within an AI system to materialise its purposes."@en ;
                   rdfs:label "has capability"@en .
airo:hasChangedEntity rdf:type owl:ObjectProperty ;
                      rdfs:domain airo:Change ;
                      rdfs:comment "Indicates the entity that is being changed."@en ;
                      rdfs:label "has changed entity"@en .
airo:hasComponent rdf:type owl:ObjectProperty ;
                  rdfs:range airo:AIComponent ;
                  rdfs:comment "Indicates a component incorporating an AI system or another component."@en ;
                  rdfs:label "has component"@en .
airo:hasConsequence rdf:type owl:ObjectProperty ;
                    rdfs:domain airo:Risk ;
                    rdfs:range airo:Consequence ;
                    rdfs:comment "Specifies consequences caused by materialisation of a risk."@en ;
                    rdfs:label "has consequence" .
airo:hasControlOverAIOutput rdf:type owl:ObjectProperty ;
                            rdfs:domain airo:Stakeholder ;
                            rdfs:range airo:ModeOfOutputControllability ;
                            rdfs:comment "Indicates the level of control a stakeholder has over outputs produced by an AI system."@en ;
                            rdfs:label "has control over AI output"@en .
airo:hasDocumentation rdf:type owl:ObjectProperty ;
                      rdfs:range airo:Documentation ;
                      rdfs:comment "Indicates documentation associated with an entity, e.g. AI model, AI system."@en ;
                      rdfs:label "has documentation"@en .
airo:hasFrequency rdf:type owl:ObjectProperty ;
                  rdfs:range airo:Frequency ;
                  rdfs:comment "Indicates frequency of an event, e.g. change."@en ;
                  rdfs:label "has frequency"@en .
airo:hasHumanInvolvement rdf:type owl:ObjectProperty ;
                         rdfs:domain airo:Stakeholder ;
                         rdfs:range airo:HumanInvolvement ;
                         rdfs:comment "Indicates the type involvement of a human."@en ;
                         rdfs:label "has human involvement"@en .
airo:hasImpact rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( airo:Consequence
                                           airo:Impact
                                         )
                         ] ;
               rdfs:range airo:Impact ;
               rdfs:comment "Specifies the impact caused by materialisation of a consequence."@en ;
               rdfs:label "has impact"@en .
airo:hasImpactOnArea rdf:type owl:ObjectProperty ;
                     rdfs:domain airo:Impact ;
                     rdfs:range airo:AreaOfImpact ;
                     rdfs:comment "Specifies the area (e.g. physical health) that is impacted by an  AI system or component." ;
                     rdfs:label "has impact on area"@en .
airo:hasImpactOnEntity rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf airo:hasImpactOnEntity ;
                       rdfs:domain airo:Impact ;
                       rdfs:range airo:Stakeholder ;
                       rdfs:comment "Indicates the people that are (negatively) impacted by an AI system or component."@en ;
                       rdfs:label "has impact on stakeholder"@en .
airo:hasInput rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( airo:AIComponent
                                          airo:AISystem
                                        )
                          ] ;
              rdfs:range airo:Input ;
              rdfs:comment "Indicates the input an AI system or componet need to process to generate output."@en ;
              rdfs:label "has input"@en .
airo:hasLicense rdf:type owl:ObjectProperty ;
                rdfs:range airo:License ;
                rdfs:comment "Indicates licenses associated with a resource."@en ;
                rdfs:label "has license"@en .
airo:hasLifecyclePhase rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( airo:AIComponent
                                                   airo:AISystem
                                                 )
                                   ] ;
                       rdfs:range airo:AILifecyclePhase ;
                       rdfs:comment "Indicates the lifecycle phase of the AI system or component."@en ;
                       rdfs:label "has lifecycle phase"@en .
airo:hasLikelihood rdf:type owl:ObjectProperty ;
                 rdfs:domain airo:RiskConcept ;
                 rdfs:range airo:Likelihood ;
                 rdfs:comment "Indicates the probability of occurrence of risks, risk sources, consequences, or impacts."@en ;
                 rdfs:label "has likelihood"@en .
airo:hasModality rdf:type owl:ObjectProperty ;
                 rdfs:range airo:Modality ;
                 rdfs:comment "Indicates the modality in which an entity exists."@en ;
                 rdfs:label "has modality"@en .
airo:hasModel rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf airo:hasComponent ;
              rdfs:range airo:AIModel ;
              rdfs:comment "Indicates machine learning models used with a system or component."@en ;
              rdfs:label "has model"@en .
airo:hasPreDeterminedChange rdf:type owl:ObjectProperty ;
                            rdfs:range airo:Change ;
                            rdfs:comment "Indicates the changes that are planned to be applied to the system, components, or context of use."@en ;
                            rdfs:label "has pre-determined change"@en .
airo:hasPurpose rdf:type owl:ObjectProperty ;
                rdfs:range airo:Purpose ;
                rdfs:comment "Indicates the purpose of an entity, e.g. AI system, components."@en ;
                rdfs:label "has purpose"@en .
airo:hasResidualRisk rdf:type owl:ObjectProperty ;
                     rdfs:domain airo:Risk ;
                     rdfs:range airo:Risk ;
                     rdfs:comment "Indicates the residual risk"@en ,
                                  "has residual risk"@en .
airo:hasRisk rdf:type owl:ObjectProperty ;
             rdfs:range airo:Risk ;
             rdfs:comment "Indicates risks associated with an AI system, an AI component, etc."@en ;
             rdfs:label "has risk"@en .
airo:hasRiskControl rdf:type owl:ObjectProperty ;
                    rdfs:range airo:RiskControl ;
                    rdfs:comment "Indicates the control measures associated with a system or component to modify risks."@en ;
                    rdfs:label "has risk control"@en .
airo:hasSeverity rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( airo:Consequence
                                             airo:Impact
                                           )
                            ] ;
                 rdfs:range airo:Severity ;
                 rdfs:comment "Indicates severity of a consequence or an impact."@en ;
                 rdfs:label "has severity"@en .
airo:hasStakeholder rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( airo:AIComponent
                                                airo:AISystem
                                              )
                                ] ;
                    rdfs:range airo:Stakeholder ;
                    rdfs:comment "Indicates stakeholders of an AI system or component."@en ;
                    rdfs:label "has stakeholder"@en .
airo:hasTestingData rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf airo:hasComponent ;
                    rdfs:range airo:Data ;
                    rdfs:comment "Indicates datasets used for testing."@en ;
                    rdfs:label "has testing data"@en .
airo:hasTrainingData rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf airo:hasComponent ;
                     rdfs:range airo:Data ;
                     rdfs:comment "Indicates datasets used in training."@en ;
                     rdfs:label "has training data"@en .
airo:hasValidationData rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf airo:hasComponent ;
                       rdfs:range airo:Data ;
                       rdfs:comment "Indicates datasets used for validation."@en ;
                       rdfs:label "has validation data"@en .
airo:hasVersion rdf:type owl:ObjectProperty ;
                rdfs:range airo:Version ;
                rdfs:comment "Indicates the version of an entity."@en ;
                rdfs:label "has version"@en .
airo:hasVulnerability rdf:type owl:ObjectProperty ;
                      rdfs:range airo:Vulnerability ;
                      rdfs:comment "Indicates vulnerabilities associated with an entity, e.g. AI system and its components."@en ;
                      rdfs:label "has vulnerability"@en .
airo:isAppliedWithinDomain rdf:type owl:ObjectProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( airo:AIComponent
                                                       airo:AISystem
                                                     )
                                       ] ;
                           rdfs:range airo:Domain ;
                           rdfs:comment "Specifies the domain an AI system or component is used within."@en ;
                           rdfs:label "is applied within domain"@en .
airo:isDeployedBy rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( airo:AIComponent
                                              airo:AISystem
                                            )
                              ] ;
                  rdfs:range airo:AIDeployer ;
                  rdfs:comment "Indicates the deployer of an AI system or component."@en ;
                  rdfs:label "is deployed by"@en .
airo:isDevelopedBy rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( airo:AIComponent
                                               airo:AISystem
                                             )
                               ] ;
                   rdfs:range airo:AIDeveloper ;
                   rdfs:comment "Indicates the developer of a system or component."@en ;
                   rdfs:label "is developed by"@en .
airo:isFollowedByControl rdf:type owl:ObjectProperty ;
                         rdfs:domain airo:RiskControl ;
                         rdfs:range airo:RiskControl ;
                         rdfs:comment "Specifies the order of controls."@en ;
                         rdfs:label "is followed by control"@en .
airo:isPartOfControl rdf:type owl:ObjectProperty ;
                     rdfs:domain airo:RiskControl ;
                     rdfs:range airo:RiskControl ;
                     rdfs:comment "Specifies composition of controls"@en ;
                     rdfs:label "is part of control"@en .
airo:isProvidedBy rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( airo:AIComponent
                                              airo:AISystem
                                              airo:Input
                                            )
                              ] ;
                  rdfs:range airo:AIProvider ;
                  rdfs:comment "Indicates the provider of an AI system or component."@en ;
                  rdfs:label "is provided by"@en .
airo:isRiskSourceFor rdf:type owl:ObjectProperty ;
                     rdfs:domain airo:RiskSource ;
                     rdfs:range airo:Risk ;
                     rdfs:comment "Specifies risks caused by materialisation of a risk source."@en ;
                     rdfs:label "is risk source for"@en .
airo:isUsedWithinLocality rdf:type owl:ObjectProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( airo:AIComponent
                                                      airo:AISystem
                                                    )
                                      ] ;
                          rdfs:range airo:LocalityOfUse ;
                          rdfs:comment "Indicates the locality of use."@en ;
                          rdfs:label "is used within locality"@en .
airo:mitigatesRiskConcept rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf airo:modifiesRiskConcept ;
                          rdfs:domain airo:RiskControl ;
                          rdfs:range airo:RiskConcept ;
                          rdfs:comment "Indicates the control used for mitigating  risks, risk sources, consequences, and impacts."@en ;
                          rdfs:label "mitigates risk concept"@en .
airo:modifiesRiskConcept rdf:type owl:ObjectProperty ;
                         rdfs:domain airo:RiskControl ;
                         rdfs:range airo:RiskConcept ;
                         rdfs:comment "Indicates the control employed to modify risks, risk sources, consequences, and impacts."@en ;
                         rdfs:label "modifies risk concept"@en .
airo:producesOutput rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( airo:AIComponent
                                                airo:AISystem
                                              )
                                ] ;
                    rdfs:range airo:Output ;
                    rdfs:comment "Specifies an output generated by an AI system or component."@en ;
                    rdfs:label "produces output"@en .
airo:runsOnHardware rdf:type owl:ObjectProperty ;
                    rdfs:domain airo:AISystem ;
                    rdfs:range airo:HardwarePlatform ;
                    rdfs:comment "Indicates the hardware on which the system runs."@en ;
                    rdfs:label "runs on hardware"@en .
airo:usesTechnique rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( airo:AIComponent
                                               airo:AISystem
                                             )
                               ] ;
                   rdfs:range airo:AITechnique ;
                   rdfs:comment "Indicates the AI techniques used in an AI system or component."@en ;
                   rdfs:label "uses technique"@en .
<https://w3id.org/dpv#hasData> rdf:type owl:ObjectProperty .
<https://w3id.org/dpv#hasDataSource> rdf:type owl:ObjectProperty .
<https://w3id.org/dpv#hasDataSubject> rdf:type owl:ObjectProperty .
<https://w3id.org/dpv#hasLegalBasis> rdf:type owl:ObjectProperty .
<https://w3id.org/dpv#hasProcessing> rdf:type owl:ObjectProperty .
airo:AICapability rdf:type owl:Class ;
                  rdfs:comment "The capability of an AI system that enables realisation of the system's purposes."@en ;
                  rdfs:label "AI Capability"@en .
airo:AIComponent rdf:type owl:Class ;
                 terms:source "ISO/IEC 22989, 3.1.2"@en ;
                 rdfs:comment "Functional element that constructs an AI system."@en ;
                 rdfs:label "AI Component"@en .
airo:AIDeployer rdf:type owl:Class ;
                rdfs:subClassOf airo:AIOperator ;
                terms:source "EU AI Act, Article 3(4)"@en ;
                rdfs:comment "Any natural or legal person, public authority, agency or other body using an AI system under its authority except where the AI system is used in the course of a personal non-professional activity."@en ;
                rdfs:label "AI Deployer"@en .
airo:AIDeveloper rdf:type owl:Class ;
                 rdfs:subClassOf airo:Stakeholder ;
                 terms:source "ISO/IEC 22989, 5.19.3.2"@en ;
                 rdfs:comment "An organisation or entity that is concerned with the development of AI services and products."@en ;
                 rdfs:label "AI Developer"@en .
airo:AILifecyclePhase rdf:type owl:Class ;
                      rdfs:comment "A Phase of AI lifecycle which indicates evolution of the system from conception through retirement."@en ;
                      rdfs:label "AI Lifecycle Phase"@en .
airo:AIModel rdf:type owl:Class ;
             rdfs:subClassOf airo:AIComponent ;
             terms:source "ISO/IEC TR 24028, 3.24"@en ;
             rdfs:comment "Mathematical construct that generates an inference or prediction, based on input data."@en ;
             rdfs:label "AI Model"@en .
airo:AIOperator rdf:type owl:Class ;
                rdfs:subClassOf airo:Stakeholder ;
                terms:source "EU AI Act, Article 3(8)"@en ;
                rdfs:comment "Refers to a provider, product manufacturer, deployer, authorised representative, importer or distributor."@en ;
                rdfs:label "AI Operator"@en .
airo:AIProvider rdf:type owl:Class ;
                rdfs:subClassOf airo:AIOperator ;
                terms:source "EU AI Act, Article 3(3)"@en ;
                rdfs:comment "A natural or legal person, public authority, agency or other body that develops an AI system or a general-purpose AI model or that has an AI system or a general-purpose AI model developed and places it on the market or puts the AI system into service under its own name or trademark, whether for payment or free of charge."@en ;
                rdfs:label "AI Provider"@en .
airo:AISubject rdf:type owl:Class ;
               rdfs:subClassOf airo:Stakeholder ;
               rdfs:comment "An entity that is subject to or impacted by the use of AI."@en ;
               rdfs:label "AI Subject"@en .
airo:AISystem rdf:type owl:Class ;
              terms:source "EU AI Act, Article 3(1)"@en ;
              rdfs:comment "A machine-based system that is designed to operate with varying levels of autonomy and that may exhibit adaptiveness after deployment, and that, for explicit or implicit objectives, infers, from the input it receives, how to generate outputs such as predictions, content, recommendations, or decisions that can influence physical or virtual environments."@en ;
              rdfs:label "AI System"@en .
airo:AITechnique rdf:type owl:Class ;
                 rdfs:comment "Approaches or techniques used in development of a system."@en ;
                 rdfs:label "AI Technique"@en .
airo:AIUser rdf:type owl:Class ;
            rdfs:subClassOf airo:Stakeholder ;
            terms:source "ISO/IEC TR 24028, 3.37"@en ;
            rdfs:comment "Individual or group that interacts with a system."@en ;
            rdfs:label "AI User"@en .
airo:AreaOfImpact rdf:type owl:Class ;
                  rdfs:comment "Areas or aspects impacted by an AI system, e.g. physical health, right to privacy."@en ;
                  rdfs:label "Area Of Impact"@en .
airo:AutomationLevel rdf:type owl:Class ;
                     rdfs:comment "Refers to the degree of automation under which an AI system operates."@en ;
                     rdfs:label "Automation Level"@en .
airo:Change rdf:type owl:Class ;
            rdfs:comment "An alternation in an entity."@en ;
            rdfs:label "Change"@en .
airo:CodeOfConduct rdf:type owl:Class ;
                   rdfs:comment "A non-binding set of norms and responsibilities."@en ;
                   rdfs:label "Code Of Conduct"@en .
airo:Consequence rdf:type owl:Class ;
                 rdfs:subClassOf airo:RiskConcept ;
                 terms:source "ISO 31000, 3.6 [with modifications]"@en ,
                              "ISO 31073:2022, 3.3.18 [with modifications]"@en ;
                 rdfs:comment "Direct outcome of risk affecting objectives."@en ;
                 rdfs:label "Consequence"@en .
airo:Data rdf:type owl:Class ;
          rdfs:subClassOf airo:AIComponent ,
                          <https://w3id.org/dpv#Data> ,
                          <https://www.w3.org/TR/vocab-dcat-3/Dataset> ;
          rdfs:comment "Refers to dataset and the broad concept of data"@en ;
          rdfs:label "Data"@en .
airo:Documentation rdf:type owl:Class ;
                   rdfs:comment "Refers to documeneted information."@en ;
                   rdfs:label "Documentation"@en .
airo:Domain rdf:type owl:Class ;
            rdfs:comment "An area, sector, or industry that is associated with economic activities."@en ;
            rdfs:label "Domain"@en .
airo:Frequency rdf:type owl:Class ;
               terms:source "ISO 31073:2022, 3.3.20"@en ;
               rdfs:comment "Number of events or outcomes per defined unit of time."@en ;
               rdfs:label "Frequency"@en .
airo:GPAIModel rdf:type owl:Class ;
               rdfs:subClassOf airo:AIModel ;
               terms:source "EU AI Act, Article 3(63)"@en ;
               rdfs:comment "An AI model, including where such an AI model is trained with a large amount of data using self-supervision at scale, that displays significant generality and is capable of competently performing a wide range of distinct tasks regardless of the way the model is placed on the market and that can be integrated into a variety of downstream systems or applications."@en ;
               rdfs:label "General Purpose AI Model"@en .
airo:HardwarePlatform rdf:type owl:Class ;
                      rdfs:comment "The hardware on which the system runs." ;
                      rdfs:label "Hardware Platform" .
airo:Hazard rdf:type owl:Class ;
            rdfs:subClassOf airo:RiskSource ;
            terms:source "ISO 31073:2022, 3.3.12"@en ;
            rdfs:comment "Source of potential harm."@en ;
            rdfs:label "Hazard"@en .
airo:HumanInvolvement rdf:type owl:Class ;
                      rdfs:comment "Indicates involvement of humans."@en ;
                      rdfs:label "Human Involvement"@en .
airo:Impact rdf:type owl:Class ;
            rdfs:subClassOf airo:Consequence ;
            rdfs:comment "The outcome of a consequence on individuals, groups, society, environment, etc."@en ;
            rdfs:label "Impact"@en .
airo:Input rdf:type owl:Class ;
           rdfs:comment "Input for which the system or component generates output."@en ;
           rdfs:label "Input"@en .
airo:License rdf:type owl:Class ;
             rdfs:comment "Represents a copyright license."@en ;
             rdfs:label "License"@en .
airo:Likelihood rdf:type owl:Class ;
                terms:source "ISO 31073:2022, 3.3.16"@en ;
                rdfs:comment "Chance of something happening."@en ;
                rdfs:label "Likelihood"@en .
airo:LocalityOfUse rdf:type owl:Class ;
                   rdfs:comment "The area, e.g. facility or institution, in which an entity is used."@en ;
                   rdfs:label "Locality Of Use"@en .
airo:Misuse rdf:type owl:Class ;
            rdfs:subClassOf airo:Risk ;
            rdfs:comment "The use of an AI system or component  in a way that is not in accordance with its intended purpose."@en ;
            rdfs:label "Misuse"@en .
airo:Modality rdf:type owl:Class ;
              rdfs:comment "The form in which the system exists or is represented."@en ;
              rdfs:label "Modality"@en .
airo:ModeOfOutputControllability rdf:type owl:Class ;
                                 rdfs:comment "The level of control over AI outputs exercised by humans."@en ;
                                 rdfs:label "Mode Of Output Controllability"@en .
airo:Output rdf:type owl:Class ;
            rdfs:comment "Output generated by the system."@en ;
            rdfs:label "Output"@en .
airo:Purpose rdf:type owl:Class ;
             rdfs:comment "The end goal for which an entity is used or an action is taken."@en ;
             rdfs:label "Purpose"@en .
airo:Regulation rdf:type owl:Class ;
                rdfs:comment "A binding legislative act."@en ;
                rdfs:label "Regulation"@en .
airo:Risk rdf:type owl:Class ;
         rdfs:subClassOf airo:RiskConcept ;
         rdfs:comment "the state of uncertainty associated with an AI system, that has the potential to cause harms and is expressed in terms of risk sources, consequences, impacts, likelihood, and severity"@en ;
         rdfs:label "Risk"@en .
airo:RiskConcept rdf:type owl:Class ;
                 rdfs:comment "An umbrella term for refering to risk, risk source, consequence and impact."@en ;
                 rdfs:label "Risk Concept"@en .
airo:RiskControl rdf:type owl:Class ;
                 terms:source "ISO/IEC 31073, 3.3.33 (with expansion of scope)" ;
                 rdfs:comment "A measure that maintains and/or modifies risk (and risk concepts)."@en ;
                 rdfs:label "Risk Control"@en .
airo:RiskSource rdf:type owl:Class ;
                rdfs:subClassOf airo:RiskConcept ;
                terms:source "ISO 31073:2022, 3.3.10" ;
                rdfs:comment "An element which alone or in combination has the potential to give rise to risk."@en ;
                rdfs:label "Risk Source"@en .
airo:Severity rdf:type owl:Class ;
              rdfs:comment "Indicates the level of severity."@en ;
              rdfs:label "Severity"@en .
airo:Stakeholder rdf:type owl:Class ;
                 rdfs:comment "Represents any individual, group or organization that can affect, be affected by or perceive itself to be affected by a decision or activity."@en ;
                 rdfs:isDefinedBy "ISO/IEC 22989, 3.5.13"@en ;
                 rdfs:label "Stakeholder"@en .
airo:Standard rdf:type owl:Class ;
              terms:source "Regulation (EU) No 1025/2012 on European standardisation" ;
              rdfs:comment "A technical specification, adopted by a recognised standardisation body, for repeated or continuous application, with which compliance is not compulsory."@en ;
              rdfs:label "Standard"@en .
airo:Threat rdf:type owl:Class ;
            rdfs:subClassOf airo:RiskSource ;
            terms:source "ISO 31073:2022, 3.3.13"@en ;
            rdfs:comment "Potential source of danger, harm, or other undesirable outcome."@en ;
            rdfs:label "Threat"@en .
airo:Version rdf:type owl:Class ;
             rdfs:comment "A unique number or name that is assigned to a unique state of an AI system."@en ;
             rdfs:label "Version"@en .
airo:Vulnerability rdf:type owl:Class ;
                   terms:source "ISO 31073:2022, 3.3.21 with modifications"@en ;
                   rdfs:comment "Refers to  properties of an entity, e.g. AI system or AI component, resulting in susceptibility to a risk source"@en ;
                   rdfs:label "Vulnerability"@en .
<https://w3id.org/dpv#Data> rdf:type owl:Class .
<https://w3id.org/dpv#DataSource> rdf:type owl:Class .
<https://w3id.org/dpv#DataSubject> rdf:type owl:Class .
<https://w3id.org/dpv#LegalBasis> rdf:type owl:Class .
<https://w3id.org/dpv#Processing> rdf:type owl:Class .
<https://w3id.org/dpv#SensitiveData> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/dpv#Data> .
<https://www.w3.org/TR/vocab-dcat-3/Dataset> rdf:type owl:Class .
airo:Algorithm rdf:type owl:Class ;
               rdfs:comment "The set of rules or mathematical procedures an AI system follows to process input and generate output."@en ;
               rdfs:label "Algorithm"@en .
airo:AlertTrigger rdf:type owl:Class ;
                  rdfs:comment "An event or condition that initiates an alert or notification process."@en ;
                  rdfs:label "Alert Trigger"@en .
airo:AssessmentType rdf:type owl:Class ;
                    rdfs:comment "Type of assessment performed (e.g. conformity assessment, data protection impact assessment)."@en ;
                    rdfs:label "Assessment Type"@en .
airo:BindingNature rdf:type owl:Class ;
                   rdfs:comment "Indicates whether a legal act is binding."@en ;
                   rdfs:label "Binding Nature"@en .
airo:CertifiableComponent rdf:type owl:Class ;
                          rdfs:subClassOf airo:AIComponent ;
                          rdfs:comment "An AI component whose conformity assessment is covered by a certificate."@en ;
                          rdfs:label "Certifiable Component"@en .
airo:CertificationScheme rdf:type owl:Class ;
                         rdfs:comment "A scheme under which a high-risk AI system can be certified (e.g., cybersecurity scheme)."@en ;
                         rdfs:label "Certification Scheme"@en .
airo:ComplianceStatus rdf:type owl:Class ;
                      rdfs:comment "Status of compliance with a regulation or standard."@en ;
                      rdfs:label "Compliance Status"@en .
airo:ConfidentialInformation rdf:type owl:Class ;
                             rdfs:comment "Information protected under confidentiality obligations (e.g., trade secrets, IP)."@en ;
                             rdfs:label "Confidential Information"@en .
airo:CorrectiveAction rdf:type owl:Class ;
                     rdfs:comment "Action taken to bring a non-compliant system into conformity or mitigate risks."@en ;
                     rdfs:label "Corrective Action"@en .
airo:DelegatedActType rdf:type owl:Class ;
                      rdfs:comment "Type of act delegated by the main regulation."@en ;
                      rdfs:label "Delegated Act Type"@en .
airo:Directive rdf:type owl:Class ;
               rdfs:subClassOf airo:Regulation ;
               rdfs:comment "A Union legislative act requiring Member States to adopt national implementing legislation."@en ;
               rdfs:label "Directive"@en .
airo:EUDAccessLevel rdf:type owl:Class ;
                    rdfs:comment "Level of access granted to the EU Database for high-risk AI systems."@en ;
                    rdfs:label "EU Database Access Level"@en .
airo:EUDeclarationOfConformity rdf:type owl:Class ;
                              rdfs:comment "Statement by the provider declaring conformity with applicable Union legislation."@en ;
                              rdfs:label "EU Declaration of Conformity"@en .
airo:EnforcementAction rdf:type owl:Class ;
                       rdfs:comment "Action taken by an authority to ensure compliance (e.g., fine, restriction, withdrawal)."@en ;
                       rdfs:label "Enforcement Action"@en .
airo:EvaluationMethodology rdf:type owl:Class ;
                           rdfs:comment "Methodology used for assessing capabilities or risks."@en ;
                           rdfs:label "Evaluation Methodology"@en .
airo:ExemptionReason rdf:type owl:Class ;
                     rdfs:comment "Reason justifying an exemption from a requirement."@en ;
                     rdfs:label "Exemption Reason"@en .
airo:ExpertGroup rdf:type owl:Class ;
                 rdfs:comment "A group of experts established to advise or support specific tasks."@en ;
                 rdfs:label "Expert Group"@en .
airo:FGRI rdf:type owl:Class ;
          rdfs:comment "Fundamental Rights Impact Assessment."@en ;
          rdfs:label "Fundamental Rights Impact Assessment"@en .
airo:FinesType rdf:type owl:Class ;
               rdfs:comment "Type of administrative fine imposed (e.g., based on turnover, fixed amount)."@en ;
               rdfs:label "Fines Type"@en .
airo:GovernanceStructure rdf:type owl:Class ;
                         rdfs:comment "The organizational arrangement for managing AI compliance and oversight."@en ;
                         rdfs:label "Governance Structure"@en .
airo:HarmfulPractice rdf:type owl:Class ;
                     rdfs:subClassOf airo:RiskConcept ;
                     rdfs:comment "An AI practice that is prohibited due to its harmful nature."@en ;
                     rdfs:label "Harmful AI Practice"@en .
airo:ImplementingActType rdf:type owl:Class ;
                         rdfs:comment "Type of act implemented by the Commission (e.g., setting technical specifications)."@en ;
                         rdfs:label "Implementing Act Type"@en .
airo:InformationRecipient rdf:type owl:Class ;
                          rdfs:comment "Entity receiving information."@en ;
                          rdfs:label "Information Recipient"@en .
airo:InformationSource rdf:type owl:Class ;
                       rdfs:comment "Entity providing information."@en ;
                       rdfs:label "Information Source"@en .
airo:IntendedUse rdf:type owl:Class ;
                rdfs:comment "The specific use case(s) for which an AI system is designed."@en ;
                rdfs:label "Intended Use"@en .
airo:InteroperabilityFramework rdf:type owl:Class ;
                               rdfs:comment "Framework ensuring interoperability between EU IT systems."@en ;
                               rdfs:label "Interoperability Framework"@en .
airo:LegalAct rdf:type owl:Class ;
              rdfs:comment "A legally binding act of the Union."@en ;
              rdfs:label "Legal Act"@en .
airo:LegalBasisForProcessing rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/dpv#LegalBasis> ;
                           rdfs:comment "The legal justification for processing personal data."@en ;
                           rdfs:label "Legal Basis For Processing"@en .
airo:MarketAvailabilityStatus rdf:type owl:Class ;
                              rdfs:comment "Status regarding placing on the market or putting into service."@en ;
                              rdfs:label "Market Availability Status"@en .
airo:MarketSurveillanceAction rdf:type owl:Class ;
                              rdfs:comment "Action taken by a Market Surveillance Authority."@en ;
                              rdfs:label "Market Surveillance Action"@en .
airo:MarketSurveillanceAuthority rdf:type owl:Class ;
                               rdfs:subClassOf airo:CompetentAuthority ;
                               terms:source "Regulation (EU) 2019/1020, Article 3(3)"@en ;
                               rdfs:comment "National authority responsible for market surveillance."@en ;
                               rdfs:label "Market Surveillance Authority"@en .
airo:MemberState rdf:type owl:Class ;
                 rdfs:comment "A Union Member State."@en ;
                 rdfs:label "Member State"@en .
airo:MitigationMeasure rdf:type owl:Class ;
                     rdfs:subClassOf airo:RiskControl ;
                     rdfs:comment "A measure to reduce the severity or likelihood of a risk."@en ;
                     rdfs:label "Mitigation Measure"@en .
airo:NotifiedBody rdf:type owl:Class ;
                  rdfs:subClassOf airo:ConformityAssessmentBody ;
                  terms:source "Regulation (EU) 2019/1020, Article 3(24)"@en ;
                  rdfs:comment "A conformity assessment body notified under this Regulation."@en ;
                  rdfs:label "Notified Body"@en .
airo:NotifyingAuthority rdf:type owl:Class ;
                        rdfs:subClassOf airo:CompetentAuthority ;
                        terms:source "Regulation (EU) 2019/1020, Article 3(23)"@en ;
                        rdfs:comment "National authority responsible for conformity assessment body designation."@en ;
                        rdfs:label "Notifying Authority"@en .
airo:ProhibitedPractice rdf:type owl:Class ;
                       rdfs:subClassOf airo:HarmfulPractice ;
                       rdfs:comment "An AI practice explicitly prohibited under Article 5."@en ;
                       rdfs:label "Prohibited AI Practice"@en .
airo:Remedy rdf:type owl:Class ;
            rdfs:comment "A means to obtain redress or compensation."@en ;
            rdfs:label "Remedy"@en .
airo:RiskAssessment rdf:type owl:Class ;
                    rdfs:comment "Process of identifying and evaluating risks."@en ;
                    rdfs:label "Risk Assessment"@en .
airo:RiskManagementSystem rdf:type owl:Class ;
                          rdfs:comment "The system put in place by providers to manage risks."@en ;
                          rdfs:label "Risk Management System"@en .
airo:Sector rdf:type owl:Class ;
            rdfs:comment "An industry or sector of the economy."@en ;
            rdfs:label "Sector"@en .
airo:SpecificRequirement rdf:type owl:Class ;
                          rdfs:comment "A specific requirement applicable to high-risk AI systems."@en ;
                          rdfs:label "Specific Requirement"@en .
airo:SystemicRiskLevel rdf:type owl:Class ;
                       rdfs:comment "Level of risk associated with general-purpose AI models, indicating systemic concern."@en ;
                       rdfs:label "Systemic Risk Level"@en .
airo:TransparencyObligation rdf:type owl:Class ;
                           rdfs:comment "Obligation to disclose certain information about an AI system."@en ;
                           rdfs:label "Transparency Obligation"@en .
airo:UnionInstitution rdf:type owl:Class ;
                      rdfs:comment "An institution, body, office, or agency of the European Union."@en ;
                      rdfs:label "Union Institution"@en .
airo:Withdrawal rdf:type owl:Class ;
                 rdfs:comment "Action to prevent an AI system in the supply chain from being made available on the market."@en ;
                 rdfs:label "Withdrawal"@en .
airo:AuthorisedRepresentative rdf:type owl:Class ;
                              rdfs:subClassOf airo:AIOperator ;
                              terms:source "EU AI Act, Article 3(5)"@en ;
                              rdfs:comment "Natural or legal person established in the Union mandated by a third-country provider."@en ;
                              rdfs:label "Authorised Representative"@en .
airo:CompetentAuthority rdf:type owl:Class ;
                        rdfs:comment "Authority responsible for supervision, enforcement, or notification under the AI Act."@en ;
                        rdfs:label "Competent Authority"@en .
airo:ConformityAssessmentBody rdf:type owl:Class ;
                              terms:source "EU AI Act, Article 3(21)"@en ;
                              rdfs:comment "Body performing third-party conformity assessment activities."@en ;
                              rdfs:label "Conformity Assessment Body"@en .
airo:Criterion rdf:type owl:Class ;
               rdfs:comment "A standard or factor used for making a decision or assessment."@en ;
               rdfs:label "Criterion"@en .
airo:Distributor rdf:type owl:Class ;
                 rdfs:subClassOf airo:AIOperator ;
                 terms:source "EU AI Act, Article 3(7)"@en ;
                 rdfs:comment "Natural or legal person in the supply chain making an AI system available on the Union market."@en ;
                 rdfs:label "Distributor"@en .
airo:Importer rdf:type owl:Class ;
              rdfs:subClassOf airo:AIOperator ;
              terms:source "EU AI Act, Article 3(6)"@en ;
              rdfs:comment "Natural or legal person in the Union placing an AI system from a third country on the market."@en ;
              rdfs:label "Importer"@en .
airo:ProductManufacturer rdf:type owl:Class ;
                         rdfs:subClassOf airo:AIOperator ;
                         terms:source "EU AI Act, Article 3(3) - implied role related to product placing on the market"@en ;
                         rdfs:comment "Manufacturer placing an AI system together with their product on the market."@en ;
                         rdfs:label "Product Manufacturer"@en .
airo:SystemicRiskTrigger rdf:type owl:Class ;
                         rdfs:comment "Condition leading to a general-purpose AI model being classified as having systemic risk."@en ;
                         rdfs:label "Systemic Risk Trigger"@en .
airo:Action rdf:type owl:Class ;
           rdfs:comment "Any deliberate activity or omission by an operator."@en ;
           rdfs:label "Action"@en .
airo:AffectedPerson rdf:type owl:Class ;
                    rdfs:subClassOf airo:AISubject ;
                    terms:source "EU AI Act, Article 3(10)"@en ;
                    rdfs:comment "Natural person affected by the use of an AI system."@en ;
                    rdfs:label "Affected Person"@en .
airo:Article rdf:type owl:Class ;
             rdfs:comment "A numbered section within a Regulation or Directive."@en ;
             rdfs:label "Article"@en .
airo:DataGovernancePractice rdf:type owl:Class ;
                          rdfs:comment "Practices for managing data used in training, validation, and testing."@en ;
                          rdfs:label "Data Governance Practice"@en .
airo:DataProcessingActivity rdf:type owl:Class ;
                            rdfs:subClassOf <https://w3id.org/dpv#Processing> ;
                            rdfs:comment "A specific activity involving personal data processing."@en ;
                            rdfs:label "Data Processing Activity"@en .
airo:DataRetentionPeriod rdf:type owl:Class ;
                         rdfs:comment "The duration for which data must be kept."@en ;
                         rdfs:label "Data Retention Period"@en .
airo:DocumentationRequirement rdf:type owl:Class ;
                              rdfs:comment "A specific item required in technical documentation."@en ;
                              rdfs:label "Documentation Requirement"@en .
airo:ExclusionScope rdf:type owl:Class ;
                   rdfs:comment "The area or type of system/activity explicitly excluded from the Regulation's scope."@en ;
                   rdfs:label "Exclusion Scope"@en .
airo:FinesApplicability rdf:type owl:Class ;
                       rdfs:comment "The category of infringement to which a specific fine amount applies."@en ;
                       rdfs:label "Fines Applicability"@en .
airo:GovernanceMechanism rdf:type owl:Class ;
                         rdfs:comment "A structure or process ensuring accountability and compliance."@en ;
                         rdfs:label "Governance Mechanism"@en .
airo:ImpactQualifier rdf:type owl:Class ;
                     rdfs:comment "A descriptor for the nature/scale of impact (e.g., 'significant', 'adverse')."@en ;
                     rdfs:label "Impact Qualifier"@en .
airo:LegalChallenge rdf:type owl:Class ;
                   rdfs:comment "A formal recourse to a judicial or administrative body against a decision."@en ;
                   rdfs:label "Legal Challenge"@en .
airo:LogRecordingFeature rdf:type owl:Class ;
                         rdfs:comment "A technical feature enabling automatic recording of system events."@en ;
                         rdfs:label "Log Recording Feature"@en .
airo:MarketSurveillanceActivity rdf:type owl:Class ;
                                rdfs:comment "An activity conducted by market surveillance authorities."@en ;
                                rdfs:label "Market Surveillance Activity"@en .
airo:MaturityIndicator rdf:type owl:Class ;
                        rdfs:comment "An indicator reflecting the state-of-the-art or development stage of technology."@en ;
                        rdfs:label "Maturity Indicator"@en .
airo:NotificationType rdf:type owl:Class ;
                      rdfs:comment "Type of event requiring notification to authorities."@en ;
                      rdfs:label "Notification Type"@en .
airo:Precondition rdf:type owl:Class ;
                  rdfs:comment "A condition that must be met for an action or situation to be permitted."@en ;
                  rdfs:label "Precondition"@en .
airo:RedressMechanism rdf:type owl:Class ;
                      rdfs:subClassOf airo:Remedy ;
                      rdfs:comment "Mechanism designed to correct harm or non-compliance."@en ;
                      rdfs:label "Redress Mechanism"@en .
airo:RegulationScope rdf:type owl:Class ;
                     rdfs:comment "Defines the extent of applicability of the Regulation."@en ;
                     rdfs:label "Regulation Scope"@en .
airo:RevisionTrigger rdf:type owl:Class ;
                     rdfs:comment "Event or time-based trigger for reviewing or amending parts of the Regulation."@en ;
                     rdfs:label "Revision Trigger"@en .
airo:Safeguard rdf:type owl:Class ;
               rdfs:subClassOf airo:RiskControl ;
               rdfs:comment "A specific protective measure."@en ;
               rdfs:label "Safeguard"@en .
airo:SingleIdentificationNumber rdf:type owl:Class ;
                               rdfs:comment "A unique identifier assigned to an entity (e.g., testing registration, notified body)."@en ;
                               rdfs:label "Unique Single Identification Number"@en .
airo:SubcontractingParty rdf:type owl:Class ;
                         rdfs:subClassOf airo:AIOperator ;
                         rdfs:comment "An entity subcontracted to perform conformity assessment tasks."@en ;
                         rdfs:label "Subcontracting Party"@en .
airo:SystemicRisk rdf:type owl:Class ;
                  rdfs:subClassOf airo:Risk ;
                  terms:source "EU AI Act, Article 3(65)"@en ;
                  rdfs:comment "Risk specific to high-impact general-purpose AI models due to their reach and potential for large-scale propagation."@en ;
                  rdfs:label "Systemic Risk"@en .
airo:TestingCondition rdf:type owl:Class ;
                      rdfs:comment "A condition under which real-world testing is permitted."@en ;
                      rdfs:label "Testing Condition"@en .
airo:TextDataMining rdf:type owl:Class ;
                   rdfs:comment "The practice of automated analysis of large amounts of text data."@en ;
                   rdfs:label "Text and Data Mining"@en .
airo:Threshold rdf:type owl:Class ;
               rdfs:comment "A quantitative level (e.g., FLOPS) used for classification or presumption."@en ;
               rdfs:label "Threshold"@en .
airo:TradeAgreement rdf:type owl:Class ;
                    rdfs:comment "Bilateral or multilateral agreement relevant to international data exchange."@en ;
                    rdfs:label "Trade Agreement"@en .
airo:WhistleblowingDirective rdf:type owl:Class ;
                             rdfs:comment "Directive related to the protection of persons reporting infringements."@en ;
                             rdfs:label "Whistleblowing Directive"@en .
airo:AdvisoryForum rdf:type owl:Class ;
                   rdfs:comment "Forum established to provide technical expertise and advise the Board and Commission."@en ;
                   rdfs:label "Advisory Forum"@en .
airo:BindingDecision rdf:type owl:Class ;
                   rdfs:comment "A decision made by a judicial or independent administrative authority that is binding."@en ;
                   rdfs:label "Binding Decision"@en .
airo:CybersecurityMeasure rdf:type owl:Class ;
                         rdfs:subClassOf airo:RiskControl ;
                         rdfs:comment "A measure to ensure resilience against cyberattacks."@en ;
                         rdfs:label "Cybersecurity Measure"@en .
airo:DecisionMakingProcess rdf:type owl:Class ;
                           rdfs:comment "The procedure by which a decision is reached, with or without AI assistance."@en ;
                           rdfs:label "Decision Making Process"@en ;
                           <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/airo#" .
airo:Evaluation rdf:type owl:Class ;
                rdfs:comment "The process of assessing capabilities, performance, or conformity."@en ;
                rdfs:label "Evaluation"@en .
airo:ExternalStakeholder rdf:type owl:Class ;
                         rdfs:subClassOf airo:Stakeholder ;
                         rdfs:comment "Stakeholder entities external to the core provider/deployer relationship."@en ;
                         rdfs:label "External Stakeholder"@en .
airo:FPODerogation rdf:type owl:Class ;
                  rdfs:comment "Derogation applying to Financial Institutions regarding internal governance."@en ;
                  rdfs:label "Financial Provider Obligation Derogation"@en .
airo:GDPR rdf:type owl:Class ;
          rdfs:comment "General Data Protection Regulation (EU) 2016/679."@en ;
          rdfs:label "GDPR"@en .
airo:HumanOversightMeasure rdf:type owl:Class ;
                          rdfs:subClassOf airo:RiskControl ;
                          rdfs:comment "A measure ensuring human control over the AI system's operation."@en ;
                          rdfs:label "Human Oversight Measure"@en .
airo:Investigation rdf:type owl:Class ;
                 rdfs:comment "Formal inquiry conducted by authorities (e.g., market surveillance, law enforcement)."@en ;
                 rdfs:label "Investigation"@en .
airo:Maturity rdf:type owl:Class ;
              rdfs:comment "The level of development or readiness of a system or technology."@en ;
              rdfs:label "Maturity"@en .
airo:MonitoringActivity rdf:type owl:Class ;
                        rdfs:comment "Activity to observe and track system performance or compliance over time."@en ;
                        rdfs:label "Monitoring Activity"@en .
airo:PostMarketMonitoringSystem rdf:type owl:Class ;
                              terms:source "EU AI Act, Article 3(25)"@en ;
                              rdfs:comment "System for collecting and reviewing experience gained from using an AI system after placement on the market."@en ;
                              rdfs:label "Post-Market Monitoring System"@en .
airo:ScientificPanel rdf:type owl:Class ;
                   rdfs:comment "Panel of independent experts supporting enforcement activities related to GPAI models."@en ;
                   rdfs:label "Scientific Panel"@en .
airo:UnionSafeguardProcedure rdf:type owl:Class ;
                            rdfs:comment "Procedure used at Union level to address non-justified national measures."@en ;
                            rdfs:label "Union Safeguard Procedure"@en .
airo:AIHLEG rdf:type owl:Class ;
            rdfs:comment "The High-Level Expert Group on Artificial Intelligence."@en ;
            rdfs:label "AI HLEG"@en .
airo:AlignmentActivity rdf:type owl:Class ;
                       rdfs:comment "Activity related to aligning a model's behaviour with intended objectives or values."@en ;
                       rdfs:label "Alignment Activity"@en .
airo:AlternativeDisputeResolution rdf:type owl:Class ;
                                 rdfs:comment "Process for resolving disputes outside of judicial proceedings."@en ;
                                 rdfs:label "Alternative Dispute Resolution"@en .
airo:AntiMoneyLaunderingLaw rdf:type owl:Class ;
                           rdfs:comment "Union or national law against money laundering."@en ;
                           rdfs:label "Anti-Money Laundering Law"@en .
airo:ApplicationForAuthorisation rdf:type owl:Class ;
                                 rdfs:comment "Formal request for permission to use a high-risk AI system under specific derogations."@en ;
                                 rdfs:label "Application For Authorisation"@en .
airo:AppropriateTechnicalMeans rdf:type owl:Class ;
                               rdfs:comment "Means (like APIs) used to grant technical access."@en ;
                               rdfs:label "Appropriate Technical Means"@en .
airo:ArticleScope rdf:type owl:Class ;
                  rdfs:comment "Defines the subject matter or applicability of a specific Article."@en ;
                  rdfs:label "Article Scope"@en .
airo:AuditReport rdf:type owl:Class ;
                 rdfs:comment "A formal report detailing findings from a periodic audit."@en ;
                 rdfs:label "Audit Report"@en .
airo:Beneficiary rdf:type owl:Class ;
                 rdfs:subClassOf airo:AISubject ;
                 rdfs:comment "A person or group entitled to receive services or benefits."@en ;
                 rdfs:label "Beneficiary"@en .
airo:BiometricData rdf:type owl:Class ;
                   terms:source "EU AI Act, Article 3(34)"@en ;
                   rdfs:comment "Personal data resulting from specific technical processing relating to physical, physiological or behavioural characteristics."@en ;
                   rdfs:label "Biometric Data"@en .
airo:BiometricIdentification rdf:type owl:Class ;
                             terms:source "EU AI Act, Article 3(35)"@en ;
                             rdfs:comment "Automated recognition of identity using biometric data comparison against a reference database."@en ;
                             rdfs:label "Biometric Identification"@en .
airo:BiometricVerification rdf:type owl:Class ;
                           terms:source "EU AI Act, Article 3(36)"@en ;
                           rdfs:comment "Automated one-to-one confirmation of claimed identity using biometric data."@en ;
                           rdfs:label "Biometric Verification"@en .
airo:BorderControlManagement rdf:type owl:Class ;
                             rdfs:comment "Activities related to managing external borders."@en ;
                             rdfs:label "Border Control Management"@en .
airo:CEOBLookup rdf:type owl:Class ;
                rdfs:comment "Mechanism for linking CE marking to conformity information."@en ;
                rdfs:label "CE Marking Lookup"@en .
airo:CertifiableAISystem rdf:type owl:Class ;
                         rdfs:subClassOf airo:AISystem ;
                         rdfs:comment "An AI system requiring a certificate from a notified body."@en ;
                         rdfs:label "Certifiable AI System"@en .
airo:ClassificationCriterion rdf:type owl:Class ;
                             rdfs:subClassOf airo:Criterion ;
                             rdfs:comment "Criteria used to determine if an AI system is high-risk or if a GPAI model has systemic risk."@en ;
                             rdfs:label "Classification Criterion"@en .
airo:CompetitionLaw rdf:type owl:Class ;
                   rdfs:comment "Union law related to fair competition."@en ;
                   rdfs:label "Competition Law"@en .
airo:ComplianceDocument rdf:type owl:Class ;
                        rdfs:subClassOf airo:Documentation ;
                        rdfs:comment "Document demonstrating adherence to requirements (e.g., Declaration of Conformity, Technical Documentation)."@en ;
                        rdfs:label "Compliance Document"@en .
airo:ContactDetails rdf:type owl:Class ;
                    rdfs:comment "Information identifying how to reach an operator."@en ;
                    rdfs:label "Contact Details"@en .
airo:ContractualTerm rdf:type owl:Class ;
                    rdfs:comment "Clauses agreed upon in a contract between supply chain actors."@en ;
                    rdfs:label "Contractual Term"@en .
airo:CriminalOffence rdf:type owl:Class ;
                     rdfs:comment "An offense listed in Annex II."@en ;
                     rdfs:label "Criminal Offence"@en .
airo:CybersecurityRequirement rdf:type owl:Class ;
                              rdfs:subClassOf airo:SpecificRequirement ;
                              rdfs:comment "Requirement related to protecting against cyberattacks."@en ;
                              rdfs:label "Cybersecurity Requirement"@en .
airo:DataMinimisation rdf:type owl:Class ;
                     rdfs:subClassOf airo:DataGovernancePractice ;
                     rdfs:comment "Principle of processing only necessary personal data."@en ;
                     rdfs:label "Data Minimisation"@en .
airo:DataProtectionAuthority rdf:type owl:Class ;
                             rdfs:subClassOf airo:CompetentAuthority ;
                             rdfs:comment "National authority supervising data protection law."@en ;
                             rdfs:label "Data Protection Authority"@en .
airo:DataProcessing rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/dpv#Processing> ;
                  rdfs:comment "Processing of data, including personal or non-personal."@en ;
                  rdfs:label "Data Processing"@en .
airo:Decision rdf:type owl:Class ;
              rdfs:comment "An outcome reached by a deployer, potentially influenced by AI output."@en ;
              rdfs:label "Decision"@en .
airo:DigitalServiceAct rdf:type owl:Class ;
                     rdfs:comment "Regulation (EU) 2022/2065 on a single market for digital services."@en ;
                     rdfs:label "Digital Services Act"@en .
airo:Directive rdf:type owl:Class ;
               rdfs:subClassOf airo:LegalAct ;
               rdfs:comment "A Union legislative act requiring Member States to adopt national implementing legislation."@en ;
               rdfs:label "Directive"@en .
airo:Disruption rdf:type owl:Class ;
               rdfs:comment "Interruption of normal activities or functions, potentially critical."@en ;
               rdfs:label "Disruption"@en .
airo:EducationalSetting rdf:type owl:Class ;
                        rdfs:comment "Context related to education or vocational training."@en ;
                        rdfs:label "Educational Setting"@en .
airo:EnforcementActionTaken rdf:type owl:Class ;
                           rdfs:subClassOf airo:EnforcementAction ;
                           rdfs:comment "A concrete step taken by an authority to enforce the AI Act."@en ;
                           rdfs:label "Enforcement Action Taken"@en .
airo:EthicalPrinciple rdf:type owl:Class ;
                    rdfs:comment "A non-binding principle guiding trustworthy AI design (e.g., fairness, human agency)."@en ;
                    rdfs:label "Ethical Principle"@en .
airo:EvaluationReport rdf:type owl:Class ;
                      rdfs:subClassOf airo:Documentation ;
                      rdfs:comment "Document detailing the results of model evaluations."@en ;
                      rdfs:label "Evaluation Report"@en .
airo:Exception rdf:type owl:Class ;
               rdfs:comment "A specific circumstance where a rule of the Regulation does not apply."@en ;
               rdfs:label "Exception"@en .
airo:ExplanationRight rdf:type owl:Class ;
                     rdfs:comment "The right of an affected person to receive a clear explanation for an AI-based decision."@en ;
                     rdfs:label "Right to Explanation"@en .
airo:Fines rdf:type owl:Class ;
           rdfs:subClassOf airo:EnforcementAction ;
           terms:source "EU AI Act, Article 99, 100, 101"@en ;
           rdfs:comment "Monetary penalty imposed for non-compliance."@en ;
           rdfs:label "Fine"@en .
airo:FPODerogation rdf:type owl:Class ;
                  rdfs:comment "Derogation applying to Financial Institutions regarding internal governance."@en ;
                  rdfs:label "Financial Provider Obligation Derogation"@en .
airo:HarmfulBias rdf:type owl:Class ;
                 rdfs:subClassOf airo:RiskConcept ;
                 rdfs:comment "Bias leading to discriminatory or unfair outcomes."@en ;
                 rdfs:label "Harmful Bias"@en .
airo:HumanOversightMeasure rdf:type owl:Class ;
                          rdfs:subClassOf airo:RiskControl ;
                          rdfs:comment "A measure ensuring human control over the AI system's operation."@en ;
                          rdfs:label "Human Oversight Measure"@en .
airo:ImpactAssessment rdf:type owl:Class ;
                      rdfs:subClassOf airo:RiskAssessment ;
                      rdfs:comment "An assessment focusing on the impact on fundamental rights."@en ;
                      rdfs:label "Impact Assessment"@en .
airo:ImplementationProgressReport rdf:type owl:Class ;
                                rdfs:subClassOf airo:Documentation ;
                                rdfs:comment "Report on the status of financial, technical, and human resources of national competent authorities."@en ;
                                rdfs:label "Implementation Progress Report"@en .
airo:IncidentReporting rdf:type owl:Class ;
                     rdfs:comment "Obligation for providers to report serious incidents."@en ;
                     rdfs:label "Serious Incident Reporting"@en .
airo:Infringement rdf:type owl:Class ;
                  rdfs:comment "Violation of any provision of the AI Act."@en ;
                  rdfs:label "Infringement"@en .
airo:IntellectualPropertyRights rdf:type owl:Class ;
                               rdfs:comment "Rights related to creations of the mind (e.g., copyrights, patents)."@en ;
                               rdfs:label "Intellectual Property Rights"@en .
airo:InternalControl rdf:type owl:Class ;
                     rdfs:comment "Conformity assessment procedure without third-party involvement."@en ;
                     rdfs:label "Internal Control"@en .
airo:Jurisdiction rdf:type owl:Class ;
                 rdfs:comment "The authority of a court or administrative body."@en ;
                 rdfs:label "Jurisdiction"@en .
airo:LegalChallengeProceduralRight rdf:type owl:Class ;
                                   rdfs:subClassOf airo:Remedy ;
                                   rdfs:comment "Procedural rights for operators during enforcement actions."@en ;
                                   rdfs:label "Legal Challenge Procedural Right"@en .
airo:LiabilityFramework rdf:type owl:Class ;
                        rdfs:comment "Legal framework governing responsibility for damages caused by products or services."@en ;
                        rdfs:label "Liability Framework"@en .
airo:MachineReadableFormat rdf:type owl:Class ;
                           rdfs:comment "Format allowing automated processing of information (e.g., for labels, documentation)."@en ;
                           rdfs:label "Machine Readable Format"@en .
airo:Mandate rdf:type owl:Class ;
             rdfs:comment "Formal written authorization given by a provider to a representative."@en ;
             rdfs:label "Mandate"@en .
airo:ModelEvaluation rdf:type owl:Class ;
                   rdfs:comment "Process to assess the capabilities and limitations of a GPAI model."@en ;
                   rdfs:label "Model Evaluation"@en .
airo:ModelPoisoning rdf:type owl:Class ;
                   rdfs:subClassOf airo:CybersecurityMeasure ;
                   rdfs:comment "Attack attempting to manipulate a pre-trained model."@en ;
                   rdfs:label "Model Poisoning"@en .
airo:NonBindingGuidance rdf:type owl:Class ;
                        rdfs:comment "Non-binding advice or recommendations from authorities."@en ;
                        rdfs:label "Non-Binding Guidance"@en .
airo:NonPersonalData rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/dpv#Data> ;
                     terms:source "EU AI Act, Article 3(51)"@en ;
                     rdfs:comment "Data that is not personal data."@en ;
                     rdfs:label "Non-Personal Data"@en .
airo:Operator rdf:type owl:Class ;
              rdfs:subClassOf airo:AIOperator ;
              terms:source "EU AI Act, Article 3(8)"@en ;
              rdfs:comment "A provider, product manufacturer, deployer, authorised representative, importer or distributor."@en ;
              rdfs:label "Operator"@en .
airo:PerformanceMetric rdf:type owl:Class ;
                       rdfs:comment "Measurable unit used to declare expected or validated performance."@en ;
                       rdfs:label "Performance Metric"@en .
airo:PreConditionForDerogation rdf:type owl:Class ;
                             rdfs:subClassOf airo:Precondition ;
                             rdfs:comment "Condition required for an exception or derogation to apply."@en ;
                             rdfs:label "Precondition For Derogation"@en .
airo:PreConditionForUse rdf:type owl:Class ;
                      rdfs:subClassOf airo:Precondition ;
                      rdfs:comment "Condition that must be met before an AI system can be used (e.g., authorisation)."@en ;
                      rdfs:label "Precondition For Use"@en .
airo:PrivacyPreservingTechnique rdf:type owl:Class ;
                               rdfs:comment "Techniques used to protect privacy during data processing or model training (e.g., anonymisation)."@en ;
                               rdfs:label "Privacy-Preserving Technique"@en .
airo:ProhibitoryClause rdf:type owl:Class ;
                       rdfs:subClassOf airo:RiskControl ;
                       rdfs:comment "A rule explicitly forbidding a specific action or use."@en ;
                       rdfs:label "Prohibitory Clause"@en .
airo:PublicAuthority rdf:type owl:Class ;
                     rdfs:subClassOf airo:Stakeholder ;
                     rdfs:comment "Entity exercising public authority or providing public services."@en ;
                     rdfs:label "Public Authority"@en .
airo:QualifiedAlert rdf:type owl:Class ;
                    rdfs:comment "An alert from the Scientific Panel indicating potential systemic risk."@en ;
                    rdfs:label "Qualified Alert"@en .
airo:RealWorldTesting rdf:type owl:Class ;
                      rdfs:comment "Testing of an AI system in its intended environment outside a sandbox."@en ;
                      rdfs:label "Real-World Testing"@en .
airo:RecordKeeping rdf:type owl:Class ;
                    rdfs:comment "Obligation to retain logs and documentation over time."@en ;
                    rdfs:label "Record-Keeping"@en .
airo:RegulatorySandbox rdf:type owl:Class ;
                        rdfs:comment "Controlled environment for testing innovative AI systems."@en ;
                        rdfs:label "AI Regulatory Sandbox"@en .
airo:RelevantLaw rdf:type owl:Class ;
                 rdfs:comment "Any Union or national law applicable to the AI system's context."@en ;
                 rdfs:label "Relevant Law"@en .
airo:Remediation rdf:type owl:Class ;
                 rdfs:subClassOf airo:CorrectiveAction ;
                 rdfs:comment "Action taken to resolve non-compliance identified by authorities."@en ;
                 rdfs:label "Remediation"@en .
airo:ReportingObligation rdf:type owl:Class ;
                        rdfs:comment "Duty to provide information to authorities or the public."@en ;
                        rdfs:label "Reporting Obligation"@en .
airo:ResponsibleParty rdf:type owl:Class ;
                      rdfs:comment "Entity legally responsible for a specific obligation or system."@en ;
                      rdfs:label "Responsible Party"@en .
airo:Restriction rdf:type owl:Class ;
                 rdfs:subClassOf airo:EnforcementAction ;
                 rdfs:comment "Action to limit the availability or use of a non-compliant AI system."@en ;
                 rdfs:label "Restriction"@en .
airo:ReviewTrigger rdf:type owl:Class ;
                   rdfs:subClassOf airo:RevisionTrigger ;
                   rdfs:comment "Trigger for a formal review of the Regulation or its elements."@en ;
                   rdfs:label "Review Trigger"@en .
airo:SecurityOfSupply rdf:type owl:Class ;
                    rdfs:comment "Measures ensuring the continued availability of necessary resources (e.g., hardware) for an AI system."@en ;
                    rdfs:label "Security of Supply"@en .
airo:SocialScoring rdf:type owl:Class ;
                 rdfs:subClassOf airo:HarmfulPractice ;
                 terms:source "EU AI Act, Article 5(1)(c)"@en ;
                 rdfs:comment "Evaluation or classification of natural persons based on social behaviour leading to detrimental treatment."@en ;
                 rdfs:label "Social Scoring"@en .
airo:SupervisionActivity rdf:type owl:Class ;
                         rdfs:comment "Activity conducted by supervisory bodies (e.g., Notifying Authorities, EDPS)."@en ;
                         rdfs:label "Supervision Activity"@en .
airo:SystemicRiskEvaluation rdf:type owl:Class ;
                            rdfs:subClassOf airo:Evaluation ;
                            rdfs:comment "Evaluation specifically for assessing systemic risk of GPAI models."@en ;
                            rdfs:label "Systemic Risk Evaluation"@en .
airo:TechnicalSpecification rdf:type owl:Class ;
                            rdfs:comment "Detailed technical description or standard."@en ;
                            rdfs:label "Technical Specification"@en .
airo:TradeOff rdf:type owl:Class ;
              rdfs:comment "A necessary compromise made between conflicting requirements (e.g., accuracy vs. privacy)."@en ;
              rdfs:label "Trade-Off"@en .
airo:TransparencyMechanism rdf:type owl:Class ;
                           rdfs:subClassOf airo:RiskControl ;
                           rdfs:comment "A mechanism implemented to meet transparency obligations."@en ;
                           rdfs:label "Transparency Mechanism"@en .
airo:UnionHarmonisationLegislation rdf:type owl:Class ;
                                   rdfs:comment "Existing EU legislation harmonizing product safety and conformity assessment (listed in Annex I)."@en ;
                                   rdfs:label "Union Harmonisation Legislation"@en .
airo:UnintendedOutcome rdf:type owl:Class ;
                     rdfs:subClassOf airo:RiskConcept ;
                     rdfs:comment "An outcome that was not intended by the provider."@en ;
                     rdfs:label "Unintended Outcome"@en .
airo:VoluntaryCodeOfConduct rdf:type owl:Class ;
                           rdfs:subClassOf airo:CodeOfConduct ;
                           rdfs:comment "A code developed for voluntary adherence, often to supplement mandatory rules."@en ;
                           rdfs:label "Voluntary Code of Conduct"@en .
airo:VulnerabilityExploitation rdf:type owl:Class ;
                             rdfs:subClassOf airo:RiskSource ;
                             rdfs:comment "The act of leveraging a system's weakness."@en ;
                             rdfs:label "Vulnerability Exploitation"@en .
airo:WhistleblowerProtectionDirective rdf:type owl:Class ;
                                     rdfs:subClassOf airo:Directive ;
                                     terms:source "Directive (EU) 2019/1937"@en ;
                                     rdfs:comment "Directive on the protection of persons reporting infringements."@en ;
                                     rdfs:label "Whistleblower Protection Directive"@en .
<https://w3id.org/dpv#Data> rdf:type owl:Class .
<https://w3id.org/dpv#DataSource> rdf:type owl:Class .
<https://w3id.org/dpv#DataSubject> rdf:type owl:Class .
<https://w3id.org/dpv#LegalBasis> rdf:type owl:Class .
<https://w3id.org/dpv#Processing> rdf:type owl:Class .
<https://w3id.org/dpv#SensitiveData> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/dpv#Data> .
<https://www.w3.org/TR/vocab-dcat-3/Dataset> rdf:type owl:Class .
airo:hasResidualRisk rdfs:subPropertyOf airo:hasRisk .
airo:hasImpactOnStakeholder rdfs:subPropertyOf airo:hasImpactOnEntity .
airo:hasModel rdfs:subPropertyOf airo:hasComponent .
airo:MitigationMeasure rdfs:subClassOf airo:RiskControl .
airo:ExemptionReason rdfs:subClassOf airo:Precondition .
airo:Remedy rdfs:subClassOf airo:CorrectiveAction .
airo:Safeguard rdfs:subClassOf airo:RiskControl .
airo:SystemicRisk rdfs:subClassOf airo:Risk .
airo:Threat rdfs:subClassOf airo:RiskSource .
airo:VulnerabilityExploitation rdfs:subClassOf airo:RiskSource .
airo:HarmfulPractice rdfs:subClassOf airo:RiskConcept .
airo:Misuse rdfs:subClassOf airo:Risk .
airo:Consequence rdfs:subClassOf airo:RiskConcept .
airo:Risk rdfs:subClassOf airo:RiskConcept .
airo:Hazard rdf:type owl:Class ;
            rdfs:subClassOf airo:RiskSource ;
            terms:source "ISO 31073:2022, 3.3.12"@en ;
            rdfs:comment "Source of potential harm."@en ;
            rdfs:label "Hazard"@en .
airo:ProhibitedPractice rdf:type owl:Class ;
                       rdfs:subClassOf airo:HarmfulPractice ;
                       rdfs:comment "An AI practice explicitly prohibited under Article 5."@en ;
                       rdfs:label "Prohibited AI Practice"@en .
airo:SocialScoring rdf:type owl:Class ;
                 rdfs:subClassOf airo:HarmfulPractice ;
                 terms:source "EU AI Act, Article 5(1)(c)"@en ;
                 rdfs:comment "Evaluation or classification of natural persons based on social behaviour leading to detrimental treatment."@en ;
                 rdfs:label "Social Scoring"@en .
airo:BiometricIdentification rdf:type owl:Class ;
                             terms:source "EU AI Act, Article 3(35)"@en ;
                             rdfs:comment "Automated recognition of identity using biometric data comparison against a reference database."@en ;
                             rdfs:label "Biometric Identification"@en .
airo:BiometricVerification rdf:type owl:Class ;
                           terms:source "EU AI Act, Article 3(36)"@en ;
                           rdfs:comment "Automated one-to-one confirmation of claimed identity using biometric data."@en ;
                           rdfs:label "Biometric Verification"@en .
airo:EmotionRecognitionSystem rdf:type owl:Class ;
                              terms:source "EU AI Act, Article 3(39)"@en ;
                              rdfs:comment "An AI system for identifying or inferring emotions or intentions from biometric data."@en ;
                              rdfs:label "Emotion Recognition System"@en .
airo:BiometricCategorisationSystem rdf:type owl:Class ;
                                   terms:source "EU AI Act, Article 3(40)"@en ;
                                   rdfs:comment "An AI system assigning persons to categories based on biometric data, unless ancillary."@en ;
                                   rdfs:label "Biometric Categorisation System"@en .
airo:RealTimeRemoteBiometricIdentificationSystem rdf:type owl:Class ;
                                               terms:source "EU AI Act, Article 3(42)"@en ;
                                               rdfs:comment "Remote biometric identification system where capture, comparison, and identification occur without significant delay."@en ;
                                               rdfs:label "Real-Time Remote Biometric Identification System"@en .
airo:PostRemoteBiometricIdentificationSystem rdf:type owl:Class ;
                                          terms:source "EU AI Act, Article 3(43)"@en ;
                                          rdfs:comment "A remote biometric identification system other than a real-time one."@en ;
                                          rdfs:label "Post-Remote Biometric Identification System"@en .
airo:PubliclyAccessibleSpace rdf:type owl:Class ;
                             terms:source "EU AI Act, Article 3(44)"@en ;
                             rdfs:comment "Any physical space accessible to an undetermined number of persons."@en ;
                             rdfs:label "Publicly Accessible Space"@en .
airo:GPAISystem rdf:type owl:Class ;
                rdfs:subClassOf airo:AISystem ;
                terms:source "EU AI Act, Article 3(66)"@en ;
                rdfs:comment "An AI system based on a GPAI model with capability for a variety of purposes."@en ;
                rdfs:label "General Purpose AI System"@en .
airo:AdversarialExample rdf:type owl:Class ;
                      rdfs:subClassOf airo:CybersecurityMeasure ;
                      rdfs:comment "Input designed to cause an AI model to make a mistake (evasion attack)."@en ;
                      rdfs:label "Adversarial Example"@en .
airo:DataPoisoning rdf:type owl:Class ;
                   rdfs:subClassOf airo:CybersecurityMeasure ;
                   rdfs:comment "Attack trying to manipulate the training data set."@en ;
                   rdfs:label "Data Poisoning"@en .
airo:DeepFake rdf:type owl:Class ;
              terms:source "EU AI Act, Article 3(60)"@en ;
              rdfs:comment "AI-generated or manipulated media resembling reality."@en ;
              rdfs:label "Deep Fake"@en .
airo:WidespreadInfringement rdf:type owl:Class ;
                           terms:source "EU AI Act, Article 3(61)"@en ;
                           rdfs:comment "An act contrary to Union law harming collective interests across multiple Member States."@en ;
                           rdfs:label "Widespread Infringement"@en .
airo:CriticalInfrastructure rdf:type owl:Class ;
                          terms:source "EU AI Act, Article 3(62)"@en ;
                          rdfs:comment "Infrastructure critical for large-scale safety or social/economic activities."@en ;
                          rdfs:label "Critical Infrastructure"@en .
airo:SystemicRiskTrigger rdf:type owl:Class ;
                         rdfs:comment "Condition leading to a general-purpose AI model being classified as having systemic risk."@en ;
                         rdfs:label "Systemic Risk Trigger"@en .
airo:HighImpactCapabilities rdf:type owl:Class ;
                            terms:source "EU AI Act, Article 3(64)"@en ;
                            rdfs:comment "Capabilities matching or exceeding those of the most advanced general-purpose AI models."@en ;
                            rdfs:label "High-Impact Capabilities"@en .
airo:FloatingPointOperation rdf:type owl:Class ;
                          terms:source "EU AI Act, Article 3(67)"@en ;
                          rdfs:comment "A mathematical operation involving scaled floating-point numbers, used for measuring training computation."@en ;
                          rdfs:label "Floating-Point Operation"@en .
airo:DownstreamProvider rdf:type owl:Class ;
                        rdfs:subClassOf airo:AIProvider ;
                        terms:source "EU AI Act, Article 3(68)"@en ;
                        rdfs:comment "Provider of an AI system that integrates an AI model from another entity."@en ;
                        rdfs:label "Downstream Provider"@en .
airo:SecurityOfSupply rdf:type owl:Class ;
                    rdfs:comment "Measures ensuring the continued availability of necessary resources (e.g., hardware) for an AI system."@en ;
                    rdfs:label "Security of Supply"@en .
airo:WhistleblowerProtectionDirective rdf:type owl:Class ;
                                     rdfs:subClassOf airo:Directive ;
                                     terms:source "Directive (EU) 2019/1937"@en ;
                                     rdfs:comment "Directive on the protection of persons reporting infringements."@en ;
                                     rdfs:label "Whistleblower Protection Directive"@en .
airo:AIHLEG rdf:type owl:Class ;
            rdfs:comment "The High-Level Expert Group on Artificial Intelligence."@en ;
            rdfs:label "AI HLEG"@en .
airo:AlignmentActivity rdf:type owl:Class ;
                       rdfs:comment "Activity related to aligning a model's behaviour with intended objectives or values."@en ;
                       rdfs:label "Alignment Activity"@en .
airo:AlternativeDisputeResolution rdf:type owl:Class ;
                                 rdfs:comment "Process for resolving disputes outside of judicial proceedings."@en ;
                                 rdfs:label "Alternative Dispute Resolution"@en .
airo:AntiMoneyLaunderingLaw rdf:type owl:Class ;
                           rdfs:comment "Union or national law against money laundering."@en ;
                           rdfs:label "Anti-Money Laundering Law"@en .
airo:ApplicationForAuthorisation rdf:type owl:Class ;
                                 rdfs:comment "Formal request for permission to use a high-risk AI system under specific derogations."@en ;
                                 rdfs:label "Application For Authorisation"@en .
airo:AppropriateTechnicalMeans rdf:type owl:Class ;
                               rdfs:comment "Means (like APIs) used to grant technical access."@en ;
                               rdfs:label "Appropriate Technical Means"@en .
airo:ArticleScope rdf:type owl:Class ;
                  rdfs:comment "Defines the subject matter or applicability of a specific Article."@en ;
                  rdfs:label "Article Scope"@en .
airo:AuditReport rdf:type owl:Class ;
                 rdfs:subClassOf airo:Documentation ;
                 rdfs:comment "A formal report detailing findings from a periodic audit."@en ;
                 rdfs:label "Audit Report"@en .
airo:Beneficiary rdf:type owl:Class ;
                 rdfs:subClassOf airo:AISubject ;
                 rdfs:comment "A person or group entitled to receive services or benefits."@en ;
                 rdfs:label "Beneficiary"@en .
airo:BiometricData rdf:type owl:Class ;
                   terms:source "EU AI Act, Article 3(34)"@en ;
                   rdfs:comment "Personal data resulting from specific technical processing relating to physical, physiological or behavioural characteristics."@en ;
                   rdfs:label "Biometric Data"@en .
airo:BiometricIdentification rdf:type owl:Class ;
                             terms:source "EU AI Act, Article 3(35)"@en ;
                             rdfs:comment "Automated recognition of identity using biometric data comparison against a reference database."@en ;
                             rdfs:label "Biometric Identification"@en .
airo:BiometricVerification rdf:type owl:Class ;
                           terms:source "EU AI Act, Article 3(36)"@en ;
                           rdfs:comment "Automated one-to-one confirmation of claimed identity using biometric data."@en ;
                           rdfs:label "Biometric Verification"@en .
airo:BorderControlManagement rdf:type owl:Class ;
                             rdfs:comment "Activities related to managing external borders."@en ;
                             rdfs:label "Border Control Management"@en .
airo:CEOBLookup rdf:type owl:Class ;
                rdfs:comment "Mechanism for linking CE marking to conformity information."@en ;
                rdfs:label "CE Marking Lookup"@en .
airo:CertifiableAISystem rdf:type owl:Class ;
                         rdfs:subClassOf airo:AISystem ;
