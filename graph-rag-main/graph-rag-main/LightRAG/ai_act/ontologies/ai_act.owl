  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/airo#LegalBasisForProcessing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/dpv#LegalBasis"/>
    <rdfs:comment xml:lang="en">The legal justification for processing personal data.</rdfs:comment>
    <rdfs:label xml:lang="en">Legal Basis For Processing</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/airo#RiskAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
