    <terms:source xml:lang="en">ISO 31000, 3.6 [with modifications]</terms:source>
    <terms:source xml:lang="en">ISO 31073:2022, 3.3.18 [with modifications]</terms:source>
    <rdfs:comment xml:lang="en">Direct outcome of risk affecting objectives.</rdfs:comment>
    <rdfs:label xml:lang="en">Consequence</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/airo#hasPurpose">
