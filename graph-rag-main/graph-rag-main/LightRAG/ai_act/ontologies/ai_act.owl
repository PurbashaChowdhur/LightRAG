    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A group of experts established to advise or support specific tasks.</rdfs:comment>
    <rdfs:label xml:lang="en">Expert Group</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/airo#DataPoisoning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/airo#CybersecurityMeasure"/>
