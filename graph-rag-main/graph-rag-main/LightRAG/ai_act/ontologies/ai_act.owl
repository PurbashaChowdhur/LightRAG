  <rdf:Description rdf:about="https://w3id.org/airo#Algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The set of rules or mathematical procedures an AI system follows to process input and generate output.</rdfs:comment>
    <rdfs:label xml:lang="en">Algorithm</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/airo#Action">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Any deliberate activity or omission by an operator.</rdfs:comment>
    <rdfs:label xml:lang="en">Action</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/airo#EUDAccessLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Level of access granted to the EU Database for high-risk AI systems.</rdfs:comment>
    <rdfs:label xml:lang="en">EU Database Access Level</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/airo#RelevantLaw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
