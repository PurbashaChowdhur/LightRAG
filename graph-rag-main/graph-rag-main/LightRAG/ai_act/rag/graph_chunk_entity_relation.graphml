    <node id="Union Law on Competition Rules">
      <data key="d0">Union Law on Competition Rules</data>
      <data key="d1">category</data>
      <data key="d2">Union Law on Competition Rules refers to the legal framework governing competition and market practices in the European Union.</data>
      <data key="d3">chunk-53fb2685a38836a165fa7637bbbadce2</data>
