    <node id="Investigation and Prosecution">
      <data key="d0">Investigation and Prosecution</data>
      <data key="d1">category</data>
      <data key="d2">Investigation and prosecution are legal processes in which law enforcement authorities gather evidence and pursue criminal charges against offenders.</data>
      <data key="d3">chunk-77ba8e0dd4981bd71dedb04a86b45601</data>
      <data key="d4">./cached_docs/recital_59.json</data>
      <data key="d5">1783934176</data>
