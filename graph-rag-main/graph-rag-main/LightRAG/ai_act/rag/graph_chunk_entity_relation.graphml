    <node id="Manufacturing">
      <data key="d0">Manufacturing</data>
      <data key="d1">category</data>
      <data key="d2">Manufacturing involves the production of goods and requires adherence to safety standards when employing advanced technologies like AI and robotics.</data>
      <data key="d3">chunk-18cf1aa30864348514b20fe64038fba8</data>
