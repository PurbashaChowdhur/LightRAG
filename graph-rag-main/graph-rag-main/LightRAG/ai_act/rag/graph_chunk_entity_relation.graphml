      <data key="d1">category</data>
      <data key="d2">High-Risk AI System Authorization is the approval process required for deploying high-risk AI systems, ensuring they comply with safety regulations.</data>
      <data key="d3">chunk-e07ee6b3452d764ccd9733dceadb1ac7</data>
      <data key="d4">./cached_docs/article_46.json</data>
      <data key="d5">1783934425</data>
    </node>
    <node id="Operational Data">
      <data key="d0">Operational Data</data>
      <data key="d1">category</data>
      <data key="d2">Operational Data refers to sensitive information pertaining to the activities of law enforcement authorities that is excluded from certain obligations.</data>
