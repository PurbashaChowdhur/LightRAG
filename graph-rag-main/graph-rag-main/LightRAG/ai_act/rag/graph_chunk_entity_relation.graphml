    <node id="Social and Environmental Well-Being">
      <data key="d0">Social and Environmental Well-Being</data>
      <data key="d1">category</data>
      <data key="d2">Social and environmental well-being emphasizes the sustainable and beneficial use of AI technologies for society and the environment.</data>
      <data key="d3">chunk-849f8f0403e6b12fa8a9c24b84c094c7</data>
