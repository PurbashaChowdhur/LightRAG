      <data key="d5">1783936278</data>
    </node>
    <node id="Transparency">
      <data key="d0">Transparency</data>
      <data key="d1">category</data>
      <data key="d2">Transparency in AI refers to the need for traceability and explainability in AI systems, ensuring users are informed about their interaction with AI.&lt;SEP&gt;Transparency refers to the practice of openly sharing information, ensuring that the processes and data are accessible and understandable.&lt;SEP&gt;Transparency is essential in the deployment of High-Risk AI Systems, involving clear communication of their functioning and potential risks to stakeholders.</data>
      <data key="d3">chunk-849f8f0403e6b12fa8a9c24b84c094c7&lt;SEP&gt;chunk-9685a1f72e235a3f5b9ee69878eedb21&lt;SEP&gt;chunk-769497b509433ed0e4746ff50bbdec69</data>
