    <node id="Health Sector">
      <data key="d0">Health Sector</data>
      <data key="d1">category</data>
      <data key="d2">The Health Sector includes all services and entities involved in the delivery of healthcare and medical data, emphasizing the importance of AI in improving health outcomes.&lt;SEP&gt;The health sector encompasses organizations and systems involved in medical care and health services where the stakes for life and health are critical.</data>
      <data key="d3">chunk-8eae051373e28d701c4893438950556b&lt;SEP&gt;chunk-18cf1aa30864348514b20fe64038fba8</data>
