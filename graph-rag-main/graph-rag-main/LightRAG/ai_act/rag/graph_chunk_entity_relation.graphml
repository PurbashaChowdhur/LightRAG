    <node id="High-Risk AI Systems Reporting">
      <data key="d0">High-Risk AI Systems Reporting</data>
      <data key="d1">event</data>
      <data key="d2">High-Risk AI Systems Reporting refers to the mandated process through which providers report serious incidents related to AI systems to authorities.</data>
      <data key="d3">chunk-0dc307b8b7cb1f0e39aa9b4b1839c408</data>
      <data key="d4">./cached_docs/article_73.json</data>
      <data key="d5">1783934445</data>
    </node>
    <node id="Causal Link">
      <data key="d0">Causal Link</data>
      <data key="d1">category</data>
      <data key="d2">Causal Link describes the necessary connection established between a high-risk AI system and a serious incident, which is critical for reporting.</data>
      <data key="d3">chunk-0dc307b8b7cb1f0e39aa9b4b1839c408</data>
      <data key="d4">./cached_docs/article_73.json</data>
