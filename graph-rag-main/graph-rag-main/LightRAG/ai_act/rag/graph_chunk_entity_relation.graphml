      <data key="d11">1783935821</data>
    </edge>
    <edge source="Provider" target="Authorised Representative">
      <data key="d6">24.0</data>
      <data key="d7">"The authorised representative acts on behalf of the provider to fulfill regulatory obligations."}&lt;SEP&gt;The Authorised Representative is appointed by the Provider to manage regulatory interactions and compliance issues.&lt;SEP&gt;The Provider must appoint an Authorised Representative who will act on their behalf to fulfill compliance obligations in the Union Market.</data>
      <data key="d8">compliance,compliance management,compliance representation,regulatory responsibility,representation</data>
      <data key="d9">chunk-f77911358a1d821f6b1731fac6d2dbd6&lt;SEP&gt;chunk-e7d62750f1113d24ac155fcd2b2ef02c&lt;SEP&gt;chunk-b567607dbb431b0d294cd02679760039</data>
