    <node id="Sandbox Experimentation">
      <data key="d0">Sandbox Experimentation</data>
      <data key="d1">event</data>
      <data key="d2">Sandbox experimentation refers to controlled environments where innovative AI systems can be tested with personal data under specific regulatory conditions.</data>
      <data key="d3">chunk-800752b66b6fe0cd70bb0290efc2fbbe</data>
