      <data key="d5">1783935558</data>
    </node>
    <node id="End of 2030">
      <data key="d0">End of 2030</data>
      <data key="d1">event</data>
      <data key="d2">The End of 2030 is the deadline set for operators of certain AI systems to ensure compliance with the requirements outlined in the Regulation.</data>
      <data key="d3">chunk-5b8c1122e1044e4445aa96d7fa6d5b6e</data>
      <data key="d4">./cached_docs/recital_177.json</data>
      <data key="d5">1783934983</data>
    </node>
