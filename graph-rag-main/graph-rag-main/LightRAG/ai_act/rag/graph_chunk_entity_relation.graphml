    <node id="exceptional fall back solution">
      <data key="d0">exceptional fall back solution</data>
      <data key="d1">category</data>
      <data key="d2">An exceptional fall back solution refers to a backup method or strategy implemented to ensure compliance with regulations when standardisation requests are not met.</data>
