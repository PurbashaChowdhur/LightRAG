    <node id="Annex VI">
      <data key="d0">Annex VI</data>
      <data key="d1">category</data>
      <data key="d2">Annex VI addresses internal control mechanisms for conformity assessment procedures aimed at minimizing risks associated with high-risk AI systems.&lt;SEP&gt;Annex VI details the internal control procedures for assessing high-risk AI systems that do not require a notified body.</data>
      <data key="d3">chunk-69838403e8b59bb122436a0d25a9fc1e&lt;SEP&gt;chunk-41e5d20a8e9427a4698b84f758676994</data>
      <data key="d4">./cached_docs/article_43.json</data>
      <data key="d5">1783935556</data>
    </node>
    <node id="Annex VII">
      <data key="d0">Annex VII</data>
      <data key="d1">category</data>
      <data key="d2">Annex VII outlines the language and communication standards for certificates issued by notified bodies in the EU context.&lt;SEP&gt;Annex VII outlines the procedures and requirements related to the conformity assessment of high-risk AI systems in the regulatory framework.&lt;SEP&gt;Annex VII specifies conformity assessment procedures involving a notified body for high-risk AI systems under specific conditions.&lt;SEP&gt;Annex VII specifies the conformity assessment procedure that high-risk AI systems must undergo before being placed on the market or in service.&lt;SEP&gt;Annex VII refers to a specific section within EU regulations that outlines the requirements for technical documentation assessments and quality management system approvals.</data>
      <data key="d3">chunk-69838403e8b59bb122436a0d25a9fc1e&lt;SEP&gt;chunk-6c72b31b17ef0accd3df4ab25a063163&lt;SEP&gt;chunk-41e5d20a8e9427a4698b84f758676994&lt;SEP&gt;chunk-f2a5e7031602556ef7d57e2811f58992&lt;SEP&gt;chunk-397d6e2474c4f45e883f265653f2e715</data>
      <data key="d4">./cached_docs/article_45.json&lt;SEP&gt;./cached_docs/article_44.json&lt;SEP&gt;./cached_docs/article_43.json</data>
      <data key="d5">1783936324</data>
    </node>
    <node id="Article 40">
      <data key="d0">Article 40</data>
      <data key="d1">category</data>
      <data key="d2">Article 40 refers to the harmonised standards applicable to the demonstration of compliance for high-risk AI systems.</data>
      <data key="d3">chunk-69838403e8b59bb122436a0d25a9fc1e</data>
      <data key="d4">./cached_docs/article_43.json</data>
      <data key="d5">1783935556</data>
    </node>
    <node id="Article 41">
      <data key="d0">Article 41</data>
      <data key="d1">category</data>
      <data key="d2">Article 41 refers to common specifications relevant for assessing high-risk AI systems where harmonised standards may not exist.</data>
