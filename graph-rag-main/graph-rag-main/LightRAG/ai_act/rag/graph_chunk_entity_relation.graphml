      <data key="d5">1783934136</data>
    </node>
    <node id="Diversity, Non-discrimination and Fairness">
      <data key="d0">Diversity, Non-discrimination and Fairness</data>
      <data key="d1">category</data>
      <data key="d2">This principle promotes equal access and aims to prevent discriminatory impacts in AI systems development and use.</data>
      <data key="d3">chunk-256a6003a5841f2764536c55f7086431</data>
      <data key="d4">./cached_docs/recital_27.json</data>
      <data key="d5">1783934136</data>
    </node>
    <node id="Societal and Environmental Well-being">
      <data key="d0">Societal and Environmental Well-being</data>
      <data key="d1">category</data>
      <data key="d2">Societal and environmental well-being ensures that AI operates sustainably and considers the long-term impacts on society.</data>
      <data key="d3">chunk-256a6003a5841f2764536c55f7086431</data>
