      <data key="d0">Environmental Sustainability</data>
      <data key="d1">category</data>
      <data key="d2">Environmental Sustainability focuses on assessing and minimizing the impact of AI systems on the environment, particularly regarding energy use and resource allocation.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240</data>
