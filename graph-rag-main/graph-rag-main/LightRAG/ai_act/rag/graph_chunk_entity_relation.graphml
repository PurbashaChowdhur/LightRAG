    <node id="deep fake">
      <data key="d0">deep fake</data>
      <data key="d1">category</data>
      <data key="d2">Deep fake is a technology involving AI-generated or manipulated content that imitates existing persons, objects, or events to create misleading authenticity.</data>
      <data key="d3">chunk-3266d68b5262e6852cabbe36178dec96</data>
