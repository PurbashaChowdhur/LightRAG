    </node>
    <node id="Authorised Representatives">
      <data key="d0">Authorised Representatives</data>
      <data key="d1">category</data>
      <data key="d2">Authorised Representatives are individuals or entities tasked with ensuring compliance with the regulation on behalf of providers.</data>
