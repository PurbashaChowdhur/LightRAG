      <data key="d0">High-Level Expert Group on Artificial Intelligence (AI HLEG)</data>
      <data key="d1">organization</data>
      <data key="d2">The AI HLEG is an advisory group established by the European Commission to provide guidance on ethical and trustworthy AI development.</data>
      <data key="d3">chunk-3ded1c99cfd152513a4ef07b96a9c5de</data>
      <data key="d4">./cached_docs/recital_7.json</data>
