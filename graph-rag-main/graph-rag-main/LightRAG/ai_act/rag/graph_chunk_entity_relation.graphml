      <data key="d5">1783935589</data>
    </node>
    <node id="Article 47">
      <data key="d0">Article 47</data>
      <data key="d1">category</data>
      <data key="d2">Article 47 mandates the creation of an EU declaration of conformity for high-risk AI systems to confirm compliance with regulations.&lt;SEP&gt;Article 47 outlines requirements for conformity regarding high-risk AI systems in the European Union's regulatory framework.&lt;SEP&gt;Article 47 of Regulation (EU) 2018/1139 outlines additional provisions related to the delegation of acts concerning Artificial Intelligence.</data>
      <data key="d3">chunk-73fd7e801c2d8d41361f6b16b45c6ed0&lt;SEP&gt;chunk-68d6983d829937a84d37118dacc3e39c&lt;SEP&gt;chunk-d7805654ce0fe0d8d9b6ba008562d2aa</data>
      <data key="d4">./cached_docs/article_108.json&lt;SEP&gt;./cached_docs/article_24.json&lt;SEP&gt;./cached_docs/article_16.json</data>
      <data key="d5">1783935589</data>
    </node>
    <node id="Article 48">
      <data key="d0">Article 48</data>
      <data key="d1">category</data>
      <data key="d2">Article 48 details the requirements regarding the affixation of the CE marking to high-risk AI systems and their packaging.</data>
      <data key="d3">chunk-68d6983d829937a84d37118dacc3e39c</data>
      <data key="d4">./cached_docs/article_16.json</data>
