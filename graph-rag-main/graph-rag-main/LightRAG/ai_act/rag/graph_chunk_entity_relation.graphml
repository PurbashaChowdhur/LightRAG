      <data key="d0">EU 2016/679</data>
      <data key="d1">organization</data>
      <data key="d2">Regulation (EU) 2016/679 is a legislative framework that establishes data protection and privacy rights within the European Union.</data>
      <data key="d3">chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="EU 2018/1725">
      <data key="d0">EU 2018/1725</data>
      <data key="d1">organization</data>
      <data key="d2">Regulation (EU) 2018/1725 relates to the protection of personal data processed in relation to the European Union institutions.</data>
      <data key="d3">chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Directive EU 2016/680">
      <data key="d0">Directive EU 2016/680</data>
      <data key="d1">organization</data>
      <data key="d2">Directive (EU) 2016/680 is designed to protect individuals concerning the processing of personal data by competent authorities for criminal matters.</data>
      <data key="d3">chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Data Gaps">
      <data key="d0">Data Gaps</data>
      <data key="d1">category</data>
      <data key="d2">Data gaps refer to the missing or insufficient data that affect compliance with regulations, particularly in the context of high-risk AI systems.</data>
      <data key="d3">chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Training Datasets">
      <data key="d0">Training Datasets</data>
      <data key="d1">category</data>
      <data key="d2">Training datasets are collections of data used to train AI systems, which must be relevant, representative, and error-free.</data>
      <data key="d3">chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Validation Datasets">
      <data key="d0">Validation Datasets</data>
      <data key="d1">category</data>
      <data key="d2">Validation datasets are utilized to validate the performance and accuracy of AI systems during development.</data>
      <data key="d3">chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Testing Datasets">
      <data key="d0">Testing Datasets</data>
      <data key="d1">category</data>
      <data key="d2">Testing datasets are employed to evaluate the effectiveness and reliability of AI systems after their deployment.</data>
      <data key="d3">chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Statistical Properties">
      <data key="d0">Statistical Properties</data>
      <data key="d1">category</data>
      <data key="d2">Statistical properties are the characteristics of data that determine its reliability and usability for AI training and evaluation.&lt;SEP&gt;Statistical properties refer to the characteristics of data sets that determine their representativeness and reliability for training AI systems.</data>
      <data key="d3">chunk-445327adc051facf545b6358f6f01466&lt;SEP&gt;chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/recital_67.json&lt;SEP&gt;./cached_docs/article_10.json</data>
      <data key="d5">1783934740</data>
    </node>
    <node id="Bias Detection">
      <data key="d0">Bias Detection</data>
      <data key="d1">category</data>
      <data key="d2">Bias detection refers to identifying and correcting biases in AI systems to ensure fair outcomes for individuals.</data>
      <data key="d3">chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Pseudonymisation">
      <data key="d0">Pseudonymisation</data>
      <data key="d1">category</data>
      <data key="d2">Pseudonymisation is a data management process that replaces identifiable information in a dataset with artificial identifiers to protect privacy.&lt;SEP&gt;Pseudonymisation is a data management process that replaces personally identifiable information with unique identifiers to enhance privacy.</data>
      <data key="d3">chunk-68df7ac042ba1913236779113868f934&lt;SEP&gt;chunk-a0639a0bd62e8b0bbe41bc1bee4a3098</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Bias Detection and Correction">
      <data key="d0">Bias Detection and Correction</data>
      <data key="d1">category</data>
      <data key="d2">Bias detection and correction involve identifying and mitigating biases in AI systems to ensure fair treatment of individuals.&lt;SEP&gt;Bias detection and correction refers to the methods and practices involved in identifying and rectifying biases in data, especially in the context of processing personal data to ensure fairness and accuracy.</data>
      <data key="d3">chunk-68df7ac042ba1913236779113868f934&lt;SEP&gt;chunk-602b68fe088482c0037845fc0b520c30</data>
      <data key="d4">./cached_docs/article_10.json&lt;SEP&gt;./cached_docs/recital_70.json</data>
      <data key="d5">1783934672</data>
    </node>
    <node id="Technical Limitations">
      <data key="d0">Technical Limitations</data>
      <data key="d1">category</data>
      <data key="d2">Technical limitations refer to constraints that hinder the effective use or re-use of personal data, particularly in ensuring security and privacy.</data>
      <data key="d3">chunk-68df7ac042ba1913236779113868f934</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Security and Privacy-Preserving Measures">
      <data key="d0">Security and Privacy-Preserving Measures</data>
      <data key="d1">category</data>
      <data key="d2">Security and privacy-preserving measures are protocols established to protect personal data from unauthorized access and misuse during processing.</data>
      <data key="d3">chunk-68df7ac042ba1913236779113868f934</data>
      <data key="d4">./cached_docs/article_10.json</data>
      <data key="d5">1783934516</data>
    </node>
    <node id="Records of Processing Activities">
      <data key="d0">Records of Processing Activities</data>
      <data key="d1">category</data>
      <data key="d2">Records of processing activities constitute documentation that outlines how personal data is handled, including purposes and compliance with regulatory requirements.</data>
      <data key="d3">chunk-68df7ac042ba1913236779113868f934</data>
