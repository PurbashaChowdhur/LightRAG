    <node id="Regulations (EU) 2017/745">
      <data key="d0">Regulations (EU) 2017/745</data>
      <data key="d1">event</data>
      <data key="d2">Regulations (EU) 2017/745 establish rules and standards for medical devices within the European Union, contributing to safety and effectiveness assessments.&lt;SEP&gt;Regulations (EU) 2017/745 set forth requirements for medical devices, which include oversight of high-risk AI systems classified as safety components.</data>
      <data key="d3">chunk-1b0c31436f0e7ce27ce5952aa2bf9ae5&lt;SEP&gt;chunk-70555b8168fcbd401cc11093ec15091a</data>
