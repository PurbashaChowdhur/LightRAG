    <node id="Experts on Inequality">
      <data key="d0">Experts on Inequality</data>
      <data key="d1">category</data>
      <data key="d2">Experts on Inequality are professionals specializing in the analysis and resolution of socio-economic disparities and their impacts on society.</data>
      <data key="d3">chunk-c7912c5a4fb8a11a998bec401999088b</data>
