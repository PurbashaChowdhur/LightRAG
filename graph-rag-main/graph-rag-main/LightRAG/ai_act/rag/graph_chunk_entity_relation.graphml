    <node id="Administrative Proceedings">
      <data key="d0">Administrative Proceedings</data>
      <data key="d1">category</data>
      <data key="d2">Administrative proceedings are processes initiated by authorities to address legal and regulatory issues, often separate from criminal investigations.</data>
      <data key="d3">chunk-77ba8e0dd4981bd71dedb04a86b45601</data>
      <data key="d4">./cached_docs/recital_59.json</data>
      <data key="d5">1783934176</data>
    </node>
    <node id="systems">
      <data key="d0">systems</data>
      <data key="d1">category</data>
      <data key="d2">Systems refer to the structured frameworks or processes through which information is obtained, processed, and managed, particularly in the context of legal investigations.</data>
      <data key="d3">chunk-7110d3511298db6faf629e1d559dc5ba</data>
      <data key="d4">./cached_docs/recital_59.json</data>
      <data key="d5">1783934176</data>
    </node>
    <node id="information">
      <data key="d0">information</data>
      <data key="d1">category</data>
      <data key="d2">Information pertains to the data and details that are crucial in understanding and challenging the functioning of systems in legal contexts.</data>
      <data key="d3">chunk-7110d3511298db6faf629e1d559dc5ba</data>
      <data key="d4">./cached_docs/recital_59.json</data>
