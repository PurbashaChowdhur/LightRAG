    </edge>
    <edge source="Member States" target="Socio-Economic Inequalities">
      <data key="d6">8.0</data>
      <data key="d7">Member States encourage AI solutions that aim to tackle Socio-Economic Inequalities.</data>
      <data key="d8">equity,social impact</data>
