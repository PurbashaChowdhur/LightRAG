    <node id="Data Subjects">
      <data key="d0">Data Subjects</data>
      <data key="d1">person</data>
      <data key="d2">Data subjects are individuals whose personal data is being processed, and they hold rights under data protection laws including consent for data usage.&lt;SEP&gt;Data subjects are individuals whose personal data is being processed, having specific rights and protections under data protection laws.</data>
      <data key="d3">chunk-800752b66b6fe0cd70bb0290efc2fbbe&lt;SEP&gt;chunk-f8022b105f5e7e2d0ba74bbe75f31f87</data>
