    </node>
    <node id="Technical Robustness and Safety">
      <data key="d0">Technical Robustness and Safety</data>
      <data key="d1">category</data>
      <data key="d2">Technical robustness and safety refers to the principle ensuring that AI systems are resilient and can handle issues appropriately.</data>
      <data key="d3">chunk-256a6003a5841f2764536c55f7086431</data>
      <data key="d4">./cached_docs/recital_27.json</data>
      <data key="d5">1783934136</data>
    </node>
    <node id="Human Agency and Oversight">
      <data key="d0">Human Agency and Oversight</data>
      <data key="d1">category</data>
      <data key="d2">Human agency and oversight emphasizes that AI should serve people and respect human autonomy and dignity.</data>
      <data key="d3">chunk-256a6003a5841f2764536c55f7086431</data>
