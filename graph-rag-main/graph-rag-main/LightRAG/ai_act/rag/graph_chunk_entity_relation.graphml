    </node>
    <node id="Diversity and Non-Discrimination">
      <data key="d0">Diversity and Non-Discrimination</data>
      <data key="d1">category</data>
      <data key="d2">Diversity and non-discrimination principles advocate for inclusive AI development that promotes equal access and avoids bias.</data>
