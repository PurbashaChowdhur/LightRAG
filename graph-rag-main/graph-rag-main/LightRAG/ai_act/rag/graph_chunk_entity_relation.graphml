    <node id="Diagnostics Systems">
      <data key="d0">Diagnostics Systems</data>
      <data key="d1">category</data>
      <data key="d2">Diagnostics systems are sophisticated technologies aimed at supporting human decisions with regard to health assessments and decisions, requiring high reliability.</data>
      <data key="d3">chunk-18cf1aa30864348514b20fe64038fba8</data>
