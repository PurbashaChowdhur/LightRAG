    <node id="Sensitive Operational Data">
      <data key="d0">Sensitive Operational Data</data>
      <data key="d1">category</data>
      <data key="d2">Sensitive operational data includes confidential information related to the operations of law enforcement authorities and is protected from monitoring protocols.&lt;SEP&gt;Sensitive operational data is linked to criminal prevention or prosecution activities where confidentiality is crucial.</data>
