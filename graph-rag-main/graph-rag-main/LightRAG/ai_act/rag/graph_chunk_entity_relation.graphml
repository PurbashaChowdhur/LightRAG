    <node id="Logs">
      <data key="d0">Logs</data>
      <data key="d1">category</data>
      <data key="d2">Logs are automatically generated records by high-risk AI systems detailing their operation and compliance, which may be requested for review.&lt;SEP&gt;Logs are records generated by high-risk AI systems that document their operation and must be maintained for compliance and monitoring purposes.&lt;SEP&gt;Logs are records generated by AI systems that capture operation data which are crucial for monitoring performance and compliance.&lt;SEP&gt;Logs are records automatically generated by high-risk AI systems that document their operations, usage, and any relevant data for compliance and auditing purposes.</data>
      <data key="d3">chunk-8af2de29a8b78dd2b512b6eb64d912a6&lt;SEP&gt;chunk-2edb4e37d5b6a1ec68d071ea273b4e52&lt;SEP&gt;chunk-c852bda35515c8d5385ef007c8140254&lt;SEP&gt;chunk-e8c5a915dca180e1c423cefa27ea6cd3</data>
