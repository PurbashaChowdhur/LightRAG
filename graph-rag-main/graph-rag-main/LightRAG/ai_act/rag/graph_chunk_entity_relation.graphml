      <data key="d5">1783936281</data>
    </node>
    <node id="Article 30">
      <data key="d0">Article 30</data>
      <data key="d1">event</data>
      <data key="d2">Article 30 outlines the general principles regarding the CE marking requirements within Regulation (EC) No 765/2008.</data>
      <data key="d3">chunk-29241e99bddf5af77eca441d2d8dbc1b</data>
