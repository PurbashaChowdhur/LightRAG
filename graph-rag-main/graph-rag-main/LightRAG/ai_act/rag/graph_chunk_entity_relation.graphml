    <node id="Regulation on AI Models">
      <data key="d0">Regulation on AI Models</data>
      <data key="d1">category</data>
      <data key="d2">The Regulation on AI Models sets compliance obligations for providers of general-purpose AI models, including enforceable measures and penalties.</data>
      <data key="d3">chunk-ae3ab8a3b5c5d0c61e8b99fa718913b0</data>
