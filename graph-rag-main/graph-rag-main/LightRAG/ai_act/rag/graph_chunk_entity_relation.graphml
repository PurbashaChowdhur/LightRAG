    </node>
    <node id="persons">
      <data key="d0">persons</data>
      <data key="d1">person</data>
      <data key="d2">Persons in this context refers to individuals acting as whistleblowers who report infringements of Union law and are afforded protection under the directive.</data>
      <data key="d3">chunk-e74c582b50b1dcae6565f7384ebbe5e1</data>
      <data key="d4">./cached_docs/recital_172.json</data>
