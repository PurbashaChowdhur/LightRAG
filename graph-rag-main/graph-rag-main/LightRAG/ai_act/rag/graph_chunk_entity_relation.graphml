    </node>
    <node id="Article 39">
      <data key="d0">Article 39</data>
      <data key="d1">category</data>
      <data key="d2">Article 39 refers to a specific provision within Regulation (EU) 2018/1725 that discusses the requirements and procedures related to sandbox experimentation.</data>
      <data key="d3">chunk-800752b66b6fe0cd70bb0290efc2fbbe</data>
      <data key="d4">./cached_docs/article_59.json</data>
      <data key="d5">1783934122</data>
