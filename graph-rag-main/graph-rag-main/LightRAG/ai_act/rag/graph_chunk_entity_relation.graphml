    </node>
    <node id="Article 49(1)">
      <data key="d0">Article 49(1)</data>
      <data key="d1">category</data>
      <data key="d2">Article 49(1) outlines the registration obligations that providers of high-risk AI systems must fulfill.</data>
      <data key="d3">chunk-68d6983d829937a84d37118dacc3e39c</data>
