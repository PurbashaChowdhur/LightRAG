      <data key="d0">Oversight Measures</data>
      <data key="d1">category</data>
      <data key="d2">Oversight measures are protocols and procedures developed to ensure that high-risk AI systems are monitored and controlled effectively.</data>
      <data key="d3">chunk-4c4d127e5313d415dd94f6b6761da956</data>
      <data key="d4">./cached_docs/article_14.json</data>
      <data key="d5">1783934336</data>
    </node>
    <node id="Border Control">
      <data key="d0">Border Control</data>
      <data key="d1">category</data>
      <data key="d2">Border Control involves the use of high-risk AI systems that may be subject to verification mandates according to applicable laws.&lt;SEP&gt;Border control refers to the enforcement of regulations and restrictions at national borders, which results in spaces not being publicly accessible.&lt;SEP&gt;Border control includes measures and policies implemented to regulate the movement of people and goods across borders.</data>
      <data key="d3">chunk-4013941d0b165f5643b927164f2ffd1c&lt;SEP&gt;chunk-5644d48de211c02e29152f909c69640b&lt;SEP&gt;chunk-2ed67e673a6fe0a3c79a41bb9102d44b</data>
