      <data key="d5">1783935697</data>
    </node>
    <node id="Obligations on Providers">
      <data key="d0">Obligations on Providers</data>
      <data key="d1">category</data>
      <data key="d2">Obligations on Providers encompass the responsibilities that organizations supplying general-purpose AI models must adhere to in order to comply with regulations.&lt;SEP&gt;Obligations on providers refer to the specific compliance requirements that entities offering general-purpose AI models must follow as part of the regulation.</data>
      <data key="d3">chunk-af991f85166d6ddfbbf84e4a73207d3d&lt;SEP&gt;chunk-ae3ab8a3b5c5d0c61e8b99fa718913b0</data>
