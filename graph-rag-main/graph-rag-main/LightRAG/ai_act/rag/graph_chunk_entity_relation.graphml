      <data key="d5">1783934866</data>
    </node>
    <node id="Judicial Proceedings">
      <data key="d0">Judicial Proceedings</data>
      <data key="d1">event</data>
      <data key="d2">Judicial proceedings are legal actions taken in courts regarding the administrative fines and related matters.</data>
      <data key="d3">chunk-8c31e49eb2274702ec6ced9550f1ca86</data>
      <data key="d4">./cached_docs/article_99.json</data>
      <data key="d5">1783934803</data>
    </node>
    <node id="Organisational Measures">
      <data key="d0">Organisational Measures</data>
      <data key="d1">category</data>
      <data key="d2">Organisational Measures refer to the structures and procedures that deployers must implement to manage the use of AI systems effectively and safely.&lt;SEP&gt;Organisational measures are internal practices and policies put in place by operators to comply with regulatory standards and manage risks effectively.</data>
