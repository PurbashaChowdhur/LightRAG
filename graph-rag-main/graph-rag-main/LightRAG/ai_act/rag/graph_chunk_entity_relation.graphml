      <data key="d1">event</data>
      <data key="d2">Administrative fines for non-compliance are penalties levied against firms or individuals who do not adhere to the stipulated regulations and practices.</data>
      <data key="d3">chunk-e7365f713d09e74d49090cb78cb3e19b</data>
      <data key="d4">./cached_docs/article_99.json</data>
