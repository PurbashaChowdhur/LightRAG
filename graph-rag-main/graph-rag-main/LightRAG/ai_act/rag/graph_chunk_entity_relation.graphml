    <node id="Directive 2014/32/EU">
      <data key="d0">Directive 2014/32/EU</data>
      <data key="d1">event</data>
      <data key="d2">Directive 2014/32/EU is a regulation that deals with the harmonisation of laws related to measuring instruments in the EU.&lt;SEP&gt;Directive 2014/32/EU relates to the harmonisation of laws concerning measuring instruments in the EU.</data>
      <data key="d3">chunk-20ac675fffdeba0fbc242b392d3af8da&lt;SEP&gt;chunk-b4fa1ad79284c6e1a9636113352a8e0f</data>
      <data key="d4">./cached_docs/recital_74.json</data>
      <data key="d5">1783934728</data>
    </node>
    <node id="metrology and benchmarking authorities">
      <data key="d0">metrology and benchmarking authorities</data>
      <data key="d1">organization</data>
      <data key="d2">Metrology and benchmarking authorities are stakeholders involved in the development of measurement standards and methodologies for AI systems.</data>
      <data key="d3">chunk-20ac675fffdeba0fbc242b392d3af8da</data>
      <data key="d4">./cached_docs/recital_74.json</data>
      <data key="d5">1783934728</data>
    </node>
    <node id="Union Law on Legal Metrology">
      <data key="d0">Union Law on Legal Metrology</data>
      <data key="d1">event</data>
      <data key="d2">Union Law on Legal Metrology encompasses regulations and directives that ensure the accuracy and reliability of measurements related to commercial transactions within the EU.</data>
      <data key="d3">chunk-20ac675fffdeba0fbc242b392d3af8da</data>
      <data key="d4">./cached_docs/recital_74.json</data>
      <data key="d5">1783934728</data>
    </node>
    <node id="State of the Art">
      <data key="d0">State of the Art</data>
      <data key="d1">category</data>
      <data key="d2">The state of the art refers to the most advanced level of development achieved in a particular field, especially concerning technological capability and standards.</data>
      <data key="d3">chunk-20ac675fffdeba0fbc242b392d3af8da</data>
      <data key="d4">./cached_docs/recital_74.json</data>
      <data key="d5">1783934728</data>
    </node>
    <node id="Directive on Non-Automatic Weighing Instruments">
      <data key="d0">Directive on Non-Automatic Weighing Instruments</data>
      <data key="d1">event</data>
      <data key="d2">This directive pertains to regulations on non-automatic weighing instruments, aiming to ensure consistent standards across member states.</data>
