    <node id="Article 290 TFEU">
      <data key="d0">Article 290 TFEU</data>
      <data key="d1">category</data>
      <data key="d2">Article 290 of the Treaty on the Functioning of the European Union provides the legal basis for the delegation of powers to the European Commission regarding the adoption of certain legislative acts and decisions.</data>
      <data key="d3">chunk-9b7fd511ed97ef1a87c9783c3425b7d4</data>
