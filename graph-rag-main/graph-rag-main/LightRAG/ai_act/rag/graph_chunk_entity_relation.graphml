    <node id="Recital 31">
      <data key="d0">Recital 31</data>
      <data key="d1">event</data>
      <data key="d2">Recital 31 outlines prohibitions related to AI systems evaluating or classifying natural persons based on social behaviors and personality traits.</data>
      <data key="d3">chunk-6ef0a2a22402771842f4d35bbf4be08d</data>
      <data key="d4">./cached_docs/article_5.json</data>
      <data key="d5">1783934531</data>
    </node>
