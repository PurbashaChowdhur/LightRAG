    <node id="individuals">
      <data key="d0">individuals</data>
      <data key="d1">person</data>
      <data key="d2">Individuals in this context refer to the persons whose interests are protected by the laws and regulations within the Union Member States.</data>
      <data key="d3">chunk-3266d68b5262e6852cabbe36178dec96</data>
