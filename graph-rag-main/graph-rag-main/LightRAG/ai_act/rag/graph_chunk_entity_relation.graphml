    </node>
    <node id="authorised representatives">
      <data key="d0">authorised representatives</data>
      <data key="d1">category</data>
      <data key="d2">Authorised representatives have specific obligations in accordance with Article 22, representing entities in legal and regulatory matters.</data>
      <data key="d3">chunk-6e7b8a0eb1cb8c27dfd822da15429870</data>
      <data key="d4">./cached_docs/article_99.json</data>
      <data key="d5">1783934803</data>
    </node>
    <node id="importers">
      <data key="d0">importers</data>
      <data key="d1">category</data>
      <data key="d2">Importers are required to comply with obligations set forth in Article 23, relating to the importation and compliance of products within regulatory frameworks.</data>
      <data key="d3">chunk-6e7b8a0eb1cb8c27dfd822da15429870</data>
      <data key="d4">./cached_docs/article_99.json</data>
      <data key="d5">1783934803</data>
    </node>
    <node id="distributors">
      <data key="d0">distributors</data>
      <data key="d1">category</data>
      <data key="d2">Distributors must adhere to the obligations mentioned in Article 24, which involve ensuring compliance of products they distribute.</data>
      <data key="d3">chunk-6e7b8a0eb1cb8c27dfd822da15429870</data>
      <data key="d4">./cached_docs/article_99.json</data>
      <data key="d5">1783934803</data>
    </node>
    <node id="notified bodies">
      <data key="d0">notified bodies</data>
      <data key="d1">category</data>
      <data key="d2">Notified bodies are organizations designated to assess conformity with regulations for AI systems, ensuring compliance and safety standards.&lt;SEP&gt;Notified bodies must fulfill the requirements and obligations outlined in Article 31, Article 33(1), (3) and (4), or Article 34, acting as compliance verification entities.</data>
      <data key="d3">chunk-6e7b8a0eb1cb8c27dfd822da15429870&lt;SEP&gt;chunk-0461b38c664574f634a78148bfce0336</data>
