    <node id="Copyright Law">
      <data key="d0">Copyright Law</data>
      <data key="d1">category</data>
      <data key="d2">Copyright Law refers to the legal frameworks that protect the rights of creators of original work and regulate the use of their data in AI training.</data>
      <data key="d3">chunk-5c4d08c48923bc3e8bff8968fd67a799</data>
      <data key="d4">./cached_docs/recital_107.json</data>
