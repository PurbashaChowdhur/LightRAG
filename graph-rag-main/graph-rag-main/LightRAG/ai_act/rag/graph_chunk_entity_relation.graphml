    <edge source="Union" target="Rule of Law">
      <data key="d6">9.0</data>
      <data key="d7">The Union advocates for the rule of law, ensuring that AI is used in a manner that complies with legal standards and upholds fundamental rights.</data>
      <data key="d8">legal standards,rights protection</data>
      <data key="d9">chunk-14f663363e3d8f01aa5c0b361bddc380</data>
