      <data key="d0">12.2016</data>
      <data key="d1">date</data>
      <data key="d2">12.2016 is a specific date that might reference an event or context relevant to the text.</data>
      <data key="d3">chunk-fa4b7c7b85b3435f5f316dd1ac957764</data>
