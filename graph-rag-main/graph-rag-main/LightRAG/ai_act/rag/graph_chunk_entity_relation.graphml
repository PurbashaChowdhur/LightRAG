      <data key="d0">Substantial and Imminent Threat</data>
      <data key="d1">category</data>
      <data key="d2">A Substantial and Imminent Threat refers to an urgent risk that necessitates the immediate use of high-risk AI systems by law enforcement or civil protection authorities.</data>
      <data key="d3">chunk-e07ee6b3452d764ccd9733dceadb1ac7</data>
