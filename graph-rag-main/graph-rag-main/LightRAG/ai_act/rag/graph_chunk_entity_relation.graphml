      <data key="d5">1783934170</data>
    </node>
    <node id="remote biometric identification system">
      <data key="d0">remote biometric identification system</data>
      <data key="d1">category</data>
      <data key="d2">A remote biometric identification system identifies individuals from a distance by comparing their biometric data with a reference database.</data>
      <data key="d3">chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="real-time remote biometric identification system">
      <data key="d0">real-time remote biometric identification system</data>
      <data key="d1">technology</data>
      <data key="d2">A real-time remote biometric identification system captures and analyzes biometric data for instant identification without significant delay.&lt;SEP&gt;A real-time remote biometric identification system conducts the complete process of data capturing, comparison, and identification without delays, aside from minor necessary lag.&lt;SEP&gt;Real-time remote biometric identification systems are technologies used for identification purposes in publicly accessible spaces, particularly for law enforcement.&lt;SEP&gt;The real-time remote biometric identification system is a technology used for identification purposes in publicly accessible spaces, subject to legal regulations.&lt;SEP&gt;The real-time remote biometric identification system is used in law enforcement to identify individuals in publicly accessible spaces, requiring judicial or administrative authorization for its use.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-dc0db03f57b007cfc458657e88e273ae&lt;SEP&gt;chunk-1e726a1ef8f481d54c995afc6a028f60&lt;SEP&gt;chunk-b4249f491e5466803d0f267a67c5cb39&lt;SEP&gt;chunk-27c28ab4482e4bec149657c656192c46</data>
      <data key="d4">./cached_docs/recital_35.json&lt;SEP&gt;./cached_docs/article_5.json&lt;SEP&gt;./cached_docs/article_3.json</data>
      <data key="d5">1783935530</data>
    </node>
    <node id="law enforcement authority">
      <data key="d0">law enforcement authority</data>
      <data key="d1">organization</data>
      <data key="d2">A law enforcement authority is a public authority responsible for preventing, investigating, and prosecuting criminal offenses, as well as safeguarding public security.&lt;SEP&gt;Law enforcement authorities are public entities responsible for preventing, investigating, detecting, or prosecuting criminal offenses.&lt;SEP&gt;The law enforcement authority is responsible for the implementation and oversight of the AI system, including the request for necessary authorizations for its use.</data>
      <data key="d3">chunk-1e726a1ef8f481d54c995afc6a028f60&lt;SEP&gt;chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-dc0db03f57b007cfc458657e88e273ae</data>
      <data key="d4">./cached_docs/recital_35.json&lt;SEP&gt;./cached_docs/article_3.json</data>
      <data key="d5">1783935530</data>
    </node>
    <node id="special categories of personal data">
      <data key="d0">special categories of personal data</data>
      <data key="d1">category</data>
      <data key="d2">Special categories of personal data include sensitive information as outlined in relevant EU regulations and directives, providing additional protection.</data>
      <data key="d3">chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="sensitive operational data">
      <data key="d0">sensitive operational data</data>
      <data key="d1">category</data>
      <data key="d2">Sensitive operational data pertains to information collected during law enforcement activities that could impact the integrity of criminal proceedings if disclosed.</data>
      <data key="d3">chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="post remote biometric identification system">
      <data key="d0">post remote biometric identification system</data>
      <data key="d1">category</data>
      <data key="d2">A post remote biometric identification system identifies individuals using biometric data but is not designed for real-time analysis.&lt;SEP&gt;A post remote biometric identification system refers to biometric systems that identify individuals but do not operate in real-time.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="publicly accessible space">
      <data key="d0">publicly accessible space</data>
      <data key="d1">category</data>
      <data key="d2">Publicly accessible space includes any physical area open to the public, which may be subject to specific access conditions or capacity limits.&lt;SEP&gt;Publicly accessible spaces are locations available to the public, which can include both publicly and privately owned places, subject to access conditions.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-1e726a1ef8f481d54c995afc6a028f60</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="serious incident">
      <data key="d0">serious incident</data>
      <data key="d1">event</data>
      <data key="d2">A serious incident refers to significant malfunctions of AI systems that may lead to severe harm, including death or serious injury.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="natural persons">
      <data key="d0">natural persons</data>
      <data key="d1">category</data>
      <data key="d2">Natural persons are individuals who possess specific rights and protections under regulation, distinguishing them from legal persons such as organizations or corporations. They are entitled to receive information about AI-generated content and the associated transparency obligations, as well as being recognized within the legal framework, particularly concerning legal investigations. Moreover, natural persons may be categorized based on their biometric data in relation to the regulation and can be affected by the implementation of high-risk AI systems, thereby implicating their fundamental rights.</data>
      <data key="d3">chunk-ac04e8bc9dd9ff3998ce3c08f3800f57&lt;SEP&gt;chunk-50cb89ed7d0d818018d373ebefa65267&lt;SEP&gt;chunk-41cdee30f8345bc3690d876d77e6845c&lt;SEP&gt;chunk-a94885e0b736d24263914e9a9d565900&lt;SEP&gt;chunk-ee04f6104a24650416810ede28f3790b&lt;SEP&gt;chunk-7110d3511298db6faf629e1d559dc5ba</data>
      <data key="d4">./cached_docs/recital_2.json&lt;SEP&gt;./cached_docs/recital_16.json&lt;SEP&gt;./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/article_50.json&lt;SEP&gt;./cached_docs/recital_96.json&lt;SEP&gt;./cached_docs/recital_59.json</data>
      <data key="d5">1783936149</data>
    </node>
    <node id="biometric data">
      <data key="d0">biometric data</data>
      <data key="d1">category</data>
      <data key="d2">Biometric data encompasses various attributes such as sex, age, hair color, and other identifiers used for categorization in this context.&lt;SEP&gt;Biometric data refers to unique physical or behavioral characteristics used for identification purposes, such as fingerprints or facial recognition.</data>
      <data key="d3">chunk-ac04e8bc9dd9ff3998ce3c08f3800f57&lt;SEP&gt;chunk-a94885e0b736d24263914e9a9d565900</data>
      <data key="d4">./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/recital_16.json</data>
      <data key="d5">1783934220</data>
    </node>
    <node id="reference database">
      <data key="d0">reference database</data>
      <data key="d1">category</data>
      <data key="d2">A reference database is a collection of stored biometric data against which new biometric data can be compared for identification.</data>
      <data key="d3">chunk-a94885e0b736d24263914e9a9d565900</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="European Data Protection Supervisor">
      <data key="d0">European Data Protection Supervisor</data>
      <data key="d1">organization</data>
      <data key="d2">The European Data Protection Supervisor (EDPS) is an independent supervisory authority established to ensure compliance with data protection laws and regulations within the European Union (EU) institutions, bodies, offices, and agencies. Tasked with upholding individuals' rights regarding their personal data, the EDPS plays a crucial role in maintaining data protection standards across the EU. Its responsibilities encompass monitoring the adherence to established data protection laws, imposing fines for violations, and overseeing data protection practices.

The EDPS serves as a market surveillance authority under Regulation (EU) 2016/680, ensuring that EU institutions and agencies comply with data protection regulations. Furthermore, the EDPS has the capability to establish an AI regulatory sandbox, aimed at fostering compliance and innovation in data protection among Union institutions and agencies. Overall, the European Data Protection Supervisor is vital in preserving the integrity of data protection frameworks within the EU.&lt;SEP&gt;The European Data Protection Supervisor is an independent supervisory authority established to ensure that individuals' rights to privacy are respected in the handling of personal data by EU institutions.&lt;SEP&gt;The European Data Protection Supervisor participates as an observer in the Board's activities, focusing on data protection issues.</data>
      <data key="d3">chunk-472b03a027e3fcae21e86e23849e4510&lt;SEP&gt;chunk-7e28e08bfb7b1ae3208e2c91ea6f1e4e&lt;SEP&gt;chunk-bc8a3a685818e1a12850434d4ddcb5cb&lt;SEP&gt;chunk-72cfde8a7c3c94fdf1dc93c4253bec9e&lt;SEP&gt;chunk-1b43f399350f0fc36795c0ce358459d9&lt;SEP&gt;chunk-5da2f6b1c2fa5619efa26719534e9c35&lt;SEP&gt;chunk-d42aaf56c15be020feabced14d2409d7&lt;SEP&gt;chunk-475967c83e624bc711a9ff13e8150163&lt;SEP&gt;chunk-c0711090702fd9b1787822998d5deac9&lt;SEP&gt;chunk-0271020749ae70ce56cbd607a6f6662a&lt;SEP&gt;chunk-828a2d9070cae319b764e3b609bc9b81&lt;SEP&gt;chunk-111c71f234a0f2d1b26490907acae6eb&lt;SEP&gt;chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d&lt;SEP&gt;chunk-8da189e7622be67a80b2e12945a657cb</data>
      <data key="d4">./cached_docs/article_58.json&lt;SEP&gt;./cached_docs/recital_168.json&lt;SEP&gt;./cached_docs/article_74.json&lt;SEP&gt;./cached_docs/article_70.json&lt;SEP&gt;./cached_docs/recital_156.json&lt;SEP&gt;./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/article_65.json&lt;SEP&gt;./cached_docs/article_100.json&lt;SEP&gt;./cached_docs/article_57.json&lt;SEP&gt;./cached_docs/recital_180.json</data>
      <data key="d5">1783936061</data>
    </node>
    <node id="Serious Incident">
      <data key="d0">Serious Incident</data>
      <data key="d1">category</data>
      <data key="d2">A Serious Incident encompasses any significant disruption or malfunction of artificial intelligence (AI) systems that results in serious harm, health risks, or impacts on critical infrastructure. It refers to events arising from the utilization of AI models that require tracking and reporting by providers to ensure accountability and safety. Serious Incidents denote any notable failures or issues linked to high-risk AI systems that affect safety or compliance and necessitate prompt reporting and investigation by the responsible entities. Furthermore, they include any significant problems identified during the deployment or testing of high-risk AI systems that must be reported to relevant authorities for further action.&lt;SEP&gt;Serious incidents are significant issues reported during the testing of AI systems that may lead to regulatory action.</data>
      <data key="d3">chunk-6f6e14583352886a741ac1d51eada03a&lt;SEP&gt;chunk-1b0c31436f0e7ce27ce5952aa2bf9ae5&lt;SEP&gt;chunk-447d51c65bac6d28fd62c36c3e70e08b&lt;SEP&gt;chunk-0dc307b8b7cb1f0e39aa9b4b1839c408&lt;SEP&gt;chunk-78dcdae0f5d22df28405d8ae03e038d0&lt;SEP&gt;chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d&lt;SEP&gt;chunk-43a1516ad8d48077af0d59fc01578f33</data>
      <data key="d4">./cached_docs/article_76.json&lt;SEP&gt;./cached_docs/article_60.json&lt;SEP&gt;./cached_docs/article_26.json&lt;SEP&gt;./cached_docs/article_73.json&lt;SEP&gt;./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/recital_115.json</data>
      <data key="d5">1783936287</data>
    </node>
    <node id="Non-Personal Data">
      <data key="d0">Non-Personal Data</data>
      <data key="d1">category</data>
      <data key="d2">Non-Personal Data refers to any data that does not relate to an identified or identifiable individual, as defined in data protection regulations.</data>
      <data key="d3">chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="Real-World Testing Plan">
      <data key="d0">Real-World Testing Plan</data>
      <data key="d1">event</data>
      <data key="d2">A real-world testing plan is a strategic outline submitted by AI developers detailing how they intend to conduct their testing in practical environments while adhering to regulations.&lt;SEP&gt;The Real-World Testing Plan outlines the objectives and methods for testing AI systems in actual conditions.&lt;SEP&gt;The real-world testing plan is a detailed outline that providers must submit to authorize the testing of high-risk AI systems in real-world environments.&lt;SEP&gt;The real-world testing plan is a documented strategy submitted by providers to detail how they will conduct testing of AI systems under actual conditions.</data>
      <data key="d3">chunk-f8022b105f5e7e2d0ba74bbe75f31f87&lt;SEP&gt;chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d&lt;SEP&gt;chunk-aa9e2916955e882c73231ed69851f6ec&lt;SEP&gt;chunk-ff61ec794793cf787d4a0473487a06f3</data>
      <data key="d4">./cached_docs/recital_141.json&lt;SEP&gt;./cached_docs/article_60.json&lt;SEP&gt;./cached_docs/article_3.json</data>
      <data key="d5">1783935794</data>
    </node>
    <node id="Sandbox Plan">
      <data key="d0">Sandbox Plan</data>
      <data key="d1">category</data>
      <data key="d2">A Sandbox Plan outlines the specific activities and timelines for developing, testing, and validating AI systems within a regulatory sandbox.&lt;SEP&gt;A sandbox plan is a framework for testing innovative systems like AI under controlled conditions to assess their effectiveness and compliance.&lt;SEP&gt;The Sandbox Plan is a document that lays out objectives and methodology for activities in a controlled testing environment for AI systems.</data>
      <data key="d3">chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d&lt;SEP&gt;chunk-475967c83e624bc711a9ff13e8150163&lt;SEP&gt;chunk-0c9405f93ec3e0ccf6209ed15ef0263f</data>
      <data key="d4">./cached_docs/article_57.json&lt;SEP&gt;./cached_docs/article_3.json</data>
      <data key="d5">1783934261</data>
    </node>
    <node id="National Competent Authority">
      <data key="d0">National Competent Authority</data>
      <data key="d1">organization</data>
      <data key="d2">National Competent Authorities are designated bodies that oversee the implementation of specific regulations in their respective countries, providing guidance and enforcing compliance.&lt;SEP&gt;National Competent Authorities are designated organizations in the EU responsible for notifying and monitoring compliance with regulations related to AI systems.&lt;SEP&gt;The National Competent Authority is a regulatory body in member states of the European Union responsible for ensuring compliance with EU directives and regulations regarding AI systems and other technologies.&lt;SEP&gt;National competent authorities are the official bodies responsible for overseeing the implementation and compliance of regulations related to AI systems within their jurisdictions.&lt;SEP&gt;The National Competent Authority is an organization responsible for overseeing the validity of certificates related to designated systems in member states.</data>
      <data key="d3">chunk-c17bf6e803eec807c9fc7299d71d51d6&lt;SEP&gt;chunk-0271020749ae70ce56cbd607a6f6662a&lt;SEP&gt;chunk-85bb41c1db2d2e1883172e505d5f7b71&lt;SEP&gt;chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d&lt;SEP&gt;chunk-b341fa074527a308a2434a3c68244d02</data>
      <data key="d4">./cached_docs/article_58.json&lt;SEP&gt;./cached_docs/article_36.json&lt;SEP&gt;./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/article_16.json&lt;SEP&gt;./cached_docs/article_57.json</data>
      <data key="d5">1783935839</data>
    </node>
    <node id="Critical Infrastructure">
      <data key="d0">Critical Infrastructure</data>
      <data key="d1">category</data>
      <data key="d2">Critical Infrastructure refers to essential systems and assets that are crucial for the functioning of a society and its economy. These systems are vital to national and public safety, and their failure or disruption could significantly impact public safety and basic supplies. As defined by relevant directives in the European Union context, critical infrastructure encompasses both physical and virtual components. It is imperative to protect these infrastructures from serious incidents, disruptions, and vulnerabilities, including those that may arise from advances in technology, such as artificial intelligence. Overall, critical infrastructure includes a wide range of services and systems that are integral to maintaining societal order and wellbeing.</data>
      <data key="d3">chunk-54948128ea5a4b84a219d7dbaa346a50&lt;SEP&gt;chunk-0c9405f93ec3e0ccf6209ed15ef0263f&lt;SEP&gt;chunk-ec6a8294e2a2ad2569029d260c4d7673&lt;SEP&gt;chunk-b3f46abe104a1bdb0fae1c25094db36d&lt;SEP&gt;chunk-a23e03a78af2035b69e69bd4fc65a435&lt;SEP&gt;chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d</data>
      <data key="d4">./cached_docs/recital_33.json&lt;SEP&gt;./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/recital_55.json&lt;SEP&gt;./cached_docs/recital_110.json&lt;SEP&gt;./cached_docs/recital_155.json</data>
      <data key="d5">1783936195</data>
    </node>
    <node id="AI Governance">
      <data key="d0">AI Governance</data>
      <data key="d1">category</data>
      <data key="d2">AI Governance refers to the frameworks and regulations designed to ensure responsible development and deployment of AI technologies.</data>
      <data key="d3">chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="Personal Data Protection">
      <data key="d0">Personal Data Protection</data>
      <data key="d1">category</data>
      <data key="d2">Personal Data Protection involves laws and practices designed to safeguard individuals' personal information from misuse and unauthorized access.&lt;SEP&gt;Personal Data Protection involves regulations and practices designed to protect individual privacy and manage personal information.&lt;SEP&gt;Personal Data Protection involves strategies and measures taken to safeguard personal information from misuse or theft.</data>
      <data key="d3">chunk-d42aaf56c15be020feabced14d2409d7&lt;SEP&gt;chunk-cfc036b3a79fdcd1eb36c0af6aafbb4d&lt;SEP&gt;chunk-8d7d6f2dd7e28584da10fdb340b37fd0</data>
      <data key="d4">./cached_docs/recital_54.json&lt;SEP&gt;./cached_docs/article_70.json&lt;SEP&gt;./cached_docs/article_3.json</data>
      <data key="d5">1783935578</data>
    </node>
    <node id="AI regulatory sandbox">
      <data key="d0">AI regulatory sandbox</data>
      <data key="d1">category</data>
      <data key="d2">An AI regulatory sandbox is a controlled framework established by a competent authority that allows for the development and testing of AI systems under regulatory supervision.</data>
      <data key="d3">chunk-fe76292b9a553c383dab6b0a4a67cee8</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="non-personal data">
      <data key="d0">non-personal data</data>
      <data key="d1">category</data>
      <data key="d2">Non-personal data refers to information that does not relate to an identified or identifiable individual, distinguishing it from personal data.</data>
      <data key="d3">chunk-fe76292b9a553c383dab6b0a4a67cee8</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="real-world testing plan">
      <data key="d0">real-world testing plan</data>
      <data key="d1">category</data>
      <data key="d2">A real-world testing plan outlines the objectives and methodologies for testing AI systems in real-world conditions to gather reliable data.</data>
      <data key="d3">chunk-fe76292b9a553c383dab6b0a4a67cee8</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="sandbox plan">
      <data key="d0">sandbox plan</data>
      <data key="d1">category</data>
      <data key="d2">A sandbox plan is a documented agreement that specifies the conditions and objectives for activities carried out within the regulatory sandbox.</data>
      <data key="d3">chunk-fe76292b9a553c383dab6b0a4a67cee8</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="competent authority">
      <data key="d0">competent authority</data>
      <data key="d1">organization</data>
      <data key="d2">A competent authority is a designated body that oversees the implementation of regulations and can establish frameworks like the AI regulatory sandbox to enable innovation under controlled conditions.</data>
      <data key="d3">chunk-fe76292b9a553c383dab6b0a4a67cee8</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="fundamental rights">
      <data key="d0">fundamental rights</data>
      <data key="d1">category</data>
      <data key="d2">Fundamental rights include a range of legal protections such as dignity, freedom of expression, and rights related to education and non-discrimination.&lt;SEP&gt;Fundamental rights refer to the basic human rights and freedoms that are protected under Union law, which AI systems must respect.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611&lt;SEP&gt;chunk-fe76292b9a553c383dab6b0a4a67cee8</data>
      <data key="d4">./cached_docs/recital_48.json&lt;SEP&gt;./cached_docs/article_3.json</data>
      <data key="d5">1783936047</data>
    </node>
    <node id="real-world conditions">
      <data key="d0">real-world conditions</data>
      <data key="d1">category</data>
      <data key="d2">Real-world conditions pertain to the actual environment outside of controlled settings where AI systems are tested to ensure their effectiveness and safety.</data>
      <data key="d3">chunk-fe76292b9a553c383dab6b0a4a67cee8</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="informed consent">
      <data key="d0">informed consent</data>
      <data key="d1">category</data>
      <data key="d2">Informed consent is the process by which participants in testing or data collection give their explicit agreement, understanding the risks and implications.&lt;SEP&gt;Informed consent refers to the process of ensuring that participants in the testing of AI systems are fully aware of and agree to the testing procedures and implications.</data>
      <data key="d3">chunk-fe76292b9a553c383dab6b0a4a67cee8&lt;SEP&gt;chunk-675b49fdde07175ec9a1afb693d1d877</data>
      <data key="d4">./cached_docs/article_60.json&lt;SEP&gt;./cached_docs/article_3.json</data>
      <data key="d5">1783935797</data>
    </node>
    <node id="profiling">
      <data key="d0">profiling</data>
      <data key="d1">category</data>
      <data key="d2">Profiling refers to the automated processing of personal data to evaluate certain personal aspects of a person, which needs to be conducted in compliance with regulations.</data>
      <data key="d3">chunk-fe76292b9a553c383dab6b0a4a67cee8</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="critical infrastructure">
      <data key="d0">critical infrastructure</data>
      <data key="d1">category</data>
      <data key="d2">Critical infrastructure encompasses essential systems and assets necessary for a country’s security, economy, public health, or safety.&lt;SEP&gt;Critical infrastructure encompasses key assets necessary for the functioning of society and the economy, defined under EU law.&lt;SEP&gt;Critical infrastructure involves essential systems and assets whose disruption would have a significant impact on public health, safety, or security.&lt;SEP&gt;Critical infrastructure involves the essential systems and assets, such as transport, energy, and communication systems, that require special consideration in the regulation of high-risk AI systems.</data>
      <data key="d3">chunk-2806e288e0b71013209c4ad85ecaa38b&lt;SEP&gt;chunk-d91755cda6acde2b40257e6d4cef1695&lt;SEP&gt;chunk-fe76292b9a553c383dab6b0a4a67cee8&lt;SEP&gt;chunk-3266d68b5262e6852cabbe36178dec96</data>
      <data key="d4">./cached_docs/recital_33.json&lt;SEP&gt;./cached_docs/recital_131.json&lt;SEP&gt;./cached_docs/article_3.json</data>
      <data key="d5">1783935020</data>
    </node>
    <node id="AI Literacy">
      <data key="d0">AI Literacy</data>
      <data key="d1">category</data>
      <data key="d2">AI Literacy refers to the understanding, awareness, and skillset necessary for individuals and stakeholders to effectively engage with artificial intelligence (AI) technology. It encompasses a comprehensive understanding of the applications, benefits, risks, and implications of AI, ensuring that users can operate and utilize AI systems responsibly and effectively. AI Literacy is essential for those involved in the development and use of AI, as it enables them to grasp best practices and make informed decisions that comply with fundamental rights and safety standards. Additionally, it emphasizes the importance of educating the public about the opportunities and risks associated with AI systems, an initiative that the European Union aims to promote. Overall, AI Literacy is critical for fostering responsible deployment and utilization of AI in society.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240&lt;SEP&gt;chunk-0c9405f93ec3e0ccf6209ed15ef0263f&lt;SEP&gt;chunk-1a77d0693b936376b7e0f7b222210759&lt;SEP&gt;chunk-8462fb6c49f462e0c2199ce80842ebde&lt;SEP&gt;chunk-00e7606a0fa9d588f18d67d02cfcf654&lt;SEP&gt;chunk-98532c431ec75ae38c76dc0730337a16&lt;SEP&gt;chunk-21acb22d994b8f65ea3709a99eb85032</data>
      <data key="d4">./cached_docs/recital_20.json&lt;SEP&gt;./cached_docs/article_4.json&lt;SEP&gt;./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/article_95.json&lt;SEP&gt;./cached_docs/article_66.json</data>
      <data key="d5">1783936098</data>
    </node>
    <node id="Informed Consent">
      <data key="d0">Informed Consent</data>
      <data key="d1">category</data>
      <data key="d2">Informed consent is the process by which individuals are made aware of the specifics of the testing and agree to participate voluntarily.&lt;SEP&gt;Informed consent is the voluntary agreement of a subject to participate in testing after being fully informed of relevant aspects.&lt;SEP&gt;Informed consent refers to the agreement obtained from subjects to participate in testing, ensuring they are fully informed of the process and implications.&lt;SEP&gt;Informed consent refers to the process of obtaining voluntary agreement from individuals before participating in testing of AI systems, crucial for ethical guidelines.&lt;SEP&gt;Informed consent refers to the voluntary agreement of participants to engage in testing, allowing them to withdraw their consent and request deletion of personal data.</data>
      <data key="d3">chunk-6f6e14583352886a741ac1d51eada03a&lt;SEP&gt;chunk-0c9405f93ec3e0ccf6209ed15ef0263f&lt;SEP&gt;chunk-4518ca313d8493e277775e1a9267b84d&lt;SEP&gt;chunk-f8022b105f5e7e2d0ba74bbe75f31f87&lt;SEP&gt;chunk-ba5a4fee300868ea16940c9ea15f534a</data>
      <data key="d4">./cached_docs/recital_141.json&lt;SEP&gt;./cached_docs/article_3.json&lt;SEP&gt;./cached_docs/article_60.json&lt;SEP&gt;./cached_docs/article_61.json</data>
      <data key="d5">1783935797</data>
    </node>
    <node id="Deep Fake">
      <data key="d0">Deep Fake</data>
      <data key="d1">category</data>
      <data key="d2">Deep fake refers to AI-generated images, audio, or video that misrepresent individuals or events, appearing authentic or truthful.</data>
      <data key="d3">chunk-0c9405f93ec3e0ccf6209ed15ef0263f</data>
      <data key="d4">./cached_docs/article_3.json</data>
      <data key="d5">1783934170</data>
    </node>
    <node id="Widespread Infringement">
      <data key="d0">Widespread Infringement</data>
      <data key="d1">event</data>
      <data key="d2">Widespread Infringement refers to significant violations concerning high-risk AI systems that necessitate immediate reporting protocols.&lt;SEP&gt;Widespread infringement involves acts contravening Union law that may cause harm to individuals across multiple Member States.</data>
      <data key="d3">chunk-0dc307b8b7cb1f0e39aa9b4b1839c408&lt;SEP&gt;chunk-0c9405f93ec3e0ccf6209ed15ef0263f</data>
