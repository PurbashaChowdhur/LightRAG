    </node>
    <node id="Accountability">
      <data key="d0">Accountability</data>
      <data key="d1">category</data>
      <data key="d2">Accountability focuses on ensuring that those responsible for AI systems can be held liable for their decisions and impacts.</data>
      <data key="d3">chunk-256a6003a5841f2764536c55f7086431</data>
      <data key="d4">./cached_docs/recital_27.json</data>
      <data key="d5">1783934136</data>
    </node>
    <node id="AI Ethics Guidelines">
      <data key="d0">AI Ethics Guidelines</data>
      <data key="d1">event</data>
      <data key="d2">The AI Ethics Guidelines refer to the set of principles and rules established to ensure the ethical development and use of artificial intelligence technologies.</data>
