    </node>
    <node id="Regulations (EU) 2019/1020">
      <data key="d0">Regulations (EU) 2019/1020</data>
      <data key="d1">event</data>
      <data key="d2">Regulations (EU) 2019/1020 establish rules for market surveillance concerning products, including the handling of notifications related to serious incidents of AI systems in the European market.</data>
      <data key="d3">chunk-1b0c31436f0e7ce27ce5952aa2bf9ae5</data>
      <data key="d4">./cached_docs/article_73.json</data>
      <data key="d5">1783934447</data>
    </node>
    <node id="Article 3">
      <data key="d0">Article 3</data>
      <data key="d1">event</data>
      <data key="d2">Article 3 of Regulation (EU) 2019/1020 specifies definitions and key terms related to high-risk AI systems, including the notification requirements for serious incidents.&lt;SEP&gt;Article 3 outlines specific obligations and procedures related to the reporting of serious incidents in AI systems within the regulatory framework.</data>
      <data key="d3">chunk-a0779dfb4a5c0f82f05a67985fe0224a&lt;SEP&gt;chunk-1b0c31436f0e7ce27ce5952aa2bf9ae5</data>
      <data key="d4">./cached_docs/article_73.json</data>
      <data key="d5">1783934447</data>
    </node>
