    <node id="AI Providers">
      <data key="d0">AI Providers</data>
      <data key="d1">organization</data>
      <data key="d2">AI Providers are organizations or entities that develop and supply AI models, responsible for ensuring compliance with copyright and transparency regulations.</data>
      <data key="d3">chunk-5c4d08c48923bc3e8bff8968fd67a799</data>
