    <node id="Digital Components">
      <data key="d0">Digital Components</data>
      <data key="d1">category</data>
      <data key="d2">Digital components refer to the electronic parts of products that may include AI systems, which pose safety risks if not properly managed.</data>
      <data key="d3">chunk-18cf1aa30864348514b20fe64038fba8</data>
