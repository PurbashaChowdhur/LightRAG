    <node id="Voluntary Best Practices">
      <data key="d0">Voluntary Best Practices</data>
      <data key="d1">category</data>
      <data key="d2">Voluntary Best Practices are established methods or techniques in a particular field that are recommended but not mandatory for adherence.</data>
