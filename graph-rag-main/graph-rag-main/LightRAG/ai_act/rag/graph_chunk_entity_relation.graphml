    <node id="Recommendation 2003/361/EC">
      <data key="d0">Recommendation 2003/361/EC</data>
      <data key="d1">category</data>
      <data key="d2">Recommendation 2003/361/EC is a European Union guideline that defines the criteria for microenterprises and the applicable quality management requirements.&lt;SEP&gt;Recommendation 2003/361/EC provides the definition of micro- and small enterprises to inform the assessment of administrative burdens.</data>
      <data key="d3">chunk-d1d974005cd87fc21678c732472ee11a&lt;SEP&gt;chunk-6e4f07f79ad3c90c82b86c0a02d0fae9</data>
