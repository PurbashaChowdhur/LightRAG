    <node id="Personal Assistance">
      <data key="d0">Personal Assistance</data>
      <data key="d1">category</data>
      <data key="d2">Personal assistance refers to supportive services provided by technologies or systems to help individuals in daily tasks and activities, with safety implications.</data>
      <data key="d3">chunk-18cf1aa30864348514b20fe64038fba8</data>
