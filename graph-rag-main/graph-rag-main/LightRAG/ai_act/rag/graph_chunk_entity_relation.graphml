    <node id="European Economic and Social Committee">
      <data key="d0">European Economic and Social Committee</data>
      <data key="d1">organization</data>
      <data key="d2">The European Economic and Social Committee is an advisory body of the EU that will be informed about the enforcement assessments of AI regulations.&lt;SEP&gt;The European Economic and Social Committee is an advisory body that provides opinions on economic and social matters affecting EU policy.</data>
      <data key="d3">chunk-b71cdb20a8fa5befb7c30c90163cd416&lt;SEP&gt;chunk-7a69b68c9998277692ac6c6341fcdcac</data>
