    <node id="AI Developers">
      <data key="d0">AI Developers</data>
      <data key="d1">category</data>
      <data key="d2">AI Developers are individuals or teams who create and advance artificial intelligence technologies and applications.</data>
      <data key="d3">chunk-c7912c5a4fb8a11a998bec401999088b</data>
