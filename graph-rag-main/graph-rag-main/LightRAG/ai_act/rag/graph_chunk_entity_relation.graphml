    <edge source="Commission" target="Council of the European Union">
      <data key="d6">8.0</data>
      <data key="d7">The Council oversees the actions of the Commission and ensures compliance with EU regulations in conjunction with member states.</data>
      <data key="d8">executive oversight,governance</data>
      <data key="d9">chunk-3fa5fe9ac042448be58de6c82bb33ea4</data>
      <data key="d10">./cached_docs/recital_175.json</data>
      <data key="d11">1783934173</data>
