    <node id="Regulatory Supervision">
      <data key="d0">Regulatory Supervision</data>
      <data key="d1">category</data>
      <data key="d2">Regulatory supervision involves governing bodies monitoring the compliance of AI systems with legal requirements to ensure safety and effectiveness.</data>
      <data key="d3">chunk-0c9405f93ec3e0ccf6209ed15ef0263f</data>
