      <data key="d5">1783936119</data>
    </node>
    <node id="Public Security Interests">
      <data key="d0">Public Security Interests</data>
      <data key="d1">category</data>
      <data key="d2">Public Security Interests relate to measures aimed at ensuring the safety and security of the general public as part of upholding the law.</data>
      <data key="d3">chunk-13b35a74627bd926656242d6545e09a6</data>
