    <node id="Care">
      <data key="d0">Care</data>
      <data key="d1">category</data>
      <data key="d2">Care encompasses various services aimed at maintaining individuals' health and well-being, often involving technology to enhance service delivery.</data>
      <data key="d3">chunk-18cf1aa30864348514b20fe64038fba8</data>
