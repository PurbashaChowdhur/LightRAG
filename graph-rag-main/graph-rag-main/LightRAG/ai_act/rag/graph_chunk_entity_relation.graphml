    <node id="Article 20">
      <data key="d0">Article 20</data>
      <data key="d1">event</data>
      <data key="d2">Article 20 includes requirements for corrective actions that must be taken if a high-risk AI system is found non-compliant.&lt;SEP&gt;Article 20 is a specific provision within Regulation (EU) 2019/1020, detailing particular rules related to product marketing.</data>
      <data key="d3">chunk-68d6983d829937a84d37118dacc3e39c&lt;SEP&gt;chunk-40de45b5b0c24b78b7ef2ca4e835c29c</data>
