    <node id="Data Collections">
      <data key="d0">Data Collections</data>
      <data key="d1">category</data>
      <data key="d2">Data Collections are aggregations of datasets used in training AI models, which include both private and public sources.</data>
      <data key="d3">chunk-5c4d08c48923bc3e8bff8968fd67a799</data>
      <data key="d4">./cached_docs/recital_107.json</data>
