    <node id="AI Training Summary">
      <data key="d0">AI Training Summary</data>
      <data key="d1">event</data>
      <data key="d2">AI Training Summary is the report generated by AI Providers that outlines the data and methods used to train AI models, ensuring transparency.</data>
      <data key="d3">chunk-5c4d08c48923bc3e8bff8968fd67a799</data>
