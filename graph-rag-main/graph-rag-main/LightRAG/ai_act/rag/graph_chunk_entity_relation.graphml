    <node id="Consumer Rights">
      <data key="d0">Consumer Rights</data>
      <data key="d1">category</data>
      <data key="d2">Consumer Rights are the legal protections and entitlements consumers have in the market, including equitable treatment and safety.</data>
      <data key="d3">chunk-c7912c5a4fb8a11a998bec401999088b</data>
      <data key="d4">./cached_docs/recital_142.json</data>
      <data key="d5">1783934441</data>
    </node>
    <node id="Digital Rights">
      <data key="d0">Digital Rights</data>
      <data key="d1">category</data>
      <data key="d2">Digital Rights pertain to freedoms and protections related to digital technology and its use, ensuring fairness and access to digital services.</data>
      <data key="d3">chunk-c7912c5a4fb8a11a998bec401999088b</data>
      <data key="d4">./cached_docs/recital_142.json</data>
