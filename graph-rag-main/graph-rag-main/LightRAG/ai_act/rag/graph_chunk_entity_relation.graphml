    <node id="Civil Society Organisations">
      <data key="d0">Civil Society Organisations</data>
      <data key="d1">organization</data>
      <data key="d2">Civil Society Organisations are involved as stakeholders in the formation of standards and codes of conduct for AI systems.&lt;SEP&gt;Civil society organisations are stakeholders that may participate in supporting the process of developing codes of practice for AI.</data>
      <data key="d3">chunk-c4dc0271c68856282748506ff58069b0&lt;SEP&gt;chunk-40f3761e589fb7702938fd4fbbecfdcc</data>
