    <node id="Natural Person Offender">
      <data key="d0">Natural Person Offender</data>
      <data key="d1">person</data>
      <data key="d2">Natural persons may be evaluated for the risk of offending or reoffending based on their personality traits and past behaviours.</data>
      <data key="d3">chunk-77ba8e0dd4981bd71dedb04a86b45601</data>
      <data key="d4">./cached_docs/recital_59.json</data>
      <data key="d5">1783934176</data>
    </node>
    <node id="Polygraphs">
      <data key="d0">Polygraphs</data>
      <data key="d1">category</data>
      <data key="d2">Polygraphs are tools used in the legal context for evaluating the reliability of evidence during criminal investigations.&lt;SEP&gt;Polygraphs are tools used to detect physiological responses indicative of truthfulness, often related to legal and investigative contexts.</data>
      <data key="d3">chunk-1eea61d03ab615ac5f518e77cd220c1d&lt;SEP&gt;chunk-77ba8e0dd4981bd71dedb04a86b45601</data>
