      <data key="d0">Binding Measures</data>
      <data key="d1">category</data>
      <data key="d2">Binding Measures refer to enforceable regulations that may be adopted to ensure compliance with established AI guidelines and principles.</data>
      <data key="d3">chunk-7a69b68c9998277692ac6c6341fcdcac</data>
      <data key="d4">./cached_docs/article_112.json</data>
      <data key="d5">1783934767</data>
    </node>
