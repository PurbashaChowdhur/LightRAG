    <node id="Legitimate Interests">
      <data key="d0">Legitimate Interests</data>
      <data key="d1">category</data>
      <data key="d2">Legitimate Interests refer to the rights and motivations of parties, such as copyright holders, to access information about data used in AI models.</data>
