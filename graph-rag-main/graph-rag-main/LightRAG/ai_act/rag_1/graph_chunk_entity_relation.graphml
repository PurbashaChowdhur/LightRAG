      <data key="d1">AIUser</data>
      <data key="d2">Operators Across the Union are the entities or individuals utilizing AI systems that must comply with the Regulation as enforced by the AI Office.</data>
      <data key="d3">chunk-e3d60cf6cbe0ae91a9793cb5c98a4a92</data>
      <data key="d4">./cached_docs/article_62.json</data>
      <data key="d5">1750861724</data>
