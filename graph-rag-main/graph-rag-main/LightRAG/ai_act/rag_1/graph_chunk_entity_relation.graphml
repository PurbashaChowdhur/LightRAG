    </node>
    <node id="evaluation or classification">
      <data key="d0">evaluation or classification</data>
      <data key="d1">AICapability</data>
      <data key="d2">Evaluation or classification refers to the capability of AI systems to assess individuals based on input data and make quantifiable judgments.</data>
      <data key="d3">chunk-28efea7f8fe5945cce5b7be57e88efe7</data>
      <data key="d4">./cached_docs/recital_31.json</data>
      <data key="d5">1750861584</data>
    </node>
    <node id="context of data generation">
      <data key="d0">context of data generation</data>
      <data key="d1">Domain</data>
      <data key="d2">The context of data generation pertains to the specific circumstances under which data is collected and analyzed by AI systems.</data>
      <data key="d3">chunk-28efea7f8fe5945cce5b7be57e88efe7</data>
      <data key="d4">./cached_docs/recital_31.json</data>
      <data key="d5">1750861584</data>
    </node>
    <node id="Unacceptable scoring practices">
      <data key="d0">Unacceptable scoring practices</data>
      <data key="d1">Standard</data>
      <data key="d2">Unacceptable scoring practices are methodologies used in social scoring that lead to unfair discrimination and violate ethical standards.</data>
      <data key="d3">chunk-28efea7f8fe5945cce5b7be57e88efe7</data>
      <data key="d4">./cached_docs/recital_31.json</data>
      <data key="d5">1750861584</data>
    </node>
    <node id="detrimental treatment due to scoring">
      <data key="d0">detrimental treatment due to scoring</data>
      <data key="d1">Consequence</data>
      <data key="d2">Detrimental treatment due to scoring refers to unfair and negative treatment of individuals based on their AI-generated social scores, often independent from actual behavior.</data>
      <data key="d3">chunk-28efea7f8fe5945cce5b7be57e88efe7</data>
      <data key="d4">./cached_docs/recital_31.json</data>
      <data key="d5">1750861584</data>
    </node>
    <node id="Union Level Risk">
      <data key="d0">Union Level Risk</data>
      <data key="d1">Risk</data>
      <data key="d2">Union level risk refers to the identifiable risks associated with AI models that can impact the entire Union and require assessment.</data>
      <data key="d3">chunk-140dff8b8263721e25ea86a4104c273d</data>
      <data key="d4">./cached_docs/article_90.json</data>
      <data key="d5">1750861590</data>
    </node>
