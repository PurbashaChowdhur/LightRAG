    <node id="Article 20">
      <data key="d0">Article 20</data>
      <data key="d1">Dimension</data>
      <data key="d2">Article 20 outlines the requirements for high-risk AI systems, including conformity demonstrations and accessibility compliance.&lt;SEP&gt;Article 20 refers to a specific provision within Regulation (EU) 2019/1020, detailing certain obligations or procedures.</data>
      <data key="d3">chunk-40de45b5b0c24b78b7ef2ca4e835c29c&lt;SEP&gt;chunk-c17bf6e803eec807c9fc7299d71d51d6</data>
