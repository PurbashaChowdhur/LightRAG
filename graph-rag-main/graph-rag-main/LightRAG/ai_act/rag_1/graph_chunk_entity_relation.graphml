    <node id="fines collected">
      <data key="d0">fines collected</data>
      <data key="d1">Metric</data>
      <data key="d2">Fines collected through enforcement of data protection laws reflect the financial penalties imposed for non-compliance, contributing to budgetary resources.</data>
      <data key="d3">chunk-828a2d9070cae319b764e3b609bc9b81</data>
      <data key="d4">./cached_docs/article_100.json</data>
      <data key="d5">1750859985</data>
    </node>
    <node id="administrative fines">
      <data key="d0">administrative fines</data>
      <data key="d1">Metric</data>
      <data key="d2">Administrative fines are penalties specifically levied for violations of data protection regulations and serve as a deterrent to non-compliance.</data>
      <data key="d3">chunk-828a2d9070cae319b764e3b609bc9b81</data>
      <data key="d4">./cached_docs/article_100.json</data>
