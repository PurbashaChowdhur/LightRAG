      <data key="d4">./cached_docs/recital_19.json</data>
      <data key="d5">1750859621</data>
    </node>
    <node id="swimming pools">
      <data key="d0">swimming pools</data>
      <data key="d1">Dimension</data>
      <data key="d2">Swimming pools are designated for sport and leisure activities, often accessible to the public.</data>
      <data key="d3">chunk-19ac689968d1b5ce1db014f781096bd3</data>
      <data key="d4">./cached_docs/recital_19.json</data>
