      <data key="d1">Stakeholder</data>
      <data key="d2">Stakeholders and organisations, including metrology and benchmarking authorities, collaborate to develop benchmarks and measurement methodologies for AI systems.</data>
      <data key="d3">chunk-671e76af4a78aebc96c988f0504bfa99</data>
      <data key="d4">./cached_docs/article_15.json</data>
      <data key="d5">1750861692</data>
