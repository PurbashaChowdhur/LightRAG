    <node id="Best Practices in Public Procurement">
      <data key="d0">Best Practices in Public Procurement</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Best practices in public procurement for AI systems are evaluated and promoted to ensure adherence to quality standards.</data>
      <data key="d3">chunk-e3d60cf6cbe0ae91a9793cb5c98a4a92</data>
      <data key="d4">./cached_docs/article_62.json</data>
      <data key="d5">1750861724</data>
    </node>
