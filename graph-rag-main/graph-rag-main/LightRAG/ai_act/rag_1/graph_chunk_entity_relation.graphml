      <data key="d0">Right to Explanation</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Right to explanation refers to the legal entitlement for individuals to receive an explanation for decisions made by high-risk AI systems.</data>
      <data key="d3">chunk-de3f18a6d766d2baa57ae891b9da7741</data>
      <data key="d4">./cached_docs/recital_93.json</data>
