    <node id="Compliance Costs">
      <data key="d0">Compliance Costs</data>
      <data key="d1">Cost</data>
      <data key="d2">Compliance costs refer to the expenses incurred by providers in meeting the regulatory requirements for high-risk AI systems.</data>
      <data key="d3">chunk-d1d974005cd87fc21678c732472ee11a</data>
