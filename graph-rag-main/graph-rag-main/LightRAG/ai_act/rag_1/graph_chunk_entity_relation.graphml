      <data key="d5">1750858704</data>
    </node>
    <node id="Public Services">
      <data key="d0">Public Services</data>
      <data key="d1">Domain</data>
      <data key="d2">Public services apply AI in enhancing delivery efficiency and improving citizen engagement.&lt;SEP&gt;Public services are essential services provided in the public interest, which may involve the deployment of high-risk AI systems by various entities.</data>
      <data key="d3">chunk-2a975f3ad5ea339c199a21dd569a7acb&lt;SEP&gt;chunk-3a1d78baf29c07c65edc311f0ca04126</data>
