    <node id="Union AI testing support structures">
      <data key="d0">Union AI testing support structures</data>
      <data key="d1">AICapability</data>
      <data key="d2">Union AI testing support structures are designated bodies tasked with various responsibilities concerning AI testing and regulation.</data>
      <data key="d3">chunk-d58805118916ede230a82a4ec3f60b3d</data>
