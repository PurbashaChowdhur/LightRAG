      <data key="d0">European Common Data Spaces</data>
      <data key="d1">DataSource</data>
      <data key="d2">European common data spaces are initiatives aimed at facilitating the sharing and access of high-quality data across sectors and organizations.</data>
      <data key="d3">chunk-8eae051373e28d701c4893438950556b</data>
      <data key="d4">./cached_docs/recital_68.json</data>
