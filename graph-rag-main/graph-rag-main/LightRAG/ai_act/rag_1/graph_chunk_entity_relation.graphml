      <data key="d0">Open Repositories</data>
      <data key="d1">DataSource</data>
      <data key="d2">Open repositories are platforms where AI components are developed and shared freely, promoting accessibility and collaboration.</data>
      <data key="d3">chunk-7ef570a9dfbda3c55d0d5bcc36fd77c5</data>
