      <data key="d0">EU database</data>
      <data key="d1">Data</data>
      <data key="d2">The EU database referenced in Article 71 is a repository for maintaining records pertinent to AI regulation and evaluation.</data>
      <data key="d3">chunk-00e7606a0fa9d588f18d67d02cfcf654</data>
