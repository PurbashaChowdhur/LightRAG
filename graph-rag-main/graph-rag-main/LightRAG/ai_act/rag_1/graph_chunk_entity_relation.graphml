    <node id="Directive (EU) 2016/2102">
      <data key="d0">Directive (EU) 2016/2102</data>
      <data key="d1">Regulation</data>
      <data key="d2">Directive (EU) 2016/2102 establishes accessibility requirements that high-risk AI systems must meet.&lt;SEP&gt;Directive (EU) 2016/2102 focuses on accessibility for websites and mobile applications of public sector bodies, ensuring equal access for persons with disabilities.</data>
      <data key="d3">chunk-c17bf6e803eec807c9fc7299d71d51d6&lt;SEP&gt;chunk-33366c5df404f37775ccbf3ec455b578</data>
