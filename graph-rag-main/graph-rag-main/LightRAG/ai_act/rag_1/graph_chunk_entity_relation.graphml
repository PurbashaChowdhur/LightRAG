      <data key="d0">Annexes XI and XII</data>
      <data key="d1">Documentation</data>
      <data key="d2">Annexes XI and XII may be amended to reflect evolving technological developments as determined by the Commission.</data>
      <data key="d3">chunk-5abff9e94aff7675c473268fd21bf551</data>
