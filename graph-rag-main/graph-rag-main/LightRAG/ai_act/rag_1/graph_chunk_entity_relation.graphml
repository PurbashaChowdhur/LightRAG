    <node id="Initiatives">
      <data key="d0">Initiatives</data>
      <data key="d1">Change</data>
      <data key="d2">Initiatives are efforts developed by the Commission aimed at lowering technical barriers for data exchange in AI development.&lt;SEP&gt;Initiatives are programs developed by Member States to assist SMEs with awareness and communication regarding AI technologies.</data>
      <data key="d3">chunk-3d6ed86abb2e8f0e12897e923d1e9964&lt;SEP&gt;chunk-a811acaf13b6420a717f6aa21a6ed331</data>
