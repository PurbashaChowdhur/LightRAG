    </node>
    <node id="Education">
      <data key="d0">Education</data>
      <data key="d1">AreaOfImpact</data>
      <data key="d2">Education is one of the public interest areas where high-risk AI systems may be deployed, impacting various stakeholders.</data>
      <data key="d3">chunk-3a1d78baf29c07c65edc311f0ca04126</data>
      <data key="d4">./cached_docs/recital_96.json</data>
      <data key="d5">1750858038</data>
    </node>
    <node id="Healthcare">
      <data key="d0">Healthcare</data>
      <data key="d1">Domain</data>
      <data key="d2">Healthcare is another public interest area where deployment of high-risk AI systems can have significant implications for individual rights.&lt;SEP&gt;Healthcare is one of the sectors where AI optimizes operations, improving patient outcomes and resource management.</data>
      <data key="d3">chunk-2a975f3ad5ea339c199a21dd569a7acb&lt;SEP&gt;chunk-3a1d78baf29c07c65edc311f0ca04126</data>
