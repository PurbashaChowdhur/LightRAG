      <data key="d0">Transparent Consultations</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Transparent consultations refer to the regular assessments conducted by the Commission regarding the costs associated with compliance for SMEs.</data>
      <data key="d3">chunk-3d6ed86abb2e8f0e12897e923d1e9964</data>
