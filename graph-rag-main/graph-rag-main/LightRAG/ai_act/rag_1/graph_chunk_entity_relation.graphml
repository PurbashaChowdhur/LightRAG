    <node id="Race">
      <data key="d0">Race</data>
      <data key="d1">Dimension</data>
      <data key="d2">Race is a classification often assessed through biometric data categories which can inform social and legal decisions.&lt;SEP&gt;Race is another demographic attribute that impacts the fairness and accuracy of AI systems for biometric identification.</data>
      <data key="d3">chunk-b65e9562dd645622f1390ba1863fee19&lt;SEP&gt;chunk-c3070277451614bdc67954ec8735dd80</data>
