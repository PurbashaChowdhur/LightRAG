    <node id="Copyright Protected Content">
      <data key="d0">Copyright Protected Content</data>
      <data key="d1">Data</data>
      <data key="d2">Copyright protected content refers to creative works that require authorization from rightsholders for their use, particularly in the context of text and data mining.</data>
      <data key="d3">chunk-5429fed5961ecea1e5eed049e922476f</data>
      <data key="d4">./cached_docs/recital_105.json</data>
