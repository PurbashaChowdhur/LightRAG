      <data key="d1">Change</data>
      <data key="d2">Alternative adequate means of compliance refer to potential methods that can be demonstrated for achieving compliance when standard procedures are not followed.</data>
      <data key="d3">chunk-fce1cda52753ec9e5183762f5b2c81b1</data>
      <data key="d4">./cached_docs/article_55.json</data>
      <data key="d5">1750857803</data>
