      <data key="d0">Use of AI Systems</data>
      <data key="d1">AICapability</data>
      <data key="d2">Use of AI systems encompasses various applications and functionalities of artificial intelligence technologies in different fields.</data>
      <data key="d3">chunk-15eee417af0ebe299ed66be76a0b845a</data>
      <data key="d4">./cached_docs/recital_10.json</data>
      <data key="d5">1750862268</data>
    </node>
