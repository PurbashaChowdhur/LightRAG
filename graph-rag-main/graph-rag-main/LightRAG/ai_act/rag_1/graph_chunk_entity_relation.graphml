    <node id="Chair">
      <data key="d0">Chair</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">The Chair is a representative selected to lead the Board's activities and manage the meetings as per the procedural rules.</data>
      <data key="d3">chunk-83ca16d466deaa751e3b9dc390e91e2f</data>
