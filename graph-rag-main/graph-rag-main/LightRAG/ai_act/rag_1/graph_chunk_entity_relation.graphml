    </node>
    <node id="Discriminatory Practices">
      <data key="d0">Discriminatory Practices</data>
      <data key="d1">RiskConcept</data>
      <data key="d2">Discriminatory practices refer to biases in AI usage that can lead to unequal treatment of individuals based on gender, age, disability, or ethnicity.</data>
