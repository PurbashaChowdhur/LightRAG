    <node id="effective investigative and corrective powers">
      <data key="d0">effective investigative and corrective powers</data>
      <data key="d1">AICapability</data>
      <data key="d2">The abilities required by market surveillance authorities to access personal data and conduct inquiries to ensure compliance with regulations.</data>
      <data key="d3">chunk-f736e1ff707eaba05079b0f194d8a123</data>
      <data key="d4">./cached_docs/recital_159.json</data>
      <data key="d5">1750857377</data>
    </node>
    <node id="sensitive operational data">
      <data key="d0">sensitive operational data</data>
      <data key="d1">SensitiveData</data>
      <data key="d2">Information that pertains to the internal functions and operations of AI systems, which can be restricted for security reasons.&lt;SEP&gt;Sensitive operational data refers to confidential information related to law enforcement authorities that require protection from monitoring.&lt;SEP&gt;Sensitive operational data refers to information that, if disclosed, could lead to risks to privacy or business operations, especially for law enforcement entities.</data>
      <data key="d3">chunk-54948128ea5a4b84a219d7dbaa346a50&lt;SEP&gt;chunk-e8c5a915dca180e1c423cefa27ea6cd3&lt;SEP&gt;chunk-f736e1ff707eaba05079b0f194d8a123</data>
