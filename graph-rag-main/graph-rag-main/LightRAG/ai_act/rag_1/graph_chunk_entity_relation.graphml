    </node>
    <node id="&quot;Experts&quot;&gt;">
      <data key="d0">"Experts"&gt;</data>
      <data key="d1">HumanInvolvement</data>
      <data key="d2">Experts are individuals designated by each Member State who provide consultation to the Commission before the adoption of delegated acts.</data>
      <data key="d3">chunk-da5fbf959baa6ee8e86278864a9144cc</data>
      <data key="d4">./cached_docs/article_97.json</data>
      <data key="d5">1750857286</data>
    </node>
    <node id="Official Journal">
      <data key="d0">Official Journal</data>
      <data key="d1">Documentation</data>
      <data key="d2">The Official Journal is the publication through which the Commission's decisions regarding delegated acts and revocations are formally announced.</data>
      <data key="d3">chunk-da5fbf959baa6ee8e86278864a9144cc</data>
      <data key="d4">./cached_docs/article_97.json</data>
      <data key="d5">1750857286</data>
    </node>
    <node id="Delegated Act">
      <data key="d0">Delegated Act</data>
      <data key="d1">AIModel</data>
      <data key="d2">A delegated act is a legal instrument in EU law that allows the Commission to make changes to non-essential elements of legislation.</data>
      <data key="d3">chunk-762d138929f27b0266d948c0aad50daa</data>
      <data key="d4">./cached_docs/article_97.json</data>
      <data key="d5">1750857286</data>
    </node>
