    <node id="Sorting of Images">
      <data key="d0">Sorting of Images</data>
      <data key="d1">AICapability</data>
      <data key="d2">Sorting of images refers to the capability to organize photographic data based on identifiable traits such as hair or eye color.</data>
      <data key="d3">chunk-c3070277451614bdc67954ec8735dd80</data>
      <data key="d4">./cached_docs/recital_30.json</data>
