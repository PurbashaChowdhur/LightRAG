    <node id="Copyright">
      <data key="d0">Copyright</data>
      <data key="d1">Regulation</data>
      <data key="d2">Copyright is a legal concept that grants creators exclusive rights to their works, impacting how content can be used by AI models.</data>
      <data key="d3">chunk-5429fed5961ecea1e5eed049e922476f</data>
      <data key="d4">./cached_docs/recital_105.json</data>
      <data key="d5">1750863667</data>
    </node>
    <node id="Rightsholder">
      <data key="d0">Rightsholder</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">Rightsholders are individuals or organizations that own copyrights to creative works and thus have the authority over their use in AI applications.</data>
      <data key="d3">chunk-5429fed5961ecea1e5eed049e922476f</data>
      <data key="d4">./cached_docs/recital_105.json</data>
