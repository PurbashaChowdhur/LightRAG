    <node id="Annual Report">
      <data key="d0">Annual Report</data>
      <data key="d1">Documentation</data>
      <data key="d2">The Advisory Forum shall prepare an annual report on its activities, which shall be made publicly available.&lt;SEP&gt;The Annual Report details the usage of real-time biometric identification systems and is submitted to the Commission by the authorities.&lt;SEP&gt;The annual report prepared by the advisory forum details their activities and is made publicly available.</data>
      <data key="d3">chunk-ad86065dee426d0a1db7444552c4a385&lt;SEP&gt;chunk-699c5fa3a4d8d093e6a599637df82443&lt;SEP&gt;chunk-2187eb3476528ac7c75b571eb3844f0e</data>
