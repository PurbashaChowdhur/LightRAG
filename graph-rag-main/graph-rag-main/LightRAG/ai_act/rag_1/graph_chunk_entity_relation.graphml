      <data key="d0">Directive 2002/14/EC</data>
      <data key="d1">Regulation</data>
      <data key="d2">Directive 2002/14/EC establishes a framework for informing and consulting employees about workplace conditions and decisions.</data>
      <data key="d3">chunk-c664ec81872dda212b64d449aa7a2014</data>
      <data key="d4">./cached_docs/recital_92.json</data>
