      <data key="d0">Article 10(4)</data>
      <data key="d1">Regulation</data>
      <data key="d2">Article 10(4) outlines the compliance requirements for high-risk AI systems used within particular settings.</data>
      <data key="d3">chunk-4d423f15a7cbd742a57795f884434b60</data>
      <data key="d4">./cached_docs/article_42.json</data>
      <data key="d5">1750857952</data>
    </node>
    <node id="Regulation (EU) 2019/881">
      <data key="d0">Regulation (EU) 2019/881</data>
      <data key="d1">Regulation</data>
      <data key="d2">Regulation (EU) 2019/881 establishes cybersecurity requirements for certified high-risk AI systems and its enforcement.&lt;SEP&gt;Regulation (EU) 2019/881 establishes the framework for ENISA's operations and responsibilities in cybersecurity and AI oversight.&lt;SEP&gt;Regulation (EU) 2019/881 pertains to ENISA and information and communications technology cybersecurity certification.&lt;SEP&gt;Regulation (EU) 2019/881 outlines the requirements for cybersecurity and compliance standards for AI systems.</data>
      <data key="d3">chunk-60a12c037b4dee54159c11f348ff3f11&lt;SEP&gt;chunk-07b79b1855840c81b5d9079a82c7e9fb&lt;SEP&gt;chunk-9ec0d2d3cbe2a53a3bbf6373c775edf2&lt;SEP&gt;chunk-4d423f15a7cbd742a57795f884434b60</data>
