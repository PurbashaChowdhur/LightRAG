      <data key="d0">Cyberscurity scheme</data>
      <data key="d1">AICapability</data>
      <data key="d2">A cybersecurity scheme under Regulation (EU) 2019/881 that issues statements of conformity for high-risk AI systems.</data>
      <data key="d3">chunk-4d423f15a7cbd742a57795f884434b60</data>
      <data key="d4">./cached_docs/article_42.json</data>
      <data key="d5">1750857952</data>
    </node>
    <node id="Statement of conformity">
      <data key="d0">Statement of conformity</data>
      <data key="d1">Documentation</data>
      <data key="d2">A statement of conformity certifies that a high-risk AI system meets the required cybersecurity standards.</data>
      <data key="d3">chunk-4d423f15a7cbd742a57795f884434b60</data>
      <data key="d4">./cached_docs/article_42.json</data>
      <data key="d5">1750857952</data>
    </node>
    <node id="Cybersecurity requirements">
      <data key="d0">Cybersecurity requirements</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Cybersecurity requirements refer to specific standards that high-risk AI systems must adhere to under Regulation (EU) 2019/881.</data>
      <data key="d3">chunk-4d423f15a7cbd742a57795f884434b60</data>
      <data key="d4">./cached_docs/article_42.json</data>
      <data key="d5">1750857952</data>
