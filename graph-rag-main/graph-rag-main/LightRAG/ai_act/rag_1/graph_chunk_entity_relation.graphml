    </node>
    <node id="Social Behaviour">
      <data key="d0">Social Behaviour</data>
      <data key="d1">Dimension</data>
      <data key="d2">Social behaviour encompasses the actions and interactions of individuals within societies, which are analyzed for the purpose of determining social scores.</data>
      <data key="d3">chunk-83317eda1161cf5d13ef9aa07297c98b</data>
      <data key="d4">./cached_docs/article_5.json</data>
      <data key="d5">1750857268</data>
    </node>
    <node id="Personality Characteristics">
      <data key="d0">Personality Characteristics</data>
      <data key="d1">Dimension</data>
      <data key="d2">Personality characteristics are traits or attributes inferred about individuals that contribute to their profiles for social scoring.</data>
      <data key="d3">chunk-83317eda1161cf5d13ef9aa07297c98b</data>
