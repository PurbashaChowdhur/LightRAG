      <data key="d0">Mutual Recognition Agreements</data>
      <data key="d1">AIComponent</data>
      <data key="d2">Mutual recognition agreements are agreements between countries that acknowledge each other’s conformity assessments, easing international trade.</data>
      <data key="d3">chunk-b4337a268de724c492ca11805622faf1</data>
      <data key="d4">./cached_docs/recital_127.json</data>
