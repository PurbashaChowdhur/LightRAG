      <data key="d1">QualityMeasurement</data>
      <data key="d2">Awareness Raising and Training Activities are initiatives tailored to inform SMEs and relevant stakeholders about the application of AI regulations.</data>
      <data key="d3">chunk-e76c1f88e5810a7e79cf9527486831e5</data>
      <data key="d4">./cached_docs/article_62.json</data>
      <data key="d5">1750861717</data>
    </node>
    <node id="Fees Reduction Policy">
      <data key="d0">Fees Reduction Policy</data>
      <data key="d1">Regulation</data>
      <data key="d2">Fees Reduction Policy dictates that the costs charged to SMEs for compliance assessments should be reduced proportionately to their size and market capabilities.</data>
      <data key="d3">chunk-e76c1f88e5810a7e79cf9527486831e5</data>
      <data key="d4">./cached_docs/article_62.json</data>
      <data key="d5">1750861717</data>
