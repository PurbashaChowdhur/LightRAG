      <data key="d0">High-risk AI Systems</data>
      <data key="d1">AISystem</data>
      <data key="d2">High-risk AI systems are systems that require resilience against unauthorized attempts to alter their use, outputs, or performance.</data>
      <data key="d3">chunk-ed5ccbca443324af303d8bca3aa31a38</data>
      <data key="d4">./cached_docs/article_15.json</data>
