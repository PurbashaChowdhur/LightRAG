      <data key="d0">Provisions of Regulation</data>
      <data key="d1">Regulation</data>
      <data key="d2">Provisions of Regulation encompass the specific rules and guidelines outlined within the overarching regulatory framework for AI models.</data>
      <data key="d3">chunk-18d33fd192f06f727ac6bb21becbaa57</data>
      <data key="d4">./cached_docs/article_89.json</data>
      <data key="d5">1750862426</data>
    </node>
