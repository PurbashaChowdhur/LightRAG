    <node id="Competent authorities">
      <data key="d0">Competent authorities</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">Competent authorities are regulatory bodies tasked with overseeing the compliance of high-risk AI systems with relevant laws and regulations.</data>
      <data key="d3">chunk-a67563c32c3414ab14ce22666bed23dc</data>
