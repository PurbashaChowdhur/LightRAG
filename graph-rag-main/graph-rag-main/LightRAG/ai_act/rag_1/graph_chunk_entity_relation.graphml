    <node id="Health Data Space">
      <data key="d0">Health Data Space</data>
      <data key="d1">DataSource</data>
      <data key="d2">The European health data space is a specific data space aimed at providing access to health-related data for AI training and research.</data>
      <data key="d3">chunk-8eae051373e28d701c4893438950556b</data>
