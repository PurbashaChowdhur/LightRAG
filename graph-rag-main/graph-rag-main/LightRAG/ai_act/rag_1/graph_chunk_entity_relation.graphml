      <data key="d0">Biometric Verification Systems</data>
      <data key="d1">AISystem</data>
      <data key="d2">Biometric verification systems are designed to confirm the identity of a person actively and are distinct from identification systems.</data>
      <data key="d3">chunk-0f62cf38e10f73dd06a997571902c1ef</data>
      <data key="d4">./cached_docs/recital_17.json</data>
