      <data key="d5">1750863319</data>
    </node>
    <node id="Simplified Compliance Guidelines">
      <data key="d0">Simplified Compliance Guidelines</data>
      <data key="d1">Documentation</data>
      <data key="d2">Simplified Compliance Guidelines are the instructions developed by the Commission to help microenterprises meet quality management system requirements.</data>
      <data key="d3">chunk-6e4f07f79ad3c90c82b86c0a02d0fae9</data>
      <data key="d4">./cached_docs/article_63.json</data>
      <data key="d5">1750861596</data>
    </node>
