    </node>
    <node id="Financial Services">
      <data key="d0">Financial Services</data>
      <data key="d1">Domain</data>
      <data key="d2">Financial services encompass the sector affected by AI regulations, focused on transaction security and compliance.</data>
      <data key="d3">chunk-577494efd5ce842563e6974b0da9707b</data>
      <data key="d4">./cached_docs/article_66.json</data>
      <data key="d5">1750858034</data>
    </node>
    <node id="Data Protection">
      <data key="d0">Data Protection</data>
      <data key="d1">Regulation</data>
      <data key="d2">Data protection refers to the fundamental rights that may be undermined by AI systems monitoring personal performance and behaviors in workplaces.&lt;SEP&gt;Data protection standards ensure the safeguarding of personal information in the development and deployment of AI systems.</data>
      <data key="d3">chunk-6fa05c618cc92c392c091a0299038b25&lt;SEP&gt;chunk-577494efd5ce842563e6974b0da9707b</data>
      <data key="d4">./cached_docs/article_66.json&lt;SEP&gt;./cached_docs/recital_57.json</data>
      <data key="d5">1750862942</data>
    </node>
    <node id="International Cooperation">
      <data key="d0">International Cooperation</data>
      <data key="d1">AICapability</data>
      <data key="d2">International cooperation refers to collaborative efforts among nations and organizations to standardize AI governance and practices.</data>
      <data key="d3">chunk-577494efd5ce842563e6974b0da9707b</data>
      <data key="d4">./cached_docs/article_66.json</data>
      <data key="d5">1750858034</data>
    </node>
    <node id="practices">
      <data key="d0">practices</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Practices define the actions, processes, or behaviors that determine the quality and consistency of outcomes within the Union.&lt;SEP&gt;Practices refer to the methods and standards employed in the monitoring and enforcement of AI systems.</data>
      <data key="d3">chunk-ca7de1b4c82ecd24e2aef654437bd0e7&lt;SEP&gt;chunk-649ac2acd7b1a3b0b6a81ce20aa799f7</data>
