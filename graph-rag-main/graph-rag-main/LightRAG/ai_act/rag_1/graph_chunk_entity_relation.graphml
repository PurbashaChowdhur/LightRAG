    </node>
    <node id="Special Threats">
      <data key="d0">Special Threats</data>
      <data key="d1">RiskConcept</data>
      <data key="d2">Special threats encompass significant risks to life or physical safety that may necessitate the immediate use of high-risk AI systems.</data>
      <data key="d3">chunk-e07ee6b3452d764ccd9733dceadb1ac7</data>
      <data key="d4">./cached_docs/article_46.json</data>
      <data key="d5">1750858547</data>
    </node>
    <node id="Objection">
      <data key="d0">Objection</data>
      <data key="d1">Change</data>
      <data key="d2">Objection is a formal challenge made by a Member State against an authorization issued by the Market Surveillance Authority.</data>
      <data key="d3">chunk-d4c7e75432b8ffa8e0b96687dc4dd380</data>
