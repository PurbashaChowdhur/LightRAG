    <node id="Local Public Authorities">
      <data key="d0">Local Public Authorities</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">Local Public Authorities are involved stakeholders that may collaborate with SMEs in the implementation of AI regulations and participate in training activities.&lt;SEP&gt;Local public authorities are identified as stakeholders that will be considered by the Commission in the implementation of the Regulation.&lt;SEP&gt;Local public authorities are stakeholders who may engage with SMEs to facilitate the implementation of AI regulations.</data>
      <data key="d3">chunk-e76c1f88e5810a7e79cf9527486831e5&lt;SEP&gt;chunk-3d6ed86abb2e8f0e12897e923d1e9964&lt;SEP&gt;chunk-b235644744fa597c94328afbeaa7e56b</data>
