    <node id="Article 15">
      <data key="d0">Article 15</data>
      <data key="d1">Regulation</data>
      <data key="d2">Article 15 outlines specific cybersecurity requirements that high-risk AI systems must meet as per Regulation (EU) 2019/881.</data>
      <data key="d3">chunk-4d423f15a7cbd742a57795f884434b60</data>
      <data key="d4">./cached_docs/article_42.json</data>
      <data key="d5">1750857952</data>
