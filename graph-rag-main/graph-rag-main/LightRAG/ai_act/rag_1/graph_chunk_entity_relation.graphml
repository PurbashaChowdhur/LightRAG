      <data key="d0">Expert Laboratories</data>
      <data key="d1">AIDeveloper</data>
      <data key="d2">Expert laboratories are accredited facilities that conduct testing to assess compliance with regulatory standards.</data>
      <data key="d3">chunk-70555b8168fcbd401cc11093ec15091a</data>
      <data key="d4">./cached_docs/recital_147.json</data>
      <data key="d5">1750861751</data>
    </node>
