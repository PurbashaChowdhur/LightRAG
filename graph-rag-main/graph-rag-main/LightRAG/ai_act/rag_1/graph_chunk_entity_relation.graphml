    </edge>
    <edge source="National Competent Authorities" target="Union Market for AI Systems">
      <data key="d6">8.0</data>
      <data key="d7">National Competent Authorities play a crucial role in facilitating access to the Union Market for AI Systems by ensuring regulatory compliance.</data>
      <data key="d8">compliance facilitation,market access</data>
