    <node id="Post-Remote Biometric Identification Systems">
      <data key="d0">Post-Remote Biometric Identification Systems</data>
      <data key="d1">AICapability</data>
      <data key="d2">Post-Remote Biometric Identification Systems are high-risk AI systems used to identify individuals, specifically in law enforcement contexts.&lt;SEP&gt;Post-remote biometric identification systems are technologies used for identifying individuals from a distance using biometric data.</data>
      <data key="d3">chunk-de40ca48bf7dafc1db86f4d8a18d2bba&lt;SEP&gt;chunk-4882abf1dd869d3dff00b8d88ee946a8</data>
