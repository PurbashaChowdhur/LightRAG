      <data key="d5">1750858541</data>
    </node>
    <node id="Human Involvement">
      <data key="d0">Human Involvement</data>
      <data key="d1">HumanInvolvement</data>
      <data key="d2">Human Involvement indicates the degree to which humans interact with or influence AI systems and their decision-making processes.&lt;SEP&gt;Human involvement refers to the degree to which humans interact with, control, or influence the actions of AI systems.</data>
      <data key="d3">chunk-907dfa7ec80255255b81cd50cd6a4494&lt;SEP&gt;chunk-3440467bfb3879bf5e30fbb107e28162</data>
      <data key="d4">./cached_docs/article_109.json&lt;SEP&gt;./cached_docs/recital_12.json</data>
