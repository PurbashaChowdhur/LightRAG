    <node id="Public Law Bodies">
      <data key="d0">Public Law Bodies</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">Bodies governed by public law that deploy high-risk AI systems, ensuring public interests are protected.</data>
      <data key="d3">chunk-3a1d78baf29c07c65edc311f0ca04126</data>
      <data key="d4">./cached_docs/recital_96.json</data>
      <data key="d5">1750858038</data>
    </node>
    <node id="Private Entities">
      <data key="d0">Private Entities</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">Private entities that provide public services and are involved in deploying high-risk AI systems, responsible for conducting impact assessments.</data>
      <data key="d3">chunk-3a1d78baf29c07c65edc311f0ca04126</data>
      <data key="d4">./cached_docs/recital_96.json</data>
      <data key="d5">1750858038</data>
    </node>
    <node id="Risks to Fundamental Rights">
      <data key="d0">Risks to Fundamental Rights</data>
      <data key="d1">Risk</data>
      <data key="d2">Potential threats to individual rights and freedoms identified during the fundamental rights impact assessment for high-risk AI systems.&lt;SEP&gt;Risks to Fundamental Rights refer to potential threats that AI systems may pose to individual rights, which are evaluated within the context of AI Regulatory Sandboxes.</data>
      <data key="d3">chunk-d08b537f9a5bb2b4f4bbdf442ba39bdd&lt;SEP&gt;chunk-3a1d78baf29c07c65edc311f0ca04126</data>
