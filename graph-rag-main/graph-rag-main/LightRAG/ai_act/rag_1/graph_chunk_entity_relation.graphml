    <node id="Downstream Providers">
      <data key="d0">Downstream Providers</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">Downstream providers are individuals or entities that use outputs from AI models and have rights to report infringements of regulations.&lt;SEP&gt;Downstream providers utilize general-purpose AI models in their products and must understand these models to ensure compliance with regulations.</data>
      <data key="d3">chunk-11bdaa862215570a86eed137e3092ea6&lt;SEP&gt;chunk-18d33fd192f06f727ac6bb21becbaa57</data>
      <data key="d4">./cached_docs/recital_101.json&lt;SEP&gt;./cached_docs/article_89.json</data>
