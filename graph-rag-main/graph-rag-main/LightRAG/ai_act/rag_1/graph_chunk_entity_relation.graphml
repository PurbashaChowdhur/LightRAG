      <data key="d5">1750861984</data>
    </node>
    <node id="Academia">
      <data key="d0">Academia</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">Academia includes researchers and educational institutions that contribute to the understanding and development of AI practices.&lt;SEP&gt;Academia refers to educational institutions and scholars who contribute knowledge and insights regarding the Regulation.&lt;SEP&gt;Scholarly institutions involved in the research and development of ethical guidelines for AI, contributing to the codes of conduct.&lt;SEP&gt;Academia refers to educational and research institutions that contribute knowledge and expertise to AI development.</data>
      <data key="d3">chunk-f6de18717bcb0167956be85a15dd210f&lt;SEP&gt;chunk-40f3761e589fb7702938fd4fbbecfdcc&lt;SEP&gt;chunk-f76666cf495bb0f0810313fe42e2c882&lt;SEP&gt;chunk-a811acaf13b6420a717f6aa21a6ed331</data>
