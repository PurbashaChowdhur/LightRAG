    <node id="Article 53(5)">
      <data key="d0">Article 53(5)</data>
      <data key="d1">Regulation</data>
      <data key="d2">Article 53(5) includes further stipulations relevant to the adoption of certain delegated acts by the Commission.&lt;SEP&gt;Article 53(5) refers to the provision within EU legislation allowing for the revocation of delegated acts by the European institutions.</data>
      <data key="d3">chunk-da5fbf959baa6ee8e86278864a9144cc&lt;SEP&gt;chunk-762d138929f27b0266d948c0aad50daa</data>
