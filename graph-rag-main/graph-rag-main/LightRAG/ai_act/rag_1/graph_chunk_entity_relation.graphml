      <data key="d11">1750863841</data>
    </edge>
    <edge source="AI System" target="Member States">
      <data key="d6">18.0</data>
      <data key="d7">Member States enforce compliance regulations for AI Systems operating within their jurisdictions.&lt;SEP&gt;Member States' involvement is crucial in testing AI systems, ensuring compliance with established regulations."|&gt;"testing jurisdiction, regulatory framework</data>
