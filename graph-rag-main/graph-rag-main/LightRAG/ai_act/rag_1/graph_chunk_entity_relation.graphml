      <data key="d4">./cached_docs/recital_56.json</data>
      <data key="d5">1750862902</data>
    </node>
    <node id="Impact on Education and Training">
      <data key="d0">Impact on Education and Training</data>
      <data key="d1">Impact</data>
      <data key="d2">The impact on education and training refers to how AI systems affect access, quality, and fairness in learning environments.</data>
