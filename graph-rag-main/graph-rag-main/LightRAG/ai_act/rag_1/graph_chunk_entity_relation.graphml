    <node id="Selection Criteria">
      <data key="d0">Selection Criteria</data>
      <data key="d1">Dimension</data>
      <data key="d2">Selection criteria refer to the specific requirements used to assess applicants seeking participation in AI regulatory sandboxes.&lt;SEP&gt;Selection criteria refer to the standards used to evaluate and approve SMEs for participation in regulatory initiatives.</data>
      <data key="d3">chunk-aca56f82b70892874784bcec5c2bb2c3&lt;SEP&gt;chunk-3d6ed86abb2e8f0e12897e923d1e9964</data>
