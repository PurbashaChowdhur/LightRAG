      <data key="d0">General-Purpose AI Model with Systemic Risk</data>
      <data key="d1">AIModel</data>
      <data key="d2">A general-purpose AI model with systemic risk is one that has been officially recognized as potentially harmful to systems and society.</data>
      <data key="d3">chunk-3e23bb4c71b510fec0bbe6570de37cd5</data>
      <data key="d4">./cached_docs/article_52.json</data>
      <data key="d5">1750862916</data>
    </node>
    <node id="List">
      <data key="d0">List</data>
      <data key="d1">Output</data>
      <data key="d2">The list is a comprehensive record maintained by the Commission of all general-purpose AI models identified as presenting systemic risks.</data>
      <data key="d3">chunk-3e23bb4c71b510fec0bbe6570de37cd5</data>
      <data key="d4">./cached_docs/article_52.json</data>
      <data key="d5">1750862916</data>
