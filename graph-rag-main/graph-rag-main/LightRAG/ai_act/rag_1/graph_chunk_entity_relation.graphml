    </node>
    <node id="judicial proceedings">
      <data key="d0">judicial proceedings</data>
      <data key="d1">Consequence</data>
      <data key="d2">Judicial proceedings entail formal legal actions taken by the European Data Protection Supervisor in response to compliance issues with data protection laws.</data>
      <data key="d3">chunk-828a2d9070cae319b764e3b609bc9b81</data>
      <data key="d4">./cached_docs/article_100.json</data>
