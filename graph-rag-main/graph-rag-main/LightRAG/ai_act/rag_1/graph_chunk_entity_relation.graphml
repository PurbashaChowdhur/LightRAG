      <data key="d0">Physical and Digital Products</data>
      <data key="d1">AICapability</data>
      <data key="d2">Physical and digital products refer to the types of AI systems that can be developed and tested within regulatory sandboxes.</data>
      <data key="d3">chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35</data>
      <data key="d4">./cached_docs/recital_138.json</data>
      <data key="d5">1750858901</data>
    </node>
    <node id="Regulatory Sandboxes">
      <data key="d0">Regulatory Sandboxes</data>
      <data key="d1">Domain</data>
      <data key="d2">Regulatory sandboxes are controlled environments where high-risk AI systems can be tested under regulatory oversight before wider deployment.&lt;SEP&gt;Regulatory sandboxes are frameworks that allow innovators to test AI systems in a controlled environment under regulatory supervision.</data>
      <data key="d3">chunk-ff61ec794793cf787d4a0473487a06f3&lt;SEP&gt;chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35</data>
