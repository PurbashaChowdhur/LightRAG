    <node id="Communication Campaigns">
      <data key="d0">Communication Campaigns</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Communication Campaigns are initiatives organized by the AI Office to raise awareness about regulatory obligations among stakeholders.&lt;SEP&gt;Communication campaigns aim to raise awareness about the obligations outlined in the Regulation for AI systems.</data>
      <data key="d3">chunk-e3d60cf6cbe0ae91a9793cb5c98a4a92&lt;SEP&gt;chunk-e76c1f88e5810a7e79cf9527486831e5</data>
