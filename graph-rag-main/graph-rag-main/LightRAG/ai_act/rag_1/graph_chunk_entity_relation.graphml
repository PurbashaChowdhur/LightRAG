      <data key="d5">1750858038</data>
    </node>
    <node id="Infringement of Regulation">
      <data key="d0">Infringement of Regulation</data>
      <data key="d1">RiskConcept</data>
      <data key="d2">Infringement of regulation refers to violations of established rules regarding the deployment and regulation of AI systems.</data>
      <data key="d3">chunk-bb040a8b4e6e3fa6f26776f560b6591c</data>
      <data key="d4">./cached_docs/recital_170.json</data>
      <data key="d5">1750857950</data>
    </node>
