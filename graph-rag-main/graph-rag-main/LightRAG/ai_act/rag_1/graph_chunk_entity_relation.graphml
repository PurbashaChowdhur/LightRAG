      <data key="d3">chunk-0f62cf38e10f73dd06a997571902c1ef</data>
      <data key="d4">./cached_docs/recital_17.json</data>
      <data key="d5">1750859198</data>
    </node>
    <node id="Security Access Systems">
      <data key="d0">Security Access Systems</data>
      <data key="d1">AISystem</data>
      <data key="d2">Security access systems are technology frameworks aimed at confirming identity to provide access to services or premises.</data>
      <data key="d3">chunk-0f62cf38e10f73dd06a997571902c1ef</data>
      <data key="d4">./cached_docs/recital_17.json</data>
      <data key="d5">1750859198</data>
    </node>
    <node id="Real-Time AI Systems">
      <data key="d0">Real-Time AI Systems</data>
      <data key="d1">AISystem</data>
      <data key="d2">Real-time AI Systems utilize live or near-live material, like video footage, and require instantaneous processing without significant delay.</data>
      <data key="d3">chunk-2d1a48b7c6d78e001878383cb0acaf58</data>
      <data key="d4">./cached_docs/recital_17.json</data>
