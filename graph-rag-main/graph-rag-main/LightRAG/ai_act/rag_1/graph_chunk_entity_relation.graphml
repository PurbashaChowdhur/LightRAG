      <data key="d0">European Global Competitiveness in AI</data>
      <data key="d1">AreaOfImpact</data>
      <data key="d2">European Global Competitiveness in AI refers to the positioning of Europe in the global AI landscape, including trends and developments.</data>
      <data key="d3">chunk-98532c431ec75ae38c76dc0730337a16</data>
