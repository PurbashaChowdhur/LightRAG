    </node>
    <node id="litigation">
      <data key="d0">litigation</data>
      <data key="d1">Consequence</data>
      <data key="d2">Litigation involves legal proceedings initiated by the Data Protection Supervisor to address violations of data protection laws.</data>
      <data key="d3">chunk-828a2d9070cae319b764e3b609bc9b81</data>
      <data key="d4">./cached_docs/article_100.json</data>
