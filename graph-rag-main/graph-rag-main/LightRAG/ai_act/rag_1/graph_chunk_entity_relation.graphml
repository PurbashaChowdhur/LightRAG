    <node id="Self-Supervision">
      <data key="d0">Self-Supervision</data>
      <data key="d1">AICapability</data>
      <data key="d2">Self-supervision is a training method where the model learns from unlabelled data, enhancing its learning capability and efficiency.</data>
      <data key="d3">chunk-e93dbcfb179aa98bf5518ab208d544fc</data>
      <data key="d4">./cached_docs/recital_98.json</data>
