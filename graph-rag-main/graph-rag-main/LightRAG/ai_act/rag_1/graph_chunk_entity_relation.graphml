      <data key="d0">Resources performance</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Resources performance refers to the efficiency and sustainability of AI systems during their lifecycle, including energy and resource consumption.</data>
      <data key="d3">chunk-2739984aae71aa27a0af867bc197b730</data>
      <data key="d4">./cached_docs/article_40.json</data>
      <data key="d5">1750861623</data>
