    </node>
    <node id="Employers">
      <data key="d0">Employers</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">Employers are organizations or individuals responsible for deploying AI systems in the workplace and are obligated to inform workers about these systems.</data>
      <data key="d3">chunk-c664ec81872dda212b64d449aa7a2014</data>
      <data key="d4">./cached_docs/recital_92.json</data>
      <data key="d5">1750861757</data>
    </node>
    <node id="Information Rights">
      <data key="d0">Information Rights</data>
      <data key="d1">Right</data>
      <data key="d2">Information Rights refer to the entitlements of workers to be informed about the deployment of AI systems and the potential impacts of such systems at work.</data>
      <data key="d3">chunk-c664ec81872dda212b64d449aa7a2014</data>
      <data key="d4">./cached_docs/recital_92.json</data>
      <data key="d5">1750861757</data>
    </node>
    <node id="Consultation Obligations">
      <data key="d0">Consultation Obligations</data>
      <data key="d1">Regulation</data>
      <data key="d2">Consultation Obligations are requirements established by law that mandate employers to engage with workers or their representatives about AI system deployments.</data>
      <data key="d3">chunk-c664ec81872dda212b64d449aa7a2014</data>
      <data key="d4">./cached_docs/recital_92.json</data>
      <data key="d5">1750861757</data>
    </node>
    <node id="Relevant National Public Authorities">
      <data key="d0">Relevant National Public Authorities</data>
      <data key="d1">AIDeveloper</data>
      <data key="d2">Relevant national public authorities are bodies that cooperate with the market surveillance authority in evaluating AI systems.</data>
      <data key="d3">chunk-9cb2802f1b508b813d06e58ae27a1f77</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1750861788</data>
    </node>
    <node id="AI System presenting a risk">
      <data key="d0">AI System presenting a risk</data>
      <data key="d1">AISystem</data>
      <data key="d2">An AI system that may pose threats to health, safety, or fundamental rights as defined under Regulation (EU) 2019/1020.</data>
      <data key="d3">chunk-9cb2802f1b508b813d06e58ae27a1f77</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1750861803</data>
    </node>
    <node id="EU Commission">
      <data key="d0">EU Commission</data>
      <data key="d1">AISystem</data>
      <data key="d2">A governing body that is informed by the market surveillance authority when AI system compliance issues extend beyond national borders.</data>
      <data key="d3">chunk-9cb2802f1b508b813d06e58ae27a1f77</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1750861803</data>
    </node>
    <node id="National Territory">
      <data key="d0">National Territory</data>
      <data key="d1">LocalityOfUse</data>
      <data key="d2">National territory refers to the geographical area within which a country's laws and regulations apply, including those for AI systems.</data>
      <data key="d3">chunk-1ad9c740a10a5c1577e578a593bd61fd</data>
