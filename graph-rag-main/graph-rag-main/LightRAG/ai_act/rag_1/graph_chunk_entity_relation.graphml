    <node id="Recommendation 2003/361/EC">
      <data key="d0">Recommendation 2003/361/EC</data>
      <data key="d1">Regulation</data>
      <data key="d2">Recommendation 2003/361/EC provides guidelines and definitions applicable to microenterprises and their compliance with quality management systems.&lt;SEP&gt;Recommendation 2003/361/EC serves as a guideline for evaluating the size and impact of micro- and small enterprises in compliance assessments.</data>
      <data key="d3">chunk-6e4f07f79ad3c90c82b86c0a02d0fae9&lt;SEP&gt;chunk-d1d974005cd87fc21678c732472ee11a</data>
