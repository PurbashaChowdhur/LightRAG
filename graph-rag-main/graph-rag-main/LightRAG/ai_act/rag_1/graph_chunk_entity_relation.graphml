    <node id="Rightsholders">
      <data key="d0">Rightsholders</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">Rightsholders are individuals or entities that own the rights to creative works and have the authority to grant or deny permission for their use in contexts like text and data mining.</data>
      <data key="d3">chunk-5429fed5961ecea1e5eed049e922476f</data>
      <data key="d4">./cached_docs/recital_105.json</data>
      <data key="d5">1750863667</data>
    </node>
    <node id="Scientific Research">
      <data key="d0">Scientific Research</data>
      <data key="d1">Purpose</data>
      <data key="d2">Scientific research refers to the activities undertaken to gain knowledge and understanding, often using text and data mining techniques under specified conditions in copyright law.</data>
      <data key="d3">chunk-5429fed5961ecea1e5eed049e922476f</data>
      <data key="d4">./cached_docs/recital_105.json</data>
      <data key="d5">1750863667</data>
    </node>
