    <node id="Geographical, behavioural, contextual or functional setting">
      <data key="d0">Geographical, behavioural, contextual or functional setting</data>
      <data key="d1">Dimension</data>
      <data key="d2">These settings refer to the specific conditions under which high-risk AI systems are intended to be applied, impacting their compliance.</data>
      <data key="d3">chunk-4d423f15a7cbd742a57795f884434b60</data>
      <data key="d4">./cached_docs/article_42.json</data>
      <data key="d5">1750857952</data>
    </node>
    <node id="Requirements">
      <data key="d0">Requirements</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Requirements are specified conditions or criteria that must be met for compliance with legal standards and regulations, as defined in Article 31.&lt;SEP&gt;Requirements are the criteria established in regulations that high-risk AI systems must fulfill to ensure compliance and safety.&lt;SEP&gt;Requirements refer to regulatory standards that third parties might be mandated to comply with when supplying AI components and services.&lt;SEP&gt;Requirements are the specific criteria or stipulations outlined in Article 31 that need to be fulfilled.</data>
      <data key="d3">chunk-b479c56b927c79a74d3a19d8470ff1da&lt;SEP&gt;chunk-778cb9e68fcb25e3f810e3cea927f7b2&lt;SEP&gt;chunk-9db4c15b43d1b7a1a1138d5a7403b240&lt;SEP&gt;chunk-4d423f15a7cbd742a57795f884434b60</data>
      <data key="d4">./cached_docs/article_42.json&lt;SEP&gt;./cached_docs/article_29.json&lt;SEP&gt;./cached_docs/article_32.json&lt;SEP&gt;./cached_docs/recital_89.json</data>
      <data key="d5">1750863479</data>
    </node>
    <node id="The Board">
      <data key="d0">The Board</data>
      <data key="d1">AIDeveloper</data>
      <data key="d2">The Board is responsible for advising and assisting the Commission and Member States in the effective implementation of AI regulations and practices.</data>
      <data key="d3">chunk-98532c431ec75ae38c76dc0730337a16</data>
      <data key="d4">./cached_docs/article_66.json</data>
      <data key="d5">1750858016</data>
    </node>
    <node id="Articles 40 and 41">
      <data key="d0">Articles 40 and 41</data>
      <data key="d1">Standard</data>
      <data key="d2">Articles 40 and 41 of the Regulation refer to specific provisions related to the use of harmonised standards or common specifications in AI development and application.&lt;SEP&gt;These articles pertain to harmonized standards or common specifications necessary for compliance with the Regulation.&lt;SEP&gt;Articles 40 and 41 refer to specific provisions in the regulation dealing with harmonised standards or common specifications for AI systems.</data>
      <data key="d3">chunk-8cc9a7191827dda78eda5924876e5f7e&lt;SEP&gt;chunk-00e7606a0fa9d588f18d67d02cfcf654&lt;SEP&gt;chunk-98532c431ec75ae38c76dc0730337a16</data>
