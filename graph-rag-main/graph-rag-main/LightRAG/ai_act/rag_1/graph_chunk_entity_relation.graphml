    </node>
    <node id="Administrating Authority">
      <data key="d0">Administrating Authority</data>
      <data key="d1">AIDeveloper</data>
      <data key="d2">The administrating authority oversees the compliance of notified bodies with regulations on AI system certifications.</data>
