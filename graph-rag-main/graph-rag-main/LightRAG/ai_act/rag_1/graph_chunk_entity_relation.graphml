      <data key="d0">Oversight Measures</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Oversight measures are designed to be commensurate with the risks and level of autonomy associated with high-risk AI systems.</data>
      <data key="d3">chunk-4c4d127e5313d415dd94f6b6761da956</data>
      <data key="d4">./cached_docs/article_14.json</data>
      <data key="d5">1750857783</data>
    </node>
