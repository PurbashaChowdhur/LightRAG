      <data key="d4">./cached_docs/recital_42.json</data>
      <data key="d5">1750857810</data>
    </node>
    <node id="Place of Residence">
      <data key="d0">Place of Residence</data>
      <data key="d1">Dimension</data>
      <data key="d2">Place of Residence refers to the geographic location where a natural person lives, relevant for profiling purposes.</data>
      <data key="d3">chunk-4274f38f6b4aeff6dc2959e9e1a87f1a</data>
      <data key="d4">./cached_docs/recital_42.json</data>
      <data key="d5">1750857810</data>
    </node>
    <node id="Level of Debt">
      <data key="d0">Level of Debt</data>
      <data key="d1">Dimension</data>
      <data key="d2">Level of Debt is a financial characteristic considered in profiling that provides insight into an individual's financial behavior and risk.</data>
