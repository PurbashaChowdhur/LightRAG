      <data key="d3">chunk-18d33fd192f06f727ac6bb21becbaa57</data>
      <data key="d4">./cached_docs/article_89.json</data>
      <data key="d5">1750862426</data>
    </node>
    <node id="Evaluations">
      <data key="d0">Evaluations</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Evaluations are assessments conducted to ascertain compliance with regulatory obligations and effective implementation of AI models.</data>
