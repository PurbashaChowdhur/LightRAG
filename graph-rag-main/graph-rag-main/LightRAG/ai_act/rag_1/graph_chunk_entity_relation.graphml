      <data key="d0">Sectoral Union Law</data>
      <data key="d1">Regulation</data>
      <data key="d2">Sectoral Union Law refers to regulations specific to certain industries that guide the quality management requirements for AI systems.</data>
      <data key="d3">chunk-44eafa4c222bb60e722eca942751cf7d</data>
      <data key="d4">./cached_docs/recital_81.json</data>
      <data key="d5">1750857543</data>
    </node>
