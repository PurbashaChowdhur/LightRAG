    </node>
    <node id="Right to Personalized Education">
      <data key="d0">Right to Personalized Education</data>
      <data key="d1">Regulation</data>
      <data key="d2">The right to personalized education ensures individuals receive tailored educational experiences and support, free from discrimination.</data>
      <data key="d3">chunk-7df88d0d68bb9e14cc05c3f581da8399</data>
