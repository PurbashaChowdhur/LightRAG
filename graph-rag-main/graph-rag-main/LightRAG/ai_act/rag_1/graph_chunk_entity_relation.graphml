      <data key="d0">Directive 2001/29/EC</data>
      <data key="d1">Regulation</data>
      <data key="d2">Directive 2001/29/EC focuses on harmonizing copyright laws across member states, ensuring rights protection in the digital environment.</data>
      <data key="d3">chunk-feb00b9eef4af47cdd3264cd99d6b2e4</data>
      <data key="d4">./cached_docs/recital_104.json</data>
      <data key="d5">1750858853</data>
    </node>
