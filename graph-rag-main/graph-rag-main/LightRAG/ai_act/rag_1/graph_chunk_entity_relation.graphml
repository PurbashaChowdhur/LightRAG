    </node>
    <node id="Software Platform">
      <data key="d0">Software Platform</data>
      <data key="d1">AIDeveloper</data>
      <data key="d2">A software platform is an environment for developing, running, and managing AI components and applications.</data>
      <data key="d3">chunk-7ef570a9dfbda3c55d0d5bcc36fd77c5</data>
