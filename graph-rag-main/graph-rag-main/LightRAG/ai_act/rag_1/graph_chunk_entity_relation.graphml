      <data key="d1">QualityMeasurement</data>
      <data key="d2">This fundamental right allows individuals to express their opinions freely, which can be affected by the use of AI systems.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_48.json</data>
      <data key="d5">1750859201</data>
