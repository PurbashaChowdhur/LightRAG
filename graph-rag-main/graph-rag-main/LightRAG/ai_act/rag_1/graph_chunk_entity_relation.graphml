    <node id="Text Mining">
      <data key="d0">Text Mining</data>
      <data key="d1">AITechnique</data>
      <data key="d2">Text mining is a technique used to extract meaningful information from unstructured text data, often employed in training AI models.</data>
      <data key="d3">chunk-5429fed5961ecea1e5eed049e922476f</data>
      <data key="d4">./cached_docs/recital_105.json</data>
