      <data key="d5">1750858963</data>
    </node>
    <node id="Union Level">
      <data key="d0">Union Level</data>
      <data key="d1">Dimension</data>
      <data key="d2">Union Level refers to the jurisdiction or scope within which the codes of practice must be compliant and operational.&lt;SEP&gt;Union level refers to the collective governance and regulation at a regional level, focusing on cooperation among competent authorities.</data>
      <data key="d3">chunk-f6de18717bcb0167956be85a15dd210f&lt;SEP&gt;chunk-13b35a74627bd926656242d6545e09a6</data>
