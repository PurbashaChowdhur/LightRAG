    <node id="Operational Data">
      <data key="d0">Operational Data</data>
      <data key="d1">Data</data>
      <data key="d2">Operational Data refers to sensitive information that law-enforcement authorities handle, which is exempt from certain oversight requirements.&lt;SEP&gt;Operational data refers to sensitive information related to the activities of law enforcement authorities and is protected under regulation.</data>
      <data key="d3">chunk-d4c7e75432b8ffa8e0b96687dc4dd380&lt;SEP&gt;chunk-e07ee6b3452d764ccd9733dceadb1ac7</data>
