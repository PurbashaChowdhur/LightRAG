    <node id="real-time remote biometric identification systems">
      <data key="d0">real-time remote biometric identification systems</data>
      <data key="d1">AICapability</data>
      <data key="d2">Real-time remote biometric identification systems are technologies used in law enforcement to identify individuals based on their biometric data.</data>
      <data key="d3">chunk-d91755cda6acde2b40257e6d4cef1695</data>
      <data key="d4">./cached_docs/recital_33.json</data>
      <data key="d5">1750857807</data>
    </node>
    <node id="criminal offences listed in an annex">
      <data key="d0">criminal offences listed in an annex</data>
      <data key="d1">LegalBasis</data>
      <data key="d2">The criminal offences listed in an annex to the Regulation define the circumstances under which remote biometric systems can be used.</data>
      <data key="d3">chunk-d91755cda6acde2b40257e6d4cef1695</data>
      <data key="d4">./cached_docs/recital_33.json</data>
      <data key="d5">1750857807</data>
    </node>
    <node id="Council Framework Decision 2002/584/JHA">
      <data key="d0">Council Framework Decision 2002/584/JHA</data>
      <data key="d1">Regulation</data>
      <data key="d2">The Council Framework Decision 2002/584/JHA provides the legal backdrop and rationale for listing serious criminal offences in the Regulation.&lt;SEP&gt;This council decision sets out the framework for the European Arrest Warrant and the procedures for surrendering individuals between Member States.&lt;SEP&gt;This decision outlines the procedures for the European arrest warrant and the surrender of individuals between Member States.</data>
      <data key="d3">chunk-6badc71855b10bbd17a31c7dfef0c442&lt;SEP&gt;chunk-d91755cda6acde2b40257e6d4cef1695&lt;SEP&gt;chunk-a23e03a78af2035b69e69bd4fc65a435</data>
      <data key="d4">./cached_docs/recital_33.json</data>
