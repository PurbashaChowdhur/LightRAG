      <data key="d0">AI practices referred to in Article 5</data>
      <data key="d1">Regulation</data>
      <data key="d2">The AI practices specified in Article 5 outline non-compliant behaviors that are prohibited under the regulations.</data>
      <data key="d3">chunk-345a8ba89ed0ea3325462384d5e16aaf</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1750861814</data>
