      <data key="d1">AISystem</data>
      <data key="d2">Information and Communications Technologies encompass a broad range of technologies that facilitate communication and access to information, essential for inclusivity.</data>
      <data key="d3">chunk-33366c5df404f37775ccbf3ec455b578</data>
      <data key="d4">./cached_docs/recital_80.json</data>
      <data key="d5">1750862926</data>
