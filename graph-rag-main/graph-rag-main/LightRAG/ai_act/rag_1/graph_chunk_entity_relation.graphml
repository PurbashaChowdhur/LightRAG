      <data key="d1">Standard</data>
      <data key="d2">Harmonised standards or common specifications provide guidelines to ensure AI systems meet required conformity for safety and effectiveness.</data>
      <data key="d3">chunk-345a8ba89ed0ea3325462384d5e16aaf</data>
