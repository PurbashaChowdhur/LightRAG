      <data key="d5">1750863383</data>
    </node>
    <node id="Health of Persons">
      <data key="d0">Health of Persons</data>
      <data key="d1">AreaOfImpact</data>
      <data key="d2">Health of persons encompasses the prevention and protection of individuals' health in relation to AI system deployment.</data>
      <data key="d3">chunk-e07ee6b3452d764ccd9733dceadb1ac7</data>
      <data key="d4">./cached_docs/article_46.json</data>
      <data key="d5">1750858547</data>
    </node>
