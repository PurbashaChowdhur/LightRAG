    <node id="Investigations">
      <data key="d0">Investigations</data>
      <data key="d1">Change</data>
      <data key="d2">Investigations refer to the procedural actions taken by the AI Office in response to alerts regarding potential risks posed by AI models.</data>
      <data key="d3">chunk-3a0c1908573a7d6a832a6b35befbd7ee</data>
      <data key="d4">./cached_docs/recital_163.json</data>
