      <data key="d11">1750861814</data>
    </edge>
    <edge source="AI System" target="Free and Open-Source AI Components">
      <data key="d6">8.0</data>
      <data key="d7">Free and open-source AI components are integral parts of an AI system, providing essential software and tools for its functioning.</data>
      <data key="d8">integration,software components</data>
