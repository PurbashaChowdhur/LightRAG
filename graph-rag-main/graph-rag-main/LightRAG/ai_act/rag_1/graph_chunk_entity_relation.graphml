      <data key="d0">Regulatory Oversight</data>
      <data key="d1">Regulation</data>
      <data key="d2">Regulatory oversight involves implementing measures to ensure the responsible innovation and integration of AI technologies.</data>
      <data key="d3">chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35</data>
      <data key="d4">./cached_docs/recital_138.json</data>
      <data key="d5">1750858892</data>
    </node>
    <node id="Financial and Human Resources">
      <data key="d0">Financial and Human Resources</data>
      <data key="d1">Resource</data>
      <data key="d2">Financial and human resources are necessary for the effective functioning of AI regulatory sandboxes.</data>
      <data key="d3">chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35</data>
      <data key="d4">./cached_docs/recital_138.json</data>
      <data key="d5">1750858901</data>
    </node>
    <node id="Risk Mitigation Measures">
      <data key="d0">Risk Mitigation Measures</data>
      <data key="d1">RiskControl</data>
      <data key="d2">Risk Mitigation Measures are actions taken to reduce identified systemic risks related to AI models.&lt;SEP&gt;Risk mitigation measures are strategies implemented to reduce potential negative impacts associated with deploying AI technologies.&lt;SEP&gt;Risk mitigation measures involve strategies implemented to reduce the potential harm associated with the misuse of high-risk AI systems.</data>
      <data key="d3">chunk-65f69156748df83d9fa179140a3fe2aa&lt;SEP&gt;chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35&lt;SEP&gt;chunk-4fcd3af92cad1d85ebf561f059acb114</data>
      <data key="d4">./cached_docs/recital_65.json&lt;SEP&gt;./cached_docs/recital_164.json&lt;SEP&gt;./cached_docs/recital_138.json</data>
      <data key="d5">1750862667</data>
    </node>
    <node id="Innovation">
      <data key="d0">Innovation</data>
      <data key="d1">Change</data>
      <data key="d2">Innovation refers to the introduction of new ideas, methods, or products that support the advancement of technology and economy in the Union.&lt;SEP&gt;Innovation refers to the process of developing and implementing new ideas, particularly in the context of AI technologies.&lt;SEP&gt;Innovation refers to the processes and initiatives aimed at developing new technologies and methods in the context of AI.</data>
      <data key="d3">chunk-6c2f867de2be6cb439557f91700b051c&lt;SEP&gt;chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35&lt;SEP&gt;chunk-41cdee30f8345bc3690d876d77e6845c</data>
      <data key="d4">./cached_docs/recital_138.json&lt;SEP&gt;./cached_docs/recital_2.json&lt;SEP&gt;./cached_docs/recital_1.json</data>
      <data key="d5">1750863728</data>
    </node>
    <node id="Testing of AI Systems">
      <data key="d0">Testing of AI Systems</data>
      <data key="d1">AITechnique</data>
      <data key="d2">Testing of AI Systems involves evaluating high-risk AI technologies to ensure adherence to defined legal obligations.&lt;SEP&gt;Testing of AI systems refers to the processes used to evaluate AI technologies in controlled environments, such as regulatory sandboxes.</data>
      <data key="d3">chunk-6e853663a3f2d06a9cfea8582e10f089&lt;SEP&gt;chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35</data>
