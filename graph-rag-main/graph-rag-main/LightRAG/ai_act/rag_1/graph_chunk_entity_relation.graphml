      <data key="d0">Directive 96/9/EC</data>
      <data key="d1">Regulation</data>
      <data key="d2">Directive 96/9/EC addresses the legal protection of databases and outlines the rights of database producers.</data>
      <data key="d3">chunk-feb00b9eef4af47cdd3264cd99d6b2e4</data>
      <data key="d4">./cached_docs/recital_104.json</data>
