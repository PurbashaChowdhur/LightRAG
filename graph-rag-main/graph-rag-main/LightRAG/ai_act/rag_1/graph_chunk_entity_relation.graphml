      <data key="d1">Consequence</data>
      <data key="d2">Psychological harm refers to mental distress or negative effects on mental health resulting from AI-related incidents.</data>
      <data key="d3">chunk-7114fa80a4a18326b68b2fd61f65c047</data>
      <data key="d4">./cached_docs/recital_5.json</data>
