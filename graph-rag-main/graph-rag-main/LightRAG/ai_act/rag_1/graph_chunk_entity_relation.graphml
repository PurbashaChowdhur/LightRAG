    <node id="Article 19">
      <data key="d0">Article 19</data>
      <data key="d1">Regulation</data>
      <data key="d2">Article 19 includes provisions for adopting delegated acts concerning safety-related AI systems within the regulation framework.&lt;SEP&gt;Article 19 of Regulation (EU) 2019/1020 outlines the responsibilities of market surveillance authorities in taking appropriate measures.</data>
      <data key="d3">chunk-d7805654ce0fe0d8d9b6ba008562d2aa&lt;SEP&gt;chunk-a0779dfb4a5c0f82f05a67985fe0224a</data>
