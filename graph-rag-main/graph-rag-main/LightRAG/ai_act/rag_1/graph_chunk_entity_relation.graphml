      <data key="d0">social behaviour</data>
      <data key="d1">Data</data>
      <data key="d2">Social behaviour encompasses various actions and interactions of individuals that AI systems evaluate to determine their social score.</data>
      <data key="d3">chunk-28efea7f8fe5945cce5b7be57e88efe7</data>
      <data key="d4">./cached_docs/recital_31.json</data>
