      <data key="d1">CodeOfConduct</data>
      <data key="d2">Confidentiality rules are guidelines that members of national competent authorities must follow to maintain the secrecy and integrity of sensitive information.</data>
      <data key="d3">chunk-fe05ef9eea0acc63f05d5b9d6a147298</data>
