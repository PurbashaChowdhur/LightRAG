    </node>
    <node id="basic supplies">
      <data key="d0">basic supplies</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Basic supplies are essential goods and services necessary for sustaining human life and societal function.</data>
      <data key="d3">chunk-d91755cda6acde2b40257e6d4cef1695</data>
