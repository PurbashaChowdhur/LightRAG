      <data key="d5">1750858541</data>
    </node>
    <node id="Levels of Autonomy">
      <data key="d0">Levels of Autonomy</data>
      <data key="d1">AutomationLevel</data>
      <data key="d2">Levels of autonomy in AI systems signify the degree of independence from human involvement in decision-making or actions.</data>
      <data key="d3">chunk-907dfa7ec80255255b81cd50cd6a4494</data>
