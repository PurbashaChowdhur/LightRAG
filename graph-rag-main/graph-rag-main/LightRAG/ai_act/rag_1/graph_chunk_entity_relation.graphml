      <data key="d1">AIDeployer</data>
      <data key="d2">This authority is responsible for monitoring compliance and can take actions such as issuing objections or enforcing measures against non-compliant AI systems.</data>
      <data key="d3">chunk-28daf57045ce50f0bd160cddd41ffc14</data>
      <data key="d4">./cached_docs/article_79.json</data>
      <data key="d5">1750861814</data>
