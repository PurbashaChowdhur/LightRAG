    <node id="AI-Generated Content">
      <data key="d0">AI-Generated Content</data>
      <data key="d1">AISubject</data>
      <data key="d2">AI-generated content refers to any content created or manipulated by artificial intelligence systems.</data>
      <data key="d3">chunk-51cb0d95dff3b7f033b351a9352b26a0</data>
      <data key="d4">./cached_docs/recital_135.json</data>
      <data key="d5">1750860932</data>
    </node>
    <node id="Authenticity and Provenance">
      <data key="d0">Authenticity and Provenance</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Authenticity and provenance refer to the assessment of whether AI-generated content can be verified for its origin and integrity prior to dissemination.</data>
