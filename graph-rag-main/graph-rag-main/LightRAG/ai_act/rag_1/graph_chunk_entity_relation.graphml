    </node>
    <node id="Directive 2006/49/EC">
      <data key="d0">Directive 2006/49/EC</data>
      <data key="d1">Regulation</data>
      <data key="d2">Directive 2006/49/EC relates to the capital adequacy of investment firms and credit institutions, focusing on risk management practices.&lt;SEP&gt;This directive covered the capital adequacy requirements for investment firms, which has been repealed and amended.</data>
      <data key="d3">chunk-6b0054dbaea0e7f90c303fe7d7a824d2&lt;SEP&gt;chunk-18f422febe10e4293aaf989ea5e3d3e8</data>
      <data key="d4">./cached_docs/recital_158.json</data>
      <data key="d5">1750857264</data>
    </node>
    <node id="Solvency II">
      <data key="d0">Solvency II</data>
      <data key="d1">Regulation</data>
      <data key="d2">Solvency II is a European regulation that establishes requirements for the prudential supervision of insurance companies.</data>
      <data key="d3">chunk-6b0054dbaea0e7f90c303fe7d7a824d2</data>
      <data key="d4">./cached_docs/recital_158.json</data>
      <data key="d5">1750857264</data>
    </node>
    <node id="Prudential Supervision">
      <data key="d0">Prudential Supervision</data>
      <data key="d1">AICapability</data>
      <data key="d2">Prudential supervision involves regulatory checks and measures designed to ensure the safety and soundness of financial institutions, including credit institutions.</data>
      <data key="d3">chunk-bfa4c0995d224333f53196e26a30156b</data>
      <data key="d4">./cached_docs/recital_158.json</data>
      <data key="d5">1750857264</data>
    </node>
