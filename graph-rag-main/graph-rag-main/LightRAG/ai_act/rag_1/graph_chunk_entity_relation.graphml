    <node id="Consultancy Services">
      <data key="d0">Consultancy Services</data>
      <data key="d1">AICapability</data>
      <data key="d2">Consultancy Services refer to advisory roles or assistance related to the design and development of AI systems that must be avoided by notified bodies to maintain impartiality.</data>
