    <node id="Notification Period">
      <data key="d0">Notification Period</data>
      <data key="d1">Frequency</data>
      <data key="d2">The Notification Period is the three-month timeframe allowed for the European Parliament or Council to express objections against the delegated acts.</data>
      <data key="d3">chunk-da5fbf959baa6ee8e86278864a9144cc</data>
      <data key="d4">./cached_docs/article_97.json</data>
