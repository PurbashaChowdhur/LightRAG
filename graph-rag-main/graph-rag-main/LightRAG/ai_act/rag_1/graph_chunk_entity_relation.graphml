    <node id="Nationality">
      <data key="d0">Nationality</data>
      <data key="d1">Dimension</data>
      <data key="d2">Nationality is a specific trait used in profiling, indicating the country of citizenship of a natural person.</data>
      <data key="d3">chunk-4274f38f6b4aeff6dc2959e9e1a87f1a</data>
      <data key="d4">./cached_docs/recital_42.json</data>
