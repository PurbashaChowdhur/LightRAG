      <data key="d5">1750862693</data>
    </node>
    <node id="Commission Guidelines">
      <data key="d0">Commission Guidelines</data>
      <data key="d1">Documentation</data>
      <data key="d2">Commission Guidelines are documents that outline the necessary elements of a quality management system tailored for microenterprises.&lt;SEP&gt;The Commission Guidelines are documents that outline how microenterprises may comply with quality management system requirements in a simplified manner.</data>
      <data key="d3">chunk-ad25bfaa86145b8556e5d82696b8bab4&lt;SEP&gt;chunk-6e4f07f79ad3c90c82b86c0a02d0fae9</data>
