      <data key="d0">Philosophical Beliefs</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Philosophical beliefs pertain to an individual's views and values that may be inferred from analyzing biometric data.</data>
      <data key="d3">chunk-c3070277451614bdc67954ec8735dd80</data>
      <data key="d4">./cached_docs/recital_30.json</data>
