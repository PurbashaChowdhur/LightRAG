    <node id="AI Office Actions">
      <data key="d0">AI Office Actions</data>
      <data key="d1">AICapability</data>
      <data key="d2">AI Office Actions encompass the measures taken by the AI Office to address qualified alerts regarding AI models.</data>
      <data key="d3">chunk-140dff8b8263721e25ea86a4104c273d</data>
      <data key="d4">./cached_docs/article_90.json</data>
      <data key="d5">1750861590</data>
    </node>
    <node id="AI Board">
      <data key="d0">AI Board</data>
      <data key="d1">AISubject</data>
      <data key="d2">The AI Board is a governing body that is informed about alerts and assessments related to AI models.</data>
      <data key="d3">chunk-140dff8b8263721e25ea86a4104c273d</data>
      <data key="d4">./cached_docs/article_90.json</data>
      <data key="d5">1750861590</data>
    </node>
    <node id="Assessing Risks">
      <data key="d0">Assessing Risks</data>
      <data key="d1">AIComponent</data>
      <data key="d2">Assessing Risks involves evaluating the potential impacts and hazards associated with the deployment of AI models.</data>
      <data key="d3">chunk-140dff8b8263721e25ea86a4104c273d</data>
      <data key="d4">./cached_docs/article_90.json</data>
      <data key="d5">1750861590</data>
    </node>
    <node id="Point of Contact">
      <data key="d0">Point of Contact</data>
      <data key="d1">Data</data>
      <data key="d2">The Point of Contact is an individual or organization associated with the provider of the AI model relevant to specific risks.&lt;SEP&gt;The point of contact refers to the designated individual or entity responsible for communication regarding a specific general-purpose AI model.</data>
      <data key="d3">chunk-140dff8b8263721e25ea86a4104c273d&lt;SEP&gt;chunk-18d33fd192f06f727ac6bb21becbaa57</data>
