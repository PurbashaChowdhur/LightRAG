      <data key="d5">1750863646</data>
    </node>
    <node id="Sexual Exploitation">
      <data key="d0">Sexual Exploitation</data>
      <data key="d1">Consequence</data>
      <data key="d2">Sexual exploitation refers to the act of abusing another person for sexual purposes, which is highlighted as a concern in the context of human rights and safety.</data>
      <data key="d3">chunk-0073df6368131f4f385a66430ef1c4f4</data>
