      <data key="d0">public interest</data>
      <data key="d1">Purpose</data>
      <data key="d2">Public interest pertains to the welfare or well-being of the general public and is a key consideration in justifying the use of law enforcement tools.</data>
      <data key="d3">chunk-d91755cda6acde2b40257e6d4cef1695</data>
      <data key="d4">./cached_docs/recital_33.json</data>
      <data key="d5">1750857807</data>
    </node>
    <node id="missing persons">
      <data key="d0">missing persons</data>
      <data key="d1">AISubject</data>
      <data key="d2">Missing persons are individuals whose whereabouts are unknown and may require the use of law enforcement resources to locate.</data>
      <data key="d3">chunk-d91755cda6acde2b40257e6d4cef1695</data>
      <data key="d4">./cached_docs/recital_33.json</data>
      <data key="d5">1750857807</data>
    </node>
    <node id="terrorist attack">
      <data key="d0">terrorist attack</data>
      <data key="d1">Threat</data>
      <data key="d2">A terrorist attack is a violent act intended to create fear or harm, posing a significant risk to public safety.</data>
      <data key="d3">chunk-d91755cda6acde2b40257e6d4cef1695</data>
      <data key="d4">./cached_docs/recital_33.json</data>
      <data key="d5">1750857807</data>
    </node>
