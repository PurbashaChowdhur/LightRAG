    <node id="Power Imbalance">
      <data key="d0">Power Imbalance</data>
      <data key="d1">Dimension</data>
      <data key="d2">Power imbalance refers to the disparity of power or authority between those who deploy AI systems and those potentially affected by them.&lt;SEP&gt;The power imbalance in workplaces and educational settings can exacerbate the harmful effects of AI systems on specific groups or individuals.</data>
      <data key="d3">chunk-8dead6db59d178a53a4fc03ed67a92e7&lt;SEP&gt;chunk-50beca99a2207706ee9f0ad17a4205ff</data>
      <data key="d4">./cached_docs/recital_44.json&lt;SEP&gt;./cached_docs/article_7.json</data>
      <data key="d5">1750863901</data>
    </node>
    <node id="Prohibition of AI Systems">
      <data key="d0">Prohibition of AI Systems</data>
      <data key="d1">Regulation</data>
      <data key="d2">Prohibition of AI systems designed to detect emotional states in workplace and educational settings due to potential discrimination risks.</data>
      <data key="d3">chunk-8dead6db59d178a53a4fc03ed67a92e7</data>
      <data key="d4">./cached_docs/recital_44.json</data>
      <data key="d5">1750862725</data>
    </node>
    <node id="Therapeutic Use AI Systems">
      <data key="d0">Therapeutic Use AI Systems</data>
      <data key="d1">AICapability</data>
      <data key="d2">AI systems strictly intended for medical or safety reasons, such as therapeutic uses, are exempt from the prohibition.</data>
      <data key="d3">chunk-8dead6db59d178a53a4fc03ed67a92e7</data>
      <data key="d4">./cached_docs/recital_44.json</data>
      <data key="d5">1750862725</data>
    </node>
    <node id="Limited Reliability">
      <data key="d0">Limited Reliability</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Limited reliability indicates that AI systems have challenges consistently identifying or inferring emotions accurately.</data>
      <data key="d3">chunk-8dead6db59d178a53a4fc03ed67a92e7</data>
      <data key="d4">./cached_docs/recital_44.json</data>
      <data key="d5">1750862725</data>
    </node>
    <node id="Lack of Specificity">
      <data key="d0">Lack of Specificity</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Lack of specificity means AI systems fail to precisely identify emotions, leading to potential misinterpretations.</data>
      <data key="d3">chunk-8dead6db59d178a53a4fc03ed67a92e7</data>
      <data key="d4">./cached_docs/recital_44.json</data>
      <data key="d5">1750862725</data>
    </node>
    <node id="Limited Generalisability">
      <data key="d0">Limited Generalisability</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Limited generalisability highlights that findings from AI systems cannot be applied broadly across diverse populations or situations.</data>
      <data key="d3">chunk-8dead6db59d178a53a4fc03ed67a92e7</data>
      <data key="d4">./cached_docs/recital_44.json</data>
      <data key="d5">1750862725</data>
    </node>
    <node id="Discriminatory Outcomes">
      <data key="d0">Discriminatory Outcomes</data>
      <data key="d1">Consequence</data>
      <data key="d2">Discriminatory outcomes refer to adverse impacts on individuals or groups based on the inaccurate detection of emotions by AI systems.</data>
      <data key="d3">chunk-8dead6db59d178a53a4fc03ed67a92e7</data>
      <data key="d4">./cached_docs/recital_44.json</data>
      <data key="d5">1750862725</data>
    </node>
    <node id="Intrusiveness">
      <data key="d0">Intrusiveness</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Intrusiveness refers to the invasive nature of AI systems in monitoring personal emotional states, raising ethical concerns.</data>
      <data key="d3">chunk-8dead6db59d178a53a4fc03ed67a92e7</data>
      <data key="d4">./cached_docs/recital_44.json</data>
      <data key="d5">1750862725</data>
    </node>
    <node id="Market Placement Prohibition">
      <data key="d0">Market Placement Prohibition</data>
      <data key="d1">Regulation</data>
      <data key="d2">Market placement prohibition refers to the regulation against using AI systems for detecting emotions in sensitive contexts like workplaces and education.</data>
      <data key="d3">chunk-8dead6db59d178a53a4fc03ed67a92e7</data>
      <data key="d4">./cached_docs/recital_44.json</data>
      <data key="d5">1750862725</data>
    </node>
    <node id="High-Risk Uses">
      <data key="d0">High-Risk Uses</data>
      <data key="d1">AreaOfImpact</data>
      <data key="d2">High-risk uses are specific applications of AI systems that may pose significant risks to health, safety, or fundamental rights, as outlined in regulations.&lt;SEP&gt;High-risk uses are specific scenarios outlined in the Regulation where AI systems may pose greater risks.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a&lt;SEP&gt;chunk-4672fd3df7077626af67d20e46d3fcb4</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="Narrow Procedural Task AI System">
      <data key="d0">Narrow Procedural Task AI System</data>
      <data key="d1">AICapability</data>
      <data key="d2">An AI system intended to perform narrow procedural tasks, such as structuring unstructured data or classifying documents, with limited risks.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="Human Activity Improvement AI System">
      <data key="d0">Human Activity Improvement AI System</data>
      <data key="d1">AICapability</data>
      <data key="d2">AI systems designed to enhance the outcomes of human activities without materially influencing decision-making outcomes.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="Decision-Making Pattern Detection AI System">
      <data key="d0">Decision-Making Pattern Detection AI System</data>
      <data key="d1">AICapability</data>
      <data key="d2">AI systems intended to detect deviations from established decision-making patterns with minimal impact on human assessments.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="Preparatory Task AI System">
      <data key="d0">Preparatory Task AI System</data>
      <data key="d1">AICapability</data>
      <data key="d2">AI systems that perform preparatory tasks relevant for assessments, thus holding minimal expected outcomes.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="Legal Interests">
      <data key="d0">Legal Interests</data>
      <data key="d1">Dimension</data>
      <data key="d2">Legal interests are the interests protected under specific regulations that AI systems must not harm.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="Decision-Making">
      <data key="d0">Decision-Making</data>
      <data key="d1">Process</data>
      <data key="d2">Decision-making encompasses the processes involved in determining outcomes based on data, either human or automated.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="Procedural Task">
      <data key="d0">Procedural Task</data>
      <data key="d1">AICapability</data>
      <data key="d2">Procedural tasks are defined as narrow functions that AI systems can perform, such as data classification.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="Humans">
      <data key="d0">Humans</data>
      <data key="d1">AIUser</data>
      <data key="d2">Humans are individuals whose decision-making processes may be complemented or supplemented by AI systems.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="Narrow Context">
      <data key="d0">Narrow Context</data>
      <data key="d1">LocalityOfUse</data>
      <data key="d2">Narrow context refers to specific scenarios where the AI system operates with limited risk and minimal influence on decision-making outcomes.</data>
      <data key="d3">chunk-c5fb48082255c480535475ddb098366a</data>
      <data key="d4">./cached_docs/recital_53.json</data>
      <data key="d5">1750862729</data>
    </node>
    <node id="High-Risk Use Cases">
