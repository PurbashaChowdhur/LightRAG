      <data key="d0">Standardisation Activities</data>
      <data key="d1">Change</data>
      <data key="d2">Standardisation Activities involve the processes and actions taken to develop and implement standards for quality management systems applicable to high-risk AI.</data>
      <data key="d3">chunk-44eafa4c222bb60e722eca942751cf7d</data>
      <data key="d4">./cached_docs/recital_81.json</data>
      <data key="d5">1750857543</data>
