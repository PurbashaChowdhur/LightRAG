      <data key="d1">AIDeployer</data>
      <data key="d2">Tech Innovators Inc. is a company that deploys AI models for various applications and focuses on automation.</data>
      <data key="d3">chunk-c553e9efc5dc64a6a2019d8e611bb1c8</data>
      <data key="d4">./cached_docs/article_104.json</data>
      <data key="d5">1750863887</data>
    </node>
    <node id="AICapabilities">
      <data key="d0">AICapabilities</data>
      <data key="d1">AICapability</data>
      <data key="d2">AICapabilities refer to the functions and features of AI systems that enhance automation and decision-making.</data>
      <data key="d3">chunk-c553e9efc5dc64a6a2019d8e611bb1c8</data>
      <data key="d4">./cached_docs/article_104.json</data>
      <data key="d5">1750863887</data>
    </node>
    <node id="Output Quality">
      <data key="d0">Output Quality</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Output Quality is measured by the effectiveness and reliability of the results produced by AI models.</data>
      <data key="d3">chunk-c553e9efc5dc64a6a2019d8e611bb1c8</data>
      <data key="d4">./cached_docs/article_104.json</data>
      <data key="d5">1750863887</data>
    </node>
    <node id="Metrics">
      <data key="d0">Metrics</data>
      <data key="d1">Metric</data>
      <data key="d2">Metrics are quantifiable measures used to assess the performance of AI models, including accuracy and precision.</data>
      <data key="d3">chunk-c553e9efc5dc64a6a2019d8e611bb1c8</data>
      <data key="d4">./cached_docs/article_104.json</data>
      <data key="d5">1750863887</data>
    </node>
    <node id="GDPR Regulations">
      <data key="d0">GDPR Regulations</data>
      <data key="d1">Regulation</data>
      <data key="d2">GDPR Regulations are legal guidelines for data protection and privacy in the European Union that companies must adhere to when handling personal data.</data>
      <data key="d3">chunk-c553e9efc5dc64a6a2019d8e611bb1c8</data>
      <data key="d4">./cached_docs/article_104.json</data>
      <data key="d5">1750863887</data>
    </node>
    <node id="AI system purpose">
      <data key="d0">AI system purpose</data>
      <data key="d1">Purpose</data>
      <data key="d2">The intended purpose of an AI system refers to the specific objectives it is designed to achieve.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="data processed">
      <data key="d0">data processed</data>
      <data key="d1">Data</data>
      <data key="d2">Data processed by an AI system includes any information that is input into the system, particularly noting special categories of personal data.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="autonomous action">
      <data key="d0">autonomous action</data>
      <data key="d1">AICapability</data>
      <data key="d2">The degree to which an AI system can operate independently and the ability for humans to override its decisions.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="harm to health and safety">
      <data key="d0">harm to health and safety</data>
      <data key="d1">Impact</data>
      <data key="d2">This refers to the potential detrimental effects an AI system may have on human health and safety.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="adverse impact on fundamental rights">
      <data key="d0">adverse impact on fundamental rights</data>
      <data key="d1">Impact</data>
      <data key="d2">Refers to negative consequences that an AI system may have on individuals' fundamental rights.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="vulnerable position">
      <data key="d0">vulnerable position</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Assessment of whether potential victims are in a position of disadvantage relative to the deployer of the AI system.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="easily corrigible outcome">
      <data key="d0">easily corrigible outcome</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Assessment of whether an outcome produced by an AI system can be easily corrected or reversed.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="criteria for assessment">
      <data key="d0">criteria for assessment</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">The criteria for assessing high-risk AI systems include intended purpose, data processing, autonomy, and potential for harm or adverse impact.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="intended purpose">
      <data key="d0">intended purpose</data>
      <data key="d1">Purpose</data>
      <data key="d2">The intended purpose refers to the specific roles or functions that AI systems are designed to fulfill in various applications.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="extent of use">
      <data key="d0">extent of use</data>
      <data key="d1">Metric</data>
      <data key="d2">The extent of use measures how frequently or widely an AI system is employed in relevant domains, impacting its risk profile.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="nature and amount of data">
      <data key="d0">nature and amount of data</data>
      <data key="d1">Data</data>
      <data key="d2">This refers to the types and volume of data that AI systems process, which can influence their risk assessments, especially concerning personal data.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="autonomy of AI system">
      <data key="d0">autonomy of AI system</data>
      <data key="d1">AICapability</data>
      <data key="d2">The level of autonomy indicates how independently an AI system operates and the implications for human oversight and accountability.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="human override possibilities">
      <data key="d0">human override possibilities</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">This considers the degree to which human operators can intervene or reverse decisions made by an AI system.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="cases of harm">
      <data key="d0">cases of harm</data>
      <data key="d1">Consequence</data>
      <data key="d2">Cases of harm document incidents where AI systems have negatively impacted health, safety, or rights, influencing regulatory assessments.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="potential for harm">
      <data key="d0">potential for harm</data>
      <data key="d1">Risk</data>
      <data key="d2">Potential for harm evaluates the severity and likelihood of adverse outcomes produced by an AI system on users and affected groups.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="imbalance of power">
      <data key="d0">imbalance of power</data>
      <data key="d1">RiskConcept</data>
      <data key="d2">Imbalance of power assesses the dynamics between those deploying AI systems and those affected by their outcomes.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="correctable or reversible outcomes">
      <data key="d0">correctable or reversible outcomes</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Correctable or reversible outcomes refer to whether the results produced by AI systems can be modified or undone without significant consequences.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="benefit magnitude and likelihood">
      <data key="d0">benefit magnitude and likelihood</data>
      <data key="d1">Metric</data>
      <data key="d2">Benefit magnitude assesses the potential positive impact of AI systems, balanced against the risks they pose to individuals and society.</data>
      <data key="d3">chunk-fe49d95d50900e82a706b2766339562f</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863895</data>
    </node>
    <node id="Likelihood of Harm">
      <data key="d0">Likelihood of Harm</data>
      <data key="d1">Metric</data>
      <data key="d2">Likelihood of harm quantifies the probability that an AI system could cause adverse effects to individuals or groups.</data>
      <data key="d3">chunk-50beca99a2207706ee9f0ad17a4205ff</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863901</data>
    </node>
    <node id="Deployer of AI System">
      <data key="d0">Deployer of AI System</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">The deployer of an AI system is the entity or individual that implements or releases the AI technology into practical use.</data>
      <data key="d3">chunk-50beca99a2207706ee9f0ad17a4205ff</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863901</data>
    </node>
    <node id="Vulnerability">
      <data key="d0">Vulnerability</data>
      <data key="d1">Dimension</data>
      <data key="d2">Vulnerability describes the state of individuals or groups who are at risk of being adversely affected by the actions or outcomes of an AI system.</data>
      <data key="d3">chunk-50beca99a2207706ee9f0ad17a4205ff</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863901</data>
    </node>
    <node id="Technical Solutions for Correction">
      <data key="d0">Technical Solutions for Correction</data>
      <data key="d1">AICapability</data>
      <data key="d2">Technical solutions for correction involve methods or technologies available to adjust or reverse adverse outcomes produced by AI systems.</data>
      <data key="d3">chunk-50beca99a2207706ee9f0ad17a4205ff</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863901</data>
    </node>
    <node id="Union Law Security Measures">
      <data key="d0">Union Law Security Measures</data>
      <data key="d1">Regulation</data>
      <data key="d2">Union law security measures establish legal protocols and protections necessary to mitigate risks posed by AI systems to individuals and society.</data>
      <data key="d3">chunk-50beca99a2207706ee9f0ad17a4205ff</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863901</data>
    </node>
    <node id="Criteria for Risk Assessment">
      <data key="d0">Criteria for Risk Assessment</data>
      <data key="d1">Metric</data>
      <data key="d2">Criteria for risk assessment are the standards and benchmarks used to evaluate the potential risks associated with an AI system.</data>
      <data key="d3">chunk-50beca99a2207706ee9f0ad17a4205ff</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863906</data>
    </node>
    <node id="Effective Measures of Redress">
      <data key="d0">Effective Measures of Redress</data>
      <data key="d1">Regulation</data>
      <data key="d2">Effective Measures of Redress refer to legal mechanisms provided under Union law to address risks posed by AI systems.&lt;SEP&gt;Effective measures of redress outline legal channels and protections available to individuals adversely affected by AI systems.</data>
      <data key="d3">chunk-cb0291da832d9defa94aaf2262ad3761&lt;SEP&gt;chunk-50beca99a2207706ee9f0ad17a4205ff</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863906</data>
    </node>
    <node id="Redress Measures">
      <data key="d0">Redress Measures</data>
      <data key="d1">Consequence</data>
      <data key="d2">Redress measures refer to the compensatory and remedial actions available to individuals affected by harmful outcomes of AI systems.</data>
      <data key="d3">chunk-50beca99a2207706ee9f0ad17a4205ff</data>
      <data key="d4">./cached_docs/article_7.json</data>
      <data key="d5">1750863906</data>
    </node>
    <node id="User Interface">
      <data key="d0">User Interface</data>
      <data key="d1">AIComponent</data>
      <data key="d2">User Interfaces are components added to AI Models to transform them into functioning AI Systems.</data>
      <data key="d3">chunk-161f3120961644fbdc17c7b09b46e54b</data>
      <data key="d4">./cached_docs/recital_97.json</data>
      <data key="d5">1750863925</data>
    </node>
    <node id="Potential Negative Effects">
      <data key="d0">Potential Negative Effects</data>
      <data key="d1">Consequence</data>
      <data key="d2">Potential Negative Effects refer to the significant risks associated with the deployment of General-Purpose AI Models, especially those with systemic risks.</data>
      <data key="d3">chunk-161f3120961644fbdc17c7b09b46e54b</data>
      <data key="d4">./cached_docs/recital_97.json</data>
      <data key="d5">1750863931</data>
    </node>
    <node id="Training Methods">
      <data key="d0">Training Methods</data>
      <data key="d1">AITechnique</data>
      <data key="d2">Training Methods such as self-supervised, unsupervised, and reinforcement learning are techniques used to develop General-Purpose AI Models.</data>
      <data key="d3">chunk-161f3120961644fbdc17c7b09b46e54b</data>
      <data key="d4">./cached_docs/recital_97.json</data>
      <data key="d5">1750863931</data>
    </node>
    <node id="Integration into AI Systems">
      <data key="d0">Integration into AI Systems</data>
      <data key="d1">AICapability</data>
      <data key="d2">Integration into AI Systems describes the process of incorporating General-Purpose AI Models with various components to create a functional AI System.</data>
      <data key="d3">chunk-161f3120961644fbdc17c7b09b46e54b</data>
      <data key="d4">./cached_docs/recital_97.json</data>
      <data key="d5">1750863931</data>
    </node>
    <node id="Modification of AI Models">
      <data key="d0">Modification of AI Models</data>
      <data key="d1">Change</data>
      <data key="d2">Modification of AI Models refers to the alteration or fine-tuning of existing General-Purpose AI Models into new versions.</data>
      <data key="d3">chunk-161f3120961644fbdc17c7b09b46e54b</data>
      <data key="d4">./cached_docs/recital_97.json</data>
      <data key="d5">1750863931</data>
    </node>
    <node id="Research, Development and Prototyping Activities">
      <data key="d0">Research, Development and Prototyping Activities</data>
      <data key="d1">Purpose</data>
      <data key="d2">Research, Development, and Prototyping Activities involve the initial phases of creating and testing AI models before market placement.</data>
      <data key="d3">chunk-b89491b02af0a00cbc13f9e8df827a6d</data>
      <data key="d4">./cached_docs/recital_97.json</data>
      <data key="d5">1750863931</data>
    </node>
    <node id="AI-enabled manipulative techniques">
      <data key="d0">AI-enabled manipulative techniques</data>
      <data key="d1">AITechnique</data>
      <data key="d2">AI-enabled manipulative techniques are methods that persuade individuals to engage in unwanted behaviors or deceive them into making decisions that impair their autonomy.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863934</data>
    </node>
    <node id="certain AI systems">
      <data key="d0">certain AI systems</data>
      <data key="d1">AISystem</data>
      <data key="d2">Certain AI systems are designed to materially distort human behavior, potentially causing significant harm to physical, psychological health, or financial interests.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863934</data>
    </node>
    <node id="subliminal components">
      <data key="d0">subliminal components</data>
      <data key="d1">AIComponent</data>
      <data key="d2">Subliminal components are stimuli such as audio or visual elements that are beyond human perception and can manipulate behavior without conscious awareness.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863934</data>
    </node>
    <node id="machine-brain interfaces">
      <data key="d0">machine-brain interfaces</data>
      <data key="d1">AICapability</data>
      <data key="d2">Machine-brain interfaces enhance the ability of AI systems to control stimuli presented to a person, potentially distorting their behavior in harmful ways.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863934</data>
    </node>
    <node id="virtual reality">
      <data key="d0">virtual reality</data>
      <data key="d1">AICapability</data>
      <data key="d2">Virtual reality technology allows for significant control over stimuli, which can influence human behavior, often in ways that are not consciously perceived by the individual.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863934</data>
    </node>
    <node id="vulnerabilities of persons">
      <data key="d0">vulnerabilities of persons</data>
      <data key="d1">HumanInvolvement</data>
      <data key="d2">Vulnerabilities refer to specific traits or circumstances of individuals that AI systems might exploit, such as age, disability, or economic hardship.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863940</data>
    </node>
    <node id="significant harm">
      <data key="d0">significant harm</data>
      <data key="d1">Impact</data>
      <data key="d2">Significant harm refers to the adverse effects that can result from the deployment of certain AI systems, affecting individuals or groups over time.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863940</data>
    </node>
    <node id="manipulative practices">
      <data key="d0">manipulative practices</data>
      <data key="d1">AITechnique</data>
      <data key="d2">Manipulative practices involve techniques used by AI systems to influence human behavior in ways that individuals may not consciously recognize or control.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863940</data>
    </node>
    <node id="deceptive techniques">
      <data key="d0">deceptive techniques</data>
      <data key="d1">AITechnique</data>
      <data key="d2">Deceptive techniques are strategies employed by AI systems that mislead individuals, impairing their decision-making capacities and autonomy.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863940</data>
    </node>
    <node id="provider of AI systems">
      <data key="d0">provider of AI systems</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">The provider of AI systems is responsible for the design and implementation of AI technologies, potentially influencing human behaviors through manipulative or deceptive practices.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863940</data>
    </node>
    <node id="deployer of AI systems">
      <data key="d0">deployer of AI systems</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">The deployer of AI systems refers to individuals or organizations that put AI technologies into use, which may impact the behaviors and choices of others.</data>
      <data key="d3">chunk-7a0ae2ebdd7c0c6e56069b878ca85c78</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863940</data>
    </node>
    <node id="Persons Living in Extreme Poverty">
      <data key="d0">Persons Living in Extreme Poverty</data>
      <data key="d1">AISubject</data>
      <data key="d2">This group is considered vulnerable due to their economic situation, which can make them susceptible to exploitation through AI systems.</data>
      <data key="d3">chunk-41b3ba2302e956849a6be7455071577d</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863940</data>
    </node>
    <node id="Ethnic and Religious Minorities">
      <data key="d0">Ethnic and Religious Minorities</data>
      <data key="d1">AISubject</data>
      <data key="d2">Ethnic and religious minorities may be disproportionately affected by AI systems that exploit vulnerabilities.</data>
      <data key="d3">chunk-41b3ba2302e956849a6be7455071577d</data>
      <data key="d4">./cached_docs/recital_29.json</data>
      <data key="d5">1750863940</data>
    </node>
    <node id="Directive 2005/29/EC">
      <data key="d0">Directive 2005/29/EC</data>
      <data key="d1">Regulation</data>
      <data key="d2">Directive 2005/29/EC addresses unfair business-to-consumer commercial practices, including those facilitated by AI systems, prohibiting manipulative and exploitative practices.&lt;SEP&gt;Directive 2005/29/EC focuses on prohibiting unfair commercial practices, ensuring consumer protection against exploitative behaviors.</data>
