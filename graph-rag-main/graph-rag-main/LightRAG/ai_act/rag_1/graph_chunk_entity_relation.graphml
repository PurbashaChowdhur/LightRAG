      <data key="d0">Administrative Burdens</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Administrative burdens include the paperwork and procedural complexities that providers must navigate during compliance assessments.</data>
      <data key="d3">chunk-d1d974005cd87fc21678c732472ee11a</data>
