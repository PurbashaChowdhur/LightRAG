    <node id="Standardisation requests">
      <data key="d0">Standardisation requests</data>
      <data key="d1">Change</data>
      <data key="d2">Standardisation requests are formal proposals issued by the Commission to ensure that AI systems meet legislative requirements and promote best practices for development.</data>
      <data key="d3">chunk-2739984aae71aa27a0af867bc197b730</data>
      <data key="d4">./cached_docs/article_40.json</data>
      <data key="d5">1750861602</data>
    </node>
    <node id="European standardisation organisations">
      <data key="d0">European standardisation organisations</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">European standardisation organisations are groups that develop and maintain standards to ensure that products, including AI systems, are safe and compliant.&lt;SEP&gt;European standardisation organisations are responsible for approving standardisation requests relevant to the compliance of regulations.</data>
      <data key="d3">chunk-d6fc829d58f1a7bbf3defd5cbe758b8f&lt;SEP&gt;chunk-2739984aae71aa27a0af867bc197b730</data>
