    <node id="Commission Decision of 24.1.2024">
      <data key="d0">Commission Decision of 24.1.2024</data>
      <data key="d1">Regulation</data>
      <data key="d2">The Commission Decision is a formal decision made by regulatory authorities, establishing the foundation for the European Artificial Intelligence Office.</data>
      <data key="d3">chunk-bb2945aab237268f7fcb2f55fd258be4</data>
      <data key="d4">./cached_docs/recital_148.json</data>
      <data key="d5">1750857907</data>
    </node>
    <node id="C(2024) 390">
      <data key="d0">C(2024) 390</data>
      <data key="d1">Document</data>
      <data key="d2">C(2024) 390 is a specific document that details the legal basis for the establishment of the European Artificial Intelligence Office.</data>
      <data key="d3">chunk-bb2945aab237268f7fcb2f55fd258be4</data>
      <data key="d4">./cached_docs/recital_148.json</data>
      <data key="d5">1750857907</data>
    </node>
    <node id="national competent authorities">
      <data key="d0">national competent authorities</data>
      <data key="d1">AISubject</data>
      <data key="d2">National competent authorities are entities that oversee the implementation and enforcement of regulations relevant to AI practices.&lt;SEP&gt;National competent authorities are organizations responsible for overseeing the compliance of AI systems with regulatory standards and ensuring public safety.&lt;SEP&gt;National competent authorities are government entities responsible for monitoring and enforcing compliance of AI systems within their jurisdiction.</data>
      <data key="d3">chunk-595952fa3e7e47cb312adaaad303b73c&lt;SEP&gt;chunk-69b5f24963810305f2a7846d54923bf0&lt;SEP&gt;chunk-46418d497e0c090818a97380d173293d</data>
      <data key="d4">./cached_docs/recital_116.json&lt;SEP&gt;./cached_docs/article_36.json&lt;SEP&gt;./cached_docs/article_18.json</data>
      <data key="d5">1750863789</data>
    </node>
    <node id="technical documentation">
      <data key="d0">technical documentation</data>
      <data key="d1">Documentation</data>
      <data key="d2">Technical documentation encompasses all relevant information about the AI system's design, functionality, and data handling, as required by regulatory authorities.&lt;SEP&gt;Technical documentation represents the collection of documents that detail the specifications and compliance measures for high-risk AI systems.&lt;SEP&gt;Technical documentation provides detailed information demonstrating that the high-risk AI system complies with established requirements, aiding in regulatory assessments.</data>
      <data key="d3">chunk-46418d497e0c090818a97380d173293d&lt;SEP&gt;chunk-36cb0fd5abf1b169a8aa13021f58c7b2&lt;SEP&gt;chunk-69838403e8b59bb122436a0d25a9fc1e</data>
      <data key="d4">./cached_docs/article_43.json&lt;SEP&gt;./cached_docs/article_11.json&lt;SEP&gt;./cached_docs/article_18.json</data>
      <data key="d5">1750863761</data>
    </node>
    <node id="quality management system">
      <data key="d0">quality management system</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">A quality management system refers to the processes and procedures used to ensure that an AI system meets quality and safety standards.</data>
      <data key="d3">chunk-46418d497e0c090818a97380d173293d</data>
      <data key="d4">./cached_docs/article_18.json</data>
      <data key="d5">1750857910</data>
    </node>
    <node id="EU declaration of conformity">
      <data key="d0">EU declaration of conformity</data>
      <data key="d1">Documentation</data>
      <data key="d2">The EU declaration of conformity is an official document declaring that an AI system meets all relevant EU standards and regulations.</data>
      <data key="d3">chunk-46418d497e0c090818a97380d173293d</data>
      <data key="d4">./cached_docs/article_18.json</data>
      <data key="d5">1750857910</data>
    </node>
    <node id="Union financial services law">
      <data key="d0">Union financial services law</data>
      <data key="d1">Regulation</data>
      <data key="d2">Union financial services law includes regulatory requirements applicable to financial institutions regarding governance and documentation standards.</data>
      <data key="d3">chunk-46418d497e0c090818a97380d173293d</data>
      <data key="d4">./cached_docs/article_18.json</data>
      <data key="d5">1750857910</data>
    </node>
    <node id="changes approved by notified bodies">
      <data key="d0">changes approved by notified bodies</data>
      <data key="d1">Change</data>
      <data key="d2">Changes approved by notified bodies document alterations to AI systems that are deemed necessary for compliance or improvement.</data>
      <data key="d3">chunk-46418d497e0c090818a97380d173293d</data>
      <data key="d4">./cached_docs/article_18.json</data>
      <data key="d5">1750857910</data>
    </node>
    <node id="decisions and documents by notified bodies">
      <data key="d0">decisions and documents by notified bodies</data>
      <data key="d1">Documentation</data>
      <data key="d2">Decisions and documents by notified bodies provide formal records of approvals, rejections, or required actions concerning AI systems.</data>
      <data key="d3">chunk-46418d497e0c090818a97380d173293d</data>
      <data key="d4">./cached_docs/article_18.json</data>
      <data key="d5">1750857910</data>
    </node>
    <node id="Union values">
      <data key="d0">Union values</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Union values emphasize respect for human dignity, freedom, equality, democracy, and rule of law, guiding ethical considerations around AI use.</data>
      <data key="d3">chunk-14f663363e3d8f01aa5c0b361bddc380</data>
      <data key="d4">./cached_docs/recital_28.json</data>
      <data key="d5">1750857912</data>
    </node>
    <node id="Manipulative Practices">
      <data key="d0">Manipulative Practices</data>
      <data key="d1">Consequence</data>
      <data key="d2">Manipulative practices refer to actions that exploit individuals economically or financially, particularly in the context of AI use.&lt;SEP&gt;Manipulative practices refer to harmful and abusive uses of AI that exploit individuals and societal structures.</data>
      <data key="d3">chunk-17045c951f494f621b2305960aade53f&lt;SEP&gt;chunk-14f663363e3d8f01aa5c0b361bddc380</data>
      <data key="d4">./cached_docs/recital_29.json&lt;SEP&gt;./cached_docs/recital_28.json</data>
      <data key="d5">1750863949</data>
    </node>
    <node id="Exploitation">
      <data key="d0">Exploitation</data>
      <data key="d1">Risk</data>
      <data key="d2">Exploitation as a consequence highlights the potential risks associated with the misuse of AI technologies in society.&lt;SEP&gt;Exploitation refers to the harmful manipulation of vulnerable individuals or groups by AI systems, leading to significant adverse effects.</data>
      <data key="d3">chunk-14f663363e3d8f01aa5c0b361bddc380&lt;SEP&gt;chunk-41b3ba2302e956849a6be7455071577d</data>
      <data key="d4">./cached_docs/recital_29.json&lt;SEP&gt;./cached_docs/recital_28.json</data>
      <data key="d5">1750863949</data>
    </node>
    <node id="Social Control Practices">
      <data key="d0">Social Control Practices</data>
      <data key="d1">Risk</data>
      <data key="d2">Social control practices represent another harmful aspect of AI misuse, challenging fundamental rights and freedoms in society.</data>
      <data key="d3">chunk-14f663363e3d8f01aa5c0b361bddc380</data>
      <data key="d4">./cached_docs/recital_28.json</data>
      <data key="d5">1750857912</data>
    </node>
    <node id="AI Misuse">
      <data key="d0">AI Misuse</data>
      <data key="d1">Risk</data>
      <data key="d2">AI Misuse refers to the improper utilization of artificial intelligence technologies that can lead to harmful consequences such as manipulation and social control.</data>
      <data key="d3">chunk-14f663363e3d8f01aa5c0b361bddc380</data>
      <data key="d4">./cached_docs/recital_28.json</data>
      <data key="d5">1750857912</data>
    </node>
    <node id="Human Dignity">
      <data key="d0">Human Dignity</data>
      <data key="d1">Dimension</data>
      <data key="d2">Human Dignity is a fundamental value that emphasizes the inherent worth of every individual and must be respected in the context of AI applications.&lt;SEP&gt;The right to human dignity is a core fundamental right that must be safeguarded, particularly in relation to AI impact on individuals' lives.&lt;SEP&gt;Human dignity is a fundamental principle ensuring that AI systems respect individual rights and autonomy in their design and implementation.</data>
      <data key="d3">chunk-14f663363e3d8f01aa5c0b361bddc380&lt;SEP&gt;chunk-256a6003a5841f2764536c55f7086431&lt;SEP&gt;chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_27.json&lt;SEP&gt;./cached_docs/recital_48.json&lt;SEP&gt;./cached_docs/recital_28.json</data>
      <data key="d5">1750859455</data>
    </node>
    <node id="Freedom">
      <data key="d0">Freedom</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Freedom represents the state of being free, a key component that should be preserved against potential abuses of AI technology.</data>
      <data key="d3">chunk-14f663363e3d8f01aa5c0b361bddc380</data>
      <data key="d4">./cached_docs/recital_28.json</data>
      <data key="d5">1750857912</data>
    </node>
    <node id="Equality">
      <data key="d0">Equality</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Equality is the principle of treating all individuals with equal respect and rights, which is threatened by the misuse of AI technologies.</data>
      <data key="d3">chunk-14f663363e3d8f01aa5c0b361bddc380</data>
      <data key="d4">./cached_docs/recital_28.json</data>
      <data key="d5">1750857912</data>
    </node>
    <node id="Democracy">
      <data key="d0">Democracy</data>
      <data key="d1">Dimension</data>
      <data key="d2">Democracy refers to a system of government where the principles of individual rights and collective decision-making are upheld, which can be compromised by AI misuse.&lt;SEP&gt;Democracy represents the governing principle that ensures participation, representation, and fairness in the Union's political processes.</data>
      <data key="d3">chunk-41cdee30f8345bc3690d876d77e6845c&lt;SEP&gt;chunk-14f663363e3d8f01aa5c0b361bddc380</data>
      <data key="d4">./cached_docs/recital_2.json&lt;SEP&gt;./cached_docs/recital_28.json</data>
      <data key="d5">1750862966</data>
    </node>
    <node id="Rule of Law">
      <data key="d0">Rule of Law</data>
      <data key="d1">Dimension</data>
      <data key="d2">Rule of Law is the principle that all individuals and institutions are accountable to the law, ensuring justice and equality.&lt;SEP&gt;Rule of Law signifies the importance of laws applied equally to all, and the potential for AI misuse to undermine this principle.</data>
      <data key="d3">chunk-41cdee30f8345bc3690d876d77e6845c&lt;SEP&gt;chunk-14f663363e3d8f01aa5c0b361bddc380</data>
      <data key="d4">./cached_docs/recital_2.json&lt;SEP&gt;./cached_docs/recital_28.json</data>
      <data key="d5">1750862966</data>
    </node>
    <node id="Union Values">
      <data key="d0">Union Values</data>
      <data key="d1">Dimension</data>
      <data key="d2">Union values emphasize principles such as human-centric design, trustworthiness, and protecting fundamental rights in the context of AI.&lt;SEP&gt;Union values reflect the principles enshrined in the Treaty on European Union, guiding the development of AI.</data>
      <data key="d3">chunk-6c2f867de2be6cb439557f91700b051c&lt;SEP&gt;chunk-cde8f1eff9bf42001a30603a860556d1</data>
      <data key="d4">./cached_docs/recital_1.json&lt;SEP&gt;./cached_docs/recital_6.json</data>
      <data key="d5">1750863718</data>
    </node>
    <node id="&quot;Article 2 of the Treaty on European Union (TEU)">
      <data key="d0">"Article 2 of the Treaty on European Union (TEU)</data>
      <data key="d1">Regulation</data>
      <data key="d2">Article 2 of TEU outlines essential values that AI development must adhere to, focusing on human dignity and rights.</data>
      <data key="d3">chunk-cde8f1eff9bf42001a30603a860556d1</data>
      <data key="d4">./cached_docs/recital_6.json</data>
      <data key="d5">1750857920</data>
    </node>
    <node id="Treaties">
      <data key="d0">Treaties</data>
      <data key="d1">Document</data>
      <data key="d2">The Treaties encapsulate fundamental rights and freedoms that inform the regulatory framework for AI.</data>
      <data key="d3">chunk-cde8f1eff9bf42001a30603a860556d1</data>
      <data key="d4">./cached_docs/recital_6.json</data>
      <data key="d5">1750857920</data>
    </node>
    <node id="Article 6 TEU">
      <data key="d0">Article 6 TEU</data>
      <data key="d1">Regulation</data>
      <data key="d2">Article 6 of TEU establishes the protection of fundamental rights and outlines the Charter's role in guiding AI.</data>
      <data key="d3">chunk-cde8f1eff9bf42001a30603a860556d1</data>
      <data key="d4">./cached_docs/recital_6.json</data>
      <data key="d5">1750857920</data>
    </node>
    <node id="The Charter">
      <data key="d0">The Charter</data>
      <data key="d1">Document</data>
      <data key="d2">The Charter sets forth fundamental rights and freedoms that must be respected in AI development.</data>
      <data key="d3">chunk-cde8f1eff9bf42001a30603a860556d1</data>
      <data key="d4">./cached_docs/recital_6.json</data>
      <data key="d5">1750857920</data>
    </node>
    <node id="Human-Centric Technology">
      <data key="d0">Human-Centric Technology</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Human-centric technology prioritizes human well-being and serves as a beneficial tool for individuals.</data>
      <data key="d3">chunk-cde8f1eff9bf42001a30603a860556d1</data>
      <data key="d4">./cached_docs/recital_6.json</data>
      <data key="d5">1750857920</data>
    </node>
    <node id="Regulatory Framework">
      <data key="d0">Regulatory Framework</data>
      <data key="d1">Regulation</data>
      <data key="d2">A regulatory framework consists of the laws and guidelines established to ensure the safe use and integration of AI technologies.&lt;SEP&gt;Regulatory framework encompasses the set of laws and guidelines that govern the conformity assessments conducted by notified bodies.&lt;SEP&gt;The Regulatory Framework outlines the principles and guidelines for the ethical development and use of AI.&lt;SEP&gt;The regulatory framework refers to the system of laws and guidelines that govern the use and assessment of AI systems.</data>
      <data key="d3">chunk-cde8f1eff9bf42001a30603a860556d1&lt;SEP&gt;chunk-be2e0f993ca9c4e593e5fcbdd8fc03fe&lt;SEP&gt;chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35&lt;SEP&gt;chunk-9b7fd511ed97ef1a87c9783c3425b7d4</data>
      <data key="d4">./cached_docs/recital_138.json&lt;SEP&gt;./cached_docs/recital_173.json&lt;SEP&gt;./cached_docs/recital_6.json&lt;SEP&gt;./cached_docs/article_31.json</data>
      <data key="d5">1750861939</data>
    </node>
    <node id="Article 2 of the Treaty on European Union (TEU)">
      <data key="d0">Article 2 of the Treaty on European Union (TEU)</data>
      <data key="d1">Regulation</data>
      <data key="d2">Article 2 TEU emphasizes the importance of human dignity and rights in the development and deployment of AI systems.</data>
      <data key="d3">chunk-cde8f1eff9bf42001a30603a860556d1</data>
      <data key="d4">./cached_docs/recital_6.json</data>
      <data key="d5">1750857920</data>
    </node>
    <node id="Human Well-Being">
      <data key="d0">Human Well-Being</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Human well-being reflects the collective health, happiness, and quality of life that AI aims to enhance through its applications.</data>
      <data key="d3">chunk-cde8f1eff9bf42001a30603a860556d1</data>
      <data key="d4">./cached_docs/recital_6.json</data>
      <data key="d5">1750857924</data>
    </node>
    <node id="AI as a Tool">
      <data key="d0">AI as a Tool</data>
      <data key="d1">AICapability</data>
      <data key="d2">AI should function as a tool that serves people, improving their capabilities and quality of life.</data>
      <data key="d3">chunk-cde8f1eff9bf42001a30603a860556d1</data>
      <data key="d4">./cached_docs/recital_6.json</data>
      <data key="d5">1750857924</data>
    </node>
    <node id="Accessible Formats">
      <data key="d0">Accessible Formats</data>
      <data key="d1">Data</data>
      <data key="d2">Accessible formats are necessary for persons with disabilities to receive information about their interactions with AI systems.</data>
      <data key="d3">chunk-eb43ec5a01dc502046ab6ffbe3a25504</data>
      <data key="d4">./cached_docs/recital_132.json</data>
      <data key="d5">1750857932</data>
    </node>
    <node id="Personal Traits">
      <data key="d0">Personal Traits</data>
      <data key="d1">Data</data>
      <data key="d2">Personal traits such as sex, age, hair color, eye color, tattoos, and ethnic origin can be categories assigned by AI systems when processing data.</data>
      <data key="d3">chunk-eb43ec5a01dc502046ab6ffbe3a25504</data>
      <data key="d4">./cached_docs/recital_132.json</data>
      <data key="d5">1750857932</data>
    </node>
    <node id="Emotions and Intentions">
      <data key="d0">Emotions and Intentions</data>
      <data key="d1">Data</data>
      <data key="d2">Emotions and intentions refer to the inferred psychological states of natural persons when their biometric data is processed by AI systems.</data>
      <data key="d3">chunk-eb43ec5a01dc502046ab6ffbe3a25504</data>
      <data key="d4">./cached_docs/recital_132.json</data>
      <data key="d5">1750857932</data>
    </node>
    <node id="Content Generation Risks">
      <data key="d0">Content Generation Risks</data>
      <data key="d1">Risk</data>
      <data key="d2">Content generation risks involve issues such as impersonation or deception that may arise when using AI systems.</data>
      <data key="d3">chunk-eb43ec5a01dc502046ab6ffbe3a25504</data>
      <data key="d4">./cached_docs/recital_132.json</data>
      <data key="d5">1750857932</data>
    </node>
    <node id="Deception Risks">
      <data key="d0">Deception Risks</data>
      <data key="d1">Risk</data>
      <data key="d2">Deception risks are associated with AI systems that may mislead individuals about their capabilities or impersonate human interactions.</data>
      <data key="d3">chunk-eb43ec5a01dc502046ab6ffbe3a25504</data>
      <data key="d4">./cached_docs/recital_132.json</data>
      <data key="d5">1750857932</data>
    </node>
    <node id="disabilities">
      <data key="d0">disabilities</data>
      <data key="d1">Dimension</data>
      <data key="d2">Disabilities refer to a range of conditions that affect a person's ability to function in various aspects of life, impacting their engagement with technology and systems.</data>
      <data key="d3">chunk-aab48a13d1c4363ad8edd440c125d4a3</data>
      <data key="d4">./cached_docs/recital_132.json</data>
      <data key="d5">1750857932</data>
    </node>
    <node id="Disabilities">
      <data key="d0">Disabilities</data>
      <data key="d1">Dimension</data>
      <data key="d2">Disabilities are characteristics that can affect the fairness and accuracy of biometric systems, leading to discriminatory uses.&lt;SEP&gt;Disabilities refer to a range of physical, cognitive, and emotional conditions that impact an individual's ability to perform daily activities and engage with technology.</data>
      <data key="d3">chunk-aab48a13d1c4363ad8edd440c125d4a3&lt;SEP&gt;chunk-b65e9562dd645622f1390ba1863fee19</data>
      <data key="d4">./cached_docs/recital_54.json&lt;SEP&gt;./cached_docs/recital_132.json</data>
      <data key="d5">1750862028</data>
    </node>
    <node id="Accessibility">
      <data key="d0">Accessibility</data>
      <data key="d1">AICapability</data>
      <data key="d2">Accessibility is the design of products, devices, services, or environments for people with disabilities, ensuring inclusivity and ease of use.</data>
      <data key="d3">chunk-aab48a13d1c4363ad8edd440c125d4a3</data>
      <data key="d4">./cached_docs/recital_132.json</data>
      <data key="d5">1750857932</data>
    </node>
    <node id="Inclusion">
      <data key="d0">Inclusion</data>
      <data key="d1">AICapability</data>
      <data key="d2">Inclusion refers to the practice of providing equal access and opportunities to individuals with disabilities, promoting participation in various areas.</data>
      <data key="d3">chunk-aab48a13d1c4363ad8edd440c125d4a3</data>
      <data key="d4">./cached_docs/recital_132.json</data>
      <data key="d5">1750857932</data>
    </node>
    <node id="Assistive Technology">
      <data key="d0">Assistive Technology</data>
      <data key="d1">AIComponent</data>
      <data key="d2">Assistive Technology consists of devices and software designed to enhance the functional capabilities of individuals with disabilities.</data>
      <data key="d3">chunk-aab48a13d1c4363ad8edd440c125d4a3</data>
      <data key="d4">./cached_docs/recital_132.json</data>
      <data key="d5">1750857932</data>
    </node>
    <node id="Empowerment">
      <data key="d0">Empowerment</data>
      <data key="d1">AreaOfImpact</data>
      <data key="d2">Empowerment in the context of disabilities refers to enabling individuals with disabilities to have control over their own lives and decisions.</data>
      <data key="d3">chunk-aab48a13d1c4363ad8edd440c125d4a3</data>
