      <data key="d0">Risk of Criminal Offences</data>
      <data key="d1">Risk</data>
      <data key="d2">Risk of criminal offences relates to the likelihood of individuals becoming victims of crimes that AI systems aim to assess.</data>
      <data key="d3">chunk-bbcf833252ce65fd6a1d8bd1f5a6efc1</data>
      <data key="d4">./cached_docs/recital_59.json</data>
