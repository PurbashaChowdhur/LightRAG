    <node id="Sustainability Impact">
      <data key="d0">Sustainability Impact</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Sustainability impact measures how AI systems affect environmental sustainability, including energy-efficient practices.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240</data>
      <data key="d4">./cached_docs/article_95.json</data>
      <data key="d5">1750858929</data>
    </node>
    <node id="Governance Mechanisms">
      <data key="d0">Governance Mechanisms</data>
      <data key="d1">AICapability</data>
      <data key="d2">Governance mechanisms are structures and processes established to ensure ethical practices in the deployment and operation of AI systems.&lt;SEP&gt;Governance mechanisms refer to the frameworks and processes in place to manage and oversee AI systems and their deployment.</data>
      <data key="d3">chunk-b71cdb20a8fa5befb7c30c90163cd416&lt;SEP&gt;chunk-064e3e5273a81cd8d9a47da9a3f51240</data>
