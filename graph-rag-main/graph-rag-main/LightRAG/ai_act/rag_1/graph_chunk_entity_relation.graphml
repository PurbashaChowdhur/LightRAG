      <data key="d0">Approved Code of Practice</data>
      <data key="d1">CodeOfConduct</data>
      <data key="d2">An approved code of practice outlines the standards and protocols that must be adhered to in compliance with regulations.</data>
      <data key="d3">chunk-fce1cda52753ec9e5183762f5b2c81b1</data>
      <data key="d4">./cached_docs/article_55.json</data>
      <data key="d5">1750857803</data>
    </node>
    <node id="European Harmonised Standard">
      <data key="d0">European Harmonised Standard</data>
      <data key="d1">Standard</data>
      <data key="d2">A European harmonised standard serves as a guideline for compliance within specific industries or sectors in Europe.</data>
      <data key="d3">chunk-fce1cda52753ec9e5183762f5b2c81b1</data>
