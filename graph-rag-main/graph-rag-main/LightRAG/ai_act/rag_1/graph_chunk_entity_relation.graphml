      <data key="d0">stadiums</data>
      <data key="d1">Dimension</data>
      <data key="d2">Stadiums are large venues used for sports and entertainment, allowing public attendance.</data>
      <data key="d3">chunk-19ac689968d1b5ce1db014f781096bd3</data>
