      <data key="d5">1750858541</data>
    </node>
    <node id="Law-Enforcement Authorities">
      <data key="d0">Law-Enforcement Authorities</data>
      <data key="d1">AISubject</data>
      <data key="d2">Law-enforcement authorities are agencies responsible for maintaining public order and may use high-risk AI systems in urgent situations.</data>
      <data key="d3">chunk-e07ee6b3452d764ccd9733dceadb1ac7</data>
      <data key="d4">./cached_docs/article_46.json</data>
      <data key="d5">1750858544</data>
    </node>
    <node id="Civil Protection Authorities">
      <data key="d0">Civil Protection Authorities</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">Civil protection authorities are responsible for emergency management and can also deploy high-risk AI systems in urgent cases.&lt;SEP&gt;Civil protection authorities are tasked with ensuring public safety during emergencies, which may involve the deployment of AI technologies.</data>
      <data key="d3">chunk-878d589bc7b69ae2d9c3a44284a1badc&lt;SEP&gt;chunk-e07ee6b3452d764ccd9733dceadb1ac7</data>
