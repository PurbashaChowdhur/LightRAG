      <data key="d0">localization of perpetrators</data>
      <data key="d1">AICapability</data>
      <data key="d2">The localization of perpetrators involves identifying and locating individuals suspected of committing crimes.</data>
      <data key="d3">chunk-d91755cda6acde2b40257e6d4cef1695</data>
      <data key="d4">./cached_docs/recital_33.json</data>
      <data key="d5">1750857807</data>
    </node>
    <node id="custodial sentence">
      <data key="d0">custodial sentence</data>
      <data key="d1">LegalBasis</data>
      <data key="d2">A custodial sentence is a penalty whereby an offender is sentenced to imprisonment for a specified period.</data>
      <data key="d3">chunk-d91755cda6acde2b40257e6d4cef1695</data>
      <data key="d4">./cached_docs/recital_33.json</data>
