    </node>
    <node id="Data Governance">
      <data key="d0">Data Governance</data>
      <data key="d1">Standard</data>
      <data key="d2">Data governance comprises the policies and standards to ensure that data is managed and protected properly in compliance with regulations.&lt;SEP&gt;Data governance refers to the management framework to ensure the quality, privacy, and compliance of data used in AI systems.&lt;SEP&gt;Data governance refers to the management of data quality, privacy, and compliance with legal standards in AI systems.</data>
      <data key="d3">chunk-d7eb8204c84c6a7310e75effed716fcf&lt;SEP&gt;chunk-7d18c3755735a13a436e766a5ca73fc4&lt;SEP&gt;chunk-256a6003a5841f2764536c55f7086431</data>
