    </node>
    <node id="Performance">
      <data key="d0">Performance</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Performance refers to how well an AI system meets its requirements in terms of accuracy, reliability, and effectiveness.</data>
