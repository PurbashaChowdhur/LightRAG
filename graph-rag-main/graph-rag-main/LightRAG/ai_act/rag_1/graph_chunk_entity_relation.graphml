    <node id="Freedom of Assembly and Association">
      <data key="d0">Freedom of Assembly and Association</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">This right protects individuals' ability to gather and associate with others, relevant when considering AI surveillance impacts.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
