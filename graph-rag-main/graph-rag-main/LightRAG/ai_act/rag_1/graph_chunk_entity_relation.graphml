    <node id="Voting Procedures">
      <data key="d0">Voting Procedures</data>
      <data key="d1">Process</data>
      <data key="d2">Voting Procedures outline the methods and rules for making decisions within the Board through a two-thirds majority.</data>
      <data key="d3">chunk-83ca16d466deaa751e3b9dc390e91e2f</data>
