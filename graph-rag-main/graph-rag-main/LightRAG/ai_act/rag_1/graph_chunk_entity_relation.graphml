      <data key="d0">Articles 51, 91 to 94</data>
      <data key="d1">Regulation</data>
      <data key="d2">Articles 51, 91 to 94 provide the framework for assessment and measures to be taken regarding AI models posing risks.</data>
      <data key="d3">chunk-140dff8b8263721e25ea86a4104c273d</data>
      <data key="d4">./cached_docs/article_90.json</data>
      <data key="d5">1750861590</data>
    </node>
    <node id="Qualified Alert">
      <data key="d0">Qualified Alert</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">A Qualified Alert is a specific notification by a scientific panel that prompts the Commission to examine a General-Purpose AI Model for potential systemic risks.&lt;SEP&gt;A qualified alert is a formal notification provided by the scientific panel to the Commission regarding potential systemic risks.&lt;SEP&gt;A qualified alert is a notification issued by the scientific panel indicating potential risks associated with a general-purpose AI model.</data>
      <data key="d3">chunk-140dff8b8263721e25ea86a4104c273d&lt;SEP&gt;chunk-c1ef1c9ca92c002cf6ad36264fe1292c&lt;SEP&gt;chunk-3e23bb4c71b510fec0bbe6570de37cd5</data>
