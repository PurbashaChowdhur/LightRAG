      <data key="d5">1750863550</data>
    </node>
    <node id="Controlled Environment">
      <data key="d0">Controlled Environment</data>
      <data key="d1">Domain</data>
      <data key="d2">A controlled environment is a setting established to test and evaluate AI systems under strict regulations.</data>
      <data key="d3">chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35</data>
      <data key="d4">./cached_docs/recital_138.json</data>
      <data key="d5">1750858901</data>
    </node>
