    </node>
    <node id="Energy-Efficient Programming">
      <data key="d0">Energy-Efficient Programming</data>
      <data key="d1">AICapability</data>
      <data key="d2">Energy-efficient programming refers to techniques aimed at reducing the energy consumption of AI systems during their operation and training.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240</data>
      <data key="d4">./cached_docs/article_95.json</data>
