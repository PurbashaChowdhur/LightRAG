    <node id="Societal Harm">
      <data key="d0">Societal Harm</data>
      <data key="d1">Consequence</data>
      <data key="d2">Societal harm comprises adverse effects on the social fabric and community well-being due to the application of AI.</data>
      <data key="d3">chunk-7114fa80a4a18326b68b2fd61f65c047</data>
      <data key="d4">./cached_docs/recital_5.json</data>
      <data key="d5">1750861087</data>
    </node>
    <node id="Economic Harm">
      <data key="d0">Economic Harm</data>
      <data key="d1">Consequence</data>
      <data key="d2">Economic harm involves negative financial impacts that can result from the deployment of AI systems.</data>
