      <data key="d5">1750863646</data>
    </node>
    <node id="Detrimental Treatment">
      <data key="d0">Detrimental Treatment</data>
      <data key="d1">Consequence</data>
      <data key="d2">Detrimental treatment refers to adverse outcomes faced by individuals or groups due to the use of AI systems for emotional detection.&lt;SEP&gt;Detrimental treatment refers to the negative or unfair treatment of natural persons or groups based on their social score or other inferred characteristics.</data>
      <data key="d3">chunk-83317eda1161cf5d13ef9aa07297c98b&lt;SEP&gt;chunk-8dead6db59d178a53a4fc03ed67a92e7</data>
