      <data key="d4">./cached_docs/recital_48.json</data>
      <data key="d5">1750859201</data>
    </node>
    <node id="Right to Fair Trial">
      <data key="d0">Right to Fair Trial</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">This right guarantees due process and a fair legal process, crucial in the context of AI's impact on justice systems.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_48.json</data>
      <data key="d5">1750859201</data>
    </node>
    <node id="Right of Defence">
      <data key="d0">Right of Defence</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">This right ensures individuals can defend themselves in legal settings, relevant when AI systems influence judicial outcomes.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
      <data key="d4">./cached_docs/recital_48.json</data>
      <data key="d5">1750859201</data>
    </node>
    <node id="Presumption of Innocence">
      <data key="d0">Presumption of Innocence</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">This legal principle ensures individuals are considered innocent until proven guilty, particularly relevant in AI-driven legal decisions.</data>
      <data key="d3">chunk-0e284955c1d36330bd14d117bb417611</data>
