      <data key="d0">Policies Relating to Credit Institutions</data>
      <data key="d1">Domain</data>
      <data key="d2">Policies relating to credit institutions define the guidelines and regulations that govern the operations of banks and financial entities in relation to their financial stability and market conduct.</data>
      <data key="d3">chunk-bfa4c0995d224333f53196e26a30156b</data>
      <data key="d4">./cached_docs/recital_158.json</data>
      <data key="d5">1750857264</data>
    </node>
