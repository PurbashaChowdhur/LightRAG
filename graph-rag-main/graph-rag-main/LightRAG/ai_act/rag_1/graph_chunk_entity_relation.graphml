      <data key="d1">AITechnique</data>
      <data key="d2">Text and data mining techniques are methods used for retrieving and analyzing content, often involving the extraction of information from large datasets.</data>
      <data key="d3">chunk-5429fed5961ecea1e5eed049e922476f</data>
      <data key="d4">./cached_docs/recital_105.json</data>
      <data key="d5">1750863667</data>
