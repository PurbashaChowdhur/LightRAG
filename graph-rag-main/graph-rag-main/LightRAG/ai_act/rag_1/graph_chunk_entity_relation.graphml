    <node id="Data Governance Act">
      <data key="d0">Data Governance Act</data>
      <data key="d1">Regulation</data>
      <data key="d2">The Data Governance Act establishes regulations for the governance of data use and access within the EU.</data>
      <data key="d3">chunk-f182220530b59a4450fc951016283bfc</data>
      <data key="d4">./cached_docs/recital_141.json</data>
      <data key="d5">1750861057</data>
