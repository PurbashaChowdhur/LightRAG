    <node id="Copyright Exceptions and Limitations">
      <data key="d0">Copyright Exceptions and Limitations</data>
      <data key="d1">Regulation</data>
      <data key="d2">Copyright exceptions and limitations allow for certain uses of protected works without permission, particularly for text and data mining under specified conditions.</data>
      <data key="d3">chunk-5429fed5961ecea1e5eed049e922476f</data>
      <data key="d4">./cached_docs/recital_105.json</data>
      <data key="d5">1750863667</data>
    </node>
    <node id="Text and Data Mining Provisions">
      <data key="d0">Text and Data Mining Provisions</data>
      <data key="d1">Regulation</data>
      <data key="d2">Text and data mining provisions allow researchers to analyze copyrighted material under set circumstances, enhancing research capabilities in various fields.</data>
      <data key="d3">chunk-5429fed5961ecea1e5eed049e922476f</data>
