    </node>
    <node id="personal characteristics">
      <data key="d0">personal characteristics</data>
      <data key="d1">Data</data>
      <data key="d2">Personal characteristics are attributes of individuals that are analyzed by AI systems to influence social scoring outcomes.</data>
      <data key="d3">chunk-28efea7f8fe5945cce5b7be57e88efe7</data>
      <data key="d4">./cached_docs/recital_31.json</data>
