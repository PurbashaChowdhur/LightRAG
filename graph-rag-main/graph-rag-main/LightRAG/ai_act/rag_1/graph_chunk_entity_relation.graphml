    <node id="Decision No 768/2008/EC">
      <data key="d0">Decision No 768/2008/EC</data>
      <data key="d1">Regulation</data>
      <data key="d2">Decision No 768/2008/EC details the framework for placing high-risk AI systems and ensuring compliance with Union law.&lt;SEP&gt;Decision No 768/2008/EC presents a common framework for the marketing of products, repealing earlier decisions and aiming for streamlined regulations.</data>
      <data key="d3">chunk-a5ff05678672211287e9053ebcd9c1c6&lt;SEP&gt;chunk-c28a81721b7de3ef4442495cc499b1cb</data>
      <data key="d4">./cached_docs/recital_9.json</data>
      <data key="d5">1750863124</data>
    </node>
    <node id="Council Directive 85/374/EEC">
      <data key="d0">Council Directive 85/374/EEC</data>
      <data key="d1">Regulation</data>
      <data key="d2">Council Directive 85/374/EEC addresses liability for defective products across Member States, providing guidelines for legal frameworks.&lt;SEP&gt;Council Directive 85/374/EEC establishes liability for defective products, relevant in the context of AI systems causing harm.&lt;SEP&gt;The Council Directive 85/374/EEC addresses the harmonization of laws concerning liability for defective products across Member States.</data>
      <data key="d3">chunk-a5ff05678672211287e9053ebcd9c1c6&lt;SEP&gt;chunk-c28a81721b7de3ef4442495cc499b1cb&lt;SEP&gt;chunk-620a69f3197e8df8e7c863ebf2c2155c</data>
      <data key="d4">./cached_docs/recital_9.json</data>
      <data key="d5">1750863130</data>
    </node>
    <node id="National Labour Law">
      <data key="d0">National Labour Law</data>
      <data key="d1">Regulation</data>
      <data key="d2">National Labour Law governs employment relationships and workers' rights, impacting AI systems' deployment in workplace settings.&lt;SEP&gt;National labour law encompasses the legislation that governs working conditions and employee rights at a country level, influencing the broader context of the Regulation.</data>
      <data key="d3">chunk-8b474f9815c7033ca1ad8daff4012eff&lt;SEP&gt;chunk-c28a81721b7de3ef4442495cc499b1cb</data>
      <data key="d4">./cached_docs/recital_9.json</data>
      <data key="d5">1750863137</data>
    </node>
    <node id="Rights and Remedies">
      <data key="d0">Rights and Remedies</data>
      <data key="d1">QualityMeasurement</data>
