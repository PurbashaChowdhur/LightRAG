      <data key="d5">1750863073</data>
    </node>
    <node id="Member States Competent Authorities">
      <data key="d0">Member States Competent Authorities</data>
      <data key="d1">AIDeployer</data>
      <data key="d2">Member States’ competent authorities are tasked with establishing AI regulatory sandboxes and ensuring compliance with regulatory frameworks.</data>
      <data key="d3">chunk-4cdf1c7e7ad7fe2c6b1b8f1b0b12db35</data>
      <data key="d4">./cached_docs/recital_138.json</data>
      <data key="d5">1750858901</data>
    </node>
    <node id="Union Ethical Guidelines for Trustworthy AI">
      <data key="d0">Union Ethical Guidelines for Trustworthy AI</data>
      <data key="d1">Standard</data>
      <data key="d2">Union ethical guidelines provide a framework for assessing and ensuring the trustworthiness of AI applications.</data>
      <data key="d3">chunk-064e3e5273a81cd8d9a47da9a3f51240</data>
