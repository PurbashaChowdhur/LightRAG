    <node id="Persons acting as whistleblowers">
      <data key="d0">Persons acting as whistleblowers</data>
      <data key="d1">AISubject</data>
      <data key="d2">Whistleblowers are individuals who report wrongdoing or infringements of regulations and are afforded legal protection under Union law.</data>
      <data key="d3">chunk-e74c582b50b1dcae6565f7384ebbe5e1</data>
      <data key="d4">./cached_docs/recital_172.json</data>
