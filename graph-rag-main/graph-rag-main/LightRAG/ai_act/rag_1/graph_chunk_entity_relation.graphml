    <node id="Article 47">
      <data key="d0">Article 47</data>
      <data key="d1">DocumentSection</data>
      <data key="d2">Article 47 concerns delegated acts for AI safety components, ensuring alignment with the regulatory requirements laid out previously.</data>
      <data key="d3">chunk-d7805654ce0fe0d8d9b6ba008562d2aa</data>
      <data key="d4">./cached_docs/article_108.json</data>
