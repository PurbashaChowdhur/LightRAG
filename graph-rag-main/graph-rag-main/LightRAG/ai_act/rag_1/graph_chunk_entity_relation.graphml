    <node id="Micro- and Small Enterprises">
      <data key="d0">Micro- and Small Enterprises</data>
      <data key="d1">Stakeholder</data>
      <data key="d2">Micro- and small enterprises are considered when assessing the compliance burden in relation to high-risk AI systems.</data>
      <data key="d3">chunk-d1d974005cd87fc21678c732472ee11a</data>
