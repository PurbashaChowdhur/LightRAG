      <data key="d1">Regulation</data>
      <data key="d2">The GDPR is a comprehensive regulation focused on protecting personal data and privacy in the European Union, setting guidelines for data processing and data subjects' rights.</data>
      <data key="d3">chunk-15eee417af0ebe299ed66be76a0b845a</data>
      <data key="d4">./cached_docs/recital_10.json</data>
      <data key="d5">1750862268</data>
    </node>
