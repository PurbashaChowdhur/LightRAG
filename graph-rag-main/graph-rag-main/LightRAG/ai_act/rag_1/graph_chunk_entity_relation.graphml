    <node id="Model Retraining">
      <data key="d0">Model Retraining</data>
      <data key="d1">AILifecyclePhase</data>
      <data key="d2">Model Retraining involves updating AI models with new data to maintain their accuracy and relevance over time.</data>
      <data key="d3">chunk-7963b30391bfa3d5e28ecd9a95b61010</data>
      <data key="d4">./cached_docs/recital_88.json</data>
