    <node id="Adverse Impacts">
      <data key="d0">Adverse Impacts</data>
      <data key="d1">Consequence</data>
      <data key="d2">Adverse impacts refer to negative effects on individuals or groups as a result of the use of AI systems, particularly in law enforcement.</data>
      <data key="d3">chunk-bbcf833252ce65fd6a1d8bd1f5a6efc1</data>
