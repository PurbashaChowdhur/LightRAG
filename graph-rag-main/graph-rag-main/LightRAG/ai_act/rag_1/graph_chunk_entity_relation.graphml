    </node>
    <node id="Implementation Commitments">
      <data key="d0">Implementation Commitments</data>
      <data key="d1">Commitment</data>
      <data key="d2">Implementation commitments are promises made by participants to adhere to the objectives and measures outlined in the codes of practice.</data>
      <data key="d3">chunk-f6de18717bcb0167956be85a15dd210f</data>
      <data key="d4">./cached_docs/article_56.json</data>
      <data key="d5">1750857367</data>
