    </node>
    <node id="Sex Life">
      <data key="d0">Sex Life</data>
      <data key="d1">QualityMeasurement</data>
      <data key="d2">Sex life refers to personal and private information that could be inferred through the analysis of biometric data.</data>
      <data key="d3">chunk-c3070277451614bdc67954ec8735dd80</data>
      <data key="d4">./cached_docs/recital_30.json</data>
      <data key="d5">1750858860</data>
    </node>
    <node id="Sexual Orientation">
      <data key="d0">Sexual Orientation</data>
      <data key="d1">Dimension</data>
      <data key="d2">Sexual orientation describes the pattern of emotional, romantic, or sexual attraction, which may be inferred from biometric data.&lt;SEP&gt;Sexual orientation is an important aspect of identity captured under biometric categorisation.</data>
      <data key="d3">chunk-ac04e8bc9dd9ff3998ce3c08f3800f57&lt;SEP&gt;chunk-c3070277451614bdc67954ec8735dd80</data>
