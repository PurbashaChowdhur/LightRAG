    <node id="Housing">
      <data key="d0">Housing</data>
      <data key="d1">AreaOfImpact</data>
      <data key="d2">Housing refers to the public interest sector where AI systems might be deployed to manage resources and ensure fairness.</data>
      <data key="d3">chunk-3a1d78baf29c07c65edc311f0ca04126</data>
      <data key="d4">./cached_docs/recital_96.json</data>
      <data key="d5">1750858038</data>
    </node>
    <node id="Administration of Justice">
      <data key="d0">Administration of Justice</data>
      <data key="d1">AreaOfImpact</data>
      <data key="d2">The administration of justice is crucial in maintaining rights and may involve high-risk AI systems in decision-making processes.</data>
      <data key="d3">chunk-3a1d78baf29c07c65edc311f0ca04126</data>
