    <node id="EU Competitiveness in AI">
      <data key="d0">EU Competitiveness in AI</data>
      <data key="d1">AreaOfImpact</data>
      <data key="d2">This refers to the examination of trends regarding Europe's global competitiveness in the AI sector.</data>
