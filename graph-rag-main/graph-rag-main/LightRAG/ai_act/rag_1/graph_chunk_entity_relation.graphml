    </node>
    <node id="gyms">
      <data key="d0">gyms</data>
      <data key="d1">Dimension</data>
      <data key="d2">Gyms provide fitness spaces that are usually open for public membership and attendance.</data>
      <data key="d3">chunk-19ac689968d1b5ce1db014f781096bd3</data>
      <data key="d4">./cached_docs/recital_19.json</data>
