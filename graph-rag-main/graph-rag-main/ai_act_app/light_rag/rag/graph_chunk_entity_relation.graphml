      <data key="d9">chunk-898711e7e6ddb7ddaceadb36ff94f179</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/107/</data>
      <data key="d11">1748426241</data>
    </edge>
    <edge source="AI Office" target="Conformity Assessment System">
      <data key="d6">7.0</data>
      <data key="d7">The AI Office is responsible for overseeing the implementation of the Conformity Assessment System as part of regulatory compliance.</data>
      <data key="d8">compliance,oversight</data>
      <data key="d9">chunk-f567c4be37bce779f921de15ad5f2a7f</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/179/</data>
