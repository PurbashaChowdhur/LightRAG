      <data key="d10">https://artificialintelligenceact.eu/article/83/</data>
      <data key="d11">1748425969</data>
    </edge>
    <edge source="market surveillance authority" target="notified body">
      <data key="d6">9.0</data>
      <data key="d7">The market surveillance authority acts as a notified body for high-risk AI systems used by law enforcement and Union institutions.</data>
      <data key="d8">oversight,regulatory compliance</data>
      <data key="d9">chunk-7480046fc569a1b54a7d243d7d5a87b1</data>
      <data key="d10">https://artificialintelligenceact.eu/article/43/</data>
      <data key="d11">1748426498</data>
    </edge>
    <edge source="market surveillance authority" target="deployers">
      <data key="d6">7.0</data>
      <data key="d7">Deployers must notify the market surveillance authority about the outcomes of their impact assessments and any risks identified.</data>
      <data key="d8">compliance notification,regulatory oversight</data>
