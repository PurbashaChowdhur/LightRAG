      <data key="d10">https://artificialintelligenceact.eu/recital/37/</data>
      <data key="d11">1748427850</data>
    </edge>
    <edge source="Member State" target="European Commission">
      <data key="d6">8.0</data>
      <data key="d7">Member States designate experts to consult with the European Commission, reflecting the collaboration in the legislative process.</data>
      <data key="d8">consultation,legislative collaboration</data>
