      <data key="d9">chunk-c88552f4423ec18db9bfb3db0f708349</data>
      <data key="d10">https://artificialintelligenceact.eu/article/30/</data>
      <data key="d11">1748426299</data>
    </edge>
    <edge source="remote biometric identification system" target="real-time systems">
      <data key="d6">7.0</data>
      <data key="d7">Real-time systems are a subtype of remote biometric identification systems that process data instantly, enhancing identification capabilities.</data>
      <data key="d8">real-time processing,system classification</data>
      <data key="d9">chunk-54d70bbcd80c52a665c6844c0f583b00</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/17/</data>
      <data key="d11">1748426309</data>
    </edge>
    <edge source="remote biometric identification system" target="post systems">
      <data key="d6">6.0</data>
      <data key="d7">Post systems differ from real-time systems as they process biometric data after it has been captured, affecting identification timing.</data>
      <data key="d8">data processing,system classification</data>
      <data key="d9">chunk-54d70bbcd80c52a665c6844c0f583b00</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/17/</data>
      <data key="d11">1748426309</data>
    </edge>
    <edge source="remote biometric identification system" target="real-time remote biometric identification system">
      <data key="d6">9.0</data>
      <data key="d7">Real-time remote biometric identification systems are specific types of remote biometric identification systems."|</data>
      <data key="d8">9</data>
      <data key="d9">chunk-3a3264abf04a576ae16d704acaaf3687</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="remote biometric identification system" target="law enforcement authority">
      <data key="d6">8.0</data>
      <data key="d7">Remote biometric identification systems are utilized by law enforcement authorities to identify individuals without their consent, enhancing crime prevention efforts.</data>
      <data key="d8">public security,technology-use</data>
      <data key="d9">chunk-94ebfb1fa7d304078345c66a61c6ecc1</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Penalties" target="Application Date">
      <data key="d6">7.0</data>
      <data key="d7">The penalties will come into effect on the Application Date, indicating enforcement of compliance.</data>
      <data key="d8">enforcement timeline,regulatory penalties</data>
      <data key="d9">chunk-f519e0fb15239a9e7db009ac6e0ed402</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/179/</data>
      <data key="d11">1748426328</data>
    </edge>
    <edge source="AI-enabled manipulative techniques" target="persons">
      <data key="d6">9.0</data>
      <data key="d7">AI-enabled manipulative techniques may influence persons to make decisions without being conscious of the manipulative tactics involved.</data>
      <data key="d8">decision-making,manipulation</data>
      <data key="d9">chunk-21a89ce17cf59281aee293dc5db92f0b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI-enabled manipulative techniques" target="machine-brain interfaces">
      <data key="d6">8.0</data>
      <data key="d7">Machine-brain interfaces can facilitate AI-enabled manipulative techniques by providing enhanced control over stimuli affecting persons' behavior.</data>
      <data key="d8">manipulation,technology</data>
      <data key="d9">chunk-21a89ce17cf59281aee293dc5db92f0b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI-enabled manipulative techniques" target="virtual reality">
      <data key="d6">8.0</data>
      <data key="d7">Virtual reality can serve as a medium for AI-enabled manipulative techniques, affecting how persons perceive reality and make decisions.</data>
      <data key="d8">manipulation,technology</data>
      <data key="d9">chunk-21a89ce17cf59281aee293dc5db92f0b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI-enabled manipulative techniques" target="Significant Harms">
      <data key="d6">10.0</data>
      <data key="d7">AI-enabled manipulative techniques are directly linked to significant harms that can affect various aspects of a person's life including health and finances.</data>
      <data key="d8">harm,impact</data>
      <data key="d9">chunk-21a89ce17cf59281aee293dc5db92f0b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI-enabled manipulative techniques" target="Vulnerable Groups">
      <data key="d6">8.0</data>
      <data key="d7">Vulnerable groups are more likely to be affected by AI-enabled manipulative techniques due to their precarious social or economic situations.</data>
      <data key="d8">exploitation,risk</data>
      <data key="d9">chunk-21a89ce17cf59281aee293dc5db92f0b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI-enabled manipulative techniques" target="Manipulative Techniques">
      <data key="d6">9.0</data>
      <data key="d7">AI-enabled manipulative techniques explicitly use manipulative techniques to exert control over individuals' decision-making processes.</data>
      <data key="d8">control,manipulation</data>
      <data key="d9">chunk-21a89ce17cf59281aee293dc5db92f0b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="Person's Autonomy" target="Persons">
      <data key="d6">9.0</data>
      <data key="d7">The ability of persons to make independent choices is tied to their autonomy, which can be compromised through manipulative practices.</data>
      <data key="d8">autonomy,decision-making</data>
      <data key="d9">chunk-21a89ce17cf59281aee293dc5db92f0b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="Vulnerable Groups" target="Regulation (EU) 2022/868">
      <data key="d6">9.0</data>
      <data key="d7">Regulation (EU) 2022/868 includes provisions for protecting vulnerable groups during the testing of AI systems to minimize associated risks.</data>
      <data key="d8">ethical testing,safeguards</data>
      <data key="d9">chunk-06455acfb04ed0ea0e1fcd7b8fa89595</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/141/</data>
      <data key="d11">1748426696</data>
    </edge>
    <edge source="Vulnerable Groups" target="Risk to Health or Safety">
      <data key="d6">7.0</data>
      <data key="d7">AI systems must consider the risks they pose to Vulnerable Groups during compliance evaluations.</data>
      <data key="d8">ethical consideration,risk assessment</data>
      <data key="d9">chunk-d5ec7e335819a5f1bde0e8d27164f300</data>
      <data key="d10">https://artificialintelligenceact.eu/article/79/</data>
      <data key="d11">1748426903</data>
    </edge>
    <edge source="Vulnerable Groups" target="Discrimination">
      <data key="d6">9.0</data>
      <data key="d7">Discrimination disproportionately affects vulnerable groups, emphasizing the need for protective laws like Union law.</data>
      <data key="d8">legal protection,social justice</data>
      <data key="d9">chunk-d1b1b6d000ef2c2e744936b8e5264e46</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/67/</data>
      <data key="d11">1748427989</data>
    </edge>
    <edge source="Vulnerable Groups" target="Testing in Real World Conditions">
      <data key="d6">8.0</data>
      <data key="d7">Testing in real-world conditions must ensure the protection of vulnerable groups participating in the process, highlighting ethical considerations.</data>
      <data key="d8">ethical oversight,participant protection</data>
      <data key="d9">chunk-383d8a6d025576d908f0c7970d58be09</data>
      <data key="d10">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d11">1748428325</data>
    </edge>
    <edge source="Vulnerable Groups" target="Informed Consent">
      <data key="d6">10.0</data>
      <data key="d7">Informed consent is crucial for ensuring that vulnerable groups can participate in testing without coercion or undue risk.</data>
      <data key="d8">ethical standards,participant rights</data>
      <data key="d9">chunk-4a7fb5abd6ad1ba2e9256fc63dbda4a7</data>
      <data key="d10">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d11">1748428325</data>
    </edge>
    <edge source="Directive 2005/29/EC" target="Medical Treatment Practices">
      <data key="d6">7.0</data>
      <data key="d7">Directive 2005/29/EC explicitly states that it does not affect lawful medical treatment practices.</data>
