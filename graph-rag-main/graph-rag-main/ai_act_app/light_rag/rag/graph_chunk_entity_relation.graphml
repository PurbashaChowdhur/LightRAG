      <data key="d10">https://artificialintelligenceact.eu/recital/96/</data>
      <data key="d11">1748426558</data>
    </edge>
    <edge source="market surveillance authority" target="authorised representative">
      <data key="d6">8.0</data>
      <data key="d7">The authorised representative informs the market surveillance authority about the termination of mandates due to non-compliance with the Regulation.</data>
      <data key="d8">compliance reporting,oversight</data>
