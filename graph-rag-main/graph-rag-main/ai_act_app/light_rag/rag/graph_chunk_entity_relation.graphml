      <data key="d10">https://artificialintelligenceact.eu/recital/139/</data>
      <data key="d11">1748426013</data>
    </edge>
    <edge source="AI Regulatory Sandboxes" target="European Data Protection Supervisor">
      <data key="d6">17.0</data>
      <data key="d7">The European Data Protection Supervisor can establish AI regulatory sandboxes specifically for Union institutions, enhancing oversight in AI regulation.&lt;SEP&gt;The European Data Protection Supervisor oversees the AI regulatory sandboxes to ensure they align with data protection regulations.</data>
