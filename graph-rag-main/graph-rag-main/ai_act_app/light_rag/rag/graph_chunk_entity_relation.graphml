    </edge>
    <edge source="real-time remote biometric identification systems" target="law enforcement">
      <data key="d6">8.0</data>
      <data key="d7">"The use of real-time remote biometric identification systems is regulated by law enforcement for specific situations to safeguard public interest and safety.")</data>
