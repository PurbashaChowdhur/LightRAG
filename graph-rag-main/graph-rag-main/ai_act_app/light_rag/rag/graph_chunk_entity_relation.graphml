      <data key="d11">1748428151</data>
    </edge>
    <edge source="high-risk AI system" target="Union or National Law">
      <data key="d6">8.0</data>
      <data key="d7">Union or National Law sets regulations that determine how high-risk AI systems are monitored and the extent to which oversight is applied.</data>
      <data key="d8">legal framework,regulation</data>
      <data key="d9">chunk-d3235710f8867a0e47878a2233118ed9</data>
      <data key="d10">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d11">1748428074</data>
    </edge>
    <edge source="high-risk AI system" target="Deployer">
      <data key="d6">9.0</data>
      <data key="d7">The Deployer is responsible for the implementation and oversight of high-risk AI systems, ensuring their safe operation.</data>
      <data key="d8">implementation,oversight</data>
      <data key="d9">chunk-d3235710f8867a0e47878a2233118ed9</data>
      <data key="d10">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d11">1748428074</data>
    </edge>
    <edge source="high-risk AI system" target="Anomalies">
      <data key="d6">8.0</data>
      <data key="d7">Anomalies are issues that may arise during the operation of high-risk AI systems, necessitating careful oversight and management.</data>
      <data key="d8">monitoring,operational risk</data>
      <data key="d9">chunk-d3235710f8867a0e47878a2233118ed9</data>
      <data key="d10">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d11">1748428074</data>
    </edge>
    <edge source="high-risk AI system" target="Performance">
      <data key="d6">9.0</data>
      <data key="d7">The performance of high-risk AI systems must be regularly evaluated to detect and address any anomalies or dysfunctions.</data>
