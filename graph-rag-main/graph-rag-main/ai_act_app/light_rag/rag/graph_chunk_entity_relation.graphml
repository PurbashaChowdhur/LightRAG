    <edge source="Testing Process" target="AI Regulatory Sandbox">
      <data key="d6">9.0</data>
      <data key="d7">The Testing Process refers to the evaluation of AI systems within the context of the AI Regulatory Sandbox to ensure compliance with safety and performance standards.</data>
