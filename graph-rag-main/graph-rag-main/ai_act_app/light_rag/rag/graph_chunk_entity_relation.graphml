      <data key="d11">1748427539</data>
    </edge>
    <edge source="Member States" target="Law Enforcement Cooperation Agreements">
      <data key="d6">8.0</data>
      <data key="d7">Law Enforcement Cooperation Agreements are established to facilitate collaboration between Member States and Third Countries."&lt;/|&gt;"formal agreements, cooperation</data>
      <data key="d8">8</data>
