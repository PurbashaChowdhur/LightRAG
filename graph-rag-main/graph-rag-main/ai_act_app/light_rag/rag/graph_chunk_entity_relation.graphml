      <data key="d11">1748428535</data>
    </edge>
    <edge source="SMEs" target="National Competent Authorities">
      <data key="d6">7.0</data>
      <data key="d7">National competent authorities are expected to provide guidance to SMEs regarding the implementation of regulations affecting AI technologies.</data>
      <data key="d8">guidance provision,regulatory support</data>
