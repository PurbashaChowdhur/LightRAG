      <data key="d11">1748426936</data>
    </edge>
    <edge source="Member States" target="Scientific Panel">
      <data key="d6">15.0</data>
      <data key="d7">Member States can call upon the Scientific Panel experts for support in their enforcement activities under the regulation.&lt;SEP&gt;Member States can request the assistance of the Scientific Panel to enhance their enforcement activities.</data>
      <data key="d8">expert support,government support,regulatory assistance,regulatory enforcement</data>
      <data key="d9">chunk-a644c604bba8cdc33a7125c5db02395c&lt;SEP&gt;chunk-1d7350246beee832b58d5c53fa874095</data>
