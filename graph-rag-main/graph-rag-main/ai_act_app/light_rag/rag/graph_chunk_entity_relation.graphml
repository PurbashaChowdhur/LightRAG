    </edge>
    <edge source="Systemic Risks" target="Major Accidents">
      <data key="d6">8.0</data>
      <data key="d7">Systemic risks can lead to major accidents that disrupt critical operations and result in widespread damage or harm.</data>
      <data key="d8">impact,risk association</data>
