      <data key="d10">https://artificialintelligenceact.eu/recital/57/</data>
      <data key="d11">1748426011</data>
    </edge>
    <edge source="AI Systems in Employment" target="Self-Employment Access">
      <data key="d6">7.0</data>
      <data key="d7">AI Systems in Employment can either facilitate or hinder Self-Employment Access by impacting job allocation and visibility on platforms.</data>
      <data key="d8">access barriers,technology influence</data>
