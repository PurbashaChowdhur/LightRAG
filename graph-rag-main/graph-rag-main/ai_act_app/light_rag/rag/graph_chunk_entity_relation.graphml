    </edge>
    <edge source="General-Purpose AI Models" target="Harmonised Standard">
      <data key="d6">8.0</data>
      <data key="d7">General-purpose AI models must adhere to harmonised standards set forth by the European standardisation organisations according to EU regulations.</data>
