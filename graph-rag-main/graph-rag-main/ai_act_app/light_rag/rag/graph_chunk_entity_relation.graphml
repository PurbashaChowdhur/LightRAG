      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="critical infrastructure" target="serious harm">
      <data key="d6">8.0</data>
      <data key="d7">Serious harm can occur when critical infrastructure is disrupted, affecting operations and societal functions.</data>
      <data key="d8">impact,infrastructure risk</data>
