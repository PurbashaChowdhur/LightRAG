      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Regulation (EU) 2016/679" target="non-personal data">
      <data key="d6">7.0</data>
      <data key="d7">Regulation (EU) 2016/679 also defines the scope and handling of non-personal data for regulatory compliance.</data>
      <data key="d8">data classification,regulation</data>
