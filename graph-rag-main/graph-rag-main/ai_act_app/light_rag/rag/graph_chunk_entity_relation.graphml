      <data key="d9">chunk-a6812c0a4d288d4b9c143a284b707d29</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Directive (EU) 2022/2557" target="Recital 98">
      <data key="d6">8.0</data>
      <data key="d7">Recital 98 complements the Directive by addressing responsibilities tied to AI technologies and their developers.</data>
