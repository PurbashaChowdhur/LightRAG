      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Informed Consent" target="Subjects of Testing">
      <data key="d6">9.0</data>
      <data key="d7">Informed Consent ensures that the Subjects of Testing understand their rights and the conditions of their participation.</data>
      <data key="d8">ethical considerations,participant awareness</data>
      <data key="d9">chunk-5ebb00fdd14767c86b1a8c766db05a7c</data>
      <data key="d10">https://artificialintelligenceact.eu/article/61/</data>
      <data key="d11">1748427392</data>
    </edge>
    <edge source="Informed Consent" target="Testing in Real World Conditions">
      <data key="d6">20.0</data>
      <data key="d7">Informed Consent is a prerequisite for conducting Testing in Real World Conditions, ensuring that participants agree to the testing procedures.&lt;SEP&gt;Informed consent is necessary prior to participation in Testing in Real World Conditions, ensuring ethical standards are met.</data>
      <data key="d8">ethical standards,ethics,participant rights,regulatory compliance</data>
      <data key="d9">chunk-5ebb00fdd14767c86b1a8c766db05a7c&lt;SEP&gt;chunk-383d8a6d025576d908f0c7970d58be09</data>
      <data key="d10">https://artificialintelligenceact.eu/article/60/&lt;SEP&gt;https://artificialintelligenceact.eu/article/61/</data>
      <data key="d11">1748428325</data>
    </edge>
    <edge source="Informed Consent" target="Testing Subjects">
      <data key="d6">9.0</data>
      <data key="d7">Testing subjects are required to provide informed consent before participating in any research or testing procedure.</data>
      <data key="d8">ethical standards,participation requirement</data>
      <data key="d9">chunk-295d382452d700dcc18edd615661d802</data>
      <data key="d10">https://artificialintelligenceact.eu/article/61/</data>
      <data key="d11">1748427392</data>
    </edge>
    <edge source="Informed Consent" target="Legal Representative">
      <data key="d6">8.0</data>
      <data key="d7">A legal representative must ensure that informed consent is obtained for minors or individuals unable to consent for themselves.</data>
      <data key="d8">authorization,ethical responsibility</data>
      <data key="d9">chunk-295d382452d700dcc18edd615661d802</data>
      <data key="d10">https://artificialintelligenceact.eu/article/61/</data>
      <data key="d11">1748427392</data>
    </edge>
    <edge source="Informed Consent" target="Article 61">
      <data key="d6">10.0</data>
      <data key="d7">Article 61 establishes the necessity of obtaining informed consent from subjects prior to engaging them in testing activities.</data>
      <data key="d8">consent,ethical requirements</data>
      <data key="d9">chunk-4a7fb5abd6ad1ba2e9256fc63dbda4a7</data>
      <data key="d10">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d11">1748428325</data>
    </edge>
    <edge source="Critical Infrastructure" target="Directive (EU) 2022/2557">
      <data key="d6">10.0</data>
      <data key="d7">The Directive focuses on the resilience and protection of critical infrastructure to ensure safety and continuity of services.</data>
      <data key="d8">infrastructure resilience,regulation</data>
