      <data key="d10">https://artificialintelligenceact.eu/recital/37/</data>
      <data key="d11">1748427850</data>
    </edge>
    <edge source="Member State" target="National Law">
      <data key="d6">8.0</data>
      <data key="d7">National Law is developed by each Member State based on the provisions allowed by the Regulation, indicating their sovereignty and legislative authority.</data>
      <data key="d8">compliance,legislative process</data>
