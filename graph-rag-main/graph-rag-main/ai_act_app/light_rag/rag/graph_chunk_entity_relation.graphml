      <data key="d10">https://artificialintelligenceact.eu/article/66/</data>
      <data key="d11">1748427535</data>
    </edge>
    <edge source="AI Regulatory Sandboxes" target="General-Purpose AI Models">
      <data key="d6">9.0</data>
      <data key="d7">AI regulatory sandboxes are used to test general-purpose AI models' compliance with established regulations.</data>
