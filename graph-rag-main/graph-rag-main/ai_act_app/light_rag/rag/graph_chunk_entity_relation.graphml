      <data key="d10">https://artificialintelligenceact.eu/recital/24/</data>
      <data key="d11">1748426212</data>
    </edge>
    <edge source="Conformity Assessment Bodies" target="World Trade Organization">
      <data key="d6">9.0</data>
      <data key="d7">Conformity Assessment Bodies operate under guidelines provided by the World Trade Organization to ensure standards are met.</data>
