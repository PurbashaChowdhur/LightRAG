    </edge>
    <edge source="Directive (EU) 2022/2557" target="Council Framework Decision 2002/584/JHA">
      <data key="d6">7.0</data>
      <data key="d7">Directive (EU) 2022/2557 modifies previous regulations including the Council Framework Decision 2002/584/JHA to enhance resilience measures.</data>
