      <data key="d11">1748428112</data>
    </edge>
    <edge source="Notified Bodies" target="Independence of Judgement">
      <data key="d6">8.0</data>
      <data key="d7">Notified bodies are required to operate with independence of judgement to ensure unbiased conformity assessments.</data>
      <data key="d8">impartiality,judgment</data>
