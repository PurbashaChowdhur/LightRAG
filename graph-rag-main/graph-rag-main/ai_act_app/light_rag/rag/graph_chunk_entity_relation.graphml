      <data key="d10">https://artificialintelligenceact.eu/recital/170/</data>
      <data key="d11">1748427549</data>
    </edge>
    <edge source="market surveillance authority" target="Union">
      <data key="d6">8.0</data>
      <data key="d7">The Union collaborates with market surveillance authorities to ensure adherence to regulations regarding AI systems and the protection of rights.</data>
      <data key="d8">compliance,regulatory oversight</data>
      <data key="d9">chunk-2763d61443dcf3aa274192c53e098997</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/170/</data>
      <data key="d11">1748427549</data>
    </edge>
    <edge source="market surveillance authority" target="complaint">
      <data key="d6">9.0</data>
      <data key="d7">A complaint can be lodged to the market surveillance authority by individuals claiming infringement of their rights.</data>
      <data key="d8">grievance process,regulatory oversight</data>
