      <data key="d10">https://artificialintelligenceact.eu/article/17/</data>
      <data key="d11">1748426223</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Requirements">
      <data key="d6">8.0</data>
      <data key="d7">High-risk AI systems must adhere to specific requirements set out in regulations to ensure they function safely and effectively.</data>
