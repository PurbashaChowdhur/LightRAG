      <data key="d11">1748426558</data>
    </edge>
    <edge source="market surveillance authority" target="European Artificial Intelligence Office">
      <data key="d6">9.0</data>
      <data key="d7">The European AI Office collaborates with the market surveillance authority to ensure compliance with regulations governing high-risk AI systems.</data>
      <data key="d8">compliance,regulatory framework</data>
