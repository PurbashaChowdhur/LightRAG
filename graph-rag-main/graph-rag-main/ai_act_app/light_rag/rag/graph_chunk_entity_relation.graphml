      <data key="d11">1748428074</data>
    </edge>
    <edge source="Natural Persons" target="Competence">
      <data key="d6">9.0</data>
      <data key="d7">Natural persons must possess competence to effectively validate the identifications made by AI systems.</data>
      <data key="d8">skill requirements,verification</data>
      <data key="d9">chunk-58ec10f8fea631de27f7f3ef17b5594a</data>
      <data key="d10">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d11">1748428074</data>
    </edge>
    <edge source="Natural Persons" target="Training">
      <data key="d6">8.0</data>
      <data key="d7">Training is essential for natural persons to ensure they can accurately verify the results produced by AI systems.</data>
      <data key="d8">education,skill development</data>
      <data key="d9">chunk-58ec10f8fea631de27f7f3ef17b5594a</data>
      <data key="d10">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d11">1748428074</data>
    </edge>
    <edge source="Natural Persons" target="Authority">
      <data key="d6">9.0</data>
      <data key="d7">"Natural persons must have the authority to act upon the identifications made by AI systems." \</data>
