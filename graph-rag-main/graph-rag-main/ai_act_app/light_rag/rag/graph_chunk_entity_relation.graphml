      <data key="d9">chunk-0f96f0c84ed2ea0ee7c72badcbbc5bf5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/97/</data>
      <data key="d11">1748426054</data>
    </edge>
    <edge source="Regulation" target="rights of natural persons">
      <data key="d6">9.0</data>
      <data key="d7">The Regulation aims to protect the rights of natural persons by imposing responsibilities on AI system providers to mitigate risks that may affect individuals.</data>
      <data key="d8">regulation,rights protection</data>
