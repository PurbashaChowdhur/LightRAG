      <data key="d9">chunk-b2f0180b5212a055a4e3ca493be8f830</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/103/</data>
      <data key="d11">1748426529</data>
    </edge>
    <edge source="Regulation" target="Open-Source Model">
      <data key="d6">8.0</data>
      <data key="d7">The Open-Source Model is subject to specific Regulations that govern how compliance should be implemented after its release.</data>
