      <data key="d10">https://artificialintelligenceact.eu/recital/143/</data>
      <data key="d11">1748427031</data>
    </edge>
    <edge source="SMEs" target="start-ups">
      <data key="d6">14.0</data>
      <data key="d7">Both SMEs and start-ups are identified as businesses that require specific support and consideration in regulatory frameworks.&lt;SEP&gt;Start-ups fall under the category of SMEs and are considered in the context of regulatory penalties and enforcement measures.</data>
      <data key="d8">business classification,business support,economic interests,regulatory focus</data>
