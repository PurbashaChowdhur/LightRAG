      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="general-purpose AI system" target="downstream provider">
      <data key="d6">15.0</data>
      <data key="d7">A downstream provider can integrate general-purpose AI systems into their offerings, regardless of the model provider.&lt;SEP&gt;Downstream providers utilize general-purpose AI systems to integrate AI functionalities into application-specific contexts.</data>
      <data key="d8">AI deployment,AI services,application integration,integration</data>
      <data key="d9">chunk-0f80477304c8df58e48c2b09ede4a7e2&lt;SEP&gt;chunk-a6812c0a4d288d4b9c143a284b707d29</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="general-purpose AI system" target="floating-point operation">
      <data key="d6">7.0</data>
      <data key="d7">General-purpose AI systems can perform floating-point operations as part of their computational functions.</data>
