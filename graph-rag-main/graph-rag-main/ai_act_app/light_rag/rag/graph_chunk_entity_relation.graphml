    <edge source="Directive (EU) 2016/680" target="Biometric Data">
      <data key="d6">8.0</data>
      <data key="d7">Directive (EU) 2016/680 establishes conditions for the processing of biometric data in law enforcement, enhancing the protection of such sensitive information.</data>
      <data key="d8">data protection,law enforcement</data>
