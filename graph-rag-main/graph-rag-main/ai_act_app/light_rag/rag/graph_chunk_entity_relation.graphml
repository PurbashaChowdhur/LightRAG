    </edge>
    <edge source="European Data Protection Supervisor" target="Administrative Fines">
      <data key="d6">19.0</data>
      <data key="d7">The European Data Protection Supervisor is responsible for imposing administrative fines on Union institutions for breaches of data protection regulations.&lt;SEP&gt;The European Data Protection Supervisor is responsible for imposing administrative fines on entities that violate data protection rules.</data>
      <data key="d8">compliance penalties,penalty imposition,regulatory enforcement,regulatory framework</data>
      <data key="d9">chunk-5dfd9a8d23f85f04843c95f20a9172df&lt;SEP&gt;chunk-e8744b41e4885f10e1fd533f0c9de4aa</data>
