      <data key="d10">https://artificialintelligenceact.eu/article/35/</data>
      <data key="d11">1748426431</data>
    </edge>
    <edge source="Regulation" target="AI Components">
      <data key="d6">8.0</data>
      <data key="d7">The Regulation defines the rules for the use and monetization of AI components in relation to open-source practices.</data>
