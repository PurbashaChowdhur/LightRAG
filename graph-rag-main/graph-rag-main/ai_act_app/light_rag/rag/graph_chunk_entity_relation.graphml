    </edge>
    <edge source="Notified Bodies" target="Provider of the System">
      <data key="d6">8.0</data>
      <data key="d7">Notified bodies assess the compliance of AI systems provided by the provider, and may impose actions if requirements are not met.</data>
      <data key="d8">oversight,regulatory enforcement</data>
