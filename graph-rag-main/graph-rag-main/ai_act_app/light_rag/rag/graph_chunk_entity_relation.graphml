      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Law Enforcement" target="Remote Identification Systems">
      <data key="d6">9.0</data>
      <data key="d7">Remote identification systems are utilized by law enforcement agencies to enhance security and identify potential threats.</data>
      <data key="d8">security,technology use</data>
      <data key="d9">chunk-e142ac7019ab93d80ef49579e8d0866e</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Law Enforcement" target="Section II of Regulation (EU) 2016/679">
      <data key="d6">8.0</data>
      <data key="d7">Section II of Regulation (EU) 2016/679 provides guidelines for law enforcement in handling personal data during investigations.</data>
      <data key="d8">data protection,legal framework</data>
      <data key="d9">chunk-e142ac7019ab93d80ef49579e8d0866e</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Law Enforcement" target="Remote Biometric Identification Systems">
      <data key="d6">10.0</data>
      <data key="d7">Remote biometric identification systems are used by law enforcement to enhance their capability to identify suspects and ensure public safety.</data>
      <data key="d8">public safety,technology utilization</data>
      <data key="d9">chunk-b6884d6c4641c256f66289e2e2b56965</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Law Enforcement" target="European Union Law">
      <data key="d6">9.0</data>
      <data key="d7">European Union Law governs the use of law enforcement practices, including the use of biometric data and surveillance technologies.</data>
      <data key="d8">governance,legal framework</data>
      <data key="d9">chunk-b6884d6c4641c256f66289e2e2b56965</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Law Enforcement" target="Paragraphs 1, 2, and 3">
      <data key="d6">8.0</data>
      <data key="d7">Paragraphs 1, 2, and 3 outline the legal conditions under which law enforcement may utilize biometric identification systems.</data>
      <data key="d8">legal conditions,operational guidelines</data>
      <data key="d9">chunk-b6884d6c4641c256f66289e2e2b56965</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Law Enforcement" target="High-risk AI systems">
      <data key="d6">7.0</data>
      <data key="d7">Law enforcement agencies may deploy high-risk AI systems to aid in investigations and maintain public safety.</data>
      <data key="d8">public safety,technology</data>
      <data key="d9">chunk-e32fcfee58701346b1cdfaa0595c615d</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d11">1748427848</data>
    </edge>
    <edge source="Law Enforcement" target="Regulation on AI Systems">
      <data key="d6">9.0</data>
      <data key="d7">The Regulation on AI Systems provides guidelines for their use in the domain of Law Enforcement to ensure compliance with privacy and data protection standards.</data>
      <data key="d8">law enforcement,regulatory framework</data>
      <data key="d9">chunk-b477112713d917a03ba6f595ed62f6c7</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/38/</data>
      <data key="d11">1748428613</data>
    </edge>
    <edge source="Publicly Accessible Spaces" target="Company and Factory Premises">
      <data key="d6">8.0</data>
