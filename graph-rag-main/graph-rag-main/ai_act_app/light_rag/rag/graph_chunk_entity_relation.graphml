    </edge>
    <edge source="Publicly Accessible Spaces" target="Private Residential Building">
      <data key="d6">6.0</data>
      <data key="d7">Publicly accessible spaces can exist within private residential buildings, such as hallways leading to offices.</data>
      <data key="d8">mixed accessibility,public areas</data>
