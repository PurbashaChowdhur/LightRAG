      <data key="d10">https://artificialintelligenceact.eu/article/65/&lt;SEP&gt;https://artificialintelligenceact.eu/article/67/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/150/</data>
      <data key="d11">1748428455</data>
    </edge>
    <edge source="Advisory Forum" target="Fundamental Rights Agency">
      <data key="d6">15.0</data>
      <data key="d7">The Advisory Forum includes the Fundamental Rights Agency to ensure a focus on fundamental rights in regulation.&lt;SEP&gt;The Fundamental Rights Agency is a permanent member of the Advisory Forum, providing expertise in human rights matters.</data>
      <data key="d8">advisory role,membership,rights advocacy,stakeholder composition</data>
      <data key="d9">chunk-42d0cbfdb0213c7d2eb8c1b2d49876e8&lt;SEP&gt;chunk-a04fe96efa4389bb1d352d2b400876fa</data>
