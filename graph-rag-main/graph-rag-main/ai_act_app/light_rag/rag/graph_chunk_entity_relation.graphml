      <data key="d10">https://artificialintelligenceact.eu/recital/81/</data>
      <data key="d11">1748428483</data>
    </edge>
    <edge source="Quality Management System" target="Public Authorities">
      <data key="d6">8.0</data>
      <data key="d7">Public Authorities must implement Quality Management Systems in compliance with national or regional regulations for high-risk AI systems.</data>
