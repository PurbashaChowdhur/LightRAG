      <data key="d10">https://artificialintelligenceact.eu/article/17/</data>
      <data key="d11">1748426223</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Financial Institutions">
      <data key="d6">16.0</data>
      <data key="d7">Financial Institutions are required to have specific governance arrangements that comply with regulations governing high-risk AI systems.&lt;SEP&gt;Financial Institutions deploying high-risk AI Systems must adhere to specific internal governance requirements as stipulated by Union law.</data>
      <data key="d8">compliance,governance,operational governance,regulatory compliance</data>
