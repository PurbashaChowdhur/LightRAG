      <data key="d10">https://artificialintelligenceact.eu/recital/116/</data>
      <data key="d11">1748428172</data>
    </edge>
    <edge source="Systemic Risks" target="High-Impact Capabilities">
      <data key="d6">8.0</data>
      <data key="d7">High-Impact Capabilities of an AI Model can lead to Systemic Risks, particularly when they are significantly advanced.</data>
      <data key="d8">capability assessment,risk association</data>
      <data key="d9">chunk-e116bc92c8c7cf688c26ea188fd0b2fe</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/111/</data>
