      <data key="d11">1748428214</data>
    </edge>
    <edge source="AI System" target="Vulnerable Groups">
      <data key="d6">9.0</data>
      <data key="d7">The testing of the AI system in real-world conditions must take into account the protections needed for vulnerable groups, ensuring their safety and rights are maintained.</data>
