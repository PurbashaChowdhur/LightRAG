      <data key="d11">1748428504</data>
    </edge>
    <edge source="market surveillance authority" target="high-risk AI system">
      <data key="d6">10.0</data>
      <data key="d7">The market surveillance authority ensures that high-risk AI systems comply with EU regulations and may take action if they do not.</data>
      <data key="d8">regulatory action,risk management</data>
