      <data key="d10">https://artificialintelligenceact.eu/article/17/</data>
      <data key="d11">1748426223</data>
    </edge>
    <edge source="Quality Management System" target="Risk Management System">
      <data key="d6">9.0</data>
      <data key="d7">The Quality Management System includes a Risk Management System to identify and mitigate potential hazards associated with AI technology.</data>
      <data key="d8">risk assessment,safety measures</data>
