      <data key="d10">https://artificialintelligenceact.eu/article/17/</data>
      <data key="d11">1748426223</data>
    </edge>
    <edge source="AI Systems" target="Risk Management System">
      <data key="d6">17.0</data>
      <data key="d7">High-risk AI systems are required to integrate risk management systems to ensure compliance with regulations.&lt;SEP&gt;The Risk Management System is designed to manage risks associated with high-risk AI systems through systematic evaluations and targeted measures.</data>
      <data key="d8">regulatory compliance,risk management,technology safety</data>
      <data key="d9">chunk-e2567ed4486ee359c31fd399ca77e5a3&lt;SEP&gt;chunk-492be2be76ac28fb634286d651691400</data>
      <data key="d10">https://artificialintelligenceact.eu/article/9/&lt;SEP&gt;https://artificialintelligenceact.eu/article/8/</data>
      <data key="d11">1748427498</data>
    </edge>
    <edge source="AI Systems" target="AI Regulatory Sandbox">
      <data key="d6">18.0</data>
      <data key="d7">AI systems are assessed and tested using the AI regulatory sandbox to ensure compliance with established regulations.&lt;SEP&gt;The AI Regulatory Sandbox is specifically designed for the development, training, and testing of AI Systems that address various public interest areas.</data>
      <data key="d8">compliance testing,development,innovation,system evaluation</data>
      <data key="d9">chunk-6741d9dacc504660a09282cfdfdfe32d&lt;SEP&gt;chunk-c0011a0d9e3a2637e314c176ed0dc26c</data>
