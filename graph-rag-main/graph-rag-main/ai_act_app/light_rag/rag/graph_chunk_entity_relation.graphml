      <data key="d10">https://artificialintelligenceact.eu/recital/17/</data>
      <data key="d11">1748426309</data>
    </edge>
    <edge source="Biometric Data" target="Biometric Identification">
      <data key="d6">9.0</data>
      <data key="d7">Biometric identification relies on biometric data to recognize individuals' physical features for identity verification.</data>
      <data key="d8">biometric usage,identity verification</data>
      <data key="d9">chunk-de448579f0f397ec535d8acdb68580bc</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
