      <data key="d10">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d11">1748428325</data>
    </edge>
    <edge source="CE marking" target="EU declaration of conformity">
      <data key="d6">7.0</data>
      <data key="d7">The CE marking is associated with the EU declaration of conformity as a proof of compliance with EU standards.</data>
      <data key="d8">compliance documentation,product standards</data>
      <data key="d9">chunk-b90a181c1c97be5262cd1f7a3919d6d5</data>
      <data key="d10">https://artificialintelligenceact.eu/article/83/</data>
      <data key="d11">1748425969</data>
    </edge>
    <edge source="CE marking" target="Article 48">
      <data key="d6">8.0</data>
      <data key="d7">Article 48 deals with conditions regarding the affixing of CE markings to products, connecting regulatory requirements and product compliance.</data>
      <data key="d8">compliance requirement,regulatory framework</data>
      <data key="d9">chunk-b90a181c1c97be5262cd1f7a3919d6d5</data>
      <data key="d10">https://artificialintelligenceact.eu/article/83/</data>
      <data key="d11">1748425969</data>
    </edge>
    <edge source="EU declaration of conformity" target="Article 47">
      <data key="d6">9.0</data>
      <data key="d7">Article 47 specifies the requirements that must be fulfilled for an EU declaration of conformity to be valid, ensuring accountability in product compliance.</data>
      <data key="d8">compliance standards,regulatory documentation</data>
