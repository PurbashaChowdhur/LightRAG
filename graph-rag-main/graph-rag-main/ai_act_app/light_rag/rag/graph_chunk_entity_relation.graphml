      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Member State" target="Real-Time Remote Biometric Identification System">
      <data key="d6">9.0</data>
      <data key="d7">The implementation of the Real-Time Remote Biometric Identification System requires authorization from a Member State's judicial authority before use.</data>
      <data key="d8">law enforcement,regulatory compliance</data>
      <data key="d9">chunk-a26fcdeec947c5dfd024232093934843</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Member State" target="European Artificial Intelligence Board">
      <data key="d6">9.0</data>
      <data key="d7">The European Artificial Intelligence Board consists of representatives from each Member State to facilitate coordination on AI-related tasks.</data>
      <data key="d8">coordination,representation</data>
      <data key="d9">chunk-8b4f722f831bc4c8c4594e971e7b7654</data>
      <data key="d10">https://artificialintelligenceact.eu/article/65/</data>
      <data key="d11">1748427821</data>
    </edge>
    <edge source="Member State" target="Territory">
      <data key="d6">7.0</data>
      <data key="d7">Member States have authority over the specific territories wherein they can enact the provisions of the Regulation.</data>
      <data key="d8">jurisdiction,legal authority</data>
