      <data key="d11">1748428455</data>
    </edge>
    <edge source="Advisory Forum" target="Annual Report">
      <data key="d6">9.0</data>
      <data key="d7">The advisory forum prepares an annual report to summarize its activities and outcomes, which is shared publicly.</data>
      <data key="d8">reporting,transparency</data>
