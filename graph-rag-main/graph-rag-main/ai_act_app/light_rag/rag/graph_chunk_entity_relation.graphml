    <edge source="Serious Incident Reporting" target="Relevant Market Surveillance Authority">
      <data key="d6">9.0</data>
      <data key="d7">The relevant market surveillance authority is responsible for receiving notifications of serious incidents as per the reporting requirements.</data>
