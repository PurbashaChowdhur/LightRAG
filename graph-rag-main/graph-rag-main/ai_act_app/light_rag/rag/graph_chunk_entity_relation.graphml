    </edge>
    <edge source="Biometric Data" target="Article 4, point (14)">
      <data key="d6">10.0</data>
      <data key="d7">Biometric Data is characterized under Article 4, point (14) of Regulation (EU) 2016/679, establishing its regulatory framework.</data>
