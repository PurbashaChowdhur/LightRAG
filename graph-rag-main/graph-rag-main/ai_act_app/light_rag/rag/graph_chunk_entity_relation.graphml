    <edge source="Publicly Accessible Spaces" target="Real-Time Remote Biometric Identification System">
      <data key="d6">9.0</data>
      <data key="d7">The Real-Time Remote Biometric Identification System is designed for implementation in Publicly Accessible Spaces for law enforcement purposes.</data>
      <data key="d8">law enforcement,location</data>
