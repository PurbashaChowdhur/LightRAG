      <data key="d10">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d11">1748427848</data>
    </edge>
    <edge source="serious incident" target="biometric identification system">
      <data key="d6">6.0</data>
      <data key="d7">A serious incident may arise from the malfunction of a biometric identification system, leading to issues in identification or privacy violations.</data>
