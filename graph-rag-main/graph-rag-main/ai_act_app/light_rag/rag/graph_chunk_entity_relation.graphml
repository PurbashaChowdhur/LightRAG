      <data key="d11">1748428455</data>
    </edge>
    <edge source="Advisory Forum" target="European Telecommunications Standards Institute (ETSI)">
      <data key="d6">14.0</data>
      <data key="d7">ETSI enhances the Advisory Forum's understanding of telecommunications standards through its membership.&lt;SEP&gt;ETSI is involved in the Advisory Forum to provide insights on telecommunications standards pertinent to regulations.</data>
      <data key="d8">membership,stakeholder involvement,standards influence,telecommunications standards</data>
      <data key="d9">chunk-42d0cbfdb0213c7d2eb8c1b2d49876e8&lt;SEP&gt;chunk-a04fe96efa4389bb1d352d2b400876fa</data>
