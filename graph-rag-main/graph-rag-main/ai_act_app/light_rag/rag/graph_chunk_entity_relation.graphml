    </edge>
    <edge source="real-world testing plan" target="AI regulatory sandbox">
      <data key="d6">8.0</data>
      <data key="d7">A real-world testing plan is essential for conducting tests within an AI regulatory sandbox to ensure compliance with safety and operational standards.</data>
      <data key="d8">compliance,testing framework</data>
