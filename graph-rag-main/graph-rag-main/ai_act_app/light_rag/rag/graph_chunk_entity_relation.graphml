      <data key="d10">https://artificialintelligenceact.eu/recital/59/</data>
      <data key="d11">1748427018</data>
    </edge>
    <edge source="law enforcement authorities" target="civil protection authorities">
      <data key="d6">17.0</data>
      <data key="d7">Both civil protection authorities and law enforcement authorities may act under the Regulation to ensure public safety during emergencies.&lt;SEP&gt;Both law enforcement and civil protection authorities may utilize their respective powers under the Regulation to ensure public safety during critical incidents.</data>
      <data key="d8">collaboration,emergency management,public safety</data>
