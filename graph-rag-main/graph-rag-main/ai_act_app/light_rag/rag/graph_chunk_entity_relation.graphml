      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="market surveillance authority" target="high-risk AI systems">
      <data key="d6">8.0</data>
      <data key="d7">The market surveillance authority oversees testing related to high-risk AI systems as part of its regulatory responsibilities in compliance with Union laws.</data>
      <data key="d8">oversight,regulatory responsibility</data>
