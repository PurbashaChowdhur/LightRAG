    <edge source="special categories of personal data" target="Directive (EU) 2018/1725">
      <data key="d6">9.0</data>
      <data key="d7">Directive (EU) 2018/1725 outlines the necessity for strict regulations surrounding the processing of special categories of personal data to safeguard individual rights.</data>
      <data key="d8">data protection,regulation</data>
      <data key="d9">chunk-dc185ecb84a12901d24ae59e4dd5dfe5</data>
      <data key="d10">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d11">1748427784</data>
    </edge>
    <edge source="real-time remote biometric identification system" target="biometric identification system">
      <data key="d6">9.0</data>
      <data key="d7">Real-time remote biometric identification systems are a subset of biometric identification systems that provide instant identification capability.</data>
      <data key="d8">system type,technology function</data>
      <data key="d9">chunk-94ebfb1fa7d304078345c66a61c6ecc1</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="real-time remote biometric identification system" target="independent administrative authority">
      <data key="d6">7.0</data>
      <data key="d7">The independent administrative authority provides an alternative path for authorization related to the use of biometric identification systems.</data>
      <data key="d8">authorization,regulatory function</data>
      <data key="d9">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="real-time remote biometric identification system" target="situation">
      <data key="d6">8.0</data>
      <data key="d7">The implementation of a real-time remote biometric identification system is contingent upon certain situations that necessitate its use for law enforcement.</data>
      <data key="d8">contextual deployment,necessity</data>
      <data key="d9">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="real-time remote biometric identification system" target="law enforcement">
      <data key="d6">9.0</data>
      <data key="d7">Real-time remote biometric identification systems are specifically designed for use by law enforcement agencies to aid in identifying individuals in public spaces.</data>
      <data key="d8">public safety,surveillance</data>
      <data key="d9">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="law enforcement" target="critical infrastructure">
      <data key="d6">9.0</data>
      <data key="d7">Law enforcement activities are vital for the protection and management of critical infrastructure against criminal threats.</data>
      <data key="d8">infrastructure protection,public safety</data>
      <data key="d9">chunk-df3020e6887a24702cea8a3373082e09</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="law enforcement" target="identity of the specifically targeted individual">
      <data key="d6">8.0</data>
      <data key="d7">The identity of the specifically targeted individual is crucial for law enforcement, as it directly relates to the objectives of employing biometric identification systems.</data>
      <data key="d8">law enforcement,target identification</data>
      <data key="d9">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="law enforcement" target="migration">
      <data key="d6">8.0</data>
