      <data key="d5">1748428640</data>
    </node>
    <node id="facial recognition databases">
      <data key="d0">facial recognition databases</data>
      <data key="d1">category</data>
      <data key="d2">Facial recognition databases store facial images for identification purposes and raise concerns regarding privacy and surveillance.</data>
      <data key="d3">chunk-ea591e8c170e7b5ae61060a7a9c9e5fb</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/43/</data>
      <data key="d5">1748427698</data>
    </node>
    <node id="Mass Surveillance">
      <data key="d0">Mass Surveillance</data>
      <data key="d1">category</data>
      <data key="d2">Mass surveillance refers to the pervasive monitoring of individuals' activities, often enabled by technology such as AI and facial recognition systems.</data>
      <data key="d3">chunk-ea591e8c170e7b5ae61060a7a9c9e5fb</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/43/</data>
      <data key="d5">1748427698</data>
    </node>
    <node id="Facial Images">
      <data key="d0">Facial Images</data>
      <data key="d1">category</data>
      <data key="d2">Facial Images are pictures of individuals' faces that can be harvested for creating facial recognition databases.&lt;SEP&gt;Facial images are digital representations of a person's face used for identification purposes in recognition systems.</data>
      <data key="d3">chunk-ea591e8c170e7b5ae61060a7a9c9e5fb&lt;SEP&gt;chunk-8871d96b04df0305284cbd20bfc2bf41</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/43/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="CCTV Footage">
      <data key="d0">CCTV Footage</data>
      <data key="d1">category</data>
      <data key="d2">CCTV footage is continuously recorded video used for security and surveillance, often contributing to mass surveillance efforts.&lt;SEP&gt;CCTV footage refers to video captured by closed-circuit television cameras, often used for surveillance and security purposes, which can contribute data for facial recognition systems.</data>
      <data key="d3">chunk-ea591e8c170e7b5ae61060a7a9c9e5fb&lt;SEP&gt;chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/43/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Facial Recognition Databases">
      <data key="d0">Facial Recognition Databases</data>
      <data key="d3">chunk-ea591e8c170e7b5ae61060a7a9c9e5fb&lt;SEP&gt;chunk-8871d96b04df0305284cbd20bfc2bf41&lt;SEP&gt;chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d2">Facial Recognition Databases are collections of facial images created or expanded through the scraping of images from various sources, including the internet and CCTV footage.&lt;SEP&gt;Facial recognition databases are a tool used within mass surveillance to track and identify individuals based on their facial images.&lt;SEP&gt;Facial recognition databases are collections of facial images obtained through various methods, including scraping the internet and CCTV footage, used for identifying individuals.</data>
      <data key="d1">category</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/43/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="Autonomous Robots">
      <data key="d0">Autonomous Robots</data>
      <data key="d1">category</data>
      <data key="d2">Autonomous robots are machines that operate independently and are used in various contexts such as manufacturing and personal assistance, requiring safety and reliability.</data>
      <data key="d3">chunk-192f03d2933ad10489c5b8a9e36d2ccf</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/47/</data>
      <data key="d5">1748427701</data>
    </node>
    <node id="Health Sector">
      <data key="d0">Health Sector</data>
      <data key="d1">category</data>
      <data key="d2">The health sector encompasses services related to health and life safety, where advanced diagnostics and decision-support systems are crucial for reliability and accuracy.</data>
      <data key="d3">chunk-192f03d2933ad10489c5b8a9e36d2ccf</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/47/</data>
      <data key="d5">1748427701</data>
    </node>
    <node id="Digital Components">
      <data key="d0">Digital Components</data>
      <data key="d1">category</data>
      <data key="d2">Digital components are parts of products that include software or AI systems that can impact overall product safety and compliance.</data>
      <data key="d3">chunk-192f03d2933ad10489c5b8a9e36d2ccf</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/47/</data>
      <data key="d5">1748427701</data>
    </node>
    <node id="Sophisticated Diagnostics Systems">
      <data key="d0">Sophisticated Diagnostics Systems</data>
      <data key="d1">category</data>
      <data key="d2">Sophisticated diagnostics systems are advanced technological solutions in the healthcare sector designed to support critical decision-making processes.</data>
      <data key="d3">chunk-192f03d2933ad10489c5b8a9e36d2ccf</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/47/</data>
      <data key="d5">1748427701</data>
    </node>
    <node id="Legal Effects">
      <data key="d0">Legal Effects</data>
      <data key="d1">category</data>
      <data key="d2">Legal effects are consequences or outcomes produced by decisions made through AI systems which can impact individuals' rights and freedoms.</data>
      <data key="d3">chunk-28ef04b3893d2080962790dc78128cfd</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/171/</data>
      <data key="d5">1748427704</data>
    </node>
    <node id="Decisions by Deployers">
      <data key="d0">Decisions by Deployers</data>
      <data key="d1">category</data>
      <data key="d2">Decisions by deployers refer to choices made based on AI system outputs, which can significantly affect individuals' health, safety, or fundamental rights.</data>
      <data key="d3">chunk-28ef04b3893d2080962790dc78128cfd</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/171/</data>
      <data key="d5">1748427704</data>
    </node>
    <node id="Digital Transformation">
      <data key="d0">Digital Transformation</data>
      <data key="d1">category</data>
      <data key="d2">Digital Transformation illustrates the process of leveraging digital technology to adapt and innovate business practices and strategies in the market.</data>
      <data key="d3">chunk-5bfe284b31053ed0488ca88518b58ac1</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427716</data>
    </node>
    <node id="Union Legal Framework">
      <data key="d0">Union Legal Framework</data>
      <data key="d1">category</data>
      <data key="d2">Union Legal Framework refers to a set of harmonized rules established by the Union to govern the development and use of AI in accordance with public interests, such as health, safety, and fundamental rights.</data>
      <data key="d3">chunk-5bfe284b31053ed0488ca88518b58ac1</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427716</data>
    </node>
    <node id="public interests">
      <data key="d0">public interests</data>
      <data key="d1">category</data>
      <data key="d2">Public interests encompass health, safety, fundamental rights, democracy, the rule of law, and environmental protection, which the Union aims to uphold through its regulations.</data>
      <data key="d3">chunk-5bfe284b31053ed0488ca88518b58ac1</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427716</data>
    </node>
    <node id="internal market">
      <data key="d0">internal market</data>
      <data key="d1">category</data>
      <data key="d2">Internal market refers to the integrated market within the Union that allows for the free movement of goods and services, which is affected by regulations governing AI systems.</data>
      <data key="d3">chunk-5bfe284b31053ed0488ca88518b58ac1</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427716</data>
    </node>
    <node id="responsibility of Union actors">
      <data key="d0">responsibility of Union actors</data>
      <data key="d1">category</data>
      <data key="d2">The responsibility of Union actors includes ensuring that the development and deployment of AI systems align with Union values and regulatory standards.</data>
      <data key="d3">chunk-5bfe284b31053ed0488ca88518b58ac1</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427716</data>
    </node>
    <node id="innovation and SMEs support">
      <data key="d0">innovation and SMEs support</data>
      <data key="d1">category</data>
      <data key="d2">Innovation and SMEs support encompasses measures designed to promote the development of small and medium enterprises in AI technology, encouraging economic growth.</data>
      <data key="d3">chunk-5bfe284b31053ed0488ca88518b58ac1</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427716</data>
    </node>
    <node id="Special Meeting of the European Council">
      <data key="d0">Special Meeting of the European Council</data>
      <data key="d1">event</data>
      <data key="d2">A specific gathering of the European Council to discuss urgent topics and reach conclusions.</data>
      <data key="d3">chunk-0d4324ec2284f40e56458ffbe5d2da80</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427716</data>
    </node>
    <node id="Framework of Ethical Aspects of AI">
      <data key="d0">Framework of Ethical Aspects of AI</data>
      <data key="d1">category</data>
      <data key="d2">A set of recommendations regarding the ethical considerations in the development and use of artificial intelligence and robotics.</data>
      <data key="d3">chunk-0d4324ec2284f40e56458ffbe5d2da80</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427716</data>
    </node>
    <node id="Ethical Framework of AI and Robotics">
      <data key="d0">Ethical Framework of AI and Robotics</data>
      <data key="d1">category</data>
      <data key="d2">A comprehensive set of guidelines recommended by the European Parliament to address the ethical implications and standards for artificial intelligence and robotics technology.</data>
      <data key="d3">chunk-0d4324ec2284f40e56458ffbe5d2da80</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427719</data>
    </node>
    <node id="Recommendations to the Commission">
      <data key="d0">Recommendations to the Commission</data>
      <data key="d1">event</data>
      <data key="d2">An event in which the European Parliament provides guidance and proposals to the European Commission regarding various matters, including ethical concerns in technology.</data>
      <data key="d3">chunk-0d4324ec2284f40e56458ffbe5d2da80</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/8/</data>
      <data key="d5">1748427719</data>
    </node>
    <node id="Agency">
      <data key="d0">Agency</data>
      <data key="d1">organization</data>
      <data key="d2">An agency refers to a governmental or non-governmental organization that provides specific services and oversees functions, including the deployment of AI technologies.</data>
      <data key="d3">chunk-69800a0e24a3f7afd28e97d0e1079c4a</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/13/</data>
      <data key="d5">1748427722</data>
    </node>
    <node id="Providers and Deployers of AI Systems">
      <data key="d0">Providers and Deployers of AI Systems</data>
      <data key="d1">organization</data>
      <data key="d2">Providers and deployers of AI systems are entities responsible for ensuring AI literacy among their staff and users of AI technology.</data>
      <data key="d3">chunk-b5df3c87d284ff92767412c5cae8b463</data>
      <data key="d4">https://artificialintelligenceact.eu/article/4/</data>
      <data key="d5">1748427725</data>
    </node>
    <node id="Staff and Other Persons">
      <data key="d0">Staff and Other Persons</data>
      <data key="d1">person</data>
      <data key="d2">Staff and other persons refer to individuals involved in the operation and use of AI systems who require AI literacy.</data>
      <data key="d3">chunk-b5df3c87d284ff92767412c5cae8b463</data>
      <data key="d4">https://artificialintelligenceact.eu/article/4/</data>
      <data key="d5">1748427725</data>
    </node>
    <node id="Technical Knowledge">
      <data key="d0">Technical Knowledge</data>
      <data key="d1">category</data>
      <data key="d2">Technical knowledge encompasses the expertise and understanding required to effectively operate AI systems, focusing on the necessary skills for users.</data>
      <data key="d3">chunk-b5df3c87d284ff92767412c5cae8b463</data>
      <data key="d4">https://artificialintelligenceact.eu/article/4/</data>
      <data key="d5">1748427732</data>
    </node>
    <node id="Experience">
      <data key="d0">Experience</data>
      <data key="d1">category</data>
      <data key="d2">Experience refers to the practical knowledge or skills gained over time by individuals using AI systems.</data>
      <data key="d3">chunk-b5df3c87d284ff92767412c5cae8b463</data>
      <data key="d4">https://artificialintelligenceact.eu/article/4/</data>
      <data key="d5">1748427732</data>
    </node>
    <node id="Training">
      <data key="d0">Training</data>
      <data key="d1">category</data>
      <data key="d2">Training involves the methods and practices employed to teach users how to operate and utilize AI systems effectively.&lt;SEP&gt;Training refers to the preparation and educational processes that ensure natural persons have the necessary skills to evaluate AI decisions.</data>
      <data key="d3">chunk-b5df3c87d284ff92767412c5cae8b463&lt;SEP&gt;chunk-58ec10f8fea631de27f7f3ef17b5594a</data>
      <data key="d4">https://artificialintelligenceact.eu/article/14/&lt;SEP&gt;https://artificialintelligenceact.eu/article/4/</data>
      <data key="d5">1748428074</data>
    </node>
    <node id="Real-Time Remote Biometric Identification System">
      <data key="d0">Real-Time Remote Biometric Identification System</data>
      <data key="d1">category</data>
      <data key="d2">A real-time remote biometric identification system is a technological tool used in publicly accessible spaces for law enforcement, requiring specific authorization for use.&lt;SEP&gt;The Real-Time Remote Biometric Identification System refers to a technology used for identifying individuals through biometric data in publicly accessible spaces for law enforcement purposes.</data>
      <data key="d3">chunk-92ce4de2ee2430b55395c19336af7c01&lt;SEP&gt;chunk-a26fcdeec947c5dfd024232093934843</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/35/&lt;SEP&gt;https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Law Enforcement Authority">
      <data key="d0">Law Enforcement Authority</data>
      <data key="d1">organization</data>
      <data key="d2">A law enforcement authority is an official body responsible for maintaining public order and safety, tasked with the use and regulation of AI systems in urgent situations.</data>
      <data key="d3">chunk-92ce4de2ee2430b55395c19336af7c01</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/35/</data>
      <data key="d5">1748427734</data>
    </node>
    <node id="Data Related to AI Use">
      <data key="d0">Data Related to AI Use</data>
      <data key="d1">category</data>
      <data key="d2">Data related to AI use includes all information obtained through the operation of AI systems in law enforcement, subject to legal requirements for handling.</data>
      <data key="d3">chunk-92ce4de2ee2430b55395c19336af7c01</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/35/</data>
      <data key="d5">1748427738</data>
    </node>
    <node id="Remote Biometric Identification System">
      <data key="d0">Remote Biometric Identification System</data>
      <data key="d1">organization</data>
      <data key="d2">The Remote Biometric Identification System is a technology that processes biometric data to identify individuals, often used in security and surveillance contexts.</data>
      <data key="d3">chunk-22fe2322637df933b39b478cbc8c7a08</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/35/</data>
      <data key="d5">1748427738</data>
    </node>
    <node id="Adverse Legal Effect">
      <data key="d0">Adverse Legal Effect</data>
      <data key="d1">category</data>
      <data key="d2">Adverse legal effect refers to outcomes that negatively impact individuals based on decisions made by systems, especially in regards to identification and legal processes.</data>
      <data key="d3">chunk-22fe2322637df933b39b478cbc8c7a08</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/35/</data>
      <data key="d5">1748427738</data>
    </node>
    <node id="Monitoring">
      <data key="d0">Monitoring</data>
      <data key="d1">event</data>
      <data key="d2">Monitoring encompasses ongoing assessment and oversight of AI Systems to ensure they operate within the designated compliance framework.</data>
      <data key="d3">chunk-b2252cbe714fc3b6aee570acd5f270ef</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/71/</data>
      <data key="d5">1748427746</data>
    </node>
    <node id="Algorithms">
      <data key="d0">Algorithms</data>
      <data key="d1">category</data>
      <data key="d2">Algorithms are the computational methods used by AI Systems to process data and make decisions, vital for evaluating their functionality and performance.&lt;SEP&gt;Algorithms refer to the sets of rules or instructions that AI systems follow to process data and make decisions.</data>
      <data key="d3">chunk-e010ebb9b0353d97d9e67673267bc415&lt;SEP&gt;chunk-b2252cbe714fc3b6aee570acd5f270ef</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/69/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/71/</data>
      <data key="d5">1748428214</data>
    </node>
    <node id="Regulation on Artificial Intelligence">
      <data key="d0">Regulation on Artificial Intelligence</data>
      <data key="d1">event</data>
      <data key="d2">The Regulation on Artificial Intelligence aims to establish a unified legal framework for AI systems in the EU, promoting human-centric and trustworthy AI while ensuring protection of health, safety, and fundamental rights.</data>
      <data key="d3">chunk-ec304def59e7573aa1fecc006d51bea7</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/1/</data>
      <data key="d5">1748427752</data>
    </node>
    <node id="Prohibited AI Practices">
      <data key="d0">Prohibited AI Practices</data>
      <data key="d1">event</data>
      <data key="d2">Prohibited AI Practices refers to a set of regulations outlining AI practices that are not allowed, aiming to protect individuals from manipulative and deceptive techniques.</data>
      <data key="d3">chunk-79847bb42790114b4e3db575c6fe603a</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427754</data>
    </node>
    <node id="Recital 29">
      <data key="d0">Recital 29</data>
      <data key="d1">category</data>
      <data key="d2">Recital 29 is a legal reference that addresses the prohibition of AI practices exploiting vulnerabilities and causing harm to individuals or groups.</data>
      <data key="d3">chunk-79847bb42790114b4e3db575c6fe603a</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427754</data>
    </node>
    <node id="Recital 31">
      <data key="d0">Recital 31</data>
      <data key="d1">category</data>
      <data key="d2">Recital 31 pertains to the prohibition of AI systems that evaluate or classify individuals based on their social behavior, leading to unfair treatment.</data>
      <data key="d3">chunk-79847bb42790114b4e3db575c6fe603a</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427754</data>
    </node>
    <node id="Recital 42">
      <data key="d0">Recital 42</data>
      <data key="d1">category</data>
      <data key="d2">Recital 42 discusses limitations on the use of AI for risk assessments regarding criminal activity based on profiling without objective facts.</data>
      <data key="d3">chunk-79847bb42790114b4e3db575c6fe603a</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427754</data>
    </node>
    <node id="Subliminal Techniques">
      <data key="d0">Subliminal Techniques</data>
      <data key="d1">category</data>
      <data key="d2">Subliminal Techniques involve methods that influence individuals subconsciously, which can distort their decision-making capabilities.</data>
      <data key="d3">chunk-79847bb42790114b4e3db575c6fe603a</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427754</data>
    </node>
    <node id="Vulnerability">
      <data key="d0">Vulnerability</data>
      <data key="d1">category</data>
      <data key="d2">Vulnerability describes conditions under which individuals or groups can be exploited or harmed, particularly due to age, disability, or socio-economic status.</data>
      <data key="d3">chunk-79847bb42790114b4e3db575c6fe603a</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427754</data>
    </node>
    <node id="Risk Assessments">
      <data key="d0">Risk Assessments</data>
      <data key="d1">category</data>
      <data key="d2">Risk Assessments are evaluations aimed at predicting the likelihood of a person committing a crime based on data analysis, which can sometimes rely on profiling.&lt;SEP&gt;Risk Assessments involve evaluating the likelihood of individuals committing criminal offenses based on profiling, often utilizing AI technologies.&lt;SEP&gt;Risk assessments are evaluations of the likelihood of an individual committing a crime, which should rely on verifiable facts instead of profiling.</data>
      <data key="d3">chunk-19b580305cd4ba71a7cf07559aa87a40&lt;SEP&gt;chunk-8871d96b04df0305284cbd20bfc2bf41&lt;SEP&gt;chunk-79847bb42790114b4e3db575c6fe603a</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/42/</data>
      <data key="d5">1748428115</data>
    </node>
    <node id="Biometric Categorization Systems">
      <data key="d0">Biometric Categorization Systems</data>
      <data key="d1">category</data>
      <data key="d2">Biometric Categorization Systems categorize individuals based on biometric data, inferring characteristics such as race, beliefs, or sexual orientation.</data>
      <data key="d3">chunk-8871d96b04df0305284cbd20bfc2bf41</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="Social Score">
      <data key="d0">Social Score</data>
      <data key="d1">category</data>
      <data key="d2">Social Score refers to a system of evaluation that assesses individuals or groups based on their social behavior and characteristics, potentially leading to discrimination or bias.</data>
      <data key="d3">chunk-8871d96b04df0305284cbd20bfc2bf41</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="Criminal Offense">
      <data key="d0">Criminal Offense</data>
      <data key="d1">category</data>
      <data key="d2">Criminal Offense denotes any action that violates the law, which AI systems may predict based on profiling individuals.</data>
      <data key="d3">chunk-8871d96b04df0305284cbd20bfc2bf41</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="Context">
      <data key="d0">Context</data>
      <data key="d1">category</data>
      <data key="d2">Context refers to the specific situations or circumstances under which data about individuals is generated or collected, influencing the evaluation by AI systems.</data>
      <data key="d3">chunk-8871d96b04df0305284cbd20bfc2bf41</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="Detrimental Treatment">
      <data key="d0">Detrimental Treatment</data>
      <data key="d1">category</data>
      <data key="d2">Detrimental Treatment refers to unfavorable or unjust treatment of individuals or groups based on their evaluation scores or characteristics, often linked to AI assessments.</data>
      <data key="d3">chunk-8871d96b04df0305284cbd20bfc2bf41</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="Personality Traits">
      <data key="d0">Personality Traits</data>
      <data key="d1">category</data>
      <data key="d2">Personality Traits encompass the characteristics and qualities that define individuals, which may be inferred by AI systems in the assessment process.</data>
      <data key="d3">chunk-8871d96b04df0305284cbd20bfc2bf41</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="Human Assessment">
      <data key="d0">Human Assessment</data>
      <data key="d1">category</data>
      <data key="d2">Human Assessment involves evaluations conducted by individuals rather than systems, often related to AI's role in criminal activity assessments.</data>
      <data key="d3">chunk-8871d96b04df0305284cbd20bfc2bf41</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="Facial Recognition">
      <data key="d0">Facial Recognition</data>
      <data key="d1">category</data>
      <data key="d2">Facial recognition technology analyzes facial features from images or video to identify individuals, often raising privacy concerns.</data>
      <data key="d3">chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427768</data>
    </node>
    <node id="Emotion Inference AI Systems">
      <data key="d0">Emotion Inference AI Systems</data>
      <data key="d1">category</data>
      <data key="d2">Emotion inference AI systems are designed to analyze biometric data, including facial expressions, to determine the emotional state of individuals in settings like workplaces and educational institutions.</data>
      <data key="d3">chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Workplace Institutions">
      <data key="d0">Workplace Institutions</data>
      <data key="d1">geo</data>
      <data key="d2">Workplace institutions are organizations or settings where individuals are employed and may utilize AI systems for monitoring employee performance or emotions.</data>
      <data key="d3">chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Education Institutions">
      <data key="d0">Education Institutions</data>
      <data key="d1">geo</data>
      <data key="d2">Educational institutions are organizations dedicated to educating individuals, which can also adopt AI systems for assessing student engagement and emotional responses.</data>
      <data key="d3">chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Human Trafficking">
      <data key="d0">Human Trafficking</data>
      <data key="d1">category</data>
      <data key="d2">Human trafficking refers to the illegal trade of people for exploitation, including forced labor and sexual exploitation.&lt;SEP&gt;Human trafficking refers to the illegal transportation and exploitation of individuals, often associated with severe legal and humanitarian concerns.</data>
      <data key="d3">chunk-e142ac7019ab93d80ef49579e8d0866e&lt;SEP&gt;chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Abduction">
      <data key="d0">Abduction</data>
      <data key="d1">category</data>
      <data key="d2">Abduction is the act of forcibly taking away a person, often raising concerns for law enforcement and public safety.&lt;SEP&gt;Abduction is the act of unlawfully seizing and carrying away a person by force or fraud.</data>
      <data key="d3">chunk-e142ac7019ab93d80ef49579e8d0866e&lt;SEP&gt;chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Missing Persons">
      <data key="d0">Missing Persons</data>
      <data key="d1">category</data>
      <data key="d2">Missing persons are individuals whose whereabouts are unknown and who are often the focus of law enforcement investigations and public appeals.</data>
      <data key="d3">chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Terrorist Attacks">
      <data key="d0">Terrorist Attacks</data>
      <data key="d1">category</data>
      <data key="d2">Terrorist attacks involve violent acts aimed at instilling fear for ideological purposes, often requiring law enforcement's immediate and precise response.</data>
      <data key="d3">chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Member States' Security Forces">
      <data key="d0">Member States' Security Forces</data>
      <data key="d1">organization</data>
      <data key="d2">Member States' security forces comprise various governmental agencies tasked with maintaining public safety, often involved in enforcing laws against serious crimes like trafficking and terrorism.</data>
      <data key="d3">chunk-7dcb340351b261f219fcf1a78d4f2f70</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Terrorist Attack">
      <data key="d0">Terrorist Attack</data>
      <data key="d1">category</data>
      <data key="d2">A terrorist attack is a violent act aimed at causing fear or intimidation, often for political motives.</data>
      <data key="d3">chunk-e142ac7019ab93d80ef49579e8d0866e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Criminal Offence">
      <data key="d0">Criminal Offence</data>
      <data key="d1">category</data>
      <data key="d2">A criminal offence refers to an act that violates a law and is punishable by the state.</data>
      <data key="d3">chunk-e142ac7019ab93d80ef49579e8d0866e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Section II of Regulation (EU) 2016/679">
      <data key="d0">Section II of Regulation (EU) 2016/679</data>
      <data key="d1">organization</data>
      <data key="d2">Section II of Regulation (EU) 2016/679 outlines the legal framework for processing personal data, particularly relating to law enforcement.</data>
      <data key="d3">chunk-e142ac7019ab93d80ef49579e8d0866e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Remote Identification Systems">
      <data key="d0">Remote Identification Systems</data>
      <data key="d1">category</data>
      <data key="d2">Remote identification systems are technologies used to identify individuals from a distance, particularly in public spaces for security purposes.</data>
      <data key="d3">chunk-e142ac7019ab93d80ef49579e8d0866e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="independent administrative authority">
      <data key="d0">independent administrative authority</data>
      <data key="d1">organization</data>
      <data key="d2">An independent administrative authority is a body that operates autonomously, making decisions that are binding in the context of requests for authorizations related to biometric systems.&lt;SEP&gt;An independent administrative authority is an entity that can grant authorization for law enforcement uses of biometric identification systems.</data>
      <data key="d3">chunk-7127c7bb3049241e70ac955f8f0024b5&lt;SEP&gt;chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="identity of the specifically targeted individual">
      <data key="d0">identity of the specifically targeted individual</data>
      <data key="d1">category</data>
      <data key="d2">Identity of the specifically targeted individual refers to the specific subject being monitored or identified using biometric systems, reflecting the legal and ethical considerations surrounding privacy and surveillance.</data>
      <data key="d3">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="situation">
      <data key="d0">situation</data>
      <data key="d1">category</data>
      <data key="d2">The situation addresses the context or scenario under which biometric identification systems may be employed, including potential threats or harm that justify their use.</data>
      <data key="d3">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="use of real-time remote biometric identification systems">
      <data key="d0">use of real-time remote biometric identification systems</data>
      <data key="d1">category</data>
      <data key="d2">The use of ‘real-time’ remote biometric identification systems involves deploying technology for immediate identification in public spaces for law enforcement purposes.</data>
      <data key="d3">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Article 27">
      <data key="d0">Article 27</data>
      <data key="d1">category</data>
      <data key="d2">Article 27 outlines the regulations and requirements for assessing fundamental rights impacts related to biometric surveillance and identification.</data>
      <data key="d3">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="prior authorisation">
      <data key="d0">prior authorisation</data>
      <data key="d1">category</data>
      <data key="d2">Prior authorisation is a legal requirement that necessitates approval from relevant authorities before implementing biometric identification systems in public spaces.</data>
      <data key="d3">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="judicial authority's decision">
      <data key="d0">judicial authority's decision</data>
      <data key="d1">category</data>
      <data key="d2">The judicial authority's decision is a binding determination made by a court or legal entity regarding the use of biometric systems in a specific context.</data>
      <data key="d3">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Independent Administrative Authority">
      <data key="d0">Independent Administrative Authority</data>
      <data key="d1">organization</data>
      <data key="d2">The Independent Administrative Authority oversees and ensures that the implementation of biometric identification aligns with established laws and regulations within a Member State.</data>
      <data key="d3">chunk-a26fcdeec947c5dfd024232093934843</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Competent Judicial Authority">
      <data key="d0">Competent Judicial Authority</data>
      <data key="d1">organization</data>
      <data key="d2">The Competent Judicial Authority is a legal body that evaluates and grants permission for the use of biometric identification systems based on reasoned requests.</data>
      <data key="d3">chunk-a26fcdeec947c5dfd024232093934843</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="national data protection authorities">
      <data key="d0">national data protection authorities</data>
      <data key="d1">organization</data>
      <data key="d2">National data protection authorities are governmental bodies responsible for enforcing data protection laws and ensuring compliance with privacy regulations.</data>
      <data key="d3">chunk-17b23a5bf3ea6e9c99542abdf17cfaa8</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="paragraph 4">
      <data key="d0">paragraph 4</data>
      <data key="d1">category</data>
      <data key="d2">Paragraph 4 outlines the legal provisions that Member States must establish when using biometric identification systems for law enforcement.</data>
      <data key="d3">chunk-17b23a5bf3ea6e9c99542abdf17cfaa8</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="paragraph 5">
      <data key="d0">paragraph 5</data>
      <data key="d1">category</data>
      <data key="d2">Paragraph 5 pertains to the duty of Member States to notify the European Commission of the related rules regarding biometric identification systems.</data>
      <data key="d3">chunk-17b23a5bf3ea6e9c99542abdf17cfaa8</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="paragraph 6">
      <data key="d0">paragraph 6</data>
      <data key="d1">category</data>
      <data key="d2">Paragraph 6 outlines the obligation of market surveillance authorities and data protection authorities to monitor the implementation of agreed protocols.</data>
      <data key="d3">chunk-17b23a5bf3ea6e9c99542abdf17cfaa8</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="National Market Surveillance Authorities">
      <data key="d0">National Market Surveillance Authorities</data>
      <data key="d1">organization</data>
      <data key="d2">National Market Surveillance Authorities are responsible for monitoring compliance with market regulations and laws in Member States, particularly regarding the use of biometric identification systems.</data>
      <data key="d3">chunk-b6884d6c4641c256f66289e2e2b56965</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Remote Biometric Identification Systems">
      <data key="d0">Remote Biometric Identification Systems</data>
      <data key="d1">category</data>
      <data key="d2">Remote biometric identification systems are technologies employed by law enforcement to identify individuals in real-time within publicly accessible spaces, utilizing biometric data like facial recognition.</data>
      <data key="d3">chunk-b6884d6c4641c256f66289e2e2b56965</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Paragraphs 1, 2, and 3">
      <data key="d0">Paragraphs 1, 2, and 3</data>
      <data key="d1">event</data>
      <data key="d2">Paragraphs 1, 2, and 3 reference specific sections of legal documents outlining the conditions and regulations for implementing biometric identification in law enforcement.</data>
      <data key="d3">chunk-b6884d6c4641c256f66289e2e2b56965</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="law enforcement purposes">
      <data key="d0">law enforcement purposes</data>
      <data key="d1">category</data>
      <data key="d2">Law enforcement purposes denote the legal context under which biometric identification systems are applied, emphasizing public safety and security.</data>
      <data key="d3">chunk-7127c7bb3049241e70ac955f8f0024b5</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="AI practice">
      <data key="d0">AI practice</data>
      <data key="d1">category</data>
      <data key="d2">AI practice involves the application of artificial intelligence technologies, which must comply with Union law to avoid infringements.</data>
      <data key="d3">chunk-7127c7bb3049241e70ac955f8f0024b5</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="annual reports">
      <data key="d0">annual reports</data>
      <data key="d1">category</data>
      <data key="d2">Annual reports are documents that summarize the activities and findings related to the use of biometric identification systems and law enforcement.</data>
      <data key="d3">chunk-7127c7bb3049241e70ac955f8f0024b5</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="judicial authorities">
      <data key="d0">judicial authorities</data>
      <data key="d1">organization</data>
      <data key="d2">Judicial authorities refer to the legal bodies or entities that have the power to make binding decisions regarding authorizations for the use of biometric identification.</data>
      <data key="d3">chunk-7127c7bb3049241e70ac955f8f0024b5</data>
      <data key="d4">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d5">1748427772</data>
    </node>
    <node id="Data Sets">
      <data key="d0">Data Sets</data>
      <data key="d1">category</data>
      <data key="d2">Data sets are collections of data that are used for the training, validation, and testing of AI systems, requiring quality and representativeness.&lt;SEP&gt;Data sets are collections of data used to train AI systems; their completeness and accuracy are crucial in preventing biases.&lt;SEP&gt;Data sets are collections of data used to train, validate, and test AI systems, and must be structured and representative to ensure effective model performance.</data>
      <data key="d3">chunk-06ef56265dcb6096b96bc5ee3bfe08c2&lt;SEP&gt;chunk-d1b1b6d000ef2c2e744936b8e5264e46&lt;SEP&gt;chunk-e428719939f639dff07b7393c2795962</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/67/&lt;SEP&gt;https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427989</data>
    </node>
    <node id="Bias Detection">
      <data key="d0">Bias Detection</data>
      <data key="d1">category</data>
      <data key="d2">Bias detection involves identifying and correcting biases in data that could affect the outcomes of AI systems, thus preventing discrimination.</data>
      <data key="d3">chunk-06ef56265dcb6096b96bc5ee3bfe08c2</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427776</data>
    </node>
    <node id="Validation Data Sets">
      <data key="d0">Validation Data Sets</data>
      <data key="d1">category</data>
      <data key="d2">Validation data sets are used to assess the performance of AI systems, ensuring they function correctly and meet intended purposes.&lt;SEP&gt;Validation data sets are used to assess the performance of trained AI models, helping to ensure that they generalize well to new, unseen data.</data>
      <data key="d3">chunk-06ef56265dcb6096b96bc5ee3bfe08c2&lt;SEP&gt;chunk-65688cdd97448f1f3932957595156d18</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427776</data>
    </node>
    <node id="Testing Data Sets">
      <data key="d0">Testing Data Sets</data>
      <data key="d1">category</data>
      <data key="d2">Testing data sets evaluate the final performance of AI systems, checking for accuracy and reliability in various scenarios.&lt;SEP&gt;Testing data sets serve to evaluate the accuracy and effectiveness of AI models in real-world scenarios after training and validation.</data>
      <data key="d3">chunk-06ef56265dcb6096b96bc5ee3bfe08c2&lt;SEP&gt;chunk-65688cdd97448f1f3932957595156d18</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427776</data>
    </node>
    <node id="Data Governance Practices">
      <data key="d0">Data Governance Practices</data>
      <data key="d1">category</data>
      <data key="d2">Data governance practices encompass methods and protocols for managing data quality, security, and compliance, ensuring data is handled appropriately.</data>
      <data key="d3">chunk-06ef56265dcb6096b96bc5ee3bfe08c2</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427776</data>
    </node>
    <node id="Data Collection Processes">
      <data key="d0">Data Collection Processes</data>
      <data key="d1">category</data>
      <data key="d2">Data collection processes involve the systematic gathering of information that is relevant and necessary for AI training, ensuring data quality and purpose alignment.</data>
      <data key="d3">chunk-06ef56265dcb6096b96bc5ee3bfe08c2</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427776</data>
    </node>
    <node id="Bias Mitigation Measures">
      <data key="d0">Bias Mitigation Measures</data>
      <data key="d1">category</data>
      <data key="d2">Bias mitigation measures include actions and techniques employed to detect and correct biases in data that may lead to discrimination or negative impacts.</data>
      <data key="d3">chunk-06ef56265dcb6096b96bc5ee3bfe08c2</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427776</data>
    </node>
    <node id="Geographical Context">
      <data key="d0">Geographical Context</data>
      <data key="d1">category</data>
      <data key="d2">Geographical context refers to the specific environmental or cultural settings in which high-risk AI systems are intended to be applied.&lt;SEP&gt;Geographical context refers to the various features or characteristics specific to different locations that can impact the implementation and effectiveness of AI systems.</data>
      <data key="d3">chunk-06ef56265dcb6096b96bc5ee3bfe08c2&lt;SEP&gt;chunk-e428719939f639dff07b7393c2795962</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/67/&lt;SEP&gt;https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427989</data>
    </node>
    <node id="Data Gaps">
      <data key="d0">Data Gaps</data>
      <data key="d1">category</data>
      <data key="d2">Data gaps refer to the lack of relevant data or shortcomings that hinder compliance with regulations, highlighting the need for improvement in data gathering and processing.</data>
      <data key="d3">chunk-65688cdd97448f1f3932957595156d18</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427780</data>
    </node>
    <node id="Statistical Properties">
      <data key="d0">Statistical Properties</data>
      <data key="d1">category</data>
      <data key="d2">Statistical properties refer to the characteristics of datasets that ensure their validity and reliability for use in high-risk AI systems.</data>
      <data key="d3">chunk-65688cdd97448f1f3932957595156d18</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427780</data>
    </node>
    <node id="Technical Limitations">
      <data key="d0">Technical Limitations</data>
      <data key="d1">category</data>
      <data key="d2">Technical Limitations refer to restrictions or constraints affecting the use and processing of personal data, particularly in the context of AI and data privacy.</data>
      <data key="d3">chunk-d9acb869e8831be994323dab5f07993e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427780</data>
    </node>
    <node id="Pseudonymisation">
      <data key="d0">Pseudonymisation</data>
      <data key="d1">category</data>
      <data key="d2">Pseudonymisation is a data-processing technique that replaces private identifiers with fake identifiers to help protect personal data.</data>
      <data key="d3">chunk-d9acb869e8831be994323dab5f07993e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427780</data>
    </node>
    <node id="Data Access Controls">
      <data key="d0">Data Access Controls</data>
      <data key="d1">category</data>
      <data key="d2">Data Access Controls are security measures put in place to restrict access to sensitive personal data to authorized personnel only.</data>
      <data key="d3">chunk-d9acb869e8831be994323dab5f07993e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427780</data>
    </node>
    <node id="Storage and Retention Periods">
      <data key="d0">Storage and Retention Periods</data>
      <data key="d1">category</data>
      <data key="d2">Storage and Retention Periods refer to the specified duration for which personal data can be kept and the conditions that must be met before it is deleted.</data>
      <data key="d3">chunk-d9acb869e8831be994323dab5f07993e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427780</data>
    </node>
    <node id="EU Data Protection Regulations">
      <data key="d0">EU Data Protection Regulations</data>
      <data key="d1">category</data>
      <data key="d2">EU Data Protection Regulations comprise laws aimed at protecting the fundamental rights and freedoms of individuals regarding their personal data.</data>
      <data key="d3">chunk-d9acb869e8831be994323dab5f07993e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427780</data>
    </node>
    <node id="Directive (EU) 2018/1725">
      <data key="d0">Directive (EU) 2018/1725</data>
      <data key="d1">event</data>
      <data key="d2">Directive (EU) 2018/1725 relates to the protection of personal data processed by EU institutions and bodies.</data>
      <data key="d3">chunk-dc185ecb84a12901d24ae59e4dd5dfe5</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427780</data>
    </node>
    <node id="processing of personal data">
      <data key="d0">processing of personal data</data>
      <data key="d1">category</data>
      <data key="d2">The processing of personal data involves collecting, storing, or handling individual personal information, often under strict legal frameworks to protect individuals' rights.</data>
      <data key="d3">chunk-dc185ecb84a12901d24ae59e4dd5dfe5</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427784</data>
    </node>
    <node id="High-risk AI system">
      <data key="d0">High-risk AI system</data>
      <data key="d3">chunk-65688cdd97448f1f3932957595156d18</data>
      <data key="d2">Bias detection and correction is a critical requirement for high-risk AI systems to ensure fairness and compliance with regulations.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">https://artificialintelligenceact.eu/article/10/</data>
      <data key="d5">1748427784</data>
    </node>
    <node id="Machinery">
      <data key="d0">Machinery</data>
      <data key="d1">category</data>
      <data key="d2">Machinery includes various equipment designed for industrial and commercial use, subject to safety regulations under Union legislation.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="Toys">
      <data key="d0">Toys</data>
      <data key="d1">category</data>
      <data key="d2">Toys are products intended for play and must meet safety standards as outlined in Union regulations.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="Automotive">
      <data key="d0">Automotive</data>
      <data key="d1">category</data>
      <data key="d2">Automotive products include vehicles and their components, regulated for safety under harmonisation laws.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="Aviation">
      <data key="d0">Aviation</data>
      <data key="d1">category</data>
      <data key="d2">Aviation products pertain to equipment used in air travel, governed by regulatory standards for safety.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="High-Risk Products">
      <data key="d0">High-Risk Products</data>
      <data key="d1">category</data>
      <data key="d2">High-Risk Products are those that could pose safety risks to users and are subject to rigorous testing and compliance under relevant legislation.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="Lifts">
      <data key="d0">Lifts</data>
      <data key="d1">category</data>
      <data key="d2">Lifts are mechanical systems used for transporting people or goods vertically and must comply with safety regulations outlined in harmonisation legislation.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="Equipment for Potentially Explosive Atmospheres">
      <data key="d0">Equipment for Potentially Explosive Atmospheres</data>
      <data key="d1">category</data>
      <data key="d2">Equipment for potentially explosive atmospheres refers to devices engineered to operate safely in environments with a risk of explosion.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="In Vitro Diagnostic Medical Devices">
      <data key="d0">In Vitro Diagnostic Medical Devices</data>
      <data key="d1">category</data>
      <data key="d2">In Vitro Diagnostic Medical Devices are tests performed on samples taken from the body, requiring compliance with safety regulations.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="Automotive Products">
      <data key="d0">Automotive Products</data>
      <data key="d1">category</data>
      <data key="d2">Automotive Products include vehicles and parts that must meet safety standards as prescribed by EU regulations to protect users.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="Aviation Equipment">
      <data key="d0">Aviation Equipment</data>
      <data key="d1">category</data>
      <data key="d2">Aviation Equipment encompasses all devices utilized in aircraft that must adhere to strict safety and regulatory standards in compliance with aviation laws.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="Cableway Installations">
      <data key="d0">Cableway Installations</data>
      <data key="d1">category</data>
      <data key="d2">Cableway Installations are transport systems that utilize cables for the movement of passengers or goods, needing to comply with safety legislation.</data>
      <data key="d3">chunk-13251cb96e29c95cab559ac75d5b1f1f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/50/</data>
      <data key="d5">1748427803</data>
    </node>
    <node id="Union Authorities">
      <data key="d0">Union Authorities</data>
      <data key="d1">category</data>
      <data key="d2">Union authorities refer to entities within the European Union that may participate in relevant discussions at the European Artificial Intelligence Board.</data>
      <data key="d3">chunk-8b4f722f831bc4c8c4594e971e7b7654</data>
      <data key="d4">https://artificialintelligenceact.eu/article/65/</data>
      <data key="d5">1748427814</data>
    </node>
    <node id="Board Meetings">
      <data key="d0">Board Meetings</data>
      <data key="d1">event</data>
      <data key="d2">Board Meetings are gatherings where representatives discuss and make decisions regarding the implementation of AI regulations and policies.</data>
      <data key="d3">chunk-8b4f722f831bc4c8c4594e971e7b7654</data>
      <data key="d4">https://artificialintelligenceact.eu/article/65/</data>
      <data key="d5">1748427814</data>
    </node>
    <node id="Sub-groups">
      <data key="d0">Sub-groups</data>
      <data key="d1">category</data>
      <data key="d2">Sub-groups are specialized committees within the European Artificial Intelligence Board established to address specific issues related to market surveillance and AI regulations.&lt;SEP&gt;Sub-groups refer to specialized teams within the Board that focus on specific issues related to market surveillance and regulatory compliance.</data>
      <data key="d3">chunk-65cbc432dadad605b2e47a18258f70a0&lt;SEP&gt;chunk-8b4f722f831bc4c8c4594e971e7b7654</data>
      <data key="d4">https://artificialintelligenceact.eu/article/65/</data>
      <data key="d5">1748427814</data>
    </node>
    <node id="Rules of Procedure">
      <data key="d0">Rules of Procedure</data>
      <data key="d1">category</data>
      <data key="d2">The Rules of Procedure outline the formal guidelines for how the Board operates, including voting procedures and the selection process for the Chair.</data>
      <data key="d3">chunk-65cbc432dadad605b2e47a18258f70a0</data>
      <data key="d4">https://artificialintelligenceact.eu/article/65/</data>
      <data key="d5">1748427814</data>
    </node>
    <node id="Article 30 of Regulation (EU) 2019/1020">
      <data key="d0">Article 30 of Regulation (EU) 2019/1020</data>
      <data key="d1">category</data>
      <data key="d2">Article 30 of Regulation (EU) 2019/1020 serves as a legal foundation relevant to the tasks assigned to the Board and its operational framework.</data>
      <data key="d3">chunk-65cbc432dadad605b2e47a18258f70a0</data>
      <data key="d4">https://artificialintelligenceact.eu/article/65/</data>
      <data key="d5">1748427814</data>
    </node>
    <node id="Chair">
      <data key="d0">Chair</data>
      <data key="d1">person</data>
      <data key="d2">The Chair is the individual who leads the Board and requests meetings to discuss agenda items.</data>
      <data key="d3">chunk-3da283c72662f2af740c6edac711fbbe</data>
      <data key="d4">https://artificialintelligenceact.eu/article/65/</data>
      <data key="d5">1748427821</data>
    </node>
    <node id="EU Regulation on AI Systems">
      <data key="d0">EU Regulation on AI Systems</data>
      <data key="d1">organization</data>
      <data key="d2">The EU Regulation aims to mitigate risks associated with high-risk AI systems and to ensure their trustworthiness through mandatory requirements.</data>
      <data key="d3">chunk-d9512f56ddf79fc1a7f65b696c84e2eb</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/64/</data>
      <data key="d5">1748427831</data>
    </node>
    <node id="High-risk AI Systems">
      <data key="d0">High-risk AI Systems</data>
      <data key="d1">category</data>
      <data key="d2">High-risk AI systems are categorized based on their potential impact and are subject to stringent regulatory requirements under EU legislation.&lt;SEP&gt;High-risk AI systems are defined as those AI models that must conform to specific common specifications laid out by the Commission.</data>
      <data key="d3">chunk-214363bac320d3b288355fb10d6c0537&lt;SEP&gt;chunk-d9512f56ddf79fc1a7f65b696c84e2eb</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/64/</data>
      <data key="d5">1748428426</data>
    </node>
    <node id="Mandatory Requirements">
      <data key="d0">Mandatory Requirements</data>
      <data key="d1">category</data>
      <data key="d2">Mandatory requirements refer to the essential regulations that high-risk AI systems must adhere to in order to ensure their trustworthiness and safety in the market.</data>
      <data key="d3">chunk-d9512f56ddf79fc1a7f65b696c84e2eb</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/64/</data>
      <data key="d5">1748427831</data>
    </node>
    <node id="Risk-Management System">
      <data key="d0">Risk-Management System</data>
      <data key="d1">category</data>
      <data key="d2">A risk-management system is a structured approach implemented by providers to identify, assess and mitigate risks associated with high-risk AI systems.&lt;SEP&gt;The risk-management system is a continuous and iterative framework aimed at identifying and mitigating risks associated with high-risk AI systems throughout their lifecycle.</data>
      <data key="d3">chunk-043dd859ed68e9fbb76ff618fe32c054&lt;SEP&gt;chunk-d9512f56ddf79fc1a7f65b696c84e2eb</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/64/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/65/</data>
      <data key="d5">1748428024</data>
    </node>
    <node id="Essential Health and Safety Requirements">
      <data key="d0">Essential Health and Safety Requirements</data>
      <data key="d1">category</data>
      <data key="d2">Essential health and safety requirements are the baseline safety standards established in existing Union harmonised legislation to protect consumers.</data>
      <data key="d3">chunk-d9512f56ddf79fc1a7f65b696c84e2eb</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/64/</data>
      <data key="d5">1748427837</data>
    </node>
    <node id="Blue Guide">
      <data key="d0">Blue Guide</data>
      <data key="d1">organization</data>
      <data key="d2">The Blue Guide is a Commission notice that provides clarification on the implementation of EU product rules, particularly related to AI and other high-risk products.</data>
      <data key="d3">chunk-d9512f56ddf79fc1a7f65b696c84e2eb</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/64/</data>
      <data key="d5">1748427837</data>
    </node>
    <node id="Legal Acts of Union Harmonisation Legislation">
      <data key="d0">Legal Acts of Union Harmonisation Legislation</data>
      <data key="d1">category</data>
      <data key="d2">Legal acts of Union harmonisation legislation are laws established to create consistent standards and regulations across the European Union for various products and services.</data>
      <data key="d3">chunk-d9512f56ddf79fc1a7f65b696c84e2eb</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/64/</data>
      <data key="d5">1748427837</data>
    </node>
    <node id="Union Harmonised Legislation">
      <data key="d0">Union Harmonised Legislation</data>
      <data key="d1">category</data>
      <data key="d2">Union Harmonised Legislation encompasses the regulatory framework designed to ensure safety and compliance across various sectors, specifically addressing products that may contain high-risk AI systems.</data>
      <data key="d3">chunk-92136a9226f18376c3de5d9f6b6485ef</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/64/</data>
      <data key="d5">1748427837</data>
    </node>
    <node id="Sectoral Law">
      <data key="d0">Sectoral Law</data>
      <data key="d1">category</data>
      <data key="d2">Sectoral Law refers to legislation that deals with specific sectors but lacks provisions addressing the unique risks posed by AI systems.</data>
      <data key="d3">chunk-92136a9226f18376c3de5d9f6b6485ef</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/64/</data>
      <data key="d5">1748427837</data>
    </node>
    <node id="Biometric identification systems">
      <data key="d0">Biometric identification systems</data>
      <data key="d1">category</data>
      <data key="d2">Biometric identification systems are technologies used to identify individuals based on their physical characteristics, which can have significant consequences if misapplied.</data>
      <data key="d3">chunk-e32fcfee58701346b1cdfaa0595c615d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d5">1748427840</data>
    </node>
    <node id="Operational Constraints">
      <data key="d0">Operational Constraints</data>
      <data key="d1">category</data>
      <data key="d2">Operational constraints are built-in limitations within AI systems that prevent them from making certain decisions autonomously.</data>
      <data key="d3">chunk-e32fcfee58701346b1cdfaa0595c615d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d5">1748427840</data>
    </node>
    <node id="Biometric Identification Systems">
      <data key="d0">Biometric Identification Systems</data>
      <data key="d1">category</data>
      <data key="d2">Biometric identification systems are technologies that identify individuals based on physical attributes, which can have critical implications if they produce incorrect results.</data>
      <data key="d3">chunk-e32fcfee58701346b1cdfaa0595c615d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d5">1748427840</data>
    </node>
    <node id="Verification Requirements">
      <data key="d0">Verification Requirements</data>
      <data key="d1">category</data>
      <data key="d2">Verification requirements refer to the protocols that must be followed to ensure decisions made by high-risk AI do not rely solely on automated systems without human confirmation.</data>
      <data key="d3">chunk-e32fcfee58701346b1cdfaa0595c615d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d5">1748427840</data>
    </node>
    <node id="migration">
      <data key="d0">migration</data>
      <data key="d1">category</data>
      <data key="d2">Migration refers to the movement of individuals or groups from one place to another, often across international borders, and is subject to various laws and regulations.</data>
      <data key="d3">chunk-5345c3cccd7883e192f55328579d86d4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d5">1748427843</data>
    </node>
    <node id="border control">
      <data key="d0">border control</data>
      <data key="d1">category</data>
      <data key="d2">Border control relates to the measures taken by a country to regulate its borders, including the management of people crossing into and out of the country.</data>
      <data key="d3">chunk-5345c3cccd7883e192f55328579d86d4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d5">1748427843</data>
    </node>
    <node id="asylum">
      <data key="d0">asylum</data>
      <data key="d1">category</data>
      <data key="d2">Asylum is a form of international protection given to individuals in a foreign country due to fear of persecution in their home country.</data>
      <data key="d3">chunk-5345c3cccd7883e192f55328579d86d4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d5">1748427843</data>
    </node>
    <node id="Territory">
      <data key="d0">Territory</data>
      <data key="d1">geo</data>
      <data key="d2">Territory refers to the geographical area within a Member State where the Regulation is applicable and authorization may be granted.</data>
      <data key="d3">chunk-4e43bf41139a924443fd8b200d694f24</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/37/</data>
      <data key="d5">1748427850</data>
    </node>
    <node id="Technical Standards">
      <data key="d0">Technical Standards</data>
      <data key="d1">category</data>
      <data key="d2">Technical standards are established guidelines and criteria that inform the development and interoperability of AI systems.</data>
      <data key="d3">chunk-593116201bc6ad18de913cc89dec1b6b</data>
      <data key="d4">https://artificialintelligenceact.eu/article/50/</data>
      <data key="d5">1748427859</data>
    </node>
    <node id="Human-Machine Interaction">
      <data key="d0">Human-Machine Interaction</data>
      <data key="d1">category</data>
      <data key="d2">Human-machine interaction involves the ways in which individuals communicate and engage with AI systems, requiring clarity and transparency.</data>
      <data key="d3">chunk-593116201bc6ad18de913cc89dec1b6b</data>
      <data key="d4">https://artificialintelligenceact.eu/article/50/</data>
      <data key="d5">1748427859</data>
    </node>
    <node id="Article 56 (6)">
      <data key="d0">Article 56 (6)</data>
      <data key="d1">event</data>
      <data key="d2">Article 56 (6) refers to a specific regulatory procedure within EU law related to approving codes of practice for AI transparency obligations.</data>
      <data key="d3">chunk-4425b51346d70d56a2933633cfeb0018</data>
      <data key="d4">https://artificialintelligenceact.eu/article/50/</data>
      <data key="d5">1748427864</data>
    </node>
    <node id="Generated or Manipulated Content">
      <data key="d0">Generated or Manipulated Content</data>
      <data key="d1">category</data>
      <data key="d2">Generated or manipulated content includes text created by AI systems which may influence public opinion and requires clear labeling.</data>
      <data key="d3">chunk-4425b51346d70d56a2933633cfeb0018</data>
      <data key="d4">https://artificialintelligenceact.eu/article/50/</data>
      <data key="d5">1748427864</data>
    </node>
    <node id="Recital 134">
      <data key="d0">Recital 134</data>
      <data key="d1">event</data>
      <data key="d2">Recital 134 is a part of the legislative text that sets forth obligations regarding transparency in AI-generated content.</data>
      <data key="d3">chunk-4425b51346d70d56a2933633cfeb0018</data>
      <data key="d4">https://artificialintelligenceact.eu/article/50/</data>
      <data key="d5">1748427864</data>
    </node>
    <node id="Recital 135">
      <data key="d0">Recital 135</data>
      <data key="d1">event</data>
      <data key="d2">Recital 135 references another legislative provision related to the enforcement and implications of AI transparency obligations.</data>
      <data key="d3">chunk-4425b51346d70d56a2933633cfeb0018</data>
      <data key="d4">https://artificialintelligenceact.eu/article/50/</data>
      <data key="d5">1748427864</data>
    </node>
    <node id="Codes of Practice">
      <data key="d0">Codes of Practice</data>
      <data key="d1">event</data>
      <data key="d2">Codes of Practice are guidelines and regulations that define obligations for the providers of general-purpose AI models, particularly those presenting systemic risks.&lt;SEP&gt;Codes of practice are guidelines intended to facilitate effective implementation of obligations regarding content detection and labeling.&lt;SEP&gt;Codes of practice are documents that outline standards and guidelines for compliance with AI regulations, crucial for providers of AI models.</data>
      <data key="d3">chunk-831c946b1acae90a683cbc5ac489ffaf&lt;SEP&gt;chunk-dee723ad2204a364a1d2dbe158b59a8f&lt;SEP&gt;chunk-408ee65c3eab1e86c1c4207deaf4f216</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/117/&lt;SEP&gt;https://artificialintelligenceact.eu/article/50/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/116/</data>
      <data key="d5">1748428390</data>
    </node>
    <node id="Article 4, point (14)">
      <data key="d0">Article 4, point (14)</data>
      <data key="d1">category</data>
      <data key="d2">Article 4, point (14) refers to a specific clause within Regulation (EU) 2016/679 that defines biometric data and sets its parameters for interpretation and use.</data>
      <data key="d3">chunk-d0d2c55c34335ae38db203f32e428ce7</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/14/</data>
      <data key="d5">1748427874</data>
    </node>
    <node id="Article 3, point (18)">
      <data key="d0">Article 3, point (18)</data>
      <data key="d1">category</data>
      <data key="d2">Article 3, point (18) from Regulation (EU) 2018/1725 defines the scope and constraints regarding the management of biometric data by EU institutions.</data>
      <data key="d3">chunk-d0d2c55c34335ae38db203f32e428ce7</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/14/</data>
      <data key="d5">1748427874</data>
    </node>
    <node id="Article 3, point (13)">
      <data key="d0">Article 3, point (13)</data>
      <data key="d1">category</data>
      <data key="d2">Article 3, point (13) of Directive (EU) 2016/680 elucidates the handling of biometric data within law enforcement contexts.</data>
      <data key="d3">chunk-d0d2c55c34335ae38db203f32e428ce7</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/14/</data>
      <data key="d5">1748427874</data>
    </node>
    <node id="Compliance Evaluations">
      <data key="d0">Compliance Evaluations</data>
      <data key="d1">event</data>
      <data key="d2">Compliance evaluations are assessments carried out to ensure that AI systems meet regulatory requirements and are compliant with the established guidelines.</data>
      <data key="d3">chunk-933ead385d4e52b665df0118cb006cfd</data>
      <data key="d4">https://artificialintelligenceact.eu/article/75/</data>
      <data key="d5">1748427881</data>
    </node>
    <node id="Cybersecurity Scheme">
      <data key="d0">Cybersecurity Scheme</data>
      <data key="d1">category</data>
      <data key="d2">A cybersecurity scheme refers to a framework or set of guidelines designed to ensure the security and integrity of high-risk AI systems.</data>
      <data key="d3">chunk-a0bafee65696de6d27593351f1c77561</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/122/</data>
      <data key="d5">1748427893</data>
    </node>
    <node id="Measure on Data Governance">
      <data key="d0">Measure on Data Governance</data>
      <data key="d1">category</data>
      <data key="d2">The measure on data governance sets out requirements for managing and protecting data in the context of high-risk AI systems.</data>
      <data key="d3">chunk-a0bafee65696de6d27593351f1c77561</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/122/</data>
      <data key="d5">1748427893</data>
    </node>
    <node id="Public Assistance Benefits">
      <data key="d0">Public Assistance Benefits</data>
      <data key="d1">category</data>
      <data key="d2">Public assistance benefits include essential services such as healthcare, social security, and housing assistance provided by authorities to individuals in need.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427895</data>
    </node>
    <node id="Emergency First Response Services">
      <data key="d0">Emergency First Response Services</data>
      <data key="d1">service</data>
      <data key="d2">Emergency first response services are critical services that are dispatched to handle emergencies and prioritize responses based on urgency.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Healthcare Services">
      <data key="d0">Healthcare Services</data>
      <data key="d1">category</data>
      <data key="d2">Healthcare services include medical support and treatment that individuals receive as part of public assistance benefits.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Social Security Benefits">
      <data key="d0">Social Security Benefits</data>
      <data key="d1">category</data>
      <data key="d2">Social security benefits are financial assistance programs provided by authorities to support individuals during hardships or after retirement.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Social Services">
      <data key="d0">Social Services</data>
      <data key="d1">category</data>
      <data key="d2">Social services encompass various support systems designed to protect individuals in situations like maternity, illness, or loss of employment.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Maternity Support">
      <data key="d0">Maternity Support</data>
      <data key="d1">category</data>
      <data key="d2">Maternity support refers to benefits and services aimed at assisting individuals during pregnancy and childbirth.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Illness Support">
      <data key="d0">Illness Support</data>
      <data key="d1">category</data>
      <data key="d2">Illness support encompasses benefits provided to individuals unable to work due to health issues.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Industrial Accidents">
      <data key="d0">Industrial Accidents</data>
      <data key="d1">category</data>
      <data key="d2">Industrial accidents refer to workplace incidents that can lead to injuries, entitling affected persons to public assistance benefits.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Dependency Support">
      <data key="d0">Dependency Support</data>
      <data key="d1">category</data>
      <data key="d2">Dependency support involves assistance given to individuals reliant on others for their basic needs, often due to disability or old age.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Credit Score Evaluation">
      <data key="d0">Credit Score Evaluation</data>
      <data key="d1">category</data>
      <data key="d2">Credit score evaluation is the process of assessing an individual's creditworthiness, which can impact their access to financial services.&lt;SEP&gt;Credit score evaluation refers to the process of assessing an individual's creditworthiness using algorithms, which can result in access to financial services.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f&lt;SEP&gt;chunk-3200d57c186d7db38b0cfb2e5cddca1e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Discrimination">
      <data key="d0">Discrimination</data>
      <data key="d1">category</data>
      <data key="d2">Discrimination refers to the unfair treatment of individuals based on characteristics such as race, gender, or socioeconomic status, which can be amplified by biased models.&lt;SEP&gt;Discrimination refers to the unfair treatment of individuals based on their characteristics such as race, gender, or age, often exacerbated by biased AI systems.&lt;SEP&gt;Discrimination refers to unjust treatments of individuals based on various factors, such as race, gender, or disability, particularly in the context of AI evaluations.&lt;SEP&gt;Discrimination refers to the unfair treatment of individuals based on their characteristics, which is prohibited under Union law, particularly affecting vulnerable groups.&lt;SEP&gt;Discrimination, in this context, refers to unjust or prejudicial treatment of different categories of individuals, which can arise from biased AI systems.</data>
      <data key="d3">chunk-ff9241c3a9f5f8fc78557cf5705c8c73&lt;SEP&gt;chunk-e428719939f639dff07b7393c2795962&lt;SEP&gt;chunk-3200d57c186d7db38b0cfb2e5cddca1e&lt;SEP&gt;chunk-cbc4d8b4e0e145ee1cf76386d881919f&lt;SEP&gt;chunk-d1b1b6d000ef2c2e744936b8e5264e46</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/67/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/110/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Risk Assessment in Insurance">
      <data key="d0">Risk Assessment in Insurance</data>
      <data key="d1">category</data>
      <data key="d2">Risk assessment in insurance involves evaluating individuals' health and life risks to determine coverage and pricing for insurance products.</data>
      <data key="d3">chunk-cbc4d8b4e0e145ee1cf76386d881919f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Financial Services">
      <data key="d0">Financial Services</data>
      <data key="d1">category</data>
      <data key="d2">Financial services encompass various offerings that relate to managing money, including banking, investment, and insurance.</data>
      <data key="d3">chunk-3200d57c186d7db38b0cfb2e5cddca1e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Emergency Response Services">
      <data key="d0">Emergency Response Services</data>
      <data key="d1">category</data>
      <data key="d2">Emergency response services include organizations like police, firefighters, and medical aid that respond to urgent situations impacting health and safety.</data>
      <data key="d3">chunk-3200d57c186d7db38b0cfb2e5cddca1e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Access to Services">
      <data key="d0">Access to Services</data>
      <data key="d1">category</data>
      <data key="d2">Access to services encompasses individuals' ability to obtain essential utilities such as housing, electricity, and telecommunications.</data>
      <data key="d3">chunk-3200d57c186d7db38b0cfb2e5cddca1e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Housing">
      <data key="d0">Housing</data>
      <data key="d1">category</data>
      <data key="d2">Housing refers to the provision of physical living accommodations that individuals seek to obtain as part of basic living needs.</data>
      <data key="d3">chunk-3200d57c186d7db38b0cfb2e5cddca1e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Telecommunication Services">
      <data key="d0">Telecommunication Services</data>
      <data key="d1">category</data>
      <data key="d2">Telecommunication services refer to the communication services that allow individuals to connect through the internet and mobile networks.</data>
      <data key="d3">chunk-3200d57c186d7db38b0cfb2e5cddca1e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Health and Life Insurance">
      <data key="d0">Health and Life Insurance</data>
      <data key="d1">category</data>
      <data key="d2">Health and life insurance involves products that provide financial protection against health-related expenses and provision for dependents after death.</data>
      <data key="d3">chunk-3200d57c186d7db38b0cfb2e5cddca1e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Emergency Healthcare Systems">
      <data key="d0">Emergency Healthcare Systems</data>
      <data key="d1">category</data>
      <data key="d2">Emergency healthcare systems manage the response and treatment provided to individuals in medical emergencies, often facilitated by AI for triage.</data>
      <data key="d3">chunk-3200d57c186d7db38b0cfb2e5cddca1e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="police">
      <data key="d0">police</data>
      <data key="d1">organization</data>
      <data key="d2">Police organizations are responsible for maintaining law and order, responding to emergencies, and ensuring public safety.</data>
      <data key="d3">chunk-c2fe842dc6d804d8e6d4635fc7d38915</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="firefighters">
      <data key="d0">firefighters</data>
      <data key="d1">organization</data>
      <data key="d2">Firefighters are emergency responders who combat fires, save lives, and protect property from fire-related hazards.</data>
      <data key="d3">chunk-c2fe842dc6d804d8e6d4635fc7d38915</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="medical aid">
      <data key="d0">medical aid</data>
      <data key="d1">organization</data>
      <data key="d2">Medical aid organizations provide urgent medical care and assistance during emergencies and critical situations.</data>
      <data key="d3">chunk-c2fe842dc6d804d8e6d4635fc7d38915</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="emergency healthcare patient triage systems">
      <data key="d0">emergency healthcare patient triage systems</data>
      <data key="d1">category</data>
      <data key="d2">Emergency healthcare patient triage systems categorize and prioritize patients based on the severity of their conditions in crisis scenarios.</data>
      <data key="d3">chunk-c2fe842dc6d804d8e6d4635fc7d38915</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="patients">
      <data key="d0">patients</data>
      <data key="d1">category</data>
      <data key="d2">Patients refer to individuals who are receiving medical care or treatment, particularly in emergency situations.</data>
      <data key="d3">chunk-c2fe842dc6d804d8e6d4635fc7d38915</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d5">1748427905</data>
    </node>
    <node id="Alternative Dispute Resolution Bodies">
      <data key="d0">Alternative Dispute Resolution Bodies</data>
      <data key="d1">organization</data>
      <data key="d2">These are institutions that facilitate the resolution of disputes outside of formal court proceedings.</data>
      <data key="d3">chunk-a7e9eb6e4da61705e152386e4c7c8412</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/61/</data>
      <data key="d5">1748427924</data>
    </node>
    <node id="Fair Trial Rights">
      <data key="d0">Fair Trial Rights</data>
      <data key="d1">category</data>
      <data key="d2">Fair trial rights are legal rights designed to ensure fair judicial processes.</data>
      <data key="d3">chunk-a7e9eb6e4da61705e152386e4c7c8412</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/61/</data>
      <data key="d5">1748427924</data>
    </node>
    <node id="Article 6">
      <data key="d0">Article 6</data>
      <data key="d1">category</data>
      <data key="d2">Article 6 outlines specific conditions under which the Commission is granted the authority to adopt delegated acts.&lt;SEP&gt;Article 6 outlines the criteria for classifying AI systems as high-risk and the procedures for their registration in the EU database.</data>
      <data key="d3">chunk-cefadab290f58f81c115a49845f866d1&lt;SEP&gt;chunk-ac1055eaf28da7935aee66a1acf9705b</data>
      <data key="d4">https://artificialintelligenceact.eu/article/97/&lt;SEP&gt;https://artificialintelligenceact.eu/article/71/</data>
      <data key="d5">1748427963</data>
    </node>
    <node id="Article 7">
      <data key="d0">Article 7</data>
      <data key="d1">event</data>
      <data key="d2">Article 7 provides additional stipulations regarding the process and conditions for adopting delegated acts by the Commission.</data>
      <data key="d3">chunk-ac1055eaf28da7935aee66a1acf9705b</data>
      <data key="d4">https://artificialintelligenceact.eu/article/97/</data>
      <data key="d5">1748427956</data>
    </node>
    <node id="Article 52">
      <data key="d0">Article 52</data>
      <data key="d1">event</data>
      <data key="d2">Article 52 outlines the limits and scope of the delegated authority given to the Commission.</data>
      <data key="d3">chunk-ac1055eaf28da7935aee66a1acf9705b</data>
      <data key="d4">https://artificialintelligenceact.eu/article/97/</data>
      <data key="d5">1748427956</data>
    </node>
    <node id="Interinstitutional Agreement of 13 April 2016 on Better Law-Making">
      <data key="d0">Interinstitutional Agreement of 13 April 2016 on Better Law-Making</data>
      <data key="d1">event</data>
      <data key="d2">This agreement outlines the framework for cooperation between the EU institutions to improve the quality and efficiency of EU legislation.</data>
      <data key="d3">chunk-fd90900e1cf6e0c8072e210c7e853791</data>
      <data key="d4">https://artificialintelligenceact.eu/article/97/</data>
      <data key="d5">1748427956</data>
    </node>
    <node id="delegated act">
      <data key="d0">delegated act</data>
      <data key="d1">category</data>
      <data key="d2">A delegated act is a legal act that allows the European Commission to supplement or amend certain non-essential elements of legislation.</data>
      <data key="d3">chunk-fd90900e1cf6e0c8072e210c7e853791</data>
      <data key="d4">https://artificialintelligenceact.eu/article/97/</data>
      <data key="d5">1748427956</data>
    </node>
    <node id="Notification Period">
      <data key="d0">Notification Period</data>
      <data key="d1">event</data>
      <data key="d2">The Notification Period is a legally defined timeframe in which the European Parliament and the Council can respond to acts proposed by the Commission, typically lasting three months.</data>
      <data key="d3">chunk-eef924ac2e26af24531952fcd79e9d21</data>
      <data key="d4">https://artificialintelligenceact.eu/article/97/</data>
      <data key="d5">1748427956</data>
    </node>
    <node id="EU Database for High-Risk AI Systems">
      <data key="d0">EU Database for High-Risk AI Systems</data>
      <data key="d1">organization</data>
      <data key="d2">The EU Database for High-Risk AI Systems is a regulated platform established by the Commission to contain information regarding high-risk AI systems and their registrants.</data>
      <data key="d3">chunk-cefadab290f58f81c115a49845f866d1</data>
      <data key="d4">https://artificialintelligenceact.eu/article/71/</data>
      <data key="d5">1748427963</data>
    </node>
    <node id="Legal Authority">
      <data key="d0">Legal Authority</data>
      <data key="d1">category</data>
      <data key="d2">Legal Authority encompasses the individuals or entities sanctioned by law to manage and represent service providers or deployers of AI systems.</data>
      <data key="d3">chunk-cefadab290f58f81c115a49845f866d1</data>
      <data key="d4">https://artificialintelligenceact.eu/article/71/</data>
      <data key="d5">1748427963</data>
    </node>
    <node id="Article 60(4)">
      <data key="d0">Article 60(4)</data>
      <data key="d1">category</data>
      <data key="d2">Article 60(4) refers to a section of EU regulations that dictates the accessibility requirements for information contained in the EU database.</data>
      <data key="d3">chunk-d447a0dff9a51bc6e0b8b9c92046aaae</data>
      <data key="d4">https://artificialintelligenceact.eu/article/71/</data>
      <data key="d5">1748427966</data>
    </node>
    <node id="prospective provider">
      <data key="d0">prospective provider</data>
      <data key="d1">person</data>
      <data key="d2">Prospective provider refers to an individual or entity that is seeking to provide information or services that must be registered in the EU database.</data>
      <data key="d3">chunk-d447a0dff9a51bc6e0b8b9c92046aaae</data>
      <data key="d4">https://artificialintelligenceact.eu/article/71/</data>
      <data key="d5">1748427966</data>
    </node>
    <node id="Error-Free Data">
      <data key="d0">Error-Free Data</data>
      <data key="d1">category</data>
      <data key="d2">Error-free data is essential for the operation of AI systems, as inaccuracies in data can lead to compromised system performance and biased results.</data>
      <data key="d3">chunk-e428719939f639dff07b7393c2795962</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/67/</data>
      <data key="d5">1748427989</data>
    </node>
    <node id="Historical Data">
      <data key="d0">Historical Data</data>
      <data key="d1">category</data>
      <data key="d2">Historical data is past data used to train AI systems, which may contain inherent biases that can be reflected in AI outputs.</data>
      <data key="d3">chunk-d1b1b6d000ef2c2e744936b8e5264e46</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/67/</data>
      <data key="d5">1748427989</data>
    </node>
    <node id="Privacy-Preserving Techniques">
      <data key="d0">Privacy-Preserving Techniques</data>
      <data key="d1">organization</data>
      <data key="d2">Privacy-preserving techniques protect sensitive information while developing AI systems, ensuring compliance with regulations.</data>
      <data key="d3">chunk-d1b1b6d000ef2c2e744936b8e5264e46</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/67/</data>
      <data key="d5">1748427989</data>
    </node>
    <node id="Compliance Services">
      <data key="d0">Compliance Services</data>
      <data key="d1">organization</data>
      <data key="d2">Compliance services are offered by third parties to verify data governance, data set integrity, and adherence to regulations.</data>
      <data key="d3">chunk-d1b1b6d000ef2c2e744936b8e5264e46</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/67/</data>
      <data key="d5">1748427989</data>
    </node>
    <node id="regulation">
      <data key="d0">regulation</data>
      <data key="d1">event</data>
      <data key="d2">The regulation refers to the legal framework that sets the terms for enforcing penalties and measures in relation to Article 96 regarding AI practices.</data>
      <data key="d3">chunk-93c0980cd75cdf016ff776144a4a70db</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428007</data>
    </node>
    <node id="administrative fines">
      <data key="d0">administrative fines</data>
      <data key="d1">category</data>
      <data key="d2">Administrative fines are financial penalties imposed for non-compliance with the regulatory provisions outlined in the document.</data>
      <data key="d3">chunk-93c0980cd75cdf016ff776144a4a70db</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428007</data>
    </node>
    <node id="Article 96">
      <data key="d0">Article 96</data>
      <data key="d1">category</data>
      <data key="d2">Article 96 includes provisions related to guidelines for implementing the legislation on AI systems.&lt;SEP&gt;Article 96 is a specific article within the regulation that provides guidelines on penalties and enforcement measures.&lt;SEP&gt;Article 96 is associated with the practical implementation of AI regulations and guidelines.</data>
      <data key="d3">chunk-6fe20aa0cce0b31f6a43c755317350d6&lt;SEP&gt;chunk-93c0980cd75cdf016ff776144a4a70db&lt;SEP&gt;chunk-550dce9dde15c8e156ca0acc92343929</data>
      <data key="d4">https://artificialintelligenceact.eu/article/6/&lt;SEP&gt;https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428141</data>
    </node>
    <node id="obligations of providers">
      <data key="d0">obligations of providers</data>
      <data key="d1">category</data>
      <data key="d2">Obligations of providers refer to specific requirements set forth in Article 16 that must be adhered to by operators in relation to regulatory compliance.</data>
      <data key="d3">chunk-93c0980cd75cdf016ff776144a4a70db</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428007</data>
    </node>
    <node id="obligations of authorised representatives">
      <data key="d0">obligations of authorised representatives</data>
      <data key="d1">category</data>
      <data key="d2">Obligations of authorised representatives refer to requirements defined in Article 22 that enforce accountability among representatives of operators.</data>
      <data key="d3">chunk-93c0980cd75cdf016ff776144a4a70db</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428007</data>
    </node>
    <node id="obligations of importers">
      <data key="d0">obligations of importers</data>
      <data key="d1">category</data>
      <data key="d2">Obligations of importers as specified in Article 23 demand compliance for ensuring the legality of products entering markets.</data>
      <data key="d3">chunk-93c0980cd75cdf016ff776144a4a70db</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428007</data>
    </node>
    <node id="obligations of distributors">
      <data key="d0">obligations of distributors</data>
      <data key="d1">category</data>
      <data key="d2">Obligations of distributors, outlined in Article 24, require compliance with certain standards and regulations during the distribution process.</data>
      <data key="d3">chunk-93c0980cd75cdf016ff776144a4a70db</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428007</data>
    </node>
    <node id="obligations of deployers">
      <data key="d0">obligations of deployers</data>
      <data key="d1">category</data>
      <data key="d2">Obligations of deployers, defined in Article 26, encompass the responsibilities of those utilizing AI technologies.</data>
      <data key="d3">chunk-93c0980cd75cdf016ff776144a4a70db</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428007</data>
    </node>
    <node id="obligations of notified bodies">
      <data key="d0">obligations of notified bodies</data>
      <data key="d1">category</data>
      <data key="d2">Obligations placed on notified bodies are detailed in Articles 31 and 34, which define their duties in regulatory compliance.</data>
      <data key="d3">chunk-93c0980cd75cdf016ff776144a4a70db</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428007</data>
    </node>
    <node id="penalties for incorrect information">
      <data key="d0">penalties for incorrect information</data>
      <data key="d1">category</data>
      <data key="d2">Penalties for providing incorrect, incomplete, or misleading information pertain to administrative fines established for non-compliance as per the regulation.</data>
      <data key="d3">chunk-93c0980cd75cdf016ff776144a4a70db</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428007</data>
    </node>
    <node id="Operators">
      <data key="d0">Operators</data>
      <data key="d1">organization</data>
      <data key="d2">Operators refer to entities managing or controlling systems that must comply with regulatory provisions as outlined in the legal text.&lt;SEP&gt;Operators refer to entities or individuals responsible for adhering to regulations and mitigating any infringements that occur under their operations.&lt;SEP&gt;Operators refer to entities or individuals who manage or run high-risk AI systems within the Union legislative framework, emphasizing the need to minimize their regulatory burden.</data>
      <data key="d3">chunk-bbb1781c5c0edcb30e49953ca1852eb0&lt;SEP&gt;chunk-1853942fcfd185abaf07003a8b70ff38&lt;SEP&gt;chunk-3bc759fa1feac4c57c23af89232f9785</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/124/&lt;SEP&gt;https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428329</data>
    </node>
    <node id="Financial Year">
      <data key="d0">Financial Year</data>
      <data key="d1">category</data>
      <data key="d2">The financial year is the period used for budgeting and accounting, determined for calculating fines based on total annual turnover.</data>
      <data key="d3">chunk-3bc759fa1feac4c57c23af89232f9785</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428010</data>
    </node>
    <node id="Regulatory Provisions">
      <data key="d0">Regulatory Provisions</data>
      <data key="d1">category</data>
      <data key="d2">Regulatory provisions are the specific legal requirements that entities must comply with to avoid penalties.</data>
      <data key="d3">chunk-3bc759fa1feac4c57c23af89232f9785</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428010</data>
    </node>
    <node id="Article 22">
      <data key="d0">Article 22</data>
      <data key="d1">event</data>
      <data key="d2">Article 22 pertains to the regulatory framework laid out in Regulation (EU) No 1025/2012 concerning the preparation of implementing acts.&lt;SEP&gt;Article 22 specifies the obligations of authorized representatives in regulatory compliance.</data>
      <data key="d3">chunk-3bc759fa1feac4c57c23af89232f9785&lt;SEP&gt;chunk-ee3505c356c8e76e9f364115f4eb7ea3</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/&lt;SEP&gt;https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428439</data>
    </node>
    <node id="Article 23">
      <data key="d0">Article 23</data>
      <data key="d1">category</data>
      <data key="d2">Article 23 details the obligations of importers concerning compliance with standards.</data>
      <data key="d3">chunk-3bc759fa1feac4c57c23af89232f9785</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428010</data>
    </node>
    <node id="Article 24">
      <data key="d0">Article 24</data>
      <data key="d1">category</data>
      <data key="d2">Article 24 defines the obligations of distributors in relation to regulatory compliance.</data>
      <data key="d3">chunk-3bc759fa1feac4c57c23af89232f9785</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428010</data>
    </node>
    <node id="Article 26">
      <data key="d0">Article 26</data>
      <data key="d1">category</data>
      <data key="d2">Article 26 outlines the obligations of deployers with respect to compliance standards.</data>
      <data key="d3">chunk-3bc759fa1feac4c57c23af89232f9785</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428010</data>
    </node>
    <node id="Article 33">
      <data key="d0">Article 33</data>
      <data key="d1">category</data>
      <data key="d2">Article 33 specifies additional requirements impacting compliance, particularly for notified bodies.</data>
      <data key="d3">chunk-3bc759fa1feac4c57c23af89232f9785</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428010</data>
    </node>
    <node id="Article 34">
      <data key="d0">Article 34</data>
      <data key="d1">category</data>
      <data key="d2">Article 34 discusses further obligations relevant to the operations of notified bodies.</data>
      <data key="d3">chunk-3bc759fa1feac4c57c23af89232f9785</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428010</data>
    </node>
    <node id="Administrative Fine Amount">
      <data key="d0">Administrative Fine Amount</data>
      <data key="d1">category</data>
      <data key="d2">Administrative Fine Amount refers to the monetary penalties that can be imposed based on various factors regarding the infringement.</data>
      <data key="d3">chunk-1a9e7815086e5c37a3beb2705ee18d8e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428016</data>
    </node>
    <node id="Infringement">
      <data key="d0">Infringement</data>
      <data key="d1">category</data>
      <data key="d2">An Infringement refers to a violation of regulations or laws, resulting in potential administrative fines.&lt;SEP&gt;Infringement refers to violations of regulations that necessitate reporting and remediation actions by the operator.</data>
      <data key="d3">chunk-bbb1781c5c0edcb30e49953ca1852eb0&lt;SEP&gt;chunk-1a9e7815086e5c37a3beb2705ee18d8e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428016</data>
    </node>
    <node id="National Courts">
      <data key="d0">National Courts</data>
      <data key="d1">organization</data>
      <data key="d2">National Courts are responsible for imposing administrative fines as per the legal systems of Member States.</data>
      <data key="d3">chunk-bbb1781c5c0edcb30e49953ca1852eb0</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428020</data>
    </node>
    <node id="Judicial Remedies">
      <data key="d0">Judicial Remedies</data>
      <data key="d1">category</data>
      <data key="d2">Judicial Remedies are legal safeguards that must be in place for effectively challenging the imposition of administrative fines.</data>
      <data key="d3">chunk-bbb1781c5c0edcb30e49953ca1852eb0</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428020</data>
    </node>
    <node id="Procedural Safeguards">
      <data key="d0">Procedural Safeguards</data>
      <data key="d1">category</data>
      <data key="d2">Procedural Safeguards are rules ensuring fair legal procedures are followed when imposing fines and penalties.</data>
      <data key="d3">chunk-bbb1781c5c0edcb30e49953ca1852eb0</data>
      <data key="d4">https://artificialintelligenceact.eu/article/99/</data>
      <data key="d5">1748428020</data>
    </node>
    <node id="Experts and External Stakeholders">
      <data key="d0">Experts and External Stakeholders</data>
      <data key="d1">person</data>
      <data key="d2">Experts and external stakeholders are individuals or groups with specialized knowledge who can advise on risk-management strategies for AI systems.</data>
      <data key="d3">chunk-043dd859ed68e9fbb76ff618fe32c054</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/65/</data>
      <data key="d5">1748428024</data>
    </node>
    <node id="Risk Mitigation Measures">
      <data key="d0">Risk Mitigation Measures</data>
      <data key="d1">category</data>
      <data key="d2">Risk mitigation measures are strategies and actions implemented to reduce potential risks associated with the use of high-risk AI systems.&lt;SEP&gt;Risk mitigation measures are strategies implemented to minimize potential risks and ensure that AI technologies operate safely and effectively.</data>
      <data key="d3">chunk-f1bd36f2082e6f670210d08c02e3d502&lt;SEP&gt;chunk-858c2a77ba4972f9c4e3f47479bfef07</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/65/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/138/</data>
      <data key="d5">1748428378</data>
    </node>
    <node id="High-Level Expert Group on Artificial Intelligence">
      <data key="d0">High-Level Expert Group on Artificial Intelligence</data>
      <data key="d1">organization</data>
      <data key="d2">The High-Level Expert Group on Artificial Intelligence (AI HLEG) is an entity that provides guidelines and recommendations on trustworthy AI practices and policies.</data>
      <data key="d3">chunk-de89422ce8e678b380eeca18a71bfb66</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/7/</data>
      <data key="d5">1748428035</data>
    </node>
    <node id="European Declaration on Digital Rights and Principles for the Digital Decade">
      <data key="d0">European Declaration on Digital Rights and Principles for the Digital Decade</data>
      <data key="d1">category</data>
      <data key="d2">The European Declaration on Digital Rights and Principles outlines fundamental rights and principles to shape the digital transformation in Europe.</data>
      <data key="d3">chunk-de89422ce8e678b380eeca18a71bfb66</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/7/</data>
      <data key="d5">1748428035</data>
    </node>
    <node id="Unions International Trade Commitments">
      <data key="d0">Unions International Trade Commitments</data>
      <data key="d1">category</data>
      <data key="d2">The Union’s International Trade Commitments encompass agreements and standards that the European Union must adhere to in its trade relations with other countries.</data>
      <data key="d3">chunk-de89422ce8e678b380eeca18a71bfb66</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/7/</data>
      <data key="d5">1748428035</data>
    </node>
    <node id="Common Rules">
      <data key="d0">Common Rules</data>
      <data key="d1">category</data>
      <data key="d2">Common Rules represent the regulatory framework to be established for governing practices surrounding high-risk AI systems, ensuring they protect public interests.</data>
      <data key="d3">chunk-de89422ce8e678b380eeca18a71bfb66</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/7/</data>
      <data key="d5">1748428035</data>
    </node>
    <node id="AI systems in education">
      <data key="d0">AI systems in education</data>
      <data key="d1">category</data>
      <data key="d2">AI systems in education are tools designed to enhance educational outcomes, promote digital skills, and evaluate learning, but they pose risks regarding access and discrimination.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="learners and teachers">
      <data key="d0">learners and teachers</data>
      <data key="d1">person</data>
      <data key="d2">Learners and teachers are the primary users of AI systems in education, requiring digital skills and competences for their participation in society and the economy.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="discrimination">
      <data key="d0">discrimination</data>
      <data key="d1">category</data>
      <data key="d2">Discrimination in education refers to biases that affect individuals based on gender, age, disability, race, or sexual orientation, exacerbated by the use of AI systems.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="right to education and training">
      <data key="d0">right to education and training</data>
      <data key="d1">category</data>
      <data key="d2">The right to education and training ensures that individuals have access to educational opportunities without discrimination.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Vocational Training">
      <data key="d0">Vocational Training</data>
      <data key="d1">category</data>
      <data key="d2">Vocational Training provides skills and knowledge specific to a trade or occupation, often influenced by AI systems.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Media Literacy">
      <data key="d0">Media Literacy</data>
      <data key="d1">category</data>
      <data key="d2">Media Literacy is the ability to access, analyze, evaluate, and create media content, crucial for modern education.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Critical Thinking">
      <data key="d0">Critical Thinking</data>
      <data key="d1">category</data>
      <data key="d2">Critical Thinking is the process of actively analyzing, evaluating, and applying information to question and form judgments.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Discrimination Against Women">
      <data key="d0">Discrimination Against Women</data>
      <data key="d1">category</data>
      <data key="d2">Discrimination Against Women refers to biases that adversely affect women's access to education and training opportunities.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Discrimination by Age Groups">
      <data key="d0">Discrimination by Age Groups</data>
      <data key="d1">category</data>
      <data key="d2">Discrimination by Age Groups involves biases that affect individuals based on their age, impacting their educational access and opportunities.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Discrimination Against Persons with Disabilities">
      <data key="d0">Discrimination Against Persons with Disabilities</data>
      <data key="d1">category</data>
      <data key="d2">Discrimination Against Persons with Disabilities refers to the barriers faced by individuals with disabilities in accessing education.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Discrimination by Race and Ethnicity">
      <data key="d0">Discrimination by Race and Ethnicity</data>
      <data key="d1">category</data>
      <data key="d2">Discrimination by Race and Ethnicity pertains to biases that adversely affect individuals based on their racial or ethnic origins.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Discrimination by Sexual Orientation">
      <data key="d0">Discrimination by Sexual Orientation</data>
      <data key="d1">category</data>
      <data key="d2">Discrimination by Sexual Orientation involves biases against individuals based on their sexual orientation, affecting educational equity.</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Right to Education and Training">
      <data key="d0">Right to Education and Training</data>
      <data key="d3">chunk-f4f557a252b7f04ee224d608a6628bd4</data>
      <data key="d2">The Right to Education and Training ensures all individuals have equitable access to educational opportunities.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/56/</data>
      <data key="d5">1748428037</data>
    </node>
    <node id="Annex XII">
      <data key="d0">Annex XII</data>
      <data key="d1">category</data>
      <data key="d2">Annex XII defines additional necessary elements that must be included in the information and documentation shared with AI system providers.&lt;SEP&gt;Annex XII, like Annex XI, is involved in EU regulatory provisions and may be subject to amendments based on technological developments.</data>
      <data key="d3">chunk-8f93754b5b045f375c5040d0de011e4b&lt;SEP&gt;chunk-91d56158a4a9411ebe99783effcebca7</data>
      <data key="d4">https://artificialintelligenceact.eu/article/53/</data>
      <data key="d5">1748428047</data>
    </node>
    <node id="Article 4(3)">
      <data key="d0">Article 4(3)</data>
      <data key="d1">event</data>
      <data key="d2">Article 4(3) refers to a specific provision in Directive (EU) 2019/790 that outlines obligations regarding the public availability of information about AI model training.</data>
      <data key="d3">chunk-8d41f7845b8c737d05150b060d51c16e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/53/</data>
      <data key="d5">1748428050</data>
    </node>
    <node id="free and open-source licence">
      <data key="d0">free and open-source licence</data>
      <data key="d1">category</data>
      <data key="d2">A free and open-source licence allows software to be freely used, modified, and shared, which may exempt some AI models from certain regulatory obligations.</data>
      <data key="d3">chunk-8d41f7845b8c737d05150b060d51c16e</data>
      <data key="d4">https://artificialintelligenceact.eu/article/53/</data>
      <data key="d5">1748428053</data>
    </node>
    <node id="European Harmonised Standard">
      <data key="d0">European Harmonised Standard</data>
      <data key="d1">category</data>
      <data key="d2">European Harmonised Standards are technical specifications created to support the implementation of EU legislation and facilitate product compliance.</data>
      <data key="d3">chunk-91d56158a4a9411ebe99783effcebca7</data>
      <data key="d4">https://artificialintelligenceact.eu/article/53/</data>
      <data key="d5">1748428053</data>
    </node>
    <node id="Point 2 (d) and (e) of Annex XI">
      <data key="d0">Point 2 (d) and (e) of Annex XI</data>
      <data key="d1">category</data>
      <data key="d2">Points 2 (d) and (e) of Annex XI relate to specific compliance requirements under EU regulations that organizations must follow.</data>
      <data key="d3">chunk-91d56158a4a9411ebe99783effcebca7</data>
      <data key="d4">https://artificialintelligenceact.eu/article/53/</data>
      <data key="d5">1748428053</data>
    </node>
    <node id="Article 97(2)">
      <data key="d0">Article 97(2)</data>
      <data key="d1">category</data>
      <data key="d2">Article 97(2) refers to the section that specifically outlines the Commission's power to amend annexes based on evolving scenarios.</data>
      <data key="d3">chunk-91d56158a4a9411ebe99783effcebca7</data>
      <data key="d4">https://artificialintelligenceact.eu/article/53/</data>
      <data key="d5">1748428053</data>
    </node>
    <node id="Human-Machine Interface Tools">
      <data key="d0">Human-Machine Interface Tools</data>
      <data key="d1">category</data>
      <data key="d2">Human-machine interface tools are designed to facilitate the interaction between humans and AI systems, ensuring effective oversight and monitoring of AI operations.</data>
      <data key="d3">chunk-bbe2025206c39f7e4a18788aafe6a345</data>
      <data key="d4">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d5">1748428063</data>
    </node>
    <node id="Automation Bias">
      <data key="d0">Automation Bias</data>
      <data key="d1">category</data>
      <data key="d2">Automation Bias is the tendency for users to over-rely on the outputs provided by AI systems, even when they might not be accurate or appropriate.&lt;SEP&gt;Automation bias refers to the tendency of users to overly rely on the output of automated systems, which can lead to significant risks in decision-making processes.</data>
      <data key="d3">chunk-d3235710f8867a0e47878a2233118ed9&lt;SEP&gt;chunk-bbe2025206c39f7e4a18788aafe6a345</data>
      <data key="d4">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d5">1748428063</data>
    </node>
    <node id="Health Risks">
      <data key="d0">Health Risks</data>
      <data key="d1">category</data>
      <data key="d2">Health Risks are potential threats to physical or mental health that may arise during development and testing activities.&lt;SEP&gt;Health risks are potential dangers that can arise from the use of high-risk AI systems, including impacts on safety and fundamental rights.</data>
      <data key="d3">chunk-ef2db5390248e67c8de7693a5d073f62&lt;SEP&gt;chunk-bbe2025206c39f7e4a18788aafe6a345</data>
      <data key="d4">https://artificialintelligenceact.eu/article/14/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428408</data>
    </node>
    <node id="Oversight Measures">
      <data key="d0">Oversight Measures</data>
      <data key="d1">category</data>
      <data key="d2">Oversight measures are strategies and actions designed to ensure that human oversight is effective and appropriate for high-risk AI systems.</data>
      <data key="d3">chunk-bbe2025206c39f7e4a18788aafe6a345</data>
      <data key="d4">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d5">1748428066</data>
    </node>
    <node id="Dysfunctions">
      <data key="d0">Dysfunctions</data>
      <data key="d1">category</data>
      <data key="d2">Dysfunctions are malfunctions or unintended behaviors in high-risk AI systems that need to be addressed by the assigned personnel.</data>
      <data key="d3">chunk-bbe2025206c39f7e4a18788aafe6a345</data>
      <data key="d4">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d5">1748428066</data>
    </node>
    <node id="Output Interpretation">
      <data key="d0">Output Interpretation</data>
      <data key="d1">category</data>
      <data key="d2">Output interpretation involves understanding and appropriately acting upon the results produced by high-risk AI systems.</data>
      <data key="d3">chunk-bbe2025206c39f7e4a18788aafe6a345</data>
      <data key="d4">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d5">1748428066</data>
    </node>
    <node id="Performance">
      <data key="d0">Performance</data>
      <data key="d1">category</data>
      <data key="d2">Performance refers to the output and functionality of high-risk AI systems, which must be evaluated for reliability and effectiveness.</data>
      <data key="d3">chunk-d3235710f8867a0e47878a2233118ed9</data>
      <data key="d4">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d5">1748428068</data>
    </node>
    <node id="Competence, Training, and Authority">
      <data key="d0">Competence, Training, and Authority</data>
      <data key="d1">category</data>
      <data key="d2">Competence, Training, and Authority refer to the qualifications and expertise that natural persons must possess to verify the outputs of high-risk AI systems effectively.</data>
      <data key="d3">chunk-d3235710f8867a0e47878a2233118ed9</data>
      <data key="d4">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d5">1748428068</data>
    </node>
    <node id="Directive 2002/14/EC">
      <data key="d0">Directive 2002/14/EC</data>
      <data key="d1">event</data>
      <data key="d2">Directive 2002/14/EC establishes a framework for informing and consulting employees within the European Community regarding workplace practices, including decisions affecting them.</data>
      <data key="d3">chunk-19fe8af9bab5bc955f3f1bb6e0c9c017</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/92/</data>
      <data key="d5">1748428078</data>
    </node>
    <node id="Workers">
      <data key="d0">Workers</data>
      <data key="d1">person</data>
      <data key="d2">Workers refer to individuals employed in various sectors who have rights and obligations that must be respected under both national and EU laws.</data>
      <data key="d3">chunk-19fe8af9bab5bc955f3f1bb6e0c9c017</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/92/</data>
      <data key="d5">1748428078</data>
    </node>
    <node id="Performance Limitations">
      <data key="d0">Performance Limitations</data>
      <data key="d1">category</data>
      <data key="d2">Performance limitations refer to the functional boundaries and constraints inherent in high-risk AI systems that must be understood by deployers.</data>
      <data key="d3">chunk-712fbb27f2ad82df6098ef5c90507342</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/72/</data>
      <data key="d5">1748428097</data>
    </node>
    <node id="Safety Measures">
      <data key="d0">Safety Measures</data>
      <data key="d1">category</data>
      <data key="d2">Safety measures are protocols or guidelines included in the operation of high-risk AI systems to ensure they do not pose risks to health or rights.</data>
      <data key="d3">chunk-712fbb27f2ad82df6098ef5c90507342</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/72/</data>
      <data key="d5">1748428097</data>
    </node>
    <node id="Target Deployers">
      <data key="d0">Target Deployers</data>
      <data key="d1">person</data>
      <data key="d2">Target deployers are the individuals or organizations intended to utilize the AI system, who need clear and understandable documentation to ensure proper use.</data>
      <data key="d3">chunk-6adccf24f1ddc4835908b879bcbe8674</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/72/</data>
      <data key="d5">1748428101</data>
    </node>
    <node id="Official Languages of the Institutions of the Union">
      <data key="d0">Official Languages of the Institutions of the Union</data>
      <data key="d1">category</data>
      <data key="d2">The official languages of the institutions of the European Union are languages that competent authorities must use when requesting information to ensure understanding.</data>
      <data key="d3">chunk-47f0b636a44a9e0af30b88362b202119</data>
      <data key="d4">https://artificialintelligenceact.eu/article/21/</data>
      <data key="d5">1748428103</data>
    </node>
    <node id="Union Technical Documentation Assessment Certificates">
      <data key="d0">Union Technical Documentation Assessment Certificates</data>
      <data key="d1">category</data>
      <data key="d2">Union technical documentation assessment certificates are certifications issued by notified bodies according to specific standards that confirm the conformity of products with Union regulations.</data>
      <data key="d3">chunk-ba752b306c578e6ee0a31563b30db893</data>
      <data key="d4">https://artificialintelligenceact.eu/article/45/</data>
      <data key="d5">1748428112</data>
    </node>
    <node id="Quality Management System Approvals">
      <data key="d0">Quality Management System Approvals</data>
      <data key="d1">category</data>
      <data key="d2">Quality management system approvals are certifications indicating that an organization's management systems meet certain quality criteria as outlined in applicable regulations.</data>
      <data key="d3">chunk-ba752b306c578e6ee0a31563b30db893</data>
      <data key="d4">https://artificialintelligenceact.eu/article/45/</data>
      <data key="d5">1748428112</data>
    </node>
    <node id="Cross-Border Activities">
      <data key="d0">Cross-Border Activities</data>
      <data key="d1">category</data>
      <data key="d2">Cross-border activities refer to conformity assessment actions conducted across national borders, relevant for global compliance of products.</data>
      <data key="d3">chunk-ba752b306c578e6ee0a31563b30db893</data>
      <data key="d4">https://artificialintelligenceact.eu/article/45/</data>
      <data key="d5">1748428112</data>
    </node>
    <node id="Financial Fraud Assessment">
      <data key="d0">Financial Fraud Assessment</data>
      <data key="d1">event</data>
      <data key="d2">Financial fraud assessment is an analytical process aimed at detecting and preventing fraudulent transactions based on objective data.</data>
      <data key="d3">chunk-19b580305cd4ba71a7cf07559aa87a40</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/42/</data>
      <data key="d5">1748428115</data>
    </node>
    <node id="Risk Analytics">
      <data key="d0">Risk Analytics</data>
      <data key="d1">category</data>
      <data key="d2">Risk analytics involves using data and algorithms to assess the likelihood of certain events occurring, excluding individualized profiling.</data>
      <data key="d3">chunk-19b580305cd4ba71a7cf07559aa87a40</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/42/</data>
      <data key="d5">1748428115</data>
    </node>
    <node id="Customs Authorities">
      <data key="d0">Customs Authorities</data>
      <data key="d1">organization</data>
      <data key="d2">Customs authorities are government agencies responsible for regulating the flow of goods across borders and can utilize risk analytics to track narcotics or illicit goods.</data>
      <data key="d3">chunk-19b580305cd4ba71a7cf07559aa87a40</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/42/</data>
      <data key="d5">1748428115</data>
    </node>
    <node id="AI-Predicted Behavior">
      <data key="d0">AI-Predicted Behavior</data>
      <data key="d1">category</data>
      <data key="d2">AI-predicted behavior refers to assessments about individuals based on profiling, personality traits, and characteristics, which should not be the basis for judgment in legal contexts.</data>
      <data key="d3">chunk-19b580305cd4ba71a7cf07559aa87a40</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/42/</data>
      <data key="d5">1748428115</data>
    </node>
    <node id="Profiling">
      <data key="d0">Profiling</data>
      <data key="d1">category</data>
      <data key="d2">Profiling involves assessing an individual based on their traits, such as nationality or place of birth, which should be avoided in legal judgments.</data>
      <data key="d3">chunk-19b580305cd4ba71a7cf07559aa87a40</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/42/</data>
      <data key="d5">1748428115</data>
    </node>
    <node id="Criminal Activity">
      <data key="d0">Criminal Activity</data>
      <data key="d1">category</data>
      <data key="d2">Criminal activity encompasses actions that violate laws and are subject to legal scrutiny.</data>
      <data key="d3">chunk-19b580305cd4ba71a7cf07559aa87a40</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/42/</data>
      <data key="d5">1748428115</data>
    </node>
    <node id="Illicit Goods">
      <data key="d0">Illicit Goods</data>
      <data key="d1">category</data>
      <data key="d2">Illicit goods are illegal items that are typically trafficked and require monitoring by authorities.</data>
      <data key="d3">chunk-19b580305cd4ba71a7cf07559aa87a40</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/42/</data>
      <data key="d5">1748428115</data>
    </node>
    <node id="European Health Data Space">
      <data key="d0">European Health Data Space</data>
      <data key="d1">category</data>
      <data key="d2">The European Health Data Space aims to provide non-discriminatory access to health data for AI training and algorithms, ensuring privacy and institutional governance.</data>
      <data key="d3">chunk-9f2f4cab7db3f8f9288f3fd79ff9595e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/68/</data>
      <data key="d5">1748428124</data>
    </node>
    <node id="Testing Experimentation Facilities">
      <data key="d0">Testing Experimentation Facilities</data>
      <data key="d1">organization</data>
      <data key="d2">Testing experimentation facilities are establishments that conduct assessments and tests on AI systems to ensure their safety and compliance.</data>
      <data key="d3">chunk-9f2f4cab7db3f8f9288f3fd79ff9595e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/68/</data>
      <data key="d5">1748428127</data>
    </node>
    <node id="Researchers">
      <data key="d0">Researchers</data>
      <data key="d1">person</data>
      <data key="d2">Researchers are individuals who engage in scientific study and experimentation, contributing to the development and evaluation of AI systems.</data>
      <data key="d3">chunk-9f2f4cab7db3f8f9288f3fd79ff9595e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/68/</data>
      <data key="d5">1748428127</data>
    </node>
    <node id="High-Quality Data Sets">
      <data key="d0">High-Quality Data Sets</data>
      <data key="d1">category</data>
      <data key="d2">High-quality data sets are essential collections of data that are necessary for training, validating, and testing AI systems effectively.</data>
      <data key="d3">chunk-9f2f4cab7db3f8f9288f3fd79ff9595e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/68/</data>
      <data key="d5">1748428127</data>
    </node>
    <node id="Health Data">
      <data key="d0">Health Data</data>
      <data key="d1">category</data>
      <data key="d2">Health data encompasses information that is crucial for developing and testing AI systems in the healthcare sector.</data>
      <data key="d3">chunk-9f2f4cab7db3f8f9288f3fd79ff9595e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/68/</data>
      <data key="d5">1748428127</data>
    </node>
    <node id="Recitals 47, 50, and 51">
      <data key="d0">Recitals 47, 50, and 51</data>
      <data key="d1">event</data>
      <data key="d2">Recitals 47, 50, and 51 provide context and justification for the classification of AI systems as high-risk under specific conditions.</data>
      <data key="d3">chunk-1bca7fe15bcbe076f97f98b2f3479775</data>
      <data key="d4">https://artificialintelligenceact.eu/article/6/</data>
      <data key="d5">1748428141</data>
    </node>
    <node id="Recitals 48, 52, 54-63">
      <data key="d0">Recitals 48, 52, 54-63</data>
      <data key="d1">event</data>
      <data key="d2">Recitals 48, 52, 54, 55, 56, 57, 58, 59, 60, 61, 62, and 63 further elaborate on the conditions under which certain AI systems are considered high-risk.</data>
      <data key="d3">chunk-1bca7fe15bcbe076f97f98b2f3479775</data>
      <data key="d4">https://artificialintelligenceact.eu/article/6/</data>
      <data key="d5">1748428141</data>
    </node>
    <node id="Article 49(2)">
      <data key="d0">Article 49(2)</data>
      <data key="d1">category</data>
      <data key="d2">Article 49(2) establishes registration obligations for providers of AI systems assessed as not being high-risk.&lt;SEP&gt;Article 49(2) refers to a legal stipulation concerning the registration obligations for specific providers, as outlined in the regulatory framework.</data>
      <data key="d3">chunk-6fe20aa0cce0b31f6a43c755317350d6&lt;SEP&gt;chunk-550dce9dde15c8e156ca0acc92343929</data>
      <data key="d4">https://artificialintelligenceact.eu/article/6/</data>
      <data key="d5">1748428141</data>
    </node>
    <node id="Recital 53">
      <data key="d0">Recital 53</data>
      <data key="d1">category</data>
      <data key="d2">Recital 53 is a specific consideration in the legislation discussing the responsibilities of national competent authorities and the associated regulations.&lt;SEP&gt;Recital 53 is a specific reference within the Regulation that emphasizes the importance of maintaining protections for health, safety, and rights.&lt;SEP&gt;Recital 53 outlines justification and context for the AI regulations mentioned in the legal text, particularly addressing the definitions of risk levels.</data>
      <data key="d3">chunk-6fe20aa0cce0b31f6a43c755317350d6&lt;SEP&gt;chunk-550dce9dde15c8e156ca0acc92343929&lt;SEP&gt;chunk-693b35ee905c8f567bed21c8d6bd7377</data>
      <data key="d4">https://artificialintelligenceact.eu/article/6/</data>
      <data key="d5">1748428141</data>
    </node>
    <node id="Health Protection">
      <data key="d0">Health Protection</data>
      <data key="d1">category</data>
      <data key="d2">Health Protection refers to the measures and regulations established to ensure the safety and fundamental rights of individuals.</data>
      <data key="d3">chunk-693b35ee905c8f567bed21c8d6bd7377</data>
      <data key="d4">https://artificialintelligenceact.eu/article/6/</data>
      <data key="d5">1748428151</data>
    </node>
    <node id="Regulation Article 7(1)">
      <data key="d0">Regulation Article 7(1)</data>
      <data key="d1">category</data>
      <data key="d2">Regulation Article 7(1) pertains to the delegated acts that provide further details and standards for maintaining health, safety, and rights.</data>
      <data key="d3">chunk-693b35ee905c8f567bed21c8d6bd7377</data>
      <data key="d4">https://artificialintelligenceact.eu/article/6/</data>
      <data key="d5">1748428151</data>
    </node>
    <node id="Market Developments">
      <data key="d0">Market Developments</data>
      <data key="d1">category</data>
      <data key="d2">Market Developments are changes and trends in the marketplace that impact regulatory measures concerning health, safety, and rights.</data>
      <data key="d3">chunk-693b35ee905c8f567bed21c8d6bd7377</data>
      <data key="d4">https://artificialintelligenceact.eu/article/6/</data>
      <data key="d5">1748428151</data>
    </node>
    <node id="Value Chain">
      <data key="d0">Value Chain</data>
      <data key="d1">category</data>
      <data key="d2">The Value Chain refers to the full range of activities that businesses engage in to bring a product or service to the market, in this case, AI systems.</data>
      <data key="d3">chunk-66e6524323a5bff7a82ba7868399e18a</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/83/</data>
      <data key="d5">1748428159</data>
    </node>
    <node id="Relevant Operators">
      <data key="d0">Relevant Operators</data>
      <data key="d1">category</data>
      <data key="d2">Relevant Operators are parties involved in the development and distribution of AI systems, including importers and distributors, and are subject to specific obligations.</data>
      <data key="d3">chunk-66e6524323a5bff7a82ba7868399e18a</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/83/</data>
      <data key="d5">1748428159</data>
    </node>
    <node id="Prohibited Practices">
      <data key="d0">Prohibited Practices</data>
      <data key="d1">category</data>
      <data key="d2">Prohibited Practices refer to specific activities regarding AI systems that are deemed unacceptable and are banned under the Regulation.</data>
      <data key="d3">chunk-07fb722dbde5159480cfd0e4534fc632</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/174/</data>
      <data key="d5">1748428165</data>
    </node>
    <node id="Energy Efficient Development of General-Purpose AI Models">
      <data key="d0">Energy Efficient Development of General-Purpose AI Models</data>
      <data key="d1">category</data>
      <data key="d2">This topic addresses the importance of developing AI models that utilize energy efficiently, highlighting environmental considerations in technological advancements.</data>
      <data key="d3">chunk-07fb722dbde5159480cfd0e4534fc632</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/174/</data>
      <data key="d5">1748428165</data>
    </node>
    <node id="Evaluation Process">
      <data key="d0">Evaluation Process</data>
      <data key="d1">category</data>
      <data key="d2">The Evaluation Process is the systematic review conducted by the Commission to assess the effectiveness and need for amendments to the Regulation regarding AI systems.</data>
      <data key="d3">chunk-07fb722dbde5159480cfd0e4534fc632</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/174/</data>
      <data key="d5">1748428165</data>
    </node>
    <node id="Mitigation Measures">
      <data key="d0">Mitigation Measures</data>
      <data key="d1">category</data>
      <data key="d2">Mitigation measures refer to the actions that may be required to address systemic risks posed by AI models and ensure compliance.</data>
      <data key="d3">chunk-c78ba06fc96beac812eca04fddc34af9</data>
      <data key="d4">https://artificialintelligenceact.eu/article/93/</data>
      <data key="d5">1748428182</data>
    </node>
    <node id="Technical Tools and Methodologies">
      <data key="d0">Technical Tools and Methodologies</data>
      <data key="d1">category</data>
      <data key="d2">Technical Tools and Methodologies refer to the systems and approaches used to evaluate AI models' capabilities and systemic risks.&lt;SEP&gt;Technical Tools and Methodologies refer to the systems employed to evaluate the high-impact capabilities of AI models, including benchmarks and indicators.</data>
      <data key="d3">chunk-9e5484976fb39d2996307dda5a0931d6&lt;SEP&gt;chunk-e116bc92c8c7cf688c26ea188fd0b2fe</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/111/&lt;SEP&gt;https://artificialintelligenceact.eu/article/51/</data>
      <data key="d5">1748428352</data>
    </node>
    <node id="Floating Point Operations">
      <data key="d0">Floating Point Operations</data>
      <data key="d1">category</data>
      <data key="d2">Floating Point Operations are a measure of computational resources used in training AI models, which is relevant for assessing their capabilities.</data>
      <data key="d3">chunk-e116bc92c8c7cf688c26ea188fd0b2fe</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/111/</data>
      <data key="d5">1748428190</data>
    </node>
    <node id="Training Data Set">
      <data key="d0">Training Data Set</data>
      <data key="d1">category</data>
      <data key="d2">A Training Data Set is the collection of data used to train AI models, influencing their performance and capabilities.</data>
      <data key="d3">chunk-e116bc92c8c7cf688c26ea188fd0b2fe</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/111/</data>
      <data key="d5">1748428190</data>
    </node>
    <node id="Model Capability">
      <data key="d0">Model Capability</data>
      <data key="d1">category</data>
      <data key="d2">Model Capability refers to the abilities and performance metrics of AI models, which are crucial for assessing their potential impact and systemic risks.</data>
      <data key="d3">chunk-b3fc79c1ca06abe0f478974180491236</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/111/</data>
      <data key="d5">1748428190</data>
    </node>
    <node id="Thresholds">
      <data key="d0">Thresholds</data>
      <data key="d1">category</data>
      <data key="d2">Thresholds are predefined limits that indicate whether an AI model operates at a level that presents systemic risks or requires further assessment.</data>
      <data key="d3">chunk-b3fc79c1ca06abe0f478974180491236</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/111/</data>
      <data key="d5">1748428190</data>
    </node>
    <node id="Indicators">
      <data key="d0">Indicators</data>
      <data key="d1">category</data>
      <data key="d2">Indicators are metrics or signs used to gauge the performance and risk factors of AI models.</data>
      <data key="d3">chunk-b3fc79c1ca06abe0f478974180491236</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/111/</data>
      <data key="d5">1748428190</data>
    </node>
    <node id="Technological Changes">
      <data key="d0">Technological Changes</data>
      <data key="d1">category</data>
      <data key="d2">Technological Changes refer to advancements and innovations in technology that can affect the capabilities and risks of AI models.</data>
      <data key="d3">chunk-b3fc79c1ca06abe0f478974180491236</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/111/</data>
      <data key="d5">1748428190</data>
    </node>
    <node id="Systemic Risks Associated with AI">
      <data key="d0">Systemic Risks Associated with AI</data>
      <data key="d1">category</data>
      <data key="d2">Systemic risks associated with AI are potential widespread negative effects posed by the misuse or failures of AI systems in critical sectors.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="International Approaches to AI Risks">
      <data key="d0">International Approaches to AI Risks</data>
      <data key="d1">organization</data>
      <data key="d2">International approaches refer to various global efforts aimed at addressing the risks posed by AI technologies and ensuring their safe development and deployment.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Chemical, Biological, Radiological and Nuclear Risks">
      <data key="d0">Chemical, Biological, Radiological and Nuclear Risks</data>
      <data key="d1">category</data>
      <data key="d2">This category encompasses potential dangers related to the development and misuse of AI technologies in hazardous fields like weapons and public safety.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Offensive Cyber Capabilities">
      <data key="d0">Offensive Cyber Capabilities</data>
      <data key="d1">category</data>
      <data key="d2">Offensive cyber capabilities refer to actions taken to exploit vulnerabilities in systems through AI technologies, posing risks to security.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Major Accidents">
      <data key="d0">Major Accidents</data>
      <data key="d1">category</data>
      <data key="d2">Major accidents are significant unexpected events that can result in substantial harm or damage, particularly in critical sectors affected by AI deployment.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Disruptions of Critical Sectors">
      <data key="d0">Disruptions of Critical Sectors</data>
      <data key="d1">category</data>
      <data key="d2">Disruptions of critical sectors happen when operations in essential services are interrupted, which can be influenced by AI technologies and their failures.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Public Health and Safety">
      <data key="d0">Public Health and Safety</data>
      <data key="d1">category</data>
      <data key="d2">Public health and safety encompass overall wellbeing and protection of the population, which can be compromised by systemic risks from AI.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Model Reliability">
      <data key="d0">Model Reliability</data>
      <data key="d1">category</data>
      <data key="d2">Model reliability measures the dependability of AI models in consistent and accurate performance, impacting their associated risks.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Model Fairness">
      <data key="d0">Model Fairness</data>
      <data key="d1">category</data>
      <data key="d2">Model fairness relates to the equitable performance of AI models, addressing bias and discrimination that can arise with AI deployment.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Model Security">
      <data key="d0">Model Security</data>
      <data key="d1">category</data>
      <data key="d2">Model security involves protective measures to safeguard AI systems against misuse and vulnerabilities that can result in systemic risks.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Level of Autonomy">
      <data key="d0">Level of Autonomy</data>
      <data key="d1">category</data>
      <data key="d2">Level of autonomy indicates how independent an AI model can operate, impacting its potential risks, including unintended outcomes.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Access to Tools">
      <data key="d0">Access to Tools</data>
      <data key="d1">category</data>
      <data key="d2">Access to tools refers to the resources and capabilities available to an AI model, potentially affecting its misuse or effectiveness.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Self-replicating Models">
      <data key="d0">Self-replicating Models</data>
      <data key="d1">category</data>
      <data key="d2">Self-replicating models indicate AI systems capable of creating copy versions of themselves, which can introduce significant risks.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Harmful Bias and Discrimination">
      <data key="d0">Harmful Bias and Discrimination</data>
      <data key="d1">category</data>
      <data key="d2">Harmful bias and discrimination can emerge from AI deployments, leading to adverse effects on individuals and communities.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Chain Reaction Events">
      <data key="d0">Chain Reaction Events</data>
      <data key="d1">category</data>
      <data key="d2">Chain reaction events refer to a sequence of related incidents that can occur due to an initial trigger, potentially leading to widespread negative outcomes.</data>
      <data key="d3">chunk-3c51b7bfc502a0e1b7fc0c076f574e26</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Human Rights">
      <data key="d0">Human Rights</data>
      <data key="d1">category</data>
      <data key="d2">Human rights are the fundamental rights and freedoms to which all individuals are entitled, serving as a foundation for democracy and social justice.</data>
      <data key="d3">chunk-ff9241c3a9f5f8fc78557cf5705c8c73</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Bias">
      <data key="d0">Bias</data>
      <data key="d1">category</data>
      <data key="d2">Bias in models refers to the systematic favoritism or prejudice that can arise when training algorithms, potentially leading to unfair outcomes for individuals or groups.</data>
      <data key="d3">chunk-ff9241c3a9f5f8fc78557cf5705c8c73</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Privacy Threats">
      <data key="d0">Privacy Threats</data>
      <data key="d1">category</data>
      <data key="d2">Privacy threats occur when personal data is mishandled or misused by models and technologies, impacting individuals' rights and security.</data>
      <data key="d3">chunk-ff9241c3a9f5f8fc78557cf5705c8c73</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Democratic Values">
      <data key="d0">Democratic Values</data>
      <data key="d1">category</data>
      <data key="d2">Democratic values encompass principles like equality, freedom, and justice that underpin democratic societies, which can be threatened by misuses of technology.</data>
      <data key="d3">chunk-ff9241c3a9f5f8fc78557cf5705c8c73</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Chain Reaction">
      <data key="d0">Chain Reaction</data>
      <data key="d1">category</data>
      <data key="d2">A chain reaction refers to a series of events triggered by an initial action, which can lead to widespread negative consequences, potentially affecting large populations.</data>
      <data key="d3">chunk-ff9241c3a9f5f8fc78557cf5705c8c73</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Communities">
      <data key="d0">Communities</data>
      <data key="d1">category</data>
      <data key="d2">Communities refer to groups of individuals connected by shared interests or characteristics that can be impacted by risks associated with technology and models.</data>
      <data key="d3">chunk-ff9241c3a9f5f8fc78557cf5705c8c73</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d5">1748428200</data>
    </node>
    <node id="Data Minimisation">
      <data key="d0">Data Minimisation</data>
      <data key="d1">category</data>
      <data key="d2">Data minimisation is a principle that ensures only necessary data is collected and processed, which is applicable to AI systems.</data>
      <data key="d3">chunk-e010ebb9b0353d97d9e67673267bc415</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d5">1748428205</data>
    </node>
    <node id="Data Protection by Design and by Default">
      <data key="d0">Data Protection by Design and by Default</data>
      <data key="d1">category</data>
      <data key="d2">This principle mandates that data protection measures are integrated into the development of AI systems from the start.</data>
      <data key="d3">chunk-e010ebb9b0353d97d9e67673267bc415</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d5">1748428205</data>
    </node>
    <node id="Anonymisation and Encryption">
      <data key="d0">Anonymisation and Encryption</data>
      <data key="d1">category</data>
      <data key="d2">Anonymisation and encryption are measures used to protect personal data during processing within AI systems.</data>
      <data key="d3">chunk-e010ebb9b0353d97d9e67673267bc415</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d5">1748428205</data>
    </node>
    <node id="Protection of Personal Data">
      <data key="d0">Protection of Personal Data</data>
      <data key="d1">category</data>
      <data key="d2">Protection of Personal Data refers to the practices and regulations aimed at safeguarding information that can identify individuals.</data>
      <data key="d3">chunk-e010ebb9b0353d97d9e67673267bc415</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d5">1748428214</data>
    </node>
    <node id="Measures for Compliance">
      <data key="d0">Measures for Compliance</data>
      <data key="d1">category</data>
      <data key="d2">Measures for Compliance encompass various strategies and technologies employed by providers to conform to data protection principles.</data>
      <data key="d3">chunk-e010ebb9b0353d97d9e67673267bc415</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d5">1748428214</data>
    </node>
    <node id="Encryption Technology">
      <data key="d0">Encryption Technology</data>
      <data key="d1">category</data>
      <data key="d2">Encryption Technology involves methods to secure data by encoding it, making it accessible only to authorized parties.</data>
      <data key="d3">chunk-e010ebb9b0353d97d9e67673267bc415</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d5">1748428214</data>
    </node>
    <node id="Training of AI Systems">
      <data key="d0">Training of AI Systems</data>
      <data key="d1">category</data>
      <data key="d2">Training of AI Systems describes the process by which AI learns from data to improve its performance and accuracy.</data>
      <data key="d3">chunk-e010ebb9b0353d97d9e67673267bc415</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d5">1748428214</data>
    </node>
    <node id="Operational Obligations">
      <data key="d0">Operational Obligations</data>
      <data key="d1">category</data>
      <data key="d2">Operational Obligations refer to the responsibilities that operators of AI systems must fulfill under the new regulation.</data>
      <data key="d3">chunk-c21c2e02a12c7ec585b20f1ef155db81</data>
      <data key="d4">https://artificialintelligenceact.eu/article/1/</data>
      <data key="d5">1748428231</data>
    </node>
    <node id="Market Monitoring">
      <data key="d0">Market Monitoring</data>
      <data key="d1">category</data>
      <data key="d2">Market Monitoring is a process outlined in the regulation to ensure compliance with AI rules and to protect consumer interests.</data>
      <data key="d3">chunk-c21c2e02a12c7ec585b20f1ef155db81</data>
      <data key="d4">https://artificialintelligenceact.eu/article/1/</data>
      <data key="d5">1748428231</data>
    </node>
    <node id="Harmful AI Practices">
      <data key="d0">Harmful AI Practices</data>
      <data key="d1">category</data>
      <data key="d2">Harmful AI Practices are those that pose risks to safety and rights and are prohibited under this regulation.</data>
      <data key="d3">chunk-c21c2e02a12c7ec585b20f1ef155db81</data>
      <data key="d4">https://artificialintelligenceact.eu/article/1/</data>
      <data key="d5">1748428231</data>
    </node>
    <node id="Innovation Support Measures">
      <data key="d0">Innovation Support Measures</data>
      <data key="d1">category</data>
      <data key="d2">Innovation Support Measures are provisions in the regulation aimed at fostering the development of AI by smaller companies.</data>
      <data key="d3">chunk-c21c2e02a12c7ec585b20f1ef155db81</data>
      <data key="d4">https://artificialintelligenceact.eu/article/1/</data>
      <data key="d5">1748428231</data>
    </node>
    <node id="AI Regulations">
      <data key="d0">AI Regulations</data>
      <data key="d1">event</data>
      <data key="d2">AI Regulations are directives aimed at ensuring the development and implementation of trustworthy artificial intelligence while protecting citizens and promoting innovation.</data>
      <data key="d3">chunk-24a11bcb90e7333ffe457649980a31a8</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/2/</data>
      <data key="d5">1748428238</data>
    </node>
    <node id="Undertakings">
      <data key="d0">Undertakings</data>
      <data key="d1">category</data>
      <data key="d2">Undertakings represents businesses or organizations whose interests are safeguarded under the regulation while promoting innovation and employment.</data>
      <data key="d3">chunk-24a11bcb90e7333ffe457649980a31a8</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/2/</data>
      <data key="d5">1748428245</data>
    </node>
    <node id="Administrative Burden">
      <data key="d0">Administrative Burden</data>
      <data key="d1">category</data>
      <data key="d2">Administrative burden encompasses the costs and effort required to comply with various regulations, which can disproportionately affect smaller entities like microenterprises.</data>
      <data key="d3">chunk-3917f629d239e59c1197ea2404615c32</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/146/</data>
      <data key="d5">1748428247</data>
    </node>
    <node id="Regulation on Horizontal Cybersecurity Requirements">
      <data key="d0">Regulation on Horizontal Cybersecurity Requirements</data>
      <data key="d1">event</data>
      <data key="d2">The Regulation on Horizontal Cybersecurity Requirements is legislation by the EU setting essential cybersecurity standards for digital products, including AI systems.</data>
      <data key="d3">chunk-72f817acfaca14a17a21a75176f408a9</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/77/</data>
      <data key="d5">1748428257</data>
    </node>
    <node id="Cyber Resilience">
      <data key="d0">Cyber Resilience</data>
      <data key="d1">category</data>
      <data key="d2">Cyber resilience refers to the ability of digital systems, such as AI systems, to withstand, recover from, and adapt to cyber threats, ensuring continuous operation and safety.</data>
      <data key="d3">chunk-72f817acfaca14a17a21a75176f408a9</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/77/</data>
      <data key="d5">1748428257</data>
    </node>
    <node id="Standardisation Requests">
      <data key="d0">Standardisation Requests</data>
      <data key="d1">category</data>
      <data key="d2">Standardisation Requests are formal proposals issued by the Commission to address requirements and obligations related to AI systems and their conformity with regulations.</data>
      <data key="d3">chunk-cad9133b1b75e03ab5dc35d035927dbb</data>
      <data key="d4">https://artificialintelligenceact.eu/article/40/</data>
      <data key="d5">1748428286</data>
    </node>
    <node id="Energy-Efficient Development">
      <data key="d0">Energy-Efficient Development</data>
      <data key="d1">category</data>
      <data key="d2">Energy-Efficient Development pertains to the processes and standards aimed at reducing energy consumption during the lifecycle of AI systems and models.</data>
      <data key="d3">chunk-cad9133b1b75e03ab5dc35d035927dbb</data>
      <data key="d4">https://artificialintelligenceact.eu/article/40/</data>
      <data key="d5">1748428286</data>
    </node>
    <node id="AI Investment and Innovation">
      <data key="d0">AI Investment and Innovation</data>
      <data key="d1">category</data>
      <data key="d2">AI investment and innovation encompass activities aimed at improving AI technology, including increased competitiveness and legal certainty.</data>
      <data key="d3">chunk-4f3473e38ccd9ad84662b373166a5c2b</data>
      <data key="d4">https://artificialintelligenceact.eu/article/40/</data>
      <data key="d5">1748428289</data>
    </node>
    <node id="Articles 5, 6, and 7 of Regulation (EU) No 1025/2012">
      <data key="d0">Articles 5, 6, and 7 of Regulation (EU) No 1025/2012</data>
      <data key="d1">event</data>
      <data key="d2">These articles outline the governance and participation frameworks for stakeholders in the standardisation process within the EU.</data>
      <data key="d3">chunk-4f3473e38ccd9ad84662b373166a5c2b</data>
      <data key="d4">https://artificialintelligenceact.eu/article/40/</data>
      <data key="d5">1748428289</data>
    </node>
    <node id="Sector Standards">
      <data key="d0">Sector Standards</data>
      <data key="d1">category</data>
      <data key="d2">Sector standards refer to specific standards developed for different sectors to ensure alignment with broader EU regulations.</data>
      <data key="d3">chunk-4f3473e38ccd9ad84662b373166a5c2b</data>
      <data key="d4">https://artificialintelligenceact.eu/article/40/</data>
      <data key="d5">1748428289</data>
    </node>
    <node id="Testing of High-Risk AI Systems">
      <data key="d0">Testing of High-Risk AI Systems</data>
      <data key="d1">event</data>
      <data key="d2">Testing of high-risk AI systems involves evaluating these technologies in real-world conditions, outside of regulatory sandboxes, to ensure safety and compliance.</data>
      <data key="d3">chunk-7195e1644a22885c55968d2c801e0064</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428303</data>
    </node>
    <node id="Ethical Review">
      <data key="d0">Ethical Review</data>
      <data key="d1">category</data>
      <data key="d2">An Ethical Review is a requirement under Union or national law to evaluate the ethical considerations involved in testing high-risk AI systems.</data>
      <data key="d3">chunk-7195e1644a22885c55968d2c801e0064</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428305</data>
    </node>
    <node id="Real-World Testing Plan">
      <data key="d0">Real-World Testing Plan</data>
      <data key="d1">event</data>
      <data key="d2">A Real-World Testing Plan is a prerequisite for providers of high-risk AI systems that outlines how testing will be conducted.</data>
      <data key="d3">chunk-7195e1644a22885c55968d2c801e0064</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428305</data>
    </node>
    <node id="Testing Plan">
      <data key="d0">Testing Plan</data>
      <data key="d1">category</data>
      <data key="d2">The Testing Plan is a documented strategy submitted by providers or prospective providers outlining how testing will be conducted in compliance with applicable regulations.</data>
      <data key="d3">chunk-b9d2702da009744eb8f52b44fea2c463</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428310</data>
    </node>
    <node id="Market Surveillance Authority Approval">
      <data key="d0">Market Surveillance Authority Approval</data>
      <data key="d1">event</data>
      <data key="d2">Market Surveillance Authority Approval is an event that occurs when the relevant authority in a Member State grants permission for testing to be conducted under specified conditions.</data>
      <data key="d3">chunk-b9d2702da009744eb8f52b44fea2c463</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428310</data>
    </node>
    <node id="High-Risk AI Systems Registration">
      <data key="d0">High-Risk AI Systems Registration</data>
      <data key="d1">event</data>
      <data key="d2">High-Risk AI Systems Registration is an event that entails a provider registering the testing of AI systems with unique identification numbers according to Union regulations.</data>
      <data key="d3">chunk-b9d2702da009744eb8f52b44fea2c463</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428310</data>
    </node>
    <node id="Article 71(4)">
      <data key="d0">Article 71(4)</data>
      <data key="d1">category</data>
      <data key="d2">Article 71(4) is a section of the Union regulations that outlines requirements for registering high-risk AI systems testing plans.</data>
      <data key="d3">chunk-b9d2702da009744eb8f52b44fea2c463</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428310</data>
    </node>
    <node id="Provider of High-Risk AI Systems">
      <data key="d0">Provider of High-Risk AI Systems</data>
      <data key="d1">organization</data>
      <data key="d2">The provider of high-risk AI systems is an entity that develops and implements automation systems with significant impact, particularly in sensitive areas such as law enforcement and migration management.</data>
      <data key="d3">chunk-383d8a6d025576d908f0c7970d58be09</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428317</data>
    </node>
    <node id="Providers and Deployers">
      <data key="d0">Providers and Deployers</data>
      <data key="d1">organization</data>
      <data key="d2">Providers and deployers are responsible for organizing and overseeing testing procedures, ensuring compliance with regulatory requirements.</data>
      <data key="d3">chunk-4a7fb5abd6ad1ba2e9256fc63dbda4a7</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428325</data>
    </node>
    <node id="Article 75">
      <data key="d0">Article 75</data>
      <data key="d1">category</data>
      <data key="d2">Article 75 grants market surveillance authorities the power to inspect and ensure compliance with testing regulations.&lt;SEP&gt;Article 75 refers to a regulation outlining the powers of market surveillance authorities to oversee testing processes of AI systems.</data>
      <data key="d3">chunk-17d875a9ff2b02237bb4b9ba04e5b92a&lt;SEP&gt;chunk-4a7fb5abd6ad1ba2e9256fc63dbda4a7</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428325</data>
    </node>
    <node id="National Market Surveillance Authority">
      <data key="d0">National Market Surveillance Authority</data>
      <data key="d1">organization</data>
      <data key="d2">The National Market Surveillance Authority is a government body in Member States responsible for enforcing compliance and safeguarding public interest concerning high-risk AI systems.&lt;SEP&gt;The National Market Surveillance Authority is responsible for overseeing the testing of AI systems in real-world conditions within its jurisdiction.&lt;SEP&gt;The national market surveillance authority is responsible for overseeing the compliance and safety of high-risk AI systems during testing.</data>
      <data key="d3">chunk-17d875a9ff2b02237bb4b9ba04e5b92a&lt;SEP&gt;chunk-3d21ee76ebe03dd794f42225c64861fb&lt;SEP&gt;chunk-4a7fb5abd6ad1ba2e9256fc63dbda4a7</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428325</data>
    </node>
    <node id="Testing Protocols">
      <data key="d0">Testing Protocols</data>
      <data key="d1">category</data>
      <data key="d2">Testing protocols are the established procedures and guidelines that govern the evaluation of AI systems in real-world scenarios.</data>
      <data key="d3">chunk-3d21ee76ebe03dd794f42225c64861fb</data>
      <data key="d4">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d5">1748428325</data>
    </node>
    <node id="Nondiscrimination Law">
      <data key="d0">Nondiscrimination Law</data>
      <data key="d1">category</data>
      <data key="d2">Nondiscrimination Law is part of the legal protections in the EU that prohibits discrimination based on various grounds, including race, gender, and age.</data>
      <data key="d3">chunk-55b12370838dd1a62b5ded5dc20979b9</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/45/</data>
      <data key="d5">1748428345</data>
    </node>
    <node id="Consumer Protection Law">
      <data key="d0">Consumer Protection Law</data>
      <data key="d1">category</data>
      <data key="d2">Consumer Protection Law consists of regulations intended to prevent unfair trade practices and protect consumers' rights in the marketplace within the EU.</data>
      <data key="d3">chunk-55b12370838dd1a62b5ded5dc20979b9</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/45/</data>
      <data key="d5">1748428345</data>
    </node>
    <node id="Competition Law">
      <data key="d0">Competition Law</data>
      <data key="d1">category</data>
      <data key="d2">Competition Law is designed to promote fair competition and prevent monopolistic practices within the EU, ensuring market efficiency and consumer welfare.</data>
      <data key="d3">chunk-55b12370838dd1a62b5ded5dc20979b9</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/45/</data>
      <data key="d5">1748428345</data>
    </node>
    <node id="United Kingdom">
      <data key="d0">United Kingdom</data>
      <data key="d1">geo</data>
      <data key="d2">The United Kingdom (UK) is a sovereign country located off the northwestern coast of mainland Europe, involved in European Union regulations regarding justice and security.</data>
      <data key="d3">chunk-55631cb4906af7cdbc5803cac20d432d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/40/</data>
      <data key="d5">1748428347</data>
    </node>
    <node id="Ireland">
      <data key="d0">Ireland</data>
      <data key="d1">geo</data>
      <data key="d2">Ireland is a sovereign nation that is referenced concerning its unique position in relation to EU regulations on freedom, security, and justice.</data>
      <data key="d3">chunk-55631cb4906af7cdbc5803cac20d432d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/40/</data>
      <data key="d5">1748428347</data>
    </node>
    <node id="Article 6a of Protocol No 21">
      <data key="d0">Article 6a of Protocol No 21</data>
      <data key="d1">category</data>
      <data key="d2">Article 6a refers to a specific provision concerning the position of the UK and Ireland within EU regulations related to freedom, security, and justice.</data>
      <data key="d3">chunk-55631cb4906af7cdbc5803cac20d432d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/40/</data>
      <data key="d5">1748428347</data>
    </node>
    <node id="Article 6a">
      <data key="d0">Article 6a</data>
      <data key="d1">category</data>
      <data key="d2">Article 6a refers to a specific provision in Protocol No 21 that addresses the position of the United Kingdom and Ireland concerning EU regulations on freedom, security, and justice.</data>
      <data key="d3">chunk-55631cb4906af7cdbc5803cac20d432d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/40/</data>
      <data key="d5">1748428347</data>
    </node>
    <node id="Protocol No 21">
      <data key="d0">Protocol No 21</data>
      <data key="d1">category</data>
      <data key="d2">Protocol No 21 deals with the status of the United Kingdom and Ireland in relation to the area of freedom, security, and justice within the European Union framework.</data>
      <data key="d3">chunk-55631cb4906af7cdbc5803cac20d432d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/40/</data>
      <data key="d5">1748428347</data>
    </node>
    <node id="Police Cooperation">
      <data key="d0">Police Cooperation</data>
      <data key="d1">category</data>
      <data key="d2">Police Cooperation involves collaborative efforts between law enforcement agencies of member states to enhance security and enforce laws.</data>
      <data key="d3">chunk-55631cb4906af7cdbc5803cac20d432d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/40/</data>
      <data key="d5">1748428347</data>
    </node>
    <node id="Cumulative Computation">
      <data key="d0">Cumulative Computation</data>
      <data key="d1">category</data>
      <data key="d2">Cumulative Computation refers to the total amount of computational resources used in training the AI model, an important factor in assessing its capabilities.</data>
      <data key="d3">chunk-9e5484976fb39d2996307dda5a0931d6</data>
      <data key="d4">https://artificialintelligenceact.eu/article/51/</data>
      <data key="d5">1748428352</data>
    </node>
    <node id="High Impact Capabilities">
      <data key="d0">High Impact Capabilities</data>
      <data key="d1">category</data>
      <data key="d2">High Impact Capabilities are attributes of AI models assessed based on their potential to affect systems or environments significantly, which influences their classification.</data>
      <data key="d3">chunk-9e5484976fb39d2996307dda5a0931d6</data>
      <data key="d4">https://artificialintelligenceact.eu/article/51/</data>
      <data key="d5">1748428352</data>
    </node>
    <node id="Indicators and Benchmarks">
      <data key="d0">Indicators and Benchmarks</data>
      <data key="d1">category</data>
      <data key="d2">Indicators and Benchmarks are specific metrics used to assess the performance and impact of AI models in various contexts.</data>
      <data key="d3">chunk-9e5484976fb39d2996307dda5a0931d6</data>
      <data key="d4">https://artificialintelligenceact.eu/article/51/</data>
      <data key="d5">1748428352</data>
    </node>
    <node id="Evolving Technological Developments">
      <data key="d0">Evolving Technological Developments</data>
      <data key="d1">category</data>
      <data key="d2">Evolving Technological Developments refer to advancements in technology that may alter the criteria or thresholds used in assessing AI models.</data>
      <data key="d3">chunk-9e5484976fb39d2996307dda5a0931d6</data>
      <data key="d4">https://artificialintelligenceact.eu/article/51/</data>
      <data key="d5">1748428355</data>
    </node>
    <node id="Computation Measurement">
      <data key="d0">Computation Measurement</data>
      <data key="d1">category</data>
      <data key="d2">Computation Measurement is the quantification of computational resources used for training AI models, which is a key factor in impact assessment.</data>
      <data key="d3">chunk-9e5484976fb39d2996307dda5a0931d6</data>
      <data key="d4">https://artificialintelligenceact.eu/article/51/</data>
      <data key="d5">1748428355</data>
    </node>
    <node id="Transitional Period">
      <data key="d0">Transitional Period</data>
      <data key="d1">category</data>
      <data key="d2">The Transitional Period refers to the timeframe during which providers of high-risk AI systems are encouraged to begin compliance with the relevant obligations of the Regulation.</data>
      <data key="d3">chunk-4f5a4e48721924d3a1798f61c8810d78</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/178/</data>
      <data key="d5">1748428358</data>
    </node>
    <node id="Relevant Obligations">
      <data key="d0">Relevant Obligations</data>
      <data key="d1">category</data>
      <data key="d2">Relevant Obligations are the specific requirements set forth in the Regulation that AI system providers must adhere to during the compliance process.</data>
      <data key="d3">chunk-4f5a4e48721924d3a1798f61c8810d78</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/178/</data>
      <data key="d5">1748428358</data>
    </node>
    <node id="Regulations and Directives">
      <data key="d0">Regulations and Directives</data>
      <data key="d1">category</data>
      <data key="d2">Regulations and Directives refer to the legal frameworks established by the European Union to govern data protection and privacy rights.</data>
      <data key="d3">chunk-b5414adf1ebf7087a1a00f2e4fb3570b</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/10/</data>
      <data key="d5">1748428375</data>
    </node>
    <node id="independent supervisory authorities">
      <data key="d0">independent supervisory authorities</data>
      <data key="d1">organization</data>
      <data key="d2">Independent supervisory authorities are agencies responsible for overseeing compliance with data protection regulations and ensuring individuals' rights are respected.</data>
      <data key="d3">chunk-b5414adf1ebf7087a1a00f2e4fb3570b</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/10/</data>
      <data key="d5">1748428375</data>
    </node>
    <node id="Automated Individual Decision-Making">
      <data key="d0">Automated Individual Decision-Making</data>
      <data key="d1">category</data>
      <data key="d2">Automated individual decision-making involves using algorithms to make decisions about individuals without human intervention, addressing concerns regarding fairness and transparency.</data>
      <data key="d3">chunk-57118cd489d78b33ed75c63f33151aee</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/10/</data>
      <data key="d5">1748428375</data>
    </node>
    <node id="Regulation (EC) No 45/2001">
      <data key="d0">Regulation (EC) No 45/2001</data>
      <data key="d1">event</data>
      <data key="d2">Regulation (EC) No 45/2001 laid the groundwork for data protection measures specific to the European Union's institutions and agencies before being replaced by more stringent regulations.</data>
      <data key="d3">chunk-57118cd489d78b33ed75c63f33151aee</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/10/</data>
      <data key="d5">1748428375</data>
    </node>
    <node id="Decision No 1247/2002/EC">
      <data key="d0">Decision No 1247/2002/EC</data>
      <data key="d1">event</data>
      <data key="d2">Decision No 1247/2002/EC is a European Council decision related to the handling and processing of personal data.&lt;SEP&gt;Decision No 1247/2002/EC pertains to the framework for the protection of personal data within the EU institutions and agencies.</data>
      <data key="d3">chunk-57118cd489d78b33ed75c63f33151aee&lt;SEP&gt;chunk-6ebb4e641a55d31b962b56d6017d2734</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/10/</data>
      <data key="d5">1748428375</data>
    </node>
    <node id="Directive 95/46/EC">
      <data key="d0">Directive 95/46/EC</data>
      <data key="d1">event</data>
      <data key="d2">Directive 95/46/EC was an earlier legislative measure that focused on the protection of individuals' personal data and privacy in the European Union.</data>
      <data key="d3">chunk-57118cd489d78b33ed75c63f33151aee</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/10/</data>
      <data key="d5">1748428375</data>
    </node>
    <node id="OJ L 295">
      <data key="d0">OJ L 295</data>
      <data key="d1">event</data>
      <data key="d2">OJ L 295 refers to the Official Journal of the European Union publication in which legislative acts such as directives are officially published.</data>
      <data key="d3">chunk-6ebb4e641a55d31b962b56d6017d2734</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/10/</data>
      <data key="d5">1748428375</data>
    </node>
    <node id="Council Framework Decision 2008/977/JHA">
      <data key="d0">Council Framework Decision 2008/977/JHA</data>
      <data key="d1">event</data>
      <data key="d2">Council Framework Decision 2008/977/JHA is a prior decision focusing on data protection related to law enforcement and judicial cooperation.</data>
      <data key="d3">chunk-6ebb4e641a55d31b962b56d6017d2734</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/10/</data>
      <data key="d5">1748428375</data>
    </node>
    <node id="Regulatory Oversight">
      <data key="d0">Regulatory Oversight</data>
      <data key="d1">category</data>
      <data key="d2">Regulatory oversight refers to the necessary supervision required for the safe development and deployment of AI technologies to mitigate risks and promote responsible innovation.</data>
      <data key="d3">chunk-f1bd36f2082e6f670210d08c02e3d502</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/138/</data>
      <data key="d5">1748428378</data>
    </node>
    <node id="Codes of Practice Approval">
      <data key="d0">Codes of Practice Approval</data>
      <data key="d1">event</data>
      <data key="d2">Codes of Practice Approval is a process managed by the Commission and the AI Office to evaluate and validate documents that set standards for AI model compliance.</data>
      <data key="d3">chunk-408ee65c3eab1e86c1c4207deaf4f216</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/117/</data>
      <data key="d5">1748428390</data>
    </node>
    <node id="authority">
      <data key="d0">authority</data>
      <data key="d3">chunk-9fcfeac23bcf45d7f7b0140796cad07f</data>
      <data key="d2">The authority is responsible for monitoring and verifying compliance with the requirements laid down in Article 31.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">https://artificialintelligenceact.eu/article/29/</data>
      <data key="d5">1748428406</data>
    </node>
    <node id="Providers and Prospective Providers">
      <data key="d0">Providers and Prospective Providers</data>
      <data key="d1">organization</data>
      <data key="d2">Providers and prospective providers in the AI regulatory sandbox are entities that develop AI systems while ensuring compliance with data protection regulations.</data>
      <data key="d3">chunk-6e35e35e2f589e83baa732e4cdf12f1b</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428408</data>
    </node>
    <node id="Article 6(4)">
      <data key="d0">Article 6(4)</data>
      <data key="d1">category</data>
      <data key="d2">Article 6(4) of Regulation (EU) 2016/679 outlines specific conditions under which personal data may be used for purposes other than originally intended.</data>
      <data key="d3">chunk-6e35e35e2f589e83baa732e4cdf12f1b</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428408</data>
    </node>
    <node id="Article 9(2), point (g)">
      <data key="d0">Article 9(2), point (g)</data>
      <data key="d1">category</data>
      <data key="d2">Article 9(2), point (g) of Regulation (EU) 2016/679 provides exceptions for the processing of special categories of personal data under certain conditions.</data>
      <data key="d3">chunk-6e35e35e2f589e83baa732e4cdf12f1b</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428408</data>
    </node>
    <node id="Obligations of Data Controllers">
      <data key="d0">Obligations of Data Controllers</data>
      <data key="d1">category</data>
      <data key="d2">Obligations of data controllers are responsibilities outlined in data protection regulations that ensure the rights of data subjects are respected.</data>
      <data key="d3">chunk-6e35e35e2f589e83baa732e4cdf12f1b</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428408</data>
    </node>
    <node id="Conditions for Development">
      <data key="d0">Conditions for Development</data>
      <data key="d1">category</data>
      <data key="d2">Conditions for development refer to the specified requirements under which AI systems can be developed in the AI regulatory sandbox while protecting personal data.</data>
      <data key="d3">chunk-6e35e35e2f589e83baa732e4cdf12f1b</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428408</data>
    </node>
    <node id="Guidance">
      <data key="d0">Guidance</data>
      <data key="d1">category</data>
      <data key="d2">Guidance refers to recommendations or directions provided to ensure safety, health, and rights during development processes.</data>
      <data key="d3">chunk-ef2db5390248e67c8de7693a5d073f62</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428408</data>
    </node>
    <node id="Development Sandbox">
      <data key="d0">Development Sandbox</data>
      <data key="d1">event</data>
      <data key="d2">The Development Sandbox is a controlled environment for testing and experimenting with innovative concepts, particularly focusing on safety and fundamental rights.</data>
      <data key="d3">chunk-ef2db5390248e67c8de7693a5d073f62</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428408</data>
    </node>
    <node id="Safety Risks">
      <data key="d0">Safety Risks</data>
      <data key="d1">category</data>
      <data key="d2">Safety Risks refer to potential hazards that could threaten the well-being of individuals during various processes, necessitating mitigation strategies.</data>
      <data key="d3">chunk-ef2db5390248e67c8de7693a5d073f62</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428408</data>
    </node>
    <node id="Testing and Experimentation">
      <data key="d0">Testing and Experimentation</data>
      <data key="d1">event</data>
      <data key="d2">Testing and Experimentation involve evaluating new concepts and technologies to assess their safety, effectiveness, and compliance with established rights and regulations.</data>
      <data key="d3">chunk-ef2db5390248e67c8de7693a5d073f62</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/140/</data>
      <data key="d5">1748428412</data>
    </node>
    <node id="Sections 2 and 3 of Chapter V">
      <data key="d0">Sections 2 and 3 of Chapter V</data>
      <data key="d1">category</data>
      <data key="d2">Sections 2 and 3 of Chapter V detail the obligations under which common specifications and harmonised standards are to be developed.</data>
      <data key="d3">chunk-214363bac320d3b288355fb10d6c0537</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d5">1748428428</data>
    </node>
    <node id="Article 10(1)">
      <data key="d0">Article 10(1)</data>
      <data key="d1">category</data>
      <data key="d2">Article 10(1) of Regulation (EU) No 1025/2012 outlines the process for requesting the drafting of harmonised standards.</data>
      <data key="d3">chunk-214363bac320d3b288355fb10d6c0537</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d5">1748428428</data>
    </node>
    <node id="Article 67">
      <data key="d0">Article 67</data>
      <data key="d1">event</data>
      <data key="d2">Article 67 relates to the consultation of the advisory forum in the drafting of common specifications in the EU context.</data>
      <data key="d3">chunk-ee3505c356c8e76e9f364115f4eb7ea3</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d5">1748428439</data>
    </node>
    <node id="European Standardisation Organisation">
      <data key="d0">European Standardisation Organisation</data>
      <data key="d1">organization</data>
      <data key="d2">The European standardisation organisation is responsible for the development and adoption of harmonised standards across Europe.</data>
      <data key="d3">chunk-2ae5c70e1b98b5f33eb047bb55022e9d</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d5">1748428439</data>
    </node>
    <node id="Paragraph 1">
      <data key="d0">Paragraph 1</data>
      <data key="d1">category</data>
      <data key="d2">Paragraph 1 refers to a specific clause detailing requirements that providers of high-risk AI systems must follow in the context of compliance.</data>
      <data key="d3">chunk-2ae5c70e1b98b5f33eb047bb55022e9d</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d5">1748428445</data>
    </node>
    <node id="Section 2 of this Chapter">
      <data key="d0">Section 2 of this Chapter</data>
      <data key="d1">category</data>
      <data key="d2">Section 2 refers to the specified requirements that must be fulfilled by AI system providers according to the outlined regulations.</data>
      <data key="d3">chunk-2ae5c70e1b98b5f33eb047bb55022e9d</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d5">1748428445</data>
    </node>
    <node id="Section 3 of Chapter V">
      <data key="d0">Section 3 of Chapter V</data>
      <data key="d1">category</data>
      <data key="d2">Section 3 of Chapter V pertains to obligations that must be adhered to by providers of AI systems under EU legislation.</data>
      <data key="d3">chunk-2ae5c70e1b98b5f33eb047bb55022e9d</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d5">1748428445</data>
    </node>
    <node id="Paragraph 5">
      <data key="d0">Paragraph 5</data>
      <data key="d1">category</data>
      <data key="d2">Paragraph 5 outlines the responsibilities of Member States regarding compliance and reporting to the Commission regarding standards.</data>
      <data key="d3">chunk-2ae5c70e1b98b5f33eb047bb55022e9d</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d5">1748428445</data>
    </node>
    <node id="common specification concerned">
      <data key="d0">common specification concerned</data>
      <data key="d3">chunk-f2b84ed9e420c0ae0245bb808d08db0f</data>
      <data key="d2">The Commission is responsible for assessing and potentially amending the common specification in question.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d5">1748428452</data>
    </node>
    <node id="Co-Chairs">
      <data key="d0">Co-Chairs</data>
      <data key="d1">organization</data>
      <data key="d2">The Co-Chairs are individuals or roles that lead the advisory forum for a renewable term of two years.</data>
      <data key="d3">chunk-47ac4d6cae0afd3292516531be7716e9</data>
      <data key="d4">https://artificialintelligenceact.eu/article/67/</data>
      <data key="d5">1748428455</data>
    </node>
    <node id="Meetings">
      <data key="d0">Meetings</data>
      <data key="d1">event</data>
      <data key="d2">Meetings are regular gatherings held by the advisory forum, occurring at least twice a year, to discuss relevant topics and collaborate.</data>
      <data key="d3">chunk-47ac4d6cae0afd3292516531be7716e9</data>
      <data key="d4">https://artificialintelligenceact.eu/article/67/</data>
      <data key="d5">1748428455</data>
    </node>
    <node id="Regulation Objectives">
      <data key="d0">Regulation Objectives</data>
      <data key="d1">category</data>
      <data key="d2">Regulation Objectives refer to the specific goals and aims that the advisory forum aims to address through its activities and recommendations.</data>
      <data key="d3">chunk-47ac4d6cae0afd3292516531be7716e9</data>
      <data key="d4">https://artificialintelligenceact.eu/article/67/</data>
      <data key="d5">1748428455</data>
    </node>
    <node id="Information Ecosystem">
      <data key="d0">Information Ecosystem</data>
      <data key="d1">category</data>
      <data key="d2">The information ecosystem encompasses the network of information creation, dissemination, and consumption, which is impacted by AI-generated content.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Misinformation Risks">
      <data key="d0">Misinformation Risks</data>
      <data key="d1">category</data>
      <data key="d2">Misinformation risks arise from the potential of AI systems to generate falsified information that can mislead consumers and manipulate perceptions.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Content Marking Techniques">
      <data key="d0">Content Marking Techniques</data>
      <data key="d1">category</data>
      <data key="d2">Content marking techniques are methods intended to identify AI-generated content, such as watermarks and cryptographic methods, to ensure authenticity.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Technology Providers">
      <data key="d0">Technology Providers</data>
      <data key="d1">organization</data>
      <data key="d2">Technology providers refer to companies or entities that develop and supply AI systems and related technologies.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Synthetic Content">
      <data key="d0">Synthetic Content</data>
      <data key="d1">category</data>
      <data key="d2">Synthetic content refers to content generated by AI systems that resembles human-created material, making it difficult to distinguish between the two.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="AI System Integrity">
      <data key="d0">AI System Integrity</data>
      <data key="d1">category</data>
      <data key="d2">AI system integrity relates to the reliability and authenticity of outputs produced by artificial intelligence, especially concerning misinformation.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Consumer Deception">
      <data key="d0">Consumer Deception</data>
      <data key="d1">category</data>
      <data key="d2">Consumer deception involves misleading information that can result from the outputs of AI systems, potentially leading to fraud and misinformation.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Watermarks">
      <data key="d0">Watermarks</data>
      <data key="d1">category</data>
      <data key="d2">Watermarks are a technical solution employed to mark digital content to indicate authenticity and originality, especially for AI-generated content.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Provenance Proving Methods">
      <data key="d0">Provenance Proving Methods</data>
      <data key="d1">category</data>
      <data key="d2">Provenance proving methods are techniques used to verify the origin and authenticity of content, including AI-generated materials.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Deployment of AI Models">
      <data key="d0">Deployment of AI Models</data>
      <data key="d1">category</data>
      <data key="d2">Deployment of AI models refers to the practical implementation of AI technologies that generate content, with attention to their operational impacts.</data>
      <data key="d3">chunk-d09524914eef0125fee170a5c8b400e0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Downstream Provider">
      <data key="d0">Downstream Provider</data>
      <data key="d1">organization</data>
      <data key="d2">A downstream provider is an entity that utilizes an AI system for practical applications, often responsible for the deployment and operational use of the AI technology.</data>
      <data key="d3">chunk-343138c98bcd39f893aee610a717cfc7</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/133/</data>
      <data key="d5">1748428465</data>
    </node>
    <node id="Public Interests">
      <data key="d0">Public Interests</data>
      <data key="d1">category</data>
      <data key="d2">Public Interests encompass the collective well-being and rights of society that may be impacted by the introduction of technologies like AI.&lt;SEP&gt;Public Interests refer to the welfare or well-being of the general public and the community as a whole, which can influence the implementation of laws and regulations.</data>
      <data key="d3">chunk-a33f9372e32e8879cc6f97cd662934d5&lt;SEP&gt;chunk-4df1f3eba6d36bfd15e8ab3333ac4fd3</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/5/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/167/</data>
      <data key="d5">1748428477</data>
    </node>
    <node id="AI Risks">
      <data key="d0">AI Risks</data>
      <data key="d1">category</data>
      <data key="d2">AI Risks refers to the potential dangers and negative consequences that may arise from the application of artificial intelligence technologies, affecting various societal aspects.</data>
      <data key="d3">chunk-4df1f3eba6d36bfd15e8ab3333ac4fd3</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/5/</data>
      <data key="d5">1748428477</data>
    </node>
    <node id="Technological Development">
      <data key="d0">Technological Development</data>
      <data key="d1">category</data>
      <data key="d2">Technological Development refers to the advancement and evolution of technologies, including AI, which can impact its applications and associated risks.</data>
      <data key="d3">chunk-4df1f3eba6d36bfd15e8ab3333ac4fd3</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/5/</data>
      <data key="d5">1748428477</data>
    </node>
    <node id="Harm to Society">
      <data key="d0">Harm to Society</data>
      <data key="d1">category</data>
      <data key="d2">Harm to Society denotes the negative effects that technologies, particularly AI, can inflict on the community at large, including psychological and economic consequences.</data>
      <data key="d3">chunk-4df1f3eba6d36bfd15e8ab3333ac4fd3</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/5/</data>
      <data key="d5">1748428477</data>
    </node>
    <node id="Sectoral Union Law">
      <data key="d0">Sectoral Union Law</data>
      <data key="d1">organization</data>
      <data key="d2">Sectoral Union Law encompasses industry-specific regulations that aid in the governance and quality management of technologies like AI systems.</data>
      <data key="d3">chunk-1fbb87b8107271f1fe959942ad2e3666</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/81/</data>
      <data key="d5">1748428483</data>
    </node>
    <node id="Relevant Authorities">
      <data key="d0">Relevant Authorities</data>
      <data key="d1">organization</data>
      <data key="d2">Relevant Authorities are designated entities that oversee compliance and respond to reports of serious incidents caused by AI systems.</data>
      <data key="d3">chunk-078bfdf1b899d975b7606b4acd63166d</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/155/</data>
      <data key="d5">1748428497</data>
    </node>
    <node id="National Measure">
      <data key="d0">National Measure</data>
      <data key="d1">category</data>
      <data key="d2">A National Measure refers to actions taken by Member States related to AI practices that may require review under the Union Safeguard Procedure.&lt;SEP&gt;National measures refer to actions or regulations taken by individual Member States in response to issues surrounding AI system compliance and standards.</data>
      <data key="d3">chunk-85726b1098cb96ad81df40234ad5da52&lt;SEP&gt;chunk-ec59dcaa7ce835ce9dd1c42d507cf75f</data>
      <data key="d4">https://artificialintelligenceact.eu/article/81/</data>
      <data key="d5">1748428500</data>
    </node>
    <node id="Article 40 and 41">
      <data key="d0">Article 40 and 41</data>
      <data key="d1">category</data>
      <data key="d2">Articles 40 and 41 refer to provisions that address harmonized standards and common specifications relevant to AI systems in the EU.</data>
      <data key="d3">chunk-ec59dcaa7ce835ce9dd1c42d507cf75f</data>
      <data key="d4">https://artificialintelligenceact.eu/article/81/</data>
      <data key="d5">1748428500</data>
    </node>
    <node id="Narrow Procedural Tasks">
      <data key="d0">Narrow Procedural Tasks</data>
      <data key="d1">category</data>
      <data key="d2">Narrow Procedural Tasks are specific functions performed by AI systems that involve limited risk and are designed to streamline processes, like data classification.</data>
      <data key="d3">chunk-992499cbdbb7fa23e4ae622c35e9d42f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428513</data>
    </node>
    <node id="High-Risk Uses">
      <data key="d0">High-Risk Uses</data>
      <data key="d1">category</data>
      <data key="d2">High-Risk Uses are activities or applications identified within the context of the Regulation that may pose significant risks when utilizing AI systems.&lt;SEP&gt;High-risk uses refer to applications of AI systems that have significant potential to harm health, safety, or fundamental rights and require strict oversight.</data>
      <data key="d3">chunk-1b88de119a362d1ff7d1500b9782d0c6&lt;SEP&gt;chunk-992499cbdbb7fa23e4ae622c35e9d42f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428513</data>
    </node>
    <node id="Human Activity">
      <data key="d0">Human Activity</data>
      <data key="d1">category</data>
      <data key="d2">Human Activity refers to actions completed by individuals which may be improved or augmented by AI systems according to the guidelines of the Regulation.&lt;SEP&gt;Human activity refers to tasks or actions performed by humans that AI systems aim to enhance or improve, especially in high-risk contexts.</data>
      <data key="d3">chunk-1b88de119a362d1ff7d1500b9782d0c6&lt;SEP&gt;chunk-992499cbdbb7fa23e4ae622c35e9d42f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428513</data>
    </node>
    <node id="Decision-Making">
      <data key="d0">Decision-Making</data>
      <data key="d1">category</data>
      <data key="d2">Decision-Making involves the process of making choices, often influenced by AI systems within regulated environments to ensure integrity.</data>
      <data key="d3">chunk-992499cbdbb7fa23e4ae622c35e9d42f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428513</data>
    </node>
    <node id="Data Classification">
      <data key="d0">Data Classification</data>
      <data key="d1">category</data>
      <data key="d2">Data Classification refers to the process by which AI systems categorize unstructured data into defined classes to enhance information retrieval and management.</data>
      <data key="d3">chunk-992499cbdbb7fa23e4ae622c35e9d42f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428513</data>
    </node>
    <node id="Pattern Detection">
      <data key="d0">Pattern Detection</data>
      <data key="d1">category</data>
      <data key="d2">Pattern Detection involves AI systems identifying aberrations or regularities in data, particularly relevant to evaluating historical human decisions.</data>
      <data key="d3">chunk-992499cbdbb7fa23e4ae622c35e9d42f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428513</data>
    </node>
    <node id="Grading Pattern">
      <data key="d0">Grading Pattern</data>
      <data key="d1">category</data>
      <data key="d2">Grading Pattern relates to a consistent method of assessing performance, often reviewed with the help of AI systems to ensure fairness and accuracy.</data>
      <data key="d3">chunk-992499cbdbb7fa23e4ae622c35e9d42f</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428513</data>
    </node>
    <node id="Article 4, point (4)">
      <data key="d0">Article 4, point (4)</data>
      <data key="d1">category</data>
      <data key="d2">Article 4, point (4) of Regulation (EU) 2016/679 defines profiling, which is relevant in assessing the risks posed by AI systems.</data>
      <data key="d3">chunk-1b88de119a362d1ff7d1500b9782d0c6</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428518</data>
    </node>
    <node id="Article 3, point (4)">
      <data key="d0">Article 3, point (4)</data>
      <data key="d1">category</data>
      <data key="d2">Article 3, point (4) of Directive (EU) 2016/680 relates to the protection of personal data in the context of AI regulation.</data>
      <data key="d3">chunk-1b88de119a362d1ff7d1500b9782d0c6</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428518</data>
    </node>
    <node id="Article 3, point (5)">
      <data key="d0">Article 3, point (5)</data>
      <data key="d1">category</data>
      <data key="d2">Article 3, point (5) of Regulation (EU) 2018/1725 addresses data processing in the context of privacy and AI systems.</data>
      <data key="d3">chunk-1b88de119a362d1ff7d1500b9782d0c6</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428518</data>
    </node>
    <node id="High-Risk Use-Cases">
      <data key="d0">High-Risk Use-Cases</data>
      <data key="d1">category</data>
      <data key="d2">High-Risk Use-Cases refer to applications of AI systems that are identified to pose significant risks to health, safety, or fundamental rights.</data>
      <data key="d3">chunk-22dbef3b29da3394b10b69bcc6aa4f59</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428518</data>
    </node>
    <node id="Use Cases of AI Systems">
      <data key="d0">Use Cases of AI Systems</data>
      <data key="d1">category</data>
      <data key="d2">Use Cases of AI Systems encompass practical applications of AI technology, which can be either classified as high-risk or non-high-risk, impacting guidelines for implementation.</data>
      <data key="d3">chunk-9a24148385124cc6a8cba737414c55a6</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/53/</data>
      <data key="d5">1748428525</data>
    </node>
    <node id="Start-Ups">
      <data key="d0">Start-Ups</data>
      <data key="d1">category</data>
      <data key="d2">Start-Ups are newly established businesses often focused on innovation, which are also included in the measures to support AI-related activities.</data>
      <data key="d3">chunk-8363b7ff75e2a59a44c744564b484596</data>
      <data key="d4">https://artificialintelligenceact.eu/article/62/</data>
      <data key="d5">1748428535</data>
    </node>
    <node id="Standardisation Development Process">
      <data key="d0">Standardisation Development Process</data>
      <data key="d1">event</data>
      <data key="d2">The standardisation development process involves creating guidelines and standards for AI systems, which SMEs and other stakeholders participate in.</data>
      <data key="d3">chunk-8363b7ff75e2a59a44c744564b484596</data>
      <data key="d4">https://artificialintelligenceact.eu/article/62/</data>
      <data key="d5">1748428535</data>
    </node>
    <node id="Information Platform">
      <data key="d0">Information Platform</data>
      <data key="d1">event</data>
      <data key="d2">The information platform is a digital resource organized by the AI Office to provide easily accessible information regarding AI regulations for all operators in the Union.</data>
      <data key="d3">chunk-8363b7ff75e2a59a44c744564b484596</data>
      <data key="d4">https://artificialintelligenceact.eu/article/62/</data>
      <data key="d5">1748428535</data>
    </node>
    <node id="Awareness Raising Activities">
      <data key="d0">Awareness Raising Activities</data>
      <data key="d1">event</data>
      <data key="d2">Awareness raising activities refer to initiatives aimed at increasing understanding and knowledge about AI regulations among SMEs, start-ups, and public authorities.</data>
      <data key="d3">chunk-8363b7ff75e2a59a44c744564b484596</data>
      <data key="d4">https://artificialintelligenceact.eu/article/62/</data>
      <data key="d5">1748428535</data>
    </node>
    <node id="Best Practices in Public Procurement">
      <data key="d0">Best Practices in Public Procurement</data>
      <data key="d1">category</data>
      <data key="d2">Best Practices in Public Procurement refer to recommended strategies and procedures for the acquisition of AI systems and services in a compliant manner.</data>
      <data key="d3">chunk-c4141f8e823eac643a256625a708aec7</data>
      <data key="d4">https://artificialintelligenceact.eu/article/62/</data>
      <data key="d5">1748428535</data>
    </node>
    <node id="Union Law on Legal Metrology">
      <data key="d0">Union Law on Legal Metrology</data>
      <data key="d1">category</data>
      <data key="d2">Union law on legal metrology refers to regulations ensuring the accuracy of measurements in trade and other activities, specifically focusing on compliance within the EU.</data>
      <data key="d3">chunk-a79b7078e45aa680595b27c1baab1b2e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428538</data>
    </node>
    <node id="Directive 2014/31/EU">
      <data key="d0">Directive 2014/31/EU</data>
      <data key="d1">event</data>
      <data key="d2">This directive pertains to the harmonization of laws regarding non-automatic weighing instruments in the EU, ensuring standardization in measurement practices.</data>
      <data key="d3">chunk-a79b7078e45aa680595b27c1baab1b2e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428538</data>
    </node>
    <node id="Directive 2014/32/EU">
      <data key="d0">Directive 2014/32/EU</data>
      <data key="d1">event</data>
      <data key="d2">Directive 2014/32/EU is a legal act aiming to harmonize laws regarding the market availability of measuring instruments within EU member states.&lt;SEP&gt;This directive focuses on the harmonization of laws regarding measuring instruments, similar to Directive 2014/31/EU, to ensure uniform standards across the EU.</data>
      <data key="d3">chunk-557acf7764c3014cc0e27cf73b9a0fb0&lt;SEP&gt;chunk-a79b7078e45aa680595b27c1baab1b2e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428538</data>
    </node>
    <node id="relevant organisations and stakeholders">
      <data key="d0">relevant organisations and stakeholders</data>
      <data key="d1">organization</data>
      <data key="d2">Relevant organisations and stakeholders refer to various entities involved in the oversight and management of AI systems, addressing risks and impacts associated with their use.</data>
      <data key="d3">chunk-a79b7078e45aa680595b27c1baab1b2e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428538</data>
    </node>
    <node id="performance metrics">
      <data key="d0">performance metrics</data>
      <data key="d1">category</data>
      <data key="d2">Performance metrics are standards or criteria used to evaluate the effectiveness, accuracy, and reliability of AI systems.</data>
      <data key="d3">chunk-a79b7078e45aa680595b27c1baab1b2e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428538</data>
    </node>
    <node id="instructions of use">
      <data key="d0">instructions of use</data>
      <data key="d1">category</data>
      <data key="d2">Instructions of use provide detailed guidance on how to properly deploy and utilize AI systems as intended.</data>
      <data key="d3">chunk-a79b7078e45aa680595b27c1baab1b2e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428538</data>
    </node>
    <node id="Directives 2014/31/EU">
      <data key="d0">Directives 2014/31/EU</data>
      <data key="d1">event</data>
      <data key="d2">Directive 2014/31/EU is a legislative measure that harmonizes laws among EU member states regarding non-automatic weighing instruments to ensure precision in measurements.</data>
      <data key="d3">chunk-a79b7078e45aa680595b27c1baab1b2e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428538</data>
    </node>
    <node id="Directives 2014/32/EU">
      <data key="d0">Directives 2014/32/EU</data>
      <data key="d1">event</data>
      <data key="d2">Directive 2014/32/EU pertains to the harmonization of laws concerning measuring instruments across EU member states, focusing on accuracy and compliance.</data>
      <data key="d3">chunk-a79b7078e45aa680595b27c1baab1b2e</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428538</data>
    </node>
    <node id="Directive on Non-Automatic Weighing Instruments">
      <data key="d0">Directive on Non-Automatic Weighing Instruments</data>
      <data key="d1">event</data>
      <data key="d2">The Directive on Non-Automatic Weighing Instruments pertains to the legal framework governing the market introduction of weighing devices.</data>
      <data key="d3">chunk-557acf7764c3014cc0e27cf73b9a0fb0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428543</data>
    </node>
    <node id="Non-Automatic Weighing Instruments Directive">
      <data key="d0">Non-Automatic Weighing Instruments Directive</data>
      <data key="d1">event</data>
      <data key="d2">The Directive on Non-Automatic Weighing Instruments includes regulations that ensure the accuracy and compliance of weighing devices used in transactions in the EU.</data>
      <data key="d3">chunk-557acf7764c3014cc0e27cf73b9a0fb0</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d5">1748428543</data>
    </node>
    <node id="Regulation on High-Risk AI Systems">
      <data key="d0">Regulation on High-Risk AI Systems</data>
      <data key="d1">category</data>
      <data key="d2">The Regulation on High-Risk AI Systems outlines the procedures for assessing conformity in AI systems deemed high-risk, suggesting a mix of self-assessment and third-party evaluation.</data>
      <data key="d3">chunk-3477a6053ebda4f7122ba6adc497a9ee</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/125/</data>
      <data key="d5">1748428546</data>
    </node>
    <node id="Third-Party Conformity Assessment">
      <data key="d0">Third-Party Conformity Assessment</data>
      <data key="d1">category</data>
      <data key="d2">Third-party conformity assessment refers to the evaluation process conducted by independent bodies to ensure compliance with safety and risk standards for high-risk AI systems.</data>
      <data key="d3">chunk-3477a6053ebda4f7122ba6adc497a9ee</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/125/</data>
      <data key="d5">1748428546</data>
    </node>
    <node id="Professional Pre-Market Certifiers">
      <data key="d0">Professional Pre-Market Certifiers</data>
      <data key="d1">organization</data>
      <data key="d2">Professional pre-market certifiers are organizations that evaluate products for safety before they reach the market, relevant in the context of AI system assessments.</data>
      <data key="d3">chunk-3477a6053ebda4f7122ba6adc497a9ee</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/125/</data>
      <data key="d5">1748428546</data>
    </node>
    <node id="Biometric AI Systems">
      <data key="d0">Biometric AI Systems</data>
      <data key="d1">category</data>
      <data key="d2">Biometric AI systems are a specific category of AI systems that require adherence to stricter conformity assessments due to their potential risks.</data>
      <data key="d3">chunk-3477a6053ebda4f7122ba6adc497a9ee</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/125/</data>
      <data key="d5">1748428546</data>
    </node>
    <node id="Product Safety">
      <data key="d0">Product Safety</data>
      <data key="d1">category</data>
      <data key="d2">Product Safety encompasses the measures and standards that ensure that products, including AI systems, do not pose harm to users.</data>
      <data key="d3">chunk-3477a6053ebda4f7122ba6adc497a9ee</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/125/</data>
      <data key="d5">1748428546</data>
    </node>
    <node id="Union Ethical Guidelines for Trustworthy AI">
      <data key="d0">Union Ethical Guidelines for Trustworthy AI</data>
      <data key="d1">category</data>
      <data key="d2">Union Ethical Guidelines for Trustworthy AI refers to the established principles and standards aimed at ensuring ethical practices in AI system development and use.</data>
      <data key="d3">chunk-30361d2283908d9b7babf63ae110a691</data>
      <data key="d4">https://artificialintelligenceact.eu/article/95/</data>
      <data key="d5">1748428563</data>
    </node>
    <node id="Codes of Conduct">
      <data key="d0">Codes of Conduct</data>
      <data key="d1">category</data>
      <data key="d2">Codes of Conduct are guidelines developed to ensure ethical practices in the deployment and use of AI systems, addressing the interests of various stakeholders.&lt;SEP&gt;Codes of Conduct serve as guidelines for the ethical and responsible deployment of AI systems, targeting non-high-risk systems to ensure their compliance with established principles and best practices.</data>
      <data key="d3">chunk-30361d2283908d9b7babf63ae110a691&lt;SEP&gt;chunk-2bf6ae679199f6853488d22af6ebdf75</data>
      <data key="d4">https://artificialintelligenceact.eu/article/95/</data>
      <data key="d5">1748428563</data>
    </node>
    <node id="Industry Best Practices">
      <data key="d0">Industry Best Practices</data>
      <data key="d1">category</data>
      <data key="d2">Industry Best Practices denote recognized standards and methodologies followed by organizations and developers to ensure the ethical application of AI technologies.</data>
      <data key="d3">chunk-30361d2283908d9b7babf63ae110a691</data>
      <data key="d4">https://artificialintelligenceact.eu/article/95/</data>
      <data key="d5">1748428563</data>
    </node>
    <node id="Clear Objectives and Key Performance Indicators">
      <data key="d0">Clear Objectives and Key Performance Indicators</data>
      <data key="d1">category</data>
      <data key="d2">Clear Objectives and Key Performance Indicators are metrics used to measure the success and adherence to the codes of conduct for AI systems.</data>
      <data key="d3">chunk-30361d2283908d9b7babf63ae110a691</data>
      <data key="d4">https://artificialintelligenceact.eu/article/95/</data>
      <data key="d5">1748428563</data>
    </node>
    <node id="Article 21(6)">
      <data key="d0">Article 21(6)</data>
      <data key="d1">category</data>
      <data key="d2">Article 21(6) outlines tasks and responsibilities for designated Union AI testing support structures regarding AI compliance within the regulation.</data>
      <data key="d3">chunk-4825b8c430847477f9ab6dc8f1b19797</data>
      <data key="d4">https://artificialintelligenceact.eu/article/84/</data>
      <data key="d5">1748428580</data>
    </node>
    <node id="Article 17(5)">
      <data key="d0">Article 17(5)</data>
      <data key="d1">event</data>
      <data key="d2">Article 17(5) is a subsection of Regulation (EU) No 167/2013, which includes provisions for adopting delegated acts concerning artificial intelligence systems.</data>
      <data key="d3">chunk-79114aa8214caf01a991b9fd731ca2f1</data>
      <data key="d4">https://artificialintelligenceact.eu/article/103/</data>
      <data key="d5">1748428583</data>
    </node>
    <node id="Validity Periods">
      <data key="d0">Validity Periods</data>
      <data key="d1">category</data>
      <data key="d2">Validity periods refer to the predefined durations, as established in the regulations, for which certificates for AI systems remain effective.</data>
      <data key="d3">chunk-b65d9e388dd47f8c8604a909fc7bfa39</data>
      <data key="d4">https://artificialintelligenceact.eu/article/44/</data>
      <data key="d5">1748428597</data>
    </node>
    <node id="Compliance Assessment Procedures">
      <data key="d0">Compliance Assessment Procedures</data>
      <data key="d1">category</data>
      <data key="d2">Compliance assessment procedures are the processes by which notified bodies evaluate whether AI systems meet the necessary requirements for certification.</data>
      <data key="d3">chunk-b65d9e388dd47f8c8604a909fc7bfa39</data>
      <data key="d4">https://artificialintelligenceact.eu/article/44/</data>
      <data key="d5">1748428597</data>
    </node>
    <node id="Provider of the System">
      <data key="d0">Provider of the System</data>
      <data key="d1">person</data>
      <data key="d2">The provider of the system is the entity responsible for ensuring AI systems comply with regulations and for taking corrective actions if necessary.</data>
      <data key="d3">chunk-b65d9e388dd47f8c8604a909fc7bfa39</data>
      <data key="d4">https://artificialintelligenceact.eu/article/44/</data>
      <data key="d5">1748428597</data>
    </node>
    <node id="Conformity Certificates">
      <data key="d0">Conformity Certificates</data>
      <data key="d1">category</data>
      <data key="d2">Conformity Certificates are documents issued by notified bodies to indicate that a product meets certain regulatory standards and requirements.</data>
      <data key="d3">chunk-f0b135294c63adb38cabe2c028de2021</data>
      <data key="d4">https://artificialintelligenceact.eu/article/44/</data>
      <data key="d5">1748428597</data>
    </node>
    <node id="Regulatory Standards">
      <data key="d0">Regulatory Standards</data>
      <data key="d1">category</data>
      <data key="d2">Regulatory Standards refer to the set of guidelines and criteria that products must meet to ensure safety and compliance within specific industries.</data>
      <data key="d3">chunk-f0b135294c63adb38cabe2c028de2021</data>
      <data key="d4">https://artificialintelligenceact.eu/article/44/</data>
      <data key="d5">1748428597</data>
    </node>
    <node id="Regulation on AI Systems">
      <data key="d0">Regulation on AI Systems</data>
      <data key="d1">organization</data>
      <data key="d2">The Regulation on AI Systems refers to a legal framework governing the use and processing of AI technologies, particularly in publicly accessible spaces for law enforcement purposes.</data>
      <data key="d3">chunk-b477112713d917a03ba6f595ed62f6c7</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/38/</data>
      <data key="d5">1748428606</data>
    </node>
    <node id="Transparency Measures">
      <data key="d0">Transparency Measures</data>
      <data key="d1">category</data>
      <data key="d2">Transparency measures involve regulations that require thorough documentation and disclosure of AI models to ensure their responsible use and compliance with standards.</data>
      <data key="d3">chunk-46a2185c0e7d022c2e0146a9f59929c2</data>
