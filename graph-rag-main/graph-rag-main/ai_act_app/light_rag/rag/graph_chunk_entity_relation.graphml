      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Discriminatory Effects" target="Technical Inaccuracies">
      <data key="d6">7.0</data>
      <data key="d7">Technical inaccuracies in AI systems may lead to discriminatory effects against certain groups based on biometric analysis.</data>
      <data key="d8">bias,technical errors</data>
