      <data key="d10">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d11">1748428214</data>
    </edge>
    <edge source="AI System" target="Data Minimisation">
      <data key="d6">8.0</data>
      <data key="d7">The principle of data minimisation is essential for ensuring that AI systems only process necessary personal data.</data>
