      <data key="d11">1748426654</data>
    </edge>
    <edge source="Testing in Real-World Conditions" target="Informed Consent">
      <data key="d6">9.0</data>
      <data key="d7">Informed consent is critical for ethical testing in real-world conditions to protect the rights of participants.</data>
      <data key="d8">ethics,participant protection</data>
