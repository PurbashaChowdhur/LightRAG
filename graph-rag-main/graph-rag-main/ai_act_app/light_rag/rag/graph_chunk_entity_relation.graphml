      <data key="d10">https://artificialintelligenceact.eu/recital/127/</data>
      <data key="d11">1748426255</data>
    </edge>
    <edge source="Commission" target="Committee">
      <data key="d6">8.0</data>
      <data key="d7">The Committee assists the Commission as stipulated in the EU regulations.</data>
