      <data key="d10">https://artificialintelligenceact.eu/recital/33/</data>
      <data key="d11">1748427083</data>
    </edge>
    <edge source="Critical Infrastructure" target="Monitoring Systems">
      <data key="d6">10.0</data>
      <data key="d7">Monitoring Systems are essential for ensuring the operability and safety of Critical Infrastructure components.</data>
      <data key="d8">operational integrity,safety oversight</data>
      <data key="d9">chunk-194a93e438ef6e42d5b44a136147cfaf</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/55/</data>
      <data key="d11">1748427181</data>
    </edge>
    <edge source="Critical Infrastructure" target="Risk Management">
      <data key="d6">10.0</data>
      <data key="d7">Effective risk management is essential for protecting critical infrastructure from various threats including bias, discrimination, and disinformation.</data>
      <data key="d8">proactive protection,safety measures</data>
      <data key="d9">chunk-ff9241c3a9f5f8fc78557cf5705c8c73</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/110/</data>
      <data key="d11">1748428200</data>
    </edge>
    <edge source="Directive (EU) 2022/2557" target="Recital 97">
      <data key="d6">8.0</data>
      <data key="d7">Recital 97 is included in the Directive and serves to explain the reasoning behind regulations on general-purpose AI models.</data>
