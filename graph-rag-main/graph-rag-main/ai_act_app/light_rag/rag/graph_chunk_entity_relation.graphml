    </edge>
    <edge source="AI Systems" target="Public Safety">
      <data key="d6">8.0</data>
      <data key="d7">AI Systems developed in the sandbox are aimed at enhancing Public Safety by addressing risks and improving responses to emergencies.</data>
      <data key="d8">safety,technology</data>
      <data key="d9">chunk-c0011a0d9e3a2637e314c176ed0dc26c</data>
      <data key="d10">https://artificialintelligenceact.eu/article/59/</data>
      <data key="d11">1748426294</data>
    </edge>
    <edge source="AI Systems" target="Public Health">
      <data key="d6">8.0</data>
      <data key="d7">The AI Systems may also focus on improving Public Health outcomes through disease detection and treatment innovations.</data>
      <data key="d8">healthcare,technology</data>
      <data key="d9">chunk-c0011a0d9e3a2637e314c176ed0dc26c</data>
      <data key="d10">https://artificialintelligenceact.eu/article/59/</data>
      <data key="d11">1748426294</data>
    </edge>
    <edge source="AI Systems" target="Energy Sustainability">
      <data key="d6">7.0</data>
      <data key="d7">AI Systems can contribute to Energy Sustainability by optimizing energy usage and promoting cleaner technologies.</data>
      <data key="d8">energy management,sustainability</data>
      <data key="d9">chunk-c0011a0d9e3a2637e314c176ed0dc26c</data>
      <data key="d10">https://artificialintelligenceact.eu/article/59/</data>
      <data key="d11">1748426294</data>
    </edge>
    <edge source="AI Systems" target="Climate Change Mitigation">
      <data key="d6">7.0</data>
      <data key="d7">The development of AI Systems can assist in Climate Change Mitigation efforts by providing data-driven insights for better resource management.</data>
      <data key="d8">climate action,environment</data>
      <data key="d9">chunk-c0011a0d9e3a2637e314c176ed0dc26c</data>
      <data key="d10">https://artificialintelligenceact.eu/article/59/</data>
      <data key="d11">1748426294</data>
    </edge>
    <edge source="AI Systems" target="Personal Data">
      <data key="d6">7.0</data>
      <data key="d7">AI systems often utilize personal data to function effectively, raising issues of privacy and compliance with data protection regulations.</data>
      <data key="d8">data utilization,technology and privacy</data>
      <data key="d9">chunk-1c8c5c853ef5b667f9cd6deb981812e1</data>
      <data key="d10">https://artificialintelligenceact.eu/article/59/</data>
      <data key="d11">1748426294</data>
    </edge>
    <edge source="AI Systems" target="Technical Robustness">
      <data key="d6">9.0</data>
      <data key="d7">Technical robustness is essential for AI systems to mitigate risks and ensure their reliability in high-risk situations.</data>
      <data key="d8">risk management,system reliability</data>
      <data key="d9">chunk-808684c852275ce6793d894fcdacfe17</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/75/</data>
