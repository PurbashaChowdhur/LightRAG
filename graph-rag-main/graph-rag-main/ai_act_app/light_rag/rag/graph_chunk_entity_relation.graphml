      <data key="d10">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d11">1748428325</data>
    </edge>
    <edge source="Member State" target="European Standardisation Organisation">
      <data key="d6">7.0</data>
      <data key="d7">Member States inform the European Standardisation Organisation if they have concerns about common specifications, impacting standard development.</data>
      <data key="d8">regulatory compliance,standardisation</data>
      <data key="d9">chunk-2ae5c70e1b98b5f33eb047bb55022e9d</data>
      <data key="d10">https://artificialintelligenceact.eu/article/41/</data>
      <data key="d11">1748428452</data>
    </edge>
    <edge source="Member State" target="National Measure">
      <data key="d6">6.0</data>
      <data key="d7">National measures represent actions taken by Member States to manage and regulate AI systems in their jurisdictions.</data>
      <data key="d8">governmental action,regulatory measures</data>
