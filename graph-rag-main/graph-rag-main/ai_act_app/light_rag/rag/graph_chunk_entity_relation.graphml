    <edge source="Directive (EU) 2016/680" target="Council of the European Union">
      <data key="d6">8.0</data>
      <data key="d7">The Council of the European Union collaborates with the European Parliament in the formulation and adoption of EU directives like Directive (EU) 2016/680.</data>
      <data key="d8">decision-making,legislative collaboration</data>
      <data key="d9">chunk-6ebb4e641a55d31b962b56d6017d2734</data>
