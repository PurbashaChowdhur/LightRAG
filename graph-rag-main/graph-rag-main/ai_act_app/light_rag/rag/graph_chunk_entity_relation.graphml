      <data key="d10">https://artificialintelligenceact.eu/recital/120/</data>
      <data key="d11">1748426129</data>
    </edge>
    <edge source="Systemic Risks" target="Disinformation">
      <data key="d6">7.0</data>
      <data key="d7">Disinformation is a key concern under Systemic Risks as it can undermine democratic processes and civic discourse.</data>
      <data key="d8">information integrity,societal impact</data>
      <data key="d9">chunk-6012d8db7105015b96b93aa82ad47129</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/120/</data>
      <data key="d11">1748426129</data>
    </edge>
    <edge source="Systemic Risks" target="AI Models">
      <data key="d6">9.0</data>
      <data key="d7">AI Models present systemic risks as their implementation and proliferation can impact various aspects of society and the economy, potentially leading to adverse consequences.</data>
