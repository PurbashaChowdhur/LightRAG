      <data key="d10">https://artificialintelligenceact.eu/article/3/&lt;SEP&gt;https://artificialintelligenceact.eu/article/49/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Provider" target="AI Office">
      <data key="d6">8.0</data>
      <data key="d7">The AI Office requires providers to report on the classification of AI models and their potential risks to ensure regulatory compliance.</data>
