    </edge>
    <edge source="Biometric Data" target="Biometric Categorisation System">
      <data key="d6">8.0</data>
      <data key="d7">A biometric categorization system uses biometric data to assign individuals to specific categories for purposes of analysis or recognition.</data>
      <data key="d8">analysis,categorization</data>
      <data key="d9">chunk-de448579f0f397ec535d8acdb68580bc</data>
