    </edge>
    <edge source="AI Office" target="Article 53">
      <data key="d6">6.0</data>
      <data key="d7">Article 53 outlines obligations that the AI Office may require general-purpose AI model providers to follow.</data>
      <data key="d8">AI regulation,obligation framework</data>
      <data key="d9">chunk-ec36ff3483a4dfeb40db5ce54ff19937</data>
      <data key="d10">https://artificialintelligenceact.eu/article/56/</data>
      <data key="d11">1748426363</data>
    </edge>
    <edge source="AI Office" target="AI Models">
      <data key="d6">9.0</data>
      <data key="d7">The AI Office oversees the adherence of providers to codes of practice for AI Models within the Union.</data>
      <data key="d8">compliance,regulatory oversight</data>
