      <data key="d10">https://artificialintelligenceact.eu/recital/139/</data>
      <data key="d11">1748426013</data>
    </edge>
    <edge source="providers" target="notified bodies">
      <data key="d6">7.0</data>
      <data key="d7">Providers work with notified bodies to ensure that their products meet the necessary standards for market entry.</data>
