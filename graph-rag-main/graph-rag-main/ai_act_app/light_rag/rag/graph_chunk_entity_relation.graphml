      <data key="d10">https://artificialintelligenceact.eu/recital/179/</data>
      <data key="d11">1748426328</data>
    </edge>
    <edge source="Regulation" target="Governance and Enforcement">
      <data key="d6">9.0</data>
      <data key="d7">The Governance and Enforcement structures outlined in the Regulation are crucial for managing AI's impact.</data>
