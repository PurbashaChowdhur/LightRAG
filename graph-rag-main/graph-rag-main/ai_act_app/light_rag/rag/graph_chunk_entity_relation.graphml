      <data key="d11">1748428455</data>
    </edge>
    <edge source="Advisory Forum" target="Meetings">
      <data key="d6">10.0</data>
      <data key="d7">The advisory forum holds meetings at least twice a year to discuss regulatory objectives and gather input from stakeholders.</data>
