      <data key="d10">https://artificialintelligenceact.eu/article/22/</data>
      <data key="d11">1748426763</data>
    </edge>
    <edge source="market surveillance authority" target="provider">
      <data key="d6">8.0</data>
      <data key="d7">The provider must comply with the Regulation as monitored by the market surveillance authority.</data>
      <data key="d8">oversight,regulatory compliance</data>
      <data key="d9">chunk-442777921e9a3bd01b79336245710651</data>
      <data key="d10">https://artificialintelligenceact.eu/article/22/</data>
      <data key="d11">1748426763</data>
    </edge>
    <edge source="market surveillance authority" target="AI system">
      <data key="d6">8.0</data>
      <data key="d7">The market surveillance authority oversees the AI system, ensuring that it complies with relevant regulations and testing standards.</data>
      <data key="d8">oversight,regulation</data>
