    </edge>
    <edge source="The Commission" target="Business Organizations">
      <data key="d6">6.0</data>
      <data key="d7">Business organizations may collaborate with The Commission to develop voluntary codes of conduct and improve industry standards.</data>
      <data key="d8">collaboration,industry standards</data>
      <data key="d9">chunk-b68a8b56a88e15576658c21fedd417e3</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/165/</data>
      <data key="d11">1748427139</data>
    </edge>
    <edge source="The Commission" target="Civil Society Organizations">
      <data key="d6">7.0</data>
      <data key="d7">Civil society organizations may work with The Commission to ensure that voluntary codes of conduct reflect community values and ethics.</data>
      <data key="d8">community engagement,ethical standards</data>
