      <data key="d10">https://artificialintelligenceact.eu/recital/63/</data>
      <data key="d11">1748425977</data>
    </edge>
    <edge source="AI System" target="Union Law">
      <data key="d6">26.0</data>
      <data key="d7">AI systems are subject to Union Law, particularly regarding their safety and compliance with rights.".&lt;SEP&gt;AI systems must comply with union law regarding privacy, data protection, and non-discrimination.&lt;SEP&gt;The risks posed by AI systems must be assessed according to provisions in Union Law to ensure protection of health and rights.</data>
      <data key="d8">compliance,ethical governance,regulated practices,regulatory compliance,risk assessment</data>
      <data key="d9">chunk-219c0f42877791608631c01683c4dad5&lt;SEP&gt;chunk-bfc478de6f2db42158f4375b3746b2a3&lt;SEP&gt;chunk-1b4365b37f348c4492d16b0258db2b4a</data>
      <data key="d10">https://artificialintelligenceact.eu/article/7/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/27/</data>
      <data key="d11">1748426070</data>
    </edge>
    <edge source="AI System" target="Civil Society">
      <data key="d6">8.0</data>
      <data key="d7">Civil society advocates for the ethical development of AI systems that promote human welfare and avoid discrimination.</data>
      <data key="d8">ethical advocacy,social impact</data>
      <data key="d9">chunk-219c0f42877791608631c01683c4dad5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/27/</data>
      <data key="d11">1748425994</data>
    </edge>
    <edge source="AI System" target="Industry">
      <data key="d6">9.0</data>
      <data key="d7">The industry is responsible for developing AI systems that adhere to ethical standards and guidelines.</data>
      <data key="d8">development responsibility,ethical compliance</data>
      <data key="d9">chunk-219c0f42877791608631c01683c4dad5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/27/</data>
      <data key="d11">1748425994</data>
    </edge>
    <edge source="AI System" target="Academia">
      <data key="d6">8.0</data>
      <data key="d7">Academia contributes research and insights that shape the ethical frameworks guiding AI system design.</data>
      <data key="d8">ethical framework,research contribution</data>
      <data key="d9">chunk-219c0f42877791608631c01683c4dad5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/27/</data>
      <data key="d11">1748425994</data>
    </edge>
    <edge source="AI System" target="Standardisation Organisations">
      <data key="d6">9.0</data>
      <data key="d7">Standardisation organisations help define and implement ethical standards for the development of AI systems.</data>
      <data key="d8">ethical guidelines,standards development</data>
      <data key="d9">chunk-219c0f42877791608631c01683c4dad5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/27/</data>
      <data key="d11">1748425994</data>
    </edge>
    <edge source="AI System" target="Transparency">
      <data key="d6">8.0</data>
      <data key="d7">Transparency is a key principle for how AI systems are developed and used, promoting user awareness and informed consent.</data>
      <data key="d8">informed consent,user awareness</data>
      <data key="d9">chunk-219c0f42877791608631c01683c4dad5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/27/</data>
      <data key="d11">1748425994</data>
    </edge>
    <edge source="AI System" target="Fairness">
      <data key="d6">10.0</data>
      <data key="d7">Fairness ensures that AI systems operate without bias, promoting just outcomes for users.</data>
      <data key="d8">equitable treatment,unbiased outcomes</data>
      <data key="d9">chunk-219c0f42877791608631c01683c4dad5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/27/</data>
      <data key="d11">1748425994</data>
    </edge>
    <edge source="AI System" target="Stakeholders">
      <data key="d6">7.0</data>
      <data key="d7">Stakeholders are crucial in the development of AI systems, offering insights and advocating for ethical standards.</data>
      <data key="d8">collaboration,ethical advocacy</data>
      <data key="d9">chunk-219c0f42877791608631c01683c4dad5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/27/</data>
      <data key="d11">1748425994</data>
    </edge>
    <edge source="AI System" target="Social and Environmental Well-Being">
      <data key="d6">9.0</data>
      <data key="d7">Social and environmental well-being guidelines seek to ensure AI development is sustainable and beneficial to society.</data>
      <data key="d8">societal good,sustainability</data>
      <data key="d9">chunk-219c0f42877791608631c01683c4dad5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/27/</data>
      <data key="d11">1748425994</data>
    </edge>
    <edge source="AI System" target="Market Surveillance Authority">
      <data key="d6">26.0</data>
      <data key="d7">Market Surveillance Authorities check compliance of AI systems with regulations to ensure public safety and proper classification.&lt;SEP&gt;The Market Surveillance Authority evaluates AI systems to determine if they have been correctly classified based on their risk level.&lt;SEP&gt;The Market Surveillance Authority oversees the compliance of AI systems with regulations and enforces corrective actions if necessary.</data>
      <data key="d8">compliance enforcement,compliance oversight,evaluation,regulatory authority,regulatory compliance,regulatory oversight</data>
      <data key="d9">chunk-e60a602cb4413f08687b677f68eb970c&lt;SEP&gt;chunk-893f47aa930b4d23e13586827fdcfea9&lt;SEP&gt;chunk-698242b390a097d688dcef4fc03d6687</data>
      <data key="d10">https://artificialintelligenceact.eu/article/80/&lt;SEP&gt;https://artificialintelligenceact.eu/article/79/</data>
      <data key="d11">1748426903</data>
    </edge>
    <edge source="AI System" target="Article 6(3)">
      <data key="d6">10.0</data>
      <data key="d7">Article 6(3) provides the guidelines for classifying AI systems as high-risk or non-high-risk based on their use cases and contexts.</data>
      <data key="d8">classification criteria,regulatory guidance</data>
      <data key="d9">chunk-893f47aa930b4d23e13586827fdcfea9</data>
      <data key="d10">https://artificialintelligenceact.eu/article/80/</data>
      <data key="d11">1748426004</data>
    </edge>
    <edge source="AI System" target="Provider">
      <data key="d6">42.0</data>
      <data key="d7">"The Provider is responsible for placing the AI System on the market and must comply with the Regulation regarding its status.")&lt;SEP&gt;Provider supplies an AI system or general-purpose AI model and assumes responsibility for its deployment.&lt;SEP&gt;Providers of AI systems are required to ensure compliance with regulatory requirements for these systems in the market.&lt;SEP&gt;The provider is responsible for specifying the intended purpose and uses of the AI system they supply.&lt;SEP&gt;The provider is responsible for the development and testing of the AI system under specific protocols.</data>
      <data key="d8">compliance,compliance responsibility,product development,product specifications,regulation adherence,regulatory compliance,regulatory responsibility,responsibility,supply chain</data>
      <data key="d9">chunk-3d21ee76ebe03dd794f42225c64861fb&lt;SEP&gt;chunk-e60a602cb4413f08687b677f68eb970c&lt;SEP&gt;chunk-18590180ace1a86abda373a524de5d70&lt;SEP&gt;chunk-bb293bcc156cb87ef4a7db6744a38f0d&lt;SEP&gt;chunk-63b7f62ee5f6ce97705b963caea85497</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/&lt;SEP&gt;https://artificialintelligenceact.eu/article/80/&lt;SEP&gt;https://artificialintelligenceact.eu/article/60/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/86/</data>
      <data key="d11">1748428325</data>
    </edge>
    <edge source="AI System" target="General-Purpose AI Model">
      <data key="d6">17.0</data>
      <data key="d7">A general-purpose AI model can be integrated into an AI system, allowing it to function in various roles or purposes.&lt;SEP&gt;An AI system can be a general-purpose AI model, designed for various applications in multiple contexts.</data>
      <data key="d8">flexibility,functionality,integration,versatility</data>
      <data key="d9">chunk-63b7f62ee5f6ce97705b963caea85497&lt;SEP&gt;chunk-c99635d8be9520a61f07475e6f38b608</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/100/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="AI System" target="Integration">
      <data key="d6">8.0</data>
      <data key="d7">AI systems undergo integration to combine multiple models into a cohesive and efficient unit that can perform diverse tasks.</data>
      <data key="d8">model cooperation,system enhancement</data>
      <data key="d9">chunk-c99635d8be9520a61f07475e6f38b608</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/100/</data>
      <data key="d11">1748426062</data>
    </edge>
    <edge source="AI System" target="National Competent Authorities">
      <data key="d6">28.0</data>
      <data key="d7">"The National Competent Authorities are tasked with endorsing and providing guidance for the implementation of AI Systems within the remit of Union Law.")&lt;SEP&gt;National Competent Authorities gather reports on the impacts of AI systems to evaluate risks to health and safety.&lt;SEP&gt;National competent authorities are responsible for ensuring that AI systems comply with regulations to mitigate potential risks.</data>
      <data key="d8">guidance on technology,oversight,regulatory enforcement,risk management,supervisory role</data>
      <data key="d9">chunk-1b88de119a362d1ff7d1500b9782d0c6&lt;SEP&gt;chunk-bfc478de6f2db42158f4375b3746b2a3&lt;SEP&gt;chunk-294c88b41db00dcd8f4482345b658105</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/53/&lt;SEP&gt;https://artificialintelligenceact.eu/article/7/&lt;SEP&gt;https://artificialintelligenceact.eu/article/70/</data>
      <data key="d11">1748428525</data>
    </edge>
    <edge source="AI System" target="Health and Safety">
      <data key="d6">19.0</data>
      <data key="d7">AI Systems must be regulated to mitigate risks to Health and Safety, ensuring users are protected from harm.&lt;SEP&gt;AI systems are related to health and safety as they can lead to various implications that need to be managed in order to ensure the safety of individuals.</data>
      <data key="d8">regulation,risk management,safety,technology impact</data>
      <data key="d9">chunk-414a5bbdb827f9d405cd31cc218f4ee9&lt;SEP&gt;chunk-bfc478de6f2db42158f4375b3746b2a3</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/48/&lt;SEP&gt;https://artificialintelligenceact.eu/article/7/</data>
      <data key="d11">1748426876</data>
    </edge>
    <edge source="AI System" target="Fundamental Rights">
      <data key="d6">9.0</data>
      <data key="d7">The deployment of AI Systems can impact Fundamental Rights, requiring legal oversight to protect individual freedoms.</data>
      <data key="d8">human rights,regulatory compliance</data>
      <data key="d9">chunk-bfc478de6f2db42158f4375b3746b2a3</data>
      <data key="d10">https://artificialintelligenceact.eu/article/7/</data>
      <data key="d11">1748426070</data>
    </edge>
    <edge source="AI System" target="High-Risk AI Systems">
      <data key="d6">8.0</data>
      <data key="d7">Certain AI systems may be classified as high-risk, necessitating additional scrutiny under Union law.</data>
      <data key="d8">classification,risk assessment</data>
      <data key="d9">chunk-1b4365b37f348c4492d16b0258db2b4a</data>
      <data key="d10">https://artificialintelligenceact.eu/article/7/</data>
      <data key="d11">1748426070</data>
    </edge>
    <edge source="AI System" target="Civilian Purposes">
      <data key="d6">9.0</data>
      <data key="d7">AI systems for civilian purposes must comply with the Regulation managing their use.</data>
      <data key="d8">civilian use,regulation</data>
      <data key="d9">chunk-f89272eea67d32d6ca0a58d004c2f75e</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/24/</data>
      <data key="d11">1748426212</data>
    </edge>
    <edge source="AI System" target="Law Enforcement">
      <data key="d6">8.0</data>
      <data key="d7">Law enforcement agencies utilize AI systems in their operations, which are also subject to the Regulation's compliance standards.</data>
      <data key="d8">AI application,law enforcement</data>
      <data key="d9">chunk-f89272eea67d32d6ca0a58d004c2f75e</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/24/</data>
      <data key="d11">1748426212</data>
    </edge>
    <edge source="AI System" target="Military Purposes">
      <data key="d6">7.0</data>
      <data key="d7">Military purposes can allow for the use of AI systems that may not conform to typical regulatory frameworks.</data>
      <data key="d8">military use,regulatory exclusion</data>
      <data key="d9">chunk-f89272eea67d32d6ca0a58d004c2f75e</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/24/</data>
      <data key="d11">1748426212</data>
    </edge>
    <edge source="AI System" target="Deep Fakes">
      <data key="d6">9.0</data>
      <data key="d7">AI systems are responsible for creating deep fakes by manipulating media content to resemble real entities or events.</data>
      <data key="d8">content creation,technology application</data>
