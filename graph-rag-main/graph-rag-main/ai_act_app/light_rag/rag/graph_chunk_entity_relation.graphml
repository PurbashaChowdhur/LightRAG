      <data key="d10">https://artificialintelligenceact.eu/recital/97/</data>
      <data key="d11">1748426054</data>
    </edge>
    <edge source="Regulation" target="model">
      <data key="d6">8.0</data>
      <data key="d7">The Regulation discusses obligations that must be followed when a model is placed on the market, ensuring accountability for its deployment.</data>
