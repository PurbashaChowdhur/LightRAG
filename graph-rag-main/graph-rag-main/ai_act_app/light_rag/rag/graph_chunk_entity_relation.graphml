    <edge source="High-Risk AI System" target="Risk Assessment">
      <data key="d6">10.0</data>
      <data key="d7">Conducting risk assessments is a crucial requirement for deploying high-risk AI systems to ensure safety and compliance.</data>
      <data key="d8">assessment obligation,risk management</data>
