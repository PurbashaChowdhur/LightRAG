      <data key="d11">1748427609</data>
    </edge>
    <edge source="high-risk AI system" target="natural persons">
      <data key="d6">18.0</data>
      <data key="d7">High-risk AI systems are evaluated based on their potential impact on the rights and safety of natural persons.&lt;SEP&gt;Natural persons are responsible for overseeing high-risk AI systems to monitor performance and address potential issues.</data>
      <data key="d8">impact on rights,monitoring,oversight,safety concerns</data>
      <data key="d9">chunk-d3235710f8867a0e47878a2233118ed9&lt;SEP&gt;chunk-550dce9dde15c8e156ca0acc92343929</data>
