      <data key="d10">https://artificialintelligenceact.eu/recital/112/</data>
      <data key="d11">1748426552</data>
    </edge>
    <edge source="Regulation" target="AI systems and models">
      <data key="d6">8.0</data>
      <data key="d7">The Regulation defines the legal framework for the development and commercialization of AI systems and models, emphasizing their role in scientific research.</data>
      <data key="d8">innovation,regulation,scientific research</data>
      <data key="d9">chunk-9ab6fc5c923f500a88ff985caeb05f2b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/25/</data>
      <data key="d11">1748426554</data>
    </edge>
    <edge source="Regulation" target="Union law">
      <data key="d6">9.0</data>
      <data key="d7">The Regulation must be conducted in accordance with Union law, ensuring compliance and ethical standards in AI research and development.</data>
