      <data key="d11">1748427363</data>
    </edge>
    <edge source="AI Regulatory Sandboxes" target="The Board">
      <data key="d6">8.0</data>
      <data key="d7">The Board contributes to the functioning of AI regulatory sandboxes, allowing Member States to test AI compliance effectively.</data>
      <data key="d8">compliance testing,experimental regulation</data>
