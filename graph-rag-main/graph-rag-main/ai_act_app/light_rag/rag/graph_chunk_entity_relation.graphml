      <data key="d10">https://artificialintelligenceact.eu/recital/179/</data>
      <data key="d11">1748426328</data>
    </edge>
    <edge source="Regulation" target="Application Date">
      <data key="d6">9.0</data>
      <data key="d7">The Application Date signifies when adherence to the provisions of the Regulation becomes mandatory.</data>
