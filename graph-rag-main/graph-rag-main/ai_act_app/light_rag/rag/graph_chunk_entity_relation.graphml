      <data key="d10">https://artificialintelligenceact.eu/recital/114/</data>
      <data key="d11">1748427045</data>
    </edge>
    <edge source="General-Purpose AI Models" target="Systemic Risks">
      <data key="d6">19.0</data>
      <data key="d7">General-purpose AI models are associated with systemic risks that must be assessed and mitigated by their providers.&lt;SEP&gt;The codes of practice aim to address Systemic Risks associated with General-Purpose AI Models, ensuring safe and responsible use.</data>
      <data key="d8">AI deployment,risk management,safety</data>
      <data key="d9">chunk-de9b8f7d9312e3a2994cf6e1b14f1f9e&lt;SEP&gt;chunk-831c946b1acae90a683cbc5ac489ffaf</data>
