      <data key="d0">Scientific Panel Members</data>
      <data key="d1">category</data>
      <data key="d2">Scientific Panel Members are individuals who are part of the Scientific Panel responsible for issuing alerts and performing designated tasks.</data>
      <data key="d3">chunk-e1b5a22fa12a7caf6d6a82166e9ac79b</data>
      <data key="d4">https://artificialintelligenceact.eu/article/68/</data>
