    <node id="Union copyright law">
      <data key="d0">Union copyright law</data>
      <data key="d1">category</data>
      <data key="d2">Union copyright law refers to the legislative framework governing copyright protection within the Union, impacting how AI models operate regarding intellectual property.</data>
      <data key="d3">chunk-994612dc34fa7cbfaae3dc6fdd1036d3</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/108/</data>
      <data key="d5">1748427680</data>
    </node>
    <node id="Copyright Rules">
      <data key="d0">Copyright Rules</data>
      <data key="d1">category</data>
      <data key="d2">Copyright rules are legal standards that protect the rights of creators over their works, which AI models must respect when using content for training.</data>
      <data key="d3">chunk-994612dc34fa7cbfaae3dc6fdd1036d3</data>
      <data key="d4">https://artificialintelligenceact.eu/recital/108/</data>
      <data key="d5">1748427689</data>
    </node>
    <node id="2024">
      <data key="d0">2024</data>
      <data key="d1">category</data>
      <data key="d2">2024 is a year that marks specific legislative developments and regulatory acts within the EU.&lt;SEP&gt;2024 is a year that marks specific legislative developments and regulatory acts within the EU.&lt;SEP&gt;The year 2024 signifies the temporal context pertaining to the legal document referenced.</data>
      <data key="d3">chunk-709fc77dabe05ab003b8d7217d546cdb&lt;SEP&gt;chunk-989b8f3b82689be8b7b178fea223a1b3</data>
