      <data key="d11">1748426283</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Quality Management Systems">
      <data key="d6">9.0</data>
      <data key="d7">High-Risk AI Systems are required to incorporate Quality Management Systems to ensure compliance with safety standards.</data>
      <data key="d8">quality assurance,system compliance</data>
