      <data key="d11">1748428053</data>
    </edge>
    <edge source="General-Purpose AI Models" target="Third Parties">
      <data key="d6">6.0</data>
      <data key="d7">Third parties are not mandated to comply with specific requirements when providing general-purpose AI models, streamlining access and usage.</data>
