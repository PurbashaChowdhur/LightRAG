    </edge>
    <edge source="AI Systems" target="Organizational Measures">
      <data key="d6">8.0</data>
      <data key="d7">Organizational measures are necessary to construct and maintain the necessary environment for ensuring the technical robustness of AI systems.</data>
      <data key="d8">safety protocols,system management</data>
      <data key="d9">chunk-808684c852275ce6793d894fcdacfe17</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/75/</data>
      <data key="d11">1748426297</data>
    </edge>
    <edge source="AI Systems" target="Safety Impacts">
      <data key="d6">9.0</data>
      <data key="d7">Failure to ensure robustness in AI systems can lead to significant safety impacts that affect users and stakeholders.</data>
      <data key="d8">ethical considerations,risk consequences</data>
      <data key="d9">chunk-808684c852275ce6793d894fcdacfe17</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/75/</data>
      <data key="d11">1748426297</data>
    </edge>
    <edge source="AI Systems" target="Conformity Assessment Activities">
      <data key="d6">9.0</data>
      <data key="d7">AI Systems are evaluated through Conformity Assessment Activities to ensure they adhere to regulatory standards.</data>
      <data key="d8">assessment,technology compliance</data>
      <data key="d9">chunk-2b7923bde8b2532e6e5a248aa4cfb8a0</data>
      <data key="d10">https://artificialintelligenceact.eu/article/30/</data>
      <data key="d11">1748426299</data>
    </edge>
    <edge source="AI Systems" target="Regulation on Real-Time Use">
      <data key="d6">8.0</data>
      <data key="d7">The Regulation on ‘Real-Time’ Use establishes rules for AI systems which are designed for functions like identification without delay.</data>
      <data key="d8">compliance,governance</data>
      <data key="d9">chunk-59c64c31df8d81ee8c4452fc69542d83</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/17/</data>
      <data key="d11">1748426309</data>
    </edge>
    <edge source="AI Systems" target="Biometric Data">
      <data key="d6">52.0</data>
      <data key="d7">AI Systems are heavily reliant on Biometric Data for a variety of identification processes, making them integral to biometric identification technology. These systems utilize biometric data not only to perform identification and verification tasks in real-time activities but also to infer emotions, raising concerns regarding reliability and potential discrimination. The processing and analysis of biometric data by AI systems necessitate strict compliance with data protection regulations due to the sensitive nature of the information involved. Overall, AI systems serve a crucial role in the application of biometric data for identification purposes, particularly in enforcement scenarios.</data>
      <data key="d8">AI technology,data ethics,data processing,data utilization,identification,identification technology,technology,technology reliance,technology use</data>
      <data key="d9">chunk-b477112713d917a03ba6f595ed62f6c7&lt;SEP&gt;chunk-3fd24ee33b239cebb25bf3a99d82eb1b&lt;SEP&gt;chunk-3a392041e8bab68fc3cbccc33e333ac7&lt;SEP&gt;chunk-59c64c31df8d81ee8c4452fc69542d83&lt;SEP&gt;chunk-c0c80a9013101dc32f29be5f179a89f1&lt;SEP&gt;chunk-1da6e9cf5fd822e42b8f37d6d2798af0</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/39/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/54/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/94/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/17/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/44/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/38/</data>
      <data key="d11">1748428613</data>
    </edge>
    <edge source="AI Systems" target="Real-Time Identification">
      <data key="d6">9.0</data>
      <data key="d7">Real-Time Identification is a function that relies on AI Systems to achieve instantaneous recognition and processing of data.</data>
      <data key="d8">event function,technology</data>
      <data key="d9">chunk-59c64c31df8d81ee8c4452fc69542d83</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/17/</data>
      <data key="d11">1748426309</data>
    </edge>
    <edge source="AI Systems" target="Live Material">
      <data key="d6">9.0</data>
      <data key="d7">AI Systems utilize Live Material such as real-time video footage for immediate identification and analysis.</data>
      <data key="d8">data input,technology</data>
      <data key="d9">chunk-59c64c31df8d81ee8c4452fc69542d83</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/17/</data>
      <data key="d11">1748426309</data>
    </edge>
    <edge source="AI Systems" target="Post Systems">
      <data key="d6">7.0</data>
      <data key="d7">Post Systems contrast with AI Systems by involving delayed identification processes, thereby highlighting different operational methodologies.</data>
      <data key="d8">process differences,technology</data>
      <data key="d9">chunk-59c64c31df8d81ee8c4452fc69542d83</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/17/</data>
      <data key="d11">1748426309</data>
    </edge>
    <edge source="AI Systems" target="Persons">
      <data key="d6">9.0</data>
      <data key="d7">AI systems can potentially manipulate persons by using techniques that impair their autonomy and decision-making capabilities.</data>
      <data key="d8">autonomy,manipulation</data>
      <data key="d9">chunk-21a89ce17cf59281aee293dc5db92f0b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI Systems" target="Directive 2005/29/EC">
      <data key="d6">7.0</data>
      <data key="d7">Directive 2005/29/EC prohibits unfair practices that may involve AI systems affecting consumers.</data>
      <data key="d8">regulatory scope,unfair practices</data>
      <data key="d9">chunk-65b8417f540a870b55b1e60c66cd42e2</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI Systems" target="person">
      <data key="d6">9.0</data>
      <data key="d7">AI systems can manipulate personal behaviors and decisions, especially impacting individuals in vulnerable positions.</data>
      <data key="d8">impact on individuals,manipulation</data>
      <data key="d9">chunk-65b8417f540a870b55b1e60c66cd42e2</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI Systems" target="Ethnic or Religious Minorities">
      <data key="d6">8.0</data>
      <data key="d7">AI systems may exacerbate risks for ethnic or religious minorities by targeting their vulnerabilities for exploitation.</data>
      <data key="d8">discrimination,exploitation</data>
      <data key="d9">chunk-65b8417f540a870b55b1e60c66cd42e2</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI Systems" target="Extreme Poverty">
      <data key="d6">9.0</data>
      <data key="d7">People living in extreme poverty are at risk of being targeted by AI systems that exploit their vulnerabilities.</data>
      <data key="d8">poverty,vulnerability</data>
      <data key="d9">chunk-65b8417f540a870b55b1e60c66cd42e2</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/29/</data>
      <data key="d11">1748426344</data>
    </edge>
    <edge source="AI Systems" target="Conformity Assessment Procedure">
      <data key="d6">9.0</data>
      <data key="d7">High-risk AI systems must undergo a conformity assessment procedure to ensure they meet established legal standards.</data>
      <data key="d8">regulatory compliance,safety</data>
      <data key="d9">chunk-8d1e54ed74d0a58b519fd1bbf3dc8f50</data>
      <data key="d10">https://artificialintelligenceact.eu/article/43/</data>
      <data key="d11">1748426498</data>
    </edge>
    <edge source="AI Systems" target="Commission">
      <data key="d6">42.0</data>
      <data key="d7">"The Commission oversees the categories and regulations pertaining to AI systems, ensuring compliance and safety standards."}&lt;SEP&gt;The Commission evaluates national measures taken regarding AI systems to determine their justification and communicate decisions.&lt;SEP&gt;The Commission is responsible for promoting the development and regulation of AI Systems to ensure their safety and effectiveness.&lt;SEP&gt;The Commission is involved in providing guidelines on the practical implementation of AI systems and their risk categorization.&lt;SEP&gt;The Commission provides guidelines for the practical implementation of regulations concerning high-risk AI systems.</data>
      <data key="d8">AI governance,AI oversight,decision-making,oversight,regulation,regulatory compliance,regulatory review,technology oversight</data>
      <data key="d9">chunk-9a24148385124cc6a8cba737414c55a6&lt;SEP&gt;chunk-07fb722dbde5159480cfd0e4534fc632&lt;SEP&gt;chunk-6fe20aa0cce0b31f6a43c755317350d6&lt;SEP&gt;chunk-f59c6f62bd0ab2d5521810dcbca8373d&lt;SEP&gt;chunk-37d8a464e00ff30e1ae415351b48c67e</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/53/&lt;SEP&gt;https://artificialintelligenceact.eu/article/6/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/174/&lt;SEP&gt;https://artificialintelligenceact.eu/article/15/&lt;SEP&gt;https://artificialintelligenceact.eu/article/82/</data>
      <data key="d11">1748428525</data>
    </edge>
    <edge source="AI Systems" target="Union Law">
      <data key="d6">33.0</data>
      <data key="d7">Union Law lays out obligations concerning AI Systems to ensure they are used ethically and transparently within workplaces.&lt;SEP&gt;Union Law seeks to regulate AI Systems to prevent discrimination and ensure lawful evaluations of Natural Persons.&lt;SEP&gt;Union law governs the use and implementation of AI systems, particularly in relation to risks associated with personal data and rights.&lt;SEP&gt;Union law provides regulations that categorize certain AI systems as high-risk, influencing their design and implementation.</data>
      <data key="d8">compliance,legal regulation,protection of rights,regulation,regulatory compliance,technology ethics</data>
      <data key="d9">chunk-654b17e6ab435ca442e9075545af0c79&lt;SEP&gt;chunk-cbc4d8b4e0e145ee1cf76386d881919f&lt;SEP&gt;chunk-5eb0d79706d66f4b2474faeded28100a&lt;SEP&gt;chunk-3200d57c186d7db38b0cfb2e5cddca1e</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/9/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/31/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/58/</data>
      <data key="d11">1748427905</data>
    </edge>
    <edge source="AI Systems" target="Social Scoring">
      <data key="d6">10.0</data>
      <data key="d7">AI Systems are the technologies that enable the practice of Social Scoring, influencing how individuals are treated socially.</data>
      <data key="d8">evaluation,technology practice</data>
      <data key="d9">chunk-5eb0d79706d66f4b2474faeded28100a</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/31/</data>
      <data key="d11">1748426591</data>
    </edge>
    <edge source="AI Systems" target="Law Enforcement">
      <data key="d6">7.0</data>
      <data key="d7">Law Enforcement entities may need to implement regulations regarding the use of AI Systems based on their unique requirements.</data>
      <data key="d8">compliance,regulations</data>
      <data key="d9">chunk-7c3bb945919e1b0c6e146fabaaeff87b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/132/</data>
      <data key="d11">1748426601</data>
    </edge>
    <edge source="AI Systems" target="Content Generation Risks">
      <data key="d6">9.0</data>
      <data key="d7">AI Systems may pose Content Generation Risks by generating impersonating or deceptive information.</data>
      <data key="d8">content risk,deception</data>
      <data key="d9">chunk-7c3bb945919e1b0c6e146fabaaeff87b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/132/</data>
      <data key="d11">1748426601</data>
    </edge>
    <edge source="AI Systems" target="Vulnerable Groups">
      <data key="d6">18.0</data>
      <data key="d7">AI Systems must consider the needs of Vulnerable Groups when interacting, ensuring accessibility and protection.&lt;SEP&gt;AI systems can perpetuate biases that negatively affect vulnerable groups, thus highlighting the need for careful data management.</data>
      <data key="d8">accessibility,bias,social impact,user safety</data>
      <data key="d9">chunk-7c3bb945919e1b0c6e146fabaaeff87b&lt;SEP&gt;chunk-d1b1b6d000ef2c2e744936b8e5264e46</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/67/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/132/</data>
      <data key="d11">1748427989</data>
    </edge>
    <edge source="AI Systems" target="AI Literacy">
      <data key="d6">8.0</data>
