      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="downstream provider" target="AI model">
      <data key="d6">8.0</data>
      <data key="d7">Downstream providers utilize various AI models within their systems, allowing for improved functionality and flexibility in applications.</data>
