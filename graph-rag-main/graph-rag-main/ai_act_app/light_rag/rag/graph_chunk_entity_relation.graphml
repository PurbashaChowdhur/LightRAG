      <data key="d10">https://artificialintelligenceact.eu/article/31/</data>
      <data key="d11">1748426852</data>
    </edge>
    <edge source="Notified Bodies" target="Article 78">
      <data key="d6">16.0</data>
      <data key="d7">Notified bodies must comply with the regulations stipulated in Article 78 regarding confidentiality during conformity assessment activities.&lt;SEP&gt;Notified bodies must operate under the guidelines set forth in Article 78 to ensure confidentiality in their assessments.</data>
      <data key="d8">confidentiality,regulatory compliance</data>
