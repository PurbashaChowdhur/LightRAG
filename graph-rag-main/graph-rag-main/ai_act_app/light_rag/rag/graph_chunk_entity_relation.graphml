      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Directive (EU) 2022/2557" target="Recital 99">
      <data key="d6">9.0</data>
      <data key="d7">Recital 99 touches on the societal impact of AI, aligning with the goals of the Directive to safeguard fundamental rights.</data>
