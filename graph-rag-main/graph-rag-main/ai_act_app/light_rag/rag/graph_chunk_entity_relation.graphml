      <data key="d9">chunk-1da6e9cf5fd822e42b8f37d6d2798af0</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/94/</data>
      <data key="d11">1748427441</data>
    </edge>
    <edge source="Directive (EU) 2016/680" target="Market Surveillance Authorities">
      <data key="d6">8.0</data>
      <data key="d7">Market Surveillance Authorities are defined and empowered under Directive (EU) 2016/680 to enforce compliance for data handling and privacy rights.</data>
