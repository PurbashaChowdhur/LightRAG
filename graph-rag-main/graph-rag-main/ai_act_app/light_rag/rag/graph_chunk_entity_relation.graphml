      <data key="d10">https://artificialintelligenceact.eu/recital/170/</data>
      <data key="d11">1748427549</data>
    </edge>
    <edge source="market surveillance authority" target="real-time remote biometric identification system">
      <data key="d6">7.0</data>
      <data key="d7">Market surveillance authorities are notified of the usage of biometric identification systems for law enforcement in order to ensure compliance with market standards.</data>
      <data key="d8">oversight,regulatory compliance</data>
