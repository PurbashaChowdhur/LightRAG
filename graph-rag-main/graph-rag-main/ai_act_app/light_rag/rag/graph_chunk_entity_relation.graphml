      <data key="d9">chunk-0f80477304c8df58e48c2b09ede4a7e2</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="general-purpose AI system" target="AI model">
      <data key="d6">8.0</data>
      <data key="d7">General-purpose AI systems are built upon various AI models, which dictate their behavior and capabilities in processing information.</data>
      <data key="d8">foundation,technology</data>
