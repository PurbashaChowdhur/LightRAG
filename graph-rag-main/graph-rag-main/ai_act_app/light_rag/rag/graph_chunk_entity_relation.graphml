      <data key="d9">chunk-764e9e55c5d7310dcd50b2c3e167eca7</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/30/</data>
      <data key="d11">1748426149</data>
    </edge>
    <edge source="Biometric Data" target="Human Features">
      <data key="d6">8.0</data>
      <data key="d7">Biometric data is derived from human features that are used for automated recognition in identity verification.</data>
      <data key="d8">data source,identity verification</data>
