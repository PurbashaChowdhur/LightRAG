    </edge>
    <edge source="personal data" target="Union data protection law">
      <data key="d6">9.0</data>
      <data key="d7">Union data protection law governs how personal data must be handled and protects the rights of data subjects throughout the data processing lifecycle.</data>
      <data key="d8">compliance,legal framework</data>
