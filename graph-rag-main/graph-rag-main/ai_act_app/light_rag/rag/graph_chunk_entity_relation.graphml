      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="sandbox plan" target="AI regulatory sandbox">
      <data key="d6">17.0</data>
      <data key="d7">The sandbox plan governs the activities and testing conditions within an AI regulatory sandbox, ensuring compliance and safety.&lt;SEP&gt;The sandbox plan outlines specific conditions and objectives for conducting activities in the AI regulatory sandbox, facilitating innovation within a controlled environment.</data>
      <data key="d8">compliance,regulatory framework,testing agreement,testing conditions</data>
      <data key="d9">chunk-df3020e6887a24702cea8a3373082e09&lt;SEP&gt;chunk-f518f21912bc99e646236ef5569a88e9</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="subject" target="informed consent">
      <data key="d6">8.0</data>
      <data key="d7">A subject must provide informed consent before participating in testing to ensure that they are aware of their rights and any potential risks.</data>
      <data key="d8">ethical considerations,rights</data>
      <data key="d9">chunk-f518f21912bc99e646236ef5569a88e9</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="AI Literacy" target="European Artificial Intelligence Board">
      <data key="d6">9.0</data>
      <data key="d7">The European Artificial Intelligence Board promotes AI literacy to educate stakeholders about the benefits and risks associated with AI systems.</data>
      <data key="d8">awareness,education,regulation</data>
      <data key="d9">chunk-553e3df123166674b26c5dc07f2a83af</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/20/</data>
      <data key="d11">1748427293</data>
    </edge>
    <edge source="AI Literacy" target="Affected Persons">
      <data key="d6">9.0</data>
      <data key="d7">AI Literacy aims to equip Affected Persons with the knowledge necessary to understand AI systems that influence their lives.</data>
      <data key="d8">empowerment,understanding</data>
      <data key="d9">chunk-553e3df123166674b26c5dc07f2a83af</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/20/</data>
      <data key="d11">1748427293</data>
    </edge>
    <edge source="AI Literacy" target="Working Conditions">
      <data key="d6">7.0</data>
      <data key="d7">Implementation of AI literacy measures is expected to improve Working Conditions for individuals affected by AI systems.</data>
      <data key="d8">impact,improvement</data>
      <data key="d9">chunk-553e3df123166674b26c5dc07f2a83af</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/20/</data>
      <data key="d11">1748427293</data>
    </edge>
    <edge source="AI Literacy" target="Trustworthy AI">
      <data key="d6">8.0</data>
      <data key="d7">AI Literacy contributes to the development of Trustworthy AI by ensuring compliance with ethical standards and rights.</data>
      <data key="d8">compliance,ethical practices</data>
      <data key="d9">chunk-553e3df123166674b26c5dc07f2a83af</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/20/</data>
      <data key="d11">1748427293</data>
    </edge>
    <edge source="AI Literacy" target="Providers and Deployers of AI Systems">
      <data key="d6">9.0</data>
      <data key="d7">Providers and deployers are tasked with ensuring sufficient AI literacy among staff and users of AI systems.</data>
      <data key="d8">responsibility,training</data>
