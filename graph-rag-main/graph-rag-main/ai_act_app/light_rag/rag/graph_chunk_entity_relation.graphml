      <data key="d10">https://artificialintelligenceact.eu/article/17/</data>
      <data key="d11">1748426223</data>
    </edge>
    <edge source="Quality Management System" target="Data Management">
      <data key="d6">8.0</data>
      <data key="d7">A quality management system necessitates robust Data Management processes to ensure that data integrity is maintained throughout the development of AI systems.</data>
      <data key="d8">data integrity,quality control</data>
