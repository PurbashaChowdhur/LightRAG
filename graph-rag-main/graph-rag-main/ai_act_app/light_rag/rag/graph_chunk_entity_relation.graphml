      <data key="d11">1748427018</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Natural Persons">
      <data key="d6">32.0</data>
      <data key="d7">Natural Persons are the subjects of decisions made by High-Risk AI Systems, necessitating their protection under the Regulation.&lt;SEP&gt;Natural persons are the individuals potentially impacted by the decisions made by high-risk AI systems, making their protection vital.&lt;SEP&gt;Natural persons are involved in the monitoring and verification processes of high-risk AI systems, ensuring their proper functioning.&lt;SEP&gt;Natural persons are required to verify the functioning of high-risk AI systems before any identification is acted upon.</data>
      <data key="d8">authority,human oversight,impact,impact on individuals,rights protection,user rights,verification</data>
      <data key="d9">chunk-5be37dc741c889195eef418bf4bdaca9&lt;SEP&gt;chunk-d36126d549d18d31512a9e98c8be8c3c&lt;SEP&gt;chunk-58ec10f8fea631de27f7f3ef17b5594a&lt;SEP&gt;chunk-88ec674dfb566598c9f54b13ca64a3c4</data>
      <data key="d10">https://artificialintelligenceact.eu/article/12/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/93/&lt;SEP&gt;https://artificialintelligenceact.eu/article/14/&lt;SEP&gt;https://artificialintelligenceact.eu/article/26/</data>
      <data key="d11">1748428074</data>
    </edge>
