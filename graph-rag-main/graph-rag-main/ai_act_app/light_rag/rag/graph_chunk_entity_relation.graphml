      <data key="d11">1748427438</data>
    </edge>
    <edge source="The Commission" target="EU Declaration of Conformity">
      <data key="d6">9.0</data>
      <data key="d7">The Commission is responsible for adopting acts related to the EU Declaration of Conformity to ensure its updates and compliance with technical progress.</data>
