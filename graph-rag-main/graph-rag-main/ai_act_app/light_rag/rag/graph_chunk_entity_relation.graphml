      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Regulation (EU) 2016/679" target="Post-Remote Biometric Identification Systems">
      <data key="d6">9.0</data>
      <data key="d7">Regulation (EU) 2016/679 regulates the use of biometric data and establishes safeguards for post-remote biometric identification systems within the framework of data protection law.</data>
      <data key="d8">biometric safeguards,data regulation</data>
