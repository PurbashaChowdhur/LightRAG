      <data key="d10">https://artificialintelligenceact.eu/recital/25/</data>
      <data key="d11">1748426554</data>
    </edge>
    <edge source="Regulation" target="Regulatory Sandboxes">
      <data key="d6">7.0</data>
      <data key="d7">The Regulation may incorporate provisions for regulatory sandboxes to test AI innovations before market introduction.</data>
