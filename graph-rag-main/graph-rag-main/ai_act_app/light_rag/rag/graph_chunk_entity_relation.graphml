      <data key="d11">1748426616</data>
    </edge>
    <edge source="real-time remote biometric identification systems" target="publicly accessible spaces">
      <data key="d6">9.0</data>
      <data key="d7">Real-time remote biometric identification systems are deployed in publicly accessible spaces to monitor and identify individuals for law enforcement purposes.</data>
