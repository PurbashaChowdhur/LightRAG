      <data key="d11">1748427612</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Article 73">
      <data key="d6">9.0</data>
      <data key="d7">Article 73 outlines the procedures for reporting serious incidents related to high-risk AI systems, emphasizing accountability.</data>
      <data key="d8">accountability,incident reporting</data>
      <data key="d9">chunk-4f95db6a695983806a19cc3c8894b56a</data>
      <data key="d10">https://artificialintelligenceact.eu/article/17/</data>
      <data key="d11">1748426223</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Data Acquisition">
      <data key="d6">9.0</data>
      <data key="d7">Data Acquisition is a necessary process for obtaining the data required to train and operate high-risk AI systems.</data>
      <data key="d8">AI operations,data processing</data>
      <data key="d9">chunk-4f95db6a695983806a19cc3c8894b56a</data>
      <data key="d10">https://artificialintelligenceact.eu/article/17/</data>
      <data key="d11">1748426223</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Data Analysis">
      <data key="d6">10.0</data>
      <data key="d7">Data Analysis is critical for evaluating the effectiveness and safety of high-risk AI systems after data has been collected.</data>
      <data key="d8">evaluation,safety</data>
      <data key="d9">chunk-4f95db6a695983806a19cc3c8894b56a</data>
      <data key="d10">https://artificialintelligenceact.eu/article/17/</data>
      <data key="d11">1748426223</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Data Labelling">
      <data key="d6">8.0</data>
      <data key="d7">Data Labelling is essential for the training of high-risk AI systems, allowing the systems to learn from the data provided.</data>
      <data key="d8">supervised learning,training</data>
      <data key="d9">chunk-4f95db6a695983806a19cc3c8894b56a</data>
      <data key="d10">https://artificialintelligenceact.eu/article/17/</data>
      <data key="d11">1748426223</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Data Retention">
      <data key="d6">9.0</data>
      <data key="d7">Data Retention policies must be adhered to by providers to ensure compliance with regulatory demands concerning high-risk AI systems.</data>
