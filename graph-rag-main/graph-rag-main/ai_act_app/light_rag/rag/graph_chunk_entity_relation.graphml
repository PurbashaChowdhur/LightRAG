      <data key="d9">chunk-c2395647569471a039f561bf725dfa39</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="deep fake" target="AI-generated Content">
      <data key="d6">10.0</data>
      <data key="d7">Deep fakes are a specific type of AI-generated content that raises significant ethical and legal challenges.</data>
      <data key="d8">content classification,technology issues</data>
