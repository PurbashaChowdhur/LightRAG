      <data key="d10">https://artificialintelligenceact.eu/recital/107/</data>
      <data key="d11">1748426241</data>
    </edge>
    <edge source="AI Office" target="Providers of AI Models">
      <data key="d6">17.0</data>
      <data key="d7">Providers of AI models must supply requested information to the AI Office for compliance evaluations.&lt;SEP&gt;The AI Office oversees compliance of AI model providers with transparency and data usage regulations.</data>
      <data key="d8">compliance,information sharing,regulation</data>
      <data key="d9">chunk-898711e7e6ddb7ddaceadb36ff94f179&lt;SEP&gt;chunk-b624273f3ad633492c95cc1f3608920d</data>
      <data key="d10">https://artificialintelligenceact.eu/article/92/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/107/</data>
      <data key="d11">1748426456</data>
    </edge>
    <edge source="AI Office" target="Data Privacy">
      <data key="d6">8.0</data>
      <data key="d7">The AI Office contributes to ensuring Data Privacy measures are upheld in regards to AI model training.</data>
