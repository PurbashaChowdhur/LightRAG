      <data key="d10">https://artificialintelligenceact.eu/article/97/</data>
      <data key="d11">1748427960</data>
    </edge>
    <edge source="Member State" target="Deployers">
      <data key="d6">7.0</data>
      <data key="d7">Member States influence the language and accessibility of instructions for deployers using AI systems.</data>
      <data key="d8">accessibility,regulatory influence</data>
