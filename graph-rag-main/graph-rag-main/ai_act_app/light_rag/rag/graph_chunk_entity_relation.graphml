      <data key="d7">Start-ups are represented in the Advisory Forum to ensure their interests are considered in the regulatory framework.</data>
      <data key="d8">entrepreneurship,stakeholder representation</data>
      <data key="d9">chunk-42d0cbfdb0213c7d2eb8c1b2d49876e8</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/150/</data>
      <data key="d11">1748425983</data>
    </edge>
    <edge source="Advisory Forum" target="Academia">
      <data key="d6">7.0</data>
      <data key="d7">Academia contributes research and knowledge to the Advisory Forum to inform regulatory practices and decisions.</data>
      <data key="d8">knowledge sharing,research contribution</data>
      <data key="d9">chunk-42d0cbfdb0213c7d2eb8c1b2d49876e8</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/150/</data>
      <data key="d11">1748425983</data>
    </edge>
    <edge source="Advisory Forum" target="Civil Society">
      <data key="d6">8.0</data>
      <data key="d7">Civil society organizations participate in the Advisory Forum to advocate for public interests and fundamental rights in regulation.</data>
      <data key="d8">advocacy,public interest</data>
      <data key="d9">chunk-42d0cbfdb0213c7d2eb8c1b2d49876e8</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/150/</data>
      <data key="d11">1748425983</data>
    </edge>
    <edge source="Advisory Forum" target="AI Regulation">
      <data key="d6">9.0</data>
      <data key="d7">The Advisory Forum plays a role in shaping AI Regulation by providing stakeholder expertise and recommendations.</data>
      <data key="d8">regulatory development,stakeholder involvement</data>
