    </edge>
    <edge source="Commission" target="Harmonised Standards">
      <data key="d6">9.0</data>
      <data key="d7">The Commission ensures that developed guidelines incorporate harmonised standards to maintain compliance with EU law.</data>
      <data key="d8">regulatory consistency,standardization</data>
      <data key="d9">chunk-bfbc57f477c4bd1902758e6902584d19</data>
