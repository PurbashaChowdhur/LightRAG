      <data key="d11">1748428112</data>
    </edge>
    <edge source="Notified Bodies" target="European Standardisation Organisations">
      <data key="d6">15.0</data>
      <data key="d7">Notified bodies collaborate with European standardisation organisations to stay updated on relevant standards for conformity assessment.&lt;SEP&gt;Notified bodies must participate in coordination activities with European standardisation organisations to remain informed on relevant standards.</data>
      <data key="d8">collaboration,organizational collaboration,standard adherence,standard compliance</data>
      <data key="d9">chunk-93bf0556246eea991173613a2ccf1b73&lt;SEP&gt;chunk-fbacc8a39fa85eaf6afc731174af8109</data>
