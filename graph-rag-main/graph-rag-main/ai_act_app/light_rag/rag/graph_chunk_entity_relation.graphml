      <data key="d10">https://artificialintelligenceact.eu/article/14/</data>
      <data key="d11">1748428074</data>
    </edge>
    <edge source="Natural Persons" target="Deployer">
      <data key="d6">8.0</data>
      <data key="d7">The Deployer relies on the verification by natural persons to take necessary actions based on AI outputs.</data>
