      <data key="d11">1748426054</data>
    </edge>
    <edge source="Regulation" target="natural persons">
      <data key="d6">8.0</data>
      <data key="d7">The Regulation aims to protect the rights of natural persons affected by the deployment of AI systems and models.</data>
      <data key="d8">regulation,rights protection</data>
      <data key="d9">chunk-0f96f0c84ed2ea0ee7c72badcbbc5bf5</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/97/</data>
      <data key="d11">1748426054</data>
    </edge>
    <edge source="Regulation" target="AI system">
      <data key="d6">9.0</data>
      <data key="d7">AI systems must adhere to the Regulation when utilizing general-purpose AI models to ensure compliance with established legal standards.</data>
