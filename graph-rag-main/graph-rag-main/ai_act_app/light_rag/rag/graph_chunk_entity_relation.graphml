      <data key="d10">https://artificialintelligenceact.eu/article/27/</data>
      <data key="d11">1748425998</data>
    </edge>
    <edge source="AI Office" target="template for a questionnaire">
      <data key="d6">8.0</data>
      <data key="d7">The AI Office is responsible for creating a template for a questionnaire to aid deployers in fulfilling their obligations under the law.</data>
      <data key="d8">assistance,compliance tools</data>
      <data key="d9">chunk-8a409c89b3b9a2d182dbd568b48e2e16</data>
