      <data key="d10">https://artificialintelligenceact.eu/article/16/</data>
      <data key="d11">1748426023</data>
    </edge>
    <edge source="high-risk AI system" target="Directive (EU) 2016/2102">
      <data key="d6">8.0</data>
      <data key="d7">High-risk AI systems are required to adhere to the accessibility standards set out in Directive (EU) 2016/2102.</data>
      <data key="d8">accessibility compliance,legal obligation</data>
      <data key="d9">chunk-53ca70346de523ce75c24d3a1979714d</data>
      <data key="d10">https://artificialintelligenceact.eu/article/16/</data>
      <data key="d11">1748426023</data>
    </edge>
    <edge source="high-risk AI system" target="Directive (EU) 2019/882">
      <data key="d6">8.0</data>
      <data key="d7">High-risk AI systems must comply with the requirements defined in Directive (EU) 2019/882 for their operation.</data>
      <data key="d8">operational standards,regulatory requirement</data>
      <data key="d9">chunk-53ca70346de523ce75c24d3a1979714d</data>
      <data key="d10">https://artificialintelligenceact.eu/article/16/</data>
      <data key="d11">1748426023</data>
    </edge>
    <edge source="high-risk AI system" target="Article 12">
      <data key="d6">8.0</data>
      <data key="d7">The description of maintenance and care measures for the high-risk AI system is relevant to compliance with Article 12 regulations.</data>
      <data key="d8">maintenance measures,regulatory compliance</data>
      <data key="d9">chunk-c1630fe82dedd2af2d49f1b480b55eec</data>
      <data key="d10">https://artificialintelligenceact.eu/article/13/</data>
      <data key="d11">1748426251</data>
    </edge>
    <edge source="high-risk AI system" target="Software Updates">
      <data key="d6">9.0</data>
      <data key="d7">The high-risk AI system requires Software Updates to maintain optimal performance and security standards.</data>
      <data key="d8">maintenance,technology upkeep</data>
      <data key="d9">chunk-c1630fe82dedd2af2d49f1b480b55eec</data>
      <data key="d10">https://artificialintelligenceact.eu/article/13/</data>
      <data key="d11">1748426251</data>
    </edge>
    <edge source="high-risk AI system" target="Logs">
      <data key="d6">8.0</data>
      <data key="d7">The high-risk AI system is monitored through Logs, enabling proper management and compliance with regulatory requirements.</data>
      <data key="d8">monitoring,regulatory compliance</data>
      <data key="d9">chunk-c1630fe82dedd2af2d49f1b480b55eec</data>
      <data key="d10">https://artificialintelligenceact.eu/article/13/</data>
      <data key="d11">1748426251</data>
    </edge>
    <edge source="high-risk AI system" target="Deployers">
      <data key="d6">10.0</data>
      <data key="d7">Deployers are responsible for the management and oversight of the high-risk AI system, ensuring it is appropriately maintained and updated.</data>
      <data key="d8">implementation responsibility,system management</data>
      <data key="d9">chunk-c1630fe82dedd2af2d49f1b480b55eec</data>
      <data key="d10">https://artificialintelligenceact.eu/article/13/</data>
      <data key="d11">1748426251</data>
    </edge>
    <edge source="high-risk AI system" target="Maintenance Measures">
      <data key="d6">8.0</data>
      <data key="d7">Maintenance Measures are necessary actions taken to ensure the high-risk AI system remains functional and compliant with standards.</data>
      <data key="d8">preventive actions,regulatory adherence</data>
      <data key="d9">chunk-c1630fe82dedd2af2d49f1b480b55eec</data>
      <data key="d10">https://artificialintelligenceact.eu/article/13/</data>
      <data key="d11">1748426251</data>
    </edge>
    <edge source="high-risk AI system" target="AI Office">
      <data key="d6">9.0</data>
      <data key="d7">The AI Office is responsible for ensuring that providers of high-risk AI systems comply with the obligations outlined in regulations regarding their operation and integration.</data>
      <data key="d8">compliance,regulatory oversight</data>
