      <data key="d11">1748427940</data>
    </edge>
    <edge source="Commission" target="Article 5">
      <data key="d6">8.0</data>
      <data key="d7">The Commission is responsible for developing guidelines that include the requirements, including specified prohibited practices outlined in Article 5.</data>
