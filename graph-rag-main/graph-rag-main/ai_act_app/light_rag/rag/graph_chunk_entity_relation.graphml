      <data key="d10">https://artificialintelligenceact.eu/recital/170/</data>
      <data key="d11">1748427549</data>
    </edge>
    <edge source="national law" target="remedies">
      <data key="d6">8.0</data>
      <data key="d7">Remedies defined in national law help address the infringements of rights regarding AI systems.</data>
      <data key="d8">legal recourse,rights protection</data>
      <data key="d9">chunk-2763d61443dcf3aa274192c53e098997</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/170/</data>
      <data key="d11">1748427549</data>
    </edge>
    <edge source="national law" target="law enforcement">
      <data key="d6">8.0</data>
      <data key="d7">National law is influenced by and must comply with law enforcement standards set by Union law.</data>
