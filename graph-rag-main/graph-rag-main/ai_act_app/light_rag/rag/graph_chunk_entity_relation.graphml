      <data key="d10">https://artificialintelligenceact.eu/article/6/</data>
      <data key="d11">1748428151</data>
    </edge>
    <edge source="AI System" target="Union Data Protection Law">
      <data key="d6">9.0</data>
      <data key="d7">AI systems must comply with the Union Data Protection Law regarding the processing of personal data.</data>
