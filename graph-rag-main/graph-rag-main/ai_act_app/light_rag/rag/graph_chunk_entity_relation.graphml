      <data key="d11">1748428172</data>
    </edge>
    <edge source="General-Purpose AI Models" target="Incident Reporting">
      <data key="d6">8.0</data>
      <data key="d7">Providers of general-purpose AI models must adhere to incident reporting guidelines when serious incidents occur.</data>
