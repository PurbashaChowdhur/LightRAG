      <data key="d11">1748426088</data>
    </edge>
    <edge source="general-purpose AI models" target="provider">
      <data key="d6">8.0</data>
      <data key="d7">Providers are responsible for general-purpose AI models and must comply with specific regulations set forth by the governing authorities.</data>
