    </edge>
    <edge source="general-purpose AI model" target="scientific panel">
      <data key="d6">17.0</data>
      <data key="d7">The scientific panel assesses general-purpose AI models for risks and may trigger alerts for further investigation.&lt;SEP&gt;The scientific panel evaluates general-purpose AI models and determines if they present systemic risks based on established criteria.</data>
      <data key="d8">evaluation,preventative measures,risk assessment</data>
      <data key="d9">chunk-9c361588e67b3e6b1c6d9ddf94840a97&lt;SEP&gt;chunk-3e6126c3c3690a61de0436f93b2741fd</data>
      <data key="d10">https://artificialintelligenceact.eu/article/52/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/163/</data>
      <data key="d11">1748426104</data>
    </edge>
    <edge source="general-purpose AI model" target="provider">
      <data key="d6">8.0</data>
      <data key="d7">Providers must ensure that their general-purpose AI models meet the evaluation requirements set by facilitating access.</data>
      <data key="d8">access requirements,compliance</data>
      <data key="d9">chunk-46b1355e6b7cbd10c4515c00ce75a0b0</data>
      <data key="d10">https://artificialintelligenceact.eu/article/92/</data>
      <data key="d11">1748426456</data>
    </edge>
    <edge source="general-purpose AI model" target="Clients">
      <data key="d6">7.0</data>
      <data key="d7">Clients are responsible for the information related to the general-purpose AI model, ensuring its correctness and completeness.</data>
      <data key="d8">AI information,accountability</data>
      <data key="d9">chunk-af91b8d0f12ada4bafa5122d248a66ae</data>
      <data key="d10">https://artificialintelligenceact.eu/article/91/</data>
      <data key="d11">1748426459</data>
    </edge>
    <edge source="general-purpose AI model" target="Lawyers">
      <data key="d6">7.0</data>
      <data key="d7">Lawyers may supply information regarding the general-purpose AI model on behalf of clients under authorization.</data>
      <data key="d8">AI model,legal authority</data>
      <data key="d9">chunk-af91b8d0f12ada4bafa5122d248a66ae</data>
      <data key="d10">https://artificialintelligenceact.eu/article/91/</data>
      <data key="d11">1748426459</data>
    </edge>
    <edge source="general-purpose AI model" target="high-impact capabilities">
      <data key="d6">16.0</data>
      <data key="d7">General-purpose AI models possess high-impact capabilities, determining their influence on markets and societal sectors.&lt;SEP&gt;High-impact capabilities are a defining feature of general-purpose AI models, distinguishing them from more specialized systems.</data>
      <data key="d8">AI capabilities,market influence,technology classification</data>
      <data key="d9">chunk-c2395647569471a039f561bf725dfa39&lt;SEP&gt;chunk-a6812c0a4d288d4b9c143a284b707d29</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="general-purpose AI model" target="Directive (EU) 2022/2557">
      <data key="d6">9.0</data>
      <data key="d7">The Directive establishes regulations and definitions, including general-purpose AI models, facilitating compliance for AI developers and providers.</data>
      <data key="d8">definitions,regulatory framework</data>
      <data key="d9">chunk-a6812c0a4d288d4b9c143a284b707d29</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="systemic risk" target="high-impact capabilities">
      <data key="d6">20.0</data>
      <data key="d7">Systemic risk is associated with the high-impact capabilities of general-purpose AI models, indicating potential widespread societal issues.&lt;SEP&gt;The existence of high-impact capabilities in AI models leads to systemic risks that can affect public safety and fundamental rights.</data>
      <data key="d8">public safety,risk assessment,risk management,societal impact</data>
      <data key="d9">chunk-c2395647569471a039f561bf725dfa39&lt;SEP&gt;chunk-a6812c0a4d288d4b9c143a284b707d29</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="systemic risk" target="critical infrastructure">
      <data key="d6">7.0</data>
      <data key="d7">Critical infrastructure is at risk from systemic risks posed by advanced AI models, as failures can have significant public effects.</data>
      <data key="d8">infrastructure,risk management</data>
      <data key="d9">chunk-c2395647569471a039f561bf725dfa39</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="confidential business information" target="national law">
      <data key="d6">7.0</data>
      <data key="d7">National law provides the basis for defining and protecting confidential business information within a specific country.".</data>
      <data key="d8">business protection,legal framework</data>
      <data key="d9">chunk-d2c249a013e89cafa4541f334c555079</data>
      <data key="d10">https://artificialintelligenceact.eu/article/52/</data>
      <data key="d11">1748426088</data>
    </edge>
    <edge source="confidential business information" target="intellectual property rights">
      <data key="d6">9.0</data>
      <data key="d7">Intellectual property rights protect confidential business information, ensuring that proprietary information is shielded from unauthorized disclosure.</data>
      <data key="d8">legal rights,protection of secrets</data>
      <data key="d9">chunk-60ec41e4350eb50f98db60f37f74d3d7</data>
      <data key="d10">https://artificialintelligenceact.eu/article/78/</data>
      <data key="d11">1748426988</data>
    </edge>
    <edge source="confidential business information" target="data protection measures">
      <data key="d6">9.0</data>
      <data key="d7">Data protection measures are implemented to safeguard confidential business information from breaches and unauthorized access.</data>
      <data key="d8">data security,protection</data>
      <data key="d9">chunk-60ec41e4350eb50f98db60f37f74d3d7</data>
      <data key="d10">https://artificialintelligenceact.eu/article/78/</data>
      <data key="d11">1748426988</data>
    </edge>
    <edge source="trade secrets" target="national law">
      <data key="d6">8.0</data>
      <data key="d7">National law governs the protection of trade secrets, ensuring businesses can maintain their competitive advantage.".</data>
      <data key="d8">business regulation,legal framework</data>
      <data key="d9">chunk-d2c249a013e89cafa4541f334c555079</data>
      <data key="d10">https://artificialintelligenceact.eu/article/52/</data>
      <data key="d11">1748426088</data>
    </edge>
    <edge source="national law" target="persons">
      <data key="d6">8.0</data>
      <data key="d7">National law provides legal remedies to persons whose rights may be infringed due to the use of AI systems.</data>
      <data key="d8">legal framework,rights</data>
