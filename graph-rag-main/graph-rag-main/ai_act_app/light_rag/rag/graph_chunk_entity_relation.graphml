      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="critical infrastructure" target="Directive (EU) 2022/2557">
      <data key="d6">9.0</data>
      <data key="d7">"Directive (EU) 2022/2557 emphasizes the protection of critical infrastructure from threats, linking legal provisions to public safety concerns.")</data>
