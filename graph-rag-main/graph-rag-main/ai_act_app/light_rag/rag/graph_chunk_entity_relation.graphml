      <data key="d10">https://artificialintelligenceact.eu/recital/24/</data>
      <data key="d11">1748426212</data>
    </edge>
    <edge source="AI Systems" target="Quality Management System">
      <data key="d6">8.0</data>
      <data key="d7">The Quality Management System is crucial for managing the design, development, and verification of high-risk AI Systems.</data>
