      <data key="d10">https://artificialintelligenceact.eu/recital/15/</data>
      <data key="d11">1748426178</data>
    </edge>
    <edge source="Biometric Data" target="Reference Database">
      <data key="d6">8.0</data>
      <data key="d7">The reference database serves as a repository for biometric data to facilitate comparisons and establish identity.</data>
      <data key="d8">data repository,identification process</data>
      <data key="d9">chunk-5e666c69f3a12c76222f3212a19f9ffe</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/15/</data>
      <data key="d11">1748426178</data>
    </edge>
    <edge source="Biometric Data" target="Closed Circuit Television Cameras">
      <data key="d6">7.0</data>
      <data key="d7">Closed circuit television cameras may capture footage that includes biometric data for later identification purposes.</data>
