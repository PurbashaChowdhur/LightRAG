    </edge>
    <edge source="Regulation" target="Subsidiaries">
      <data key="d6">7.0</data>
      <data key="d7">Subsidiaries are required to meet the standards outlined in the regulation set for notified bodies.</data>
      <data key="d8">compliance,operational standards</data>
