      <data key="d10">https://artificialintelligenceact.eu/article/27/</data>
      <data key="d11">1748425998</data>
    </edge>
    <edge source="AI Office" target="data protection impact assessment">
      <data key="d6">8.0</data>
      <data key="d7">The AI Office is involved in developing tools to streamline the data protection impact assessment process for deployers.</data>
