      <data key="d11">1748427612</data>
    </edge>
    <edge source="High-Risk AI Systems" target="Financial Service Law">
      <data key="d6">7.0</data>
      <data key="d7">Financial Service Law influences the governance and operation of financial institutions deploying High-Risk AI Systems, requiring adherence to specific standards.</data>
      <data key="d8">institutional governance,regulation</data>
      <data key="d9">chunk-0b7a97b6144d96bce021cd4b80f21b84</data>
