      <data key="d11">1748427162</data>
    </edge>
    <edge source="Company Premises" target="Public Accessibility">
      <data key="d6">8.0</data>
      <data key="d7">Company premises are meant for access only by employees and service providers, which means they are not openly publicly accessible.</data>
