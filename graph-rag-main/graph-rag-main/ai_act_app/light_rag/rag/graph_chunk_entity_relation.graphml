      <data key="d11">1748426801</data>
    </edge>
    <edge source="Commission" target="Local Public Authorities">
      <data key="d6">7.0</data>
      <data key="d7">The Commission aims to address the needs of local public authorities in its guidelines, emphasizing local implementation of the regulation.</data>
      <data key="d8">local governance,regulatory impact</data>
