      <data key="d10">https://artificialintelligenceact.eu/article/73/</data>
      <data key="d11">1748426389</data>
    </edge>
    <edge source="Regulation (EU) 2017/745" target="EU product rules 2022">
      <data key="d6">8.0</data>
      <data key="d7">Regulation (EU) 2017/745 is part of the legislative framework addressed by the EU product rules 2022 regarding medical devices.</data>
      <data key="d8">product compliance,regulatory bodies</data>
      <data key="d9">chunk-abc588d012f1bc89cd1e08c6d43bb27a</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/46/</data>
      <data key="d11">1748426729</data>
    </edge>
    <edge source="Regulation (EU) 2017/745" target="Union harmonisation legislation">
      <data key="d6">10.0</data>
      <data key="d7">Regulation (EU) 2017/745 is a part of the Union harmonisation legislation aimed at ensuring safety and compliance in medical devices.</data>
