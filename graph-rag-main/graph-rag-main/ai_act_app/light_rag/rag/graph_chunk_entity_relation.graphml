      <data key="d10">https://artificialintelligenceact.eu/article/80/</data>
      <data key="d11">1748426004</data>
    </edge>
    <edge source="Provider" target="Market">
      <data key="d6">8.0</data>
      <data key="d7">The provider is involved in the market by placing high-risk AI systems for commercial use, connecting the two entities.</data>
