      <data key="d11">1748426004</data>
    </edge>
    <edge source="Provider" target="Article 79">
      <data key="d6">8.0</data>
      <data key="d7">Providers of AI systems must take corrective action as stipulated in Article 79 if their systems are misclassified.</data>
      <data key="d8">corrective action,regulatory compliance</data>
      <data key="d9">chunk-e60a602cb4413f08687b677f68eb970c</data>
      <data key="d10">https://artificialintelligenceact.eu/article/80/</data>
