      <data key="d10">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d11">1748428214</data>
    </edge>
    <edge source="AI System" target="Data Protection by Design and by Default">
      <data key="d6">9.0</data>
      <data key="d7">AI systems should incorporate data protection from the initial design phase as mandated by this principle.</data>
      <data key="d8">compliance,development principles</data>
      <data key="d9">chunk-e010ebb9b0353d97d9e67673267bc415</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/69/</data>
      <data key="d11">1748428214</data>
    </edge>
    <edge source="AI System" target="Anonymisation and Encryption">
