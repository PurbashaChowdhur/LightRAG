      <data key="d10">https://artificialintelligenceact.eu/recital/111/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/112/&lt;SEP&gt;https://artificialintelligenceact.eu/article/52/</data>
      <data key="d11">1748428194</data>
    </edge>
    <edge source="Systemic Risks" target="EU Regulation">
      <data key="d6">9.0</data>
      <data key="d7">The EU Regulation is designed to manage Systemic Risks presented by AI technologies that could affect democratic processes.</data>
