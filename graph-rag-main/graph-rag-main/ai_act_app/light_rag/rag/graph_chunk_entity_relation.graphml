      <data key="d10">https://artificialintelligenceact.eu/recital/30/</data>
      <data key="d11">1748426149</data>
    </edge>
    <edge source="Biometric Categorisation Systems" target="Sex Life">
      <data key="d6">5.0</data>
      <data key="d7">Biometric data could potentially be used to infer aspects of individuals' sex lives or preferences in categorisation systems.</data>
