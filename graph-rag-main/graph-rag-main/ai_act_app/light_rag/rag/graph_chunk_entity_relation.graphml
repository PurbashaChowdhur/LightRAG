      <data key="d10">https://artificialintelligenceact.eu/article/58/</data>
      <data key="d11">1748426579</data>
    </edge>
    <edge source="SMEs" target="European Commission">
      <data key="d6">7.0</data>
      <data key="d7">The European Commission seeks to lower certification and compliance costs for SMEs, demonstrating its commitment to their interests in AI.".</data>
      <data key="d8">cost reduction,regulatory oversight</data>
