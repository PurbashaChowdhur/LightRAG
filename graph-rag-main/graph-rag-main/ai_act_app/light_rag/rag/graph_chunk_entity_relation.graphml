    <edge source="Provider" target="Regulation (EU) 2019/1020">
      <data key="d6">7.0</data>
      <data key="d7">Providers must adhere to the stipulations laid out in Regulation (EU) 2019/1020 regarding AI systems and obligations.</data>
      <data key="d8">obligations,regulatory compliance</data>
