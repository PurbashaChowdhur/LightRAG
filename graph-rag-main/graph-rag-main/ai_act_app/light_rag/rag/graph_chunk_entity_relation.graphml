    </edge>
    <edge source="The Commission" target="Providers of General-Purpose AI Models">
      <data key="d6">9.0</data>
      <data key="d7">The Commission has the authority to impose fines on providers if they violate regulations concerning AI model compliance.</data>
      <data key="d8">compliance,regulatory enforcement</data>
