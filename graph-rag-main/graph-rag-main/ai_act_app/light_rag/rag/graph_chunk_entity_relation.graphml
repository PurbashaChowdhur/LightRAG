      <data key="d10">https://artificialintelligenceact.eu/recital/19/</data>
      <data key="d11">1748427162</data>
    </edge>
    <edge source="Publicly Accessible Space" target="Public Transport Stations">
      <data key="d6">8.0</data>
      <data key="d7">Public transport stations fit the criteria for publicly accessible spaces as per the defined Regulation.</data>
      <data key="d8">public usage,transport access</data>
