      <data key="d10">https://artificialintelligenceact.eu/article/98/</data>
      <data key="d11">1748426257</data>
    </edge>
    <edge source="Commission" target="Article 98">
      <data key="d6">17.0</data>
      <data key="d7">The Commission operates within the guidelines established by Article 98 of Regulation (EU) No 182/2011, which dictates committee procedures.&lt;SEP&gt;The Commission's actions regarding the adoption of implementing acts are guided by the examination procedures outlined in Article 98.</data>
