      <data key="d10">https://artificialintelligenceact.eu/recital/143/</data>
      <data key="d11">1748427031</data>
    </edge>
    <edge source="SMEs" target="Standardisation Development Processes">
      <data key="d6">6.0</data>
      <data key="d7">SMEs are encouraged to participate in Standardisation Development Processes to voice their specific needs and contribute to norm setting.</data>
      <data key="d8">participation,stakeholder engagement</data>
      <data key="d9">chunk-be7f21ee31292214036736eb415637fc</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/143/</data>
      <data key="d11">1748427031</data>
    </edge>
    <edge source="SMEs" target="Information Platforms">
      <data key="d6">6.0</data>
      <data key="d7">Information Platforms are developed to support SMEs by providing guidance and resources related to AI regulations.</data>
