    </edge>
    <edge source="Member State" target="Conformity Assessment">
      <data key="d6">9.0</data>
      <data key="d7">Member States are responsible for the implementation of conformity assessments, ensuring adherence to national law regarding AI systems.</data>
      <data key="d8">compliance enforcement,regulatory responsibility</data>
      <data key="d9">chunk-fbacc8a39fa85eaf6afc731174af8109</data>
