      <data key="d11">1748426813</data>
    </edge>
    <edge source="General-Purpose AI Models" target="Union Copyright Law">
      <data key="d6">8.0</data>
      <data key="d7">The release of general-purpose AI models must consider Union copyright law to ensure legal use of training data.</data>
