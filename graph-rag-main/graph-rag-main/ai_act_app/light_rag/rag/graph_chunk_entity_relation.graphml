      <data key="d10">https://artificialintelligenceact.eu/article/98/&lt;SEP&gt;https://artificialintelligenceact.eu/article/50/</data>
      <data key="d11">1748427867</data>
    </edge>
    <edge source="Commission" target="Notification Procedure">
      <data key="d6">9.0</data>
      <data key="d7">The Notification Procedure describes how conformity assessment bodies are to be notified to the Commission by Member States.</data>
