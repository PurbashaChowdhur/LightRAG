      <data key="d11">1748426654</data>
    </edge>
    <edge source="Biometric Data" target="Article 9(1) of Regulation (EU) 2016/679">
      <data key="d6">19.0</data>
      <data key="d7">Article 9(1) establishes rules for handling biometric data to prevent misuse and ensure compliance with legal standards.&lt;SEP&gt;Article 9(1) prohibits the processing of biometric data without legal grounds, linking to the need for protection of sensitive personal information.</data>
      <data key="d8">data protection,legal framework,legal restrictions</data>
      <data key="d9">chunk-3fd24ee33b239cebb25bf3a99d82eb1b&lt;SEP&gt;chunk-3a392041e8bab68fc3cbccc33e333ac7</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/54/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/39/</data>
      <data key="d11">1748427448</data>
    </edge>
    <edge source="Biometric Data" target="Biometric Categorization Systems">
      <data key="d6">8.0</data>
      <data key="d7">Biometric Categorization Systems utilize Biometric Data to categorize individuals into specific groups based on derived characteristics.</data>
      <data key="d8">categorization,data usage</data>
      <data key="d9">chunk-8871d96b04df0305284cbd20bfc2bf41</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Biometric Data" target="Regulation (EU) 2018/1725">
      <data key="d6">8.0</data>
      <data key="d7">Regulation (EU) 2018/1725 provides guidelines for the processing of biometric data in EU institutions, ensuring adequate data protection measures are in place.</data>
      <data key="d8">data privacy,institutional regulation</data>
