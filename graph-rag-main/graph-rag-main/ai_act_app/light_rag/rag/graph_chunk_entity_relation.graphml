      <data key="d9">chunk-dc0938655f22b840224fc49f2018dbf1</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/21/</data>
      <data key="d11">1748426119</data>
    </edge>
    <edge source="Regulation" target="AI Systems Deployers">
      <data key="d6">8.0</data>
      <data key="d7">AI Systems Deployers are also required to adhere to the Regulation to protect individual rights and ensure fairness in AI deployment.</data>
      <data key="d8">compliance,operational standards</data>
      <data key="d9">chunk-dc0938655f22b840224fc49f2018dbf1</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/21/</data>
      <data key="d11">1748426119</data>
    </edge>
    <edge source="Regulation" target="Providers of AI Systems">
      <data key="d6">9.0</data>
      <data key="d7">Providers of AI Systems must comply with the Regulation to ensure equitable practices regardless of their location.</data>
      <data key="d8">compliance,operational standards</data>
      <data key="d9">chunk-dc0938655f22b840224fc49f2018dbf1</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/21/</data>
      <data key="d11">1748426119</data>
    </edge>
    <edge source="Regulation" target="Deployers of AI Systems">
      <data key="d6">9.0</data>
      <data key="d7">Deployers of AI Systems are mandated by the Regulation to operate in a manner that upholds the rights of individuals.</data>
