    <edge source="Member State" target="The Commission">
      <data key="d6">8.0</data>
      <data key="d7">The Commission addresses its decisions regarding authorization directly to the Member States that are concerned, indicating a regulatory relationship.</data>
      <data key="d8">decision-making,regulatory authority</data>
      <data key="d9">chunk-95c78946b57af53cc3de27b286cf36eb</data>
      <data key="d10">https://artificialintelligenceact.eu/article/46/</data>
      <data key="d11">1748427133</data>
    </edge>
    <edge source="Member State" target="national competent authorities">
      <data key="d6">9.0</data>
      <data key="d7">National competent authorities operate within the jurisdiction of a Member State to ensure safety and compliance.</data>
      <data key="d8">government oversight,regulatory compliance</data>
      <data key="d9">chunk-e8e772b9822216e1506938086aedcaba</data>
      <data key="d10">https://artificialintelligenceact.eu/article/36/</data>
      <data key="d11">1748427202</data>
    </edge>
    <edge source="Member State" target="National Competent Authority">
      <data key="d6">6.0</data>
      <data key="d7">Each Member State has a National Competent Authority to oversee specific sectors, including AI systems.</data>
      <data key="d8">governance,national regulation</data>
      <data key="d9">chunk-d56424a5db573173fc67a6e62dd2d96b</data>
      <data key="d10">https://artificialintelligenceact.eu/article/36/</data>
      <data key="d11">1748427202</data>
    </edge>
    <edge source="Member State" target="Judicial Authority">
      <data key="d6">8.0</data>
      <data key="d7">Judicial authorities operate within the framework of Member States' legal systems to authorize the use of AI technologies in law enforcement contexts.</data>
      <data key="d8">enforcement regulation,legal framework</data>
      <data key="d9">chunk-92ce4de2ee2430b55395c19336af7c01</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/35/</data>
      <data key="d11">1748427738</data>
    </edge>
    <edge source="Member State" target="Real-Time Remote Biometric Identification Systems">
      <data key="d6">8.0</data>
      <data key="d7">Real-time identification systems must comply with national laws that authorize their use in each Member State.</data>
      <data key="d8">law enforcement,regulatory compliance</data>
      <data key="d9">chunk-e142ac7019ab93d80ef49579e8d0866e</data>
      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="Member State" target="EU database">
      <data key="d6">8.0</data>
      <data key="d7">Member States are governed by EU regulations for managing EU databases related to biometric identification systems.</data>
      <data key="d8">compliance,legal framework</data>
