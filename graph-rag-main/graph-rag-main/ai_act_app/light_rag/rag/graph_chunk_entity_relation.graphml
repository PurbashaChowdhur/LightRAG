      <data key="d10">https://artificialintelligenceact.eu/article/3/&lt;SEP&gt;https://artificialintelligenceact.eu/article/29/</data>
      <data key="d11">1748428406</data>
    </edge>
    <edge source="Notifying Authority" target="national authority">
      <data key="d6">10.0</data>
      <data key="d7">The notifying authority is a specialized body within the national authority that oversees conformity assessment procedures for AI systems.</data>
      <data key="d8">oversight,regulatory framework</data>
      <data key="d9">chunk-18590180ace1a86abda373a524de5d70</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Notifying Authority" target="Withdrawal of an AI System">
      <data key="d6">8.0</data>
      <data key="d7">Withdrawal of AI systems is overseen by the notifying authority, which sets up the necessary procedures for such actions.</data>
