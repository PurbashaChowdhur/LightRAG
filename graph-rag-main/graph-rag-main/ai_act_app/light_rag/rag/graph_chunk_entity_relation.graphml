    <edge source="law enforcement authorities" target="criminal offences">
      <data key="d6">8.0</data>
      <data key="d7">Law enforcement authorities are responsible for addressing and processing criminal offences through the application of law and regulations, including those relating to AI systems.</data>
      <data key="d8">legal enforcement,public safety</data>
