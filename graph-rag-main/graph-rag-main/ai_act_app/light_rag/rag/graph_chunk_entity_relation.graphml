      <data key="d11">1748428455</data>
    </edge>
    <edge source="Advisory Forum" target="ENISA">
      <data key="d6">15.0</data>
      <data key="d7">ENISA is part of the Advisory Forum, contributing expertise on cybersecurity issues to regulatory discussions.&lt;SEP&gt;ENISA's membership in the Advisory Forum enhances the body's technical expertise on cybersecurity issues.</data>
      <data key="d8">cybersecurity,cybersecurity expertise,membership,stakeholder involvement</data>
      <data key="d9">chunk-42d0cbfdb0213c7d2eb8c1b2d49876e8&lt;SEP&gt;chunk-a04fe96efa4389bb1d352d2b400876fa</data>
      <data key="d10">https://artificialintelligenceact.eu/article/67/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/150/</data>
      <data key="d11">1748428455</data>
    </edge>
    <edge source="Advisory Forum" target="European Committee for Standardization (CEN)">
      <data key="d6">14.0</data>
      <data key="d7">CEN contributes to the Advisory Forum through its expertise in standardization practices.&lt;SEP&gt;CEN is represented in the Advisory Forum to ensure that industry standards are considered in regulatory advice.</data>
      <data key="d8">membership,stakeholder involvement,standardization,standards development</data>
      <data key="d9">chunk-42d0cbfdb0213c7d2eb8c1b2d49876e8&lt;SEP&gt;chunk-a04fe96efa4389bb1d352d2b400876fa</data>
      <data key="d10">https://artificialintelligenceact.eu/article/67/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/150/</data>
      <data key="d11">1748428455</data>
    </edge>
    <edge source="Advisory Forum" target="European Committee for Electrotechnical Standardization (CENELEC)">
      <data key="d6">14.0</data>
      <data key="d7">CENELEC participates in the Advisory Forum to address electrotechnical standards in regulations.&lt;SEP&gt;CENELEC's involvement brings valuable technical insights to the Advisory Forum's discussions.</data>
      <data key="d8">membership,stakeholder involvement,standards development,technical expertise</data>
      <data key="d9">chunk-42d0cbfdb0213c7d2eb8c1b2d49876e8&lt;SEP&gt;chunk-a04fe96efa4389bb1d352d2b400876fa</data>
