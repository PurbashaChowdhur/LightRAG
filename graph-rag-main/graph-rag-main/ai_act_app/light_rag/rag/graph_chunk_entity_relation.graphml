      <data key="d10">https://artificialintelligenceact.eu/article/59/</data>
      <data key="d11">1748426294</data>
    </edge>
    <edge source="law enforcement authorities" target="national competent authorities">
      <data key="d6">8.0</data>
      <data key="d7">National competent authorities interact with law enforcement authorities to ensure the proper assessment and regulation of AI systems in law enforcement contexts.</data>
      <data key="d8">collaboration,regulatory oversight</data>
      <data key="d9">chunk-60ec41e4350eb50f98db60f37f74d3d7</data>
      <data key="d10">https://artificialintelligenceact.eu/article/78/</data>
      <data key="d11">1748426988</data>
    </edge>
    <edge source="law enforcement authorities" target="Union institutions, bodies, offices, or agencies">
      <data key="d6">7.0</data>
      <data key="d7">Union institutions may support law enforcement authorities in evaluating risks through the use of AI technologies.</data>
