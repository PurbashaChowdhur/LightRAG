      <data key="d11">1748426459</data>
    </edge>
    <edge source="AI Office" target="national competent authority">
      <data key="d6">22.0</data>
      <data key="d7">The AI Office collaborates with national competent authorities to ensure compliance with AI regulations established under the Commission's directives.&lt;SEP&gt;The AI Office collaborates with national competent authorities to ensure the effective governance and implementation of AI regulations.&lt;SEP&gt;The AI Office collaborates with national competent authorities to oversee the governance and regulation of AI systems in Member States.</data>
      <data key="d8">AI governance,collaboration,regulatory compliance,regulatory oversight</data>
      <data key="d9">chunk-df3020e6887a24702cea8a3373082e09&lt;SEP&gt;chunk-94ebfb1fa7d304078345c66a61c6ecc1</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="AI Office" target="Commission Decision of 24 January 2024">
      <data key="d6">17.0</data>
      <data key="d7">The AI Office is established under the Commission Decision to govern and oversee AI systems and their implementation.".&lt;SEP&gt;The Commission Decision establishes the regulatory framework that guides the functions of the AI Office in supervising AI deployments.</data>
      <data key="d8">AI supervision,governance,regulatory framework</data>
      <data key="d9">chunk-df3020e6887a24702cea8a3373082e09&lt;SEP&gt;chunk-94ebfb1fa7d304078345c66a61c6ecc1</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="AI Office" target="European Data Protection Supervisor">
      <data key="d6">8.0</data>
