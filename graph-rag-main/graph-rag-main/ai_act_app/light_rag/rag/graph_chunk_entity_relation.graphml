      <data key="d10">https://artificialintelligenceact.eu/article/31/</data>
      <data key="d11">1748426852</data>
    </edge>
    <edge source="Notified Bodies" target="Professional Secrecy">
      <data key="d6">9.0</data>
      <data key="d7">The personnel of notified bodies must adhere to professional secrecy to protect sensitive information.</data>
