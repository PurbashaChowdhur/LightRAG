      <data key="d10">https://artificialintelligenceact.eu/article/5/</data>
      <data key="d11">1748427772</data>
    </edge>
    <edge source="market surveillance authority" target="national data protection authorities">
      <data key="d6">9.0</data>
      <data key="d7">National data protection authorities and market surveillance authorities work together to ensure that biometric identification systems comply with established laws and regulations.</data>
      <data key="d8">collaboration,compliance oversight</data>
