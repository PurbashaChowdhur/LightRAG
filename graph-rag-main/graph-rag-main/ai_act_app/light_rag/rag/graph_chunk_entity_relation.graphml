      <data key="d10">https://artificialintelligenceact.eu/recital/115/</data>
      <data key="d11">1748427210</data>
    </edge>
    <edge source="General-Purpose AI Models" target="Providers of General-Purpose AI Models">
      <data key="d6">16.0</data>
      <data key="d7">Providers are responsible for developing and maintaining general-purpose AI models, ensuring compliance with relevant regulations.&lt;SEP&gt;Providers develop and distribute general-purpose AI models, which must meet regulatory standards before being placed on the market.</data>
      <data key="d8">compliance,development and distribution,development responsibility,regulatory standards</data>
      <data key="d9">chunk-8f93754b5b045f375c5040d0de011e4b&lt;SEP&gt;chunk-4650c5b3d73643d93f915f7eeb206da5</data>
