      <data key="d10">https://artificialintelligenceact.eu/article/4/</data>
      <data key="d11">1748427732</data>
    </edge>
    <edge source="Deep Fake" target="Widespread Infringement">
      <data key="d6">7.0</data>
      <data key="d7">Deep fakes can result in widespread infringements of Union law due to their potential to harm individuals' interests and rights.</data>
      <data key="d8">legal implications,technology risks</data>
      <data key="d9">chunk-d973114c994e2a695be9f8562505452d</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Subjects" target="Testing in Real-World Conditions">
      <data key="d6">9.0</data>
      <data key="d7">Subjects are integral to the testing of AI systems in real-world conditions, as their participation is required for data collection.</data>
      <data key="d8">participation,testing</data>
      <data key="d9">chunk-d973114c994e2a695be9f8562505452d</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Subjects" target="Informed Consent">
      <data key="d6">10.0</data>
      <data key="d7">Subjects must give informed consent to participate in testing, ensuring they understand the implications of their involvement.</data>
      <data key="d8">ethics,participation</data>
      <data key="d9">chunk-d973114c994e2a695be9f8562505452d</data>
      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Widespread Infringement" target="European Union Member States">
      <data key="d6">7.0</data>
      <data key="d7">Widespread infringement can occur across multiple European Union Member States, affecting collective interests and laws.</data>
