    <edge source="AI Systems" target="AI Systems Exclusion">
      <data key="d6">9.0</data>
      <data key="d7">AI Systems Exclusion delineates the parameters under which AI systems are exempt from certain regulations based on their intended military use.</data>
      <data key="d8">AI usage,regulatory exemption</data>
