      <data key="d10">https://artificialintelligenceact.eu/recital/74/</data>
      <data key="d11">1748428543</data>
    </edge>
    <edge source="Commission" target="Union AI Testing Support Structures">
      <data key="d6">8.0</data>
      <data key="d7">The Commission designates Union AI Testing Support Structures to oversee tasks related to AI regulation.</data>
