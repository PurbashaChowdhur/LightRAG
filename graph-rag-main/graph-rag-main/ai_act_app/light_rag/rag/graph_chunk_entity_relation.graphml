      <data key="d10">https://artificialintelligenceact.eu/recital/46/</data>
      <data key="d11">1748426729</data>
    </edge>
    <edge source="Regulation (EU) 2017/746" target="EU product rules 2022">
      <data key="d6">8.0</data>
      <data key="d7">Regulation (EU) 2017/746 specifies requirements for in vitro diagnostic devices under the broader EU product rules 2022.</data>
      <data key="d8">product compliance,regulatory bodies</data>
      <data key="d9">chunk-abc588d012f1bc89cd1e08c6d43bb27a</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/46/</data>
      <data key="d11">1748426729</data>
    </edge>
    <edge source="providers of general-purpose AI models" target="General-purpose AI models">
      <data key="d6">10.0</data>
      <data key="d7">General-purpose AI models are created and maintained by providers who must adhere to guidelines and standards.</data>
      <data key="d8">development,product responsibility</data>
      <data key="d9">chunk-bdcf8f8cc5bcd01cd9809a08b83c4dab</data>
      <data key="d10">https://artificialintelligenceact.eu/article/55/</data>
      <data key="d11">1748426397</data>
    </edge>
    <edge source="providers of general-purpose AI models" target="European harmonised standards">
      <data key="d6">9.0</data>
      <data key="d7">Providers must comply with European harmonised standards to ensure conformity in the safety of their AI models.</data>
      <data key="d8">compliance,safety standards</data>
      <data key="d9">chunk-bdcf8f8cc5bcd01cd9809a08b83c4dab</data>
      <data key="d10">https://artificialintelligenceact.eu/article/55/</data>
      <data key="d11">1748426397</data>
    </edge>
    <edge source="providers of general-purpose AI models" target="Article 53 and 54">
      <data key="d6">9.0</data>
      <data key="d7">Providers must adhere to the obligations set forth in Articles 53 and 54 to mitigate systemic risks during the development and usage of AI models.</data>
      <data key="d8">obligations,regulation compliance</data>
      <data key="d9">chunk-bdcf8f8cc5bcd01cd9809a08b83c4dab</data>
      <data key="d10">https://artificialintelligenceact.eu/article/55/</data>
      <data key="d11">1748426397</data>
    </edge>
    <edge source="providers of general-purpose AI models" target="model evaluation">
      <data key="d6">10.0</data>
      <data key="d7">Providers of AI models are required to perform model evaluations to ensure compliance with safety standards and to mitigate systemic risks.</data>
      <data key="d8">evaluation,safety assessment</data>
      <data key="d9">chunk-bdcf8f8cc5bcd01cd9809a08b83c4dab</data>
      <data key="d10">https://artificialintelligenceact.eu/article/55/</data>
      <data key="d11">1748426397</data>
    </edge>
    <edge source="providers of general-purpose AI models" target="cybersecurity protection">
      <data key="d6">9.0</data>
      <data key="d7">Providers are obligated to ensure adequate cybersecurity protection for their AI systems to prevent incidents and safeguard data.</data>
      <data key="d8">risk management,security measures</data>
      <data key="d9">chunk-bdcf8f8cc5bcd01cd9809a08b83c4dab</data>
      <data key="d10">https://artificialintelligenceact.eu/article/55/</data>
      <data key="d11">1748426397</data>
    </edge>
    <edge source="providers of general-purpose AI models" target="Article 56">
      <data key="d6">8.0</data>
      <data key="d7">Article 56 provides codes of practice that can help guide providers in demonstrating compliance with their obligations.</data>
      <data key="d8">compliance framework,guidance</data>
      <data key="d9">chunk-bdcf8f8cc5bcd01cd9809a08b83c4dab</data>
      <data key="d10">https://artificialintelligenceact.eu/article/55/</data>
      <data key="d11">1748426397</data>
    </edge>
    <edge source="providers of general-purpose AI models" target="Article 78">
      <data key="d6">8.0</data>
      <data key="d7">Article 78 outlines confidentiality obligations that affect how providers manage and report sensitive information about their AI models.</data>
      <data key="d8">confidentiality,information management</data>
      <data key="d9">chunk-bdcf8f8cc5bcd01cd9809a08b83c4dab</data>
      <data key="d10">https://artificialintelligenceact.eu/article/55/</data>
      <data key="d11">1748426397</data>
    </edge>
    <edge source="Articles 53 and 54" target="Mitigation Measures">
      <data key="d6">8.0</data>
      <data key="d7">The obligations specified in Articles 53 and 54 dictate the necessity of implementing mitigation measures when systemic risks are identified.</data>
      <data key="d8">compliance measures,regulatory framework</data>
      <data key="d9">chunk-c78ba06fc96beac812eca04fddc34af9</data>
      <data key="d10">https://artificialintelligenceact.eu/article/93/</data>
      <data key="d11">1748428182</data>
    </edge>
    <edge source="Article 78" target="national public authorities">
      <data key="d6">8.0</data>
      <data key="d7">National public authorities must treat information in accordance with the confidentiality obligations set out in Article 78.</data>
      <data key="d8">confidentiality,regulatory compliance</data>
      <data key="d9">chunk-5669bfd412b21e9a27b2f3c99aebc7e8</data>
      <data key="d10">https://artificialintelligenceact.eu/article/77/</data>
      <data key="d11">1748426491</data>
    </edge>
    <edge source="Article 78" target="Authority">
      <data key="d6">10.0</data>
      <data key="d7">The Authority must treat any obtained information in accordance with the confidentiality obligations set forth in Article 78.</data>
      <data key="d8">confidentiality,regulatory compliance</data>
      <data key="d9">chunk-5669bfd412b21e9a27b2f3c99aebc7e8</data>
      <data key="d10">https://artificialintelligenceact.eu/article/77/</data>
      <data key="d11">1748426491</data>
    </edge>
    <edge source="Article 78" target="Professional Secrecy">
      <data key="d6">9.0</data>
      <data key="d7">Article 78 mandates that notified bodies must practice professional secrecy concerning assessment results and information.</data>
      <data key="d8">confidentiality,regulatory requirement</data>
      <data key="d9">chunk-93bf0556246eea991173613a2ccf1b73</data>
      <data key="d10">https://artificialintelligenceact.eu/article/31/</data>
      <data key="d11">1748426852</data>
    </edge>
    <edge source="Code of Practice" target="Annex XI">
      <data key="d6">8.0</data>
      <data key="d7">Annex XI outlines specific compliance measures that organizations must adhere to as part of the Code of Practice.</data>
      <data key="d8">compliance,regulatory framework</data>
      <data key="d9">chunk-91d56158a4a9411ebe99783effcebca7</data>
      <data key="d10">https://artificialintelligenceact.eu/article/53/</data>
      <data key="d11">1748428053</data>
    </edge>
    <edge source="Code of Practice" target="Point 2 (d) and (e) of Annex XI">
      <data key="d6">7.0</data>
      <data key="d7">Points 2 (d) and (e) in Annex XI define specific provisions within the Code of Practice regarding compliance standards.</data>
      <data key="d8">compliance,specific requirements</data>
      <data key="d9">chunk-91d56158a4a9411ebe99783effcebca7</data>
      <data key="d10">https://artificialintelligenceact.eu/article/53/</data>
      <data key="d11">1748428053</data>
    </edge>
    <edge source="General-purpose AI models" target="Directive (EU) 2019/790">
      <data key="d6">8.0</data>
      <data key="d7">The Directive (EU) 2019/790 provides a legal framework affecting the usage and limitations of general-purpose AI models regarding copyright protected content.</data>
      <data key="d8">legal framework,policy impact</data>
      <data key="d9">chunk-a27392402ccb8a7a70b92094f8dd984b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/105/</data>
      <data key="d11">1748426720</data>
    </edge>
    <edge source="General-purpose AI models" target="rightsholders">
      <data key="d6">9.0</data>
      <data key="d7">General-purpose AI models require authorization from rightsholders for using their protected content, linking innovation with copyright concerns.</data>
      <data key="d8">authorization,rights management</data>
      <data key="d9">chunk-a27392402ccb8a7a70b92094f8dd984b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/105/</data>
      <data key="d11">1748426720</data>
    </edge>
    <edge source="General-purpose AI models" target="artists">
      <data key="d6">7.0</data>
      <data key="d7">General-purpose AI models impact artists by altering the ways their creative content is generated and consumed.</data>
      <data key="d8">creative impact,innovation challenges</data>
      <data key="d9">chunk-a27392402ccb8a7a70b92094f8dd984b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/105/</data>
      <data key="d11">1748426720</data>
    </edge>
    <edge source="General-purpose AI models" target="authors">
      <data key="d6">8.0</data>
      <data key="d7">Authors face challenges from general-purpose AI models regarding the usage of their literary works and their rights.</data>
      <data key="d8">content challenges,creation rights</data>
      <data key="d9">chunk-a27392402ccb8a7a70b92094f8dd984b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/105/</data>
      <data key="d11">1748426720</data>
    </edge>
    <edge source="General-purpose AI models" target="creators">
      <data key="d6">7.0</data>
      <data key="d7">Creators are affected by how general-purpose AI models generate and distribute content, impacting traditional creative processes.</data>
      <data key="d8">disruption,innovation</data>
      <data key="d9">chunk-a27392402ccb8a7a70b92094f8dd984b</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/105/</data>
      <data key="d11">1748426720</data>
    </edge>
    <edge source="Right to Explanation of Individual Decision-Making" target="Affected Person">
      <data key="d6">9.0</data>
      <data key="d7">The right to explanation specifically aims to empower affected persons with knowledge of the AI decision-making process.</data>
      <data key="d8">rights protection,transparency</data>
      <data key="d9">chunk-cad430846dc3448ba37c9f18d213e761</data>
      <data key="d10">https://artificialintelligenceact.eu/article/86/</data>
      <data key="d11">1748426403</data>
    </edge>
    <edge source="Digital Elements" target="Cybersecurity Requirements">
      <data key="d6">9.0</data>
      <data key="d7">Digital elements must adhere to specific cybersecurity requirements established by regulations to ensure they are safe for use.</data>
