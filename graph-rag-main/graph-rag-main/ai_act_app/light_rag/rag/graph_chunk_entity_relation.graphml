      <data key="d10">https://artificialintelligenceact.eu/article/67/</data>
      <data key="d11">1748428455</data>
    </edge>
    <edge source="Advisory Forum" target="Co-Chairs">
      <data key="d6">9.0</data>
      <data key="d7">The Co-Chairs lead the advisory forum and are responsible for overseeing its operations and objectives.</data>
