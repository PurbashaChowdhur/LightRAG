    </edge>
    <edge source="Provider" target="Article 99">
      <data key="d6">9.0</data>
      <data key="d7">Providers of AI systems are subject to fines as outlined in Article 99 if they fail to ensure compliance with regulations.</data>
      <data key="d8">compliance obligations,penalties</data>
