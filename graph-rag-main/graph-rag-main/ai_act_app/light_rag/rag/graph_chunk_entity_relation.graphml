      <data key="d10">https://artificialintelligenceact.eu/article/68/</data>
      <data key="d11">1748426688</data>
    </edge>
    <edge source="Scientific Panel" target="Conflicts of Interest">
      <data key="d6">9.0</data>
      <data key="d7">The Scientific Panel must manage Conflicts of Interest to ensure impartiality and objectivity in their evaluations of AI Models.</data>
      <data key="d8">ethics,impartiality</data>
