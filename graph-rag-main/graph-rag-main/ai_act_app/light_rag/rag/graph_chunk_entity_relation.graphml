    </edge>
    <edge source="Advisory Forum" target="Industry">
      <data key="d6">8.0</data>
      <data key="d7">Industry representatives are included in the Advisory Forum to provide insights relevant to their sectors in regulatory matters.</data>
      <data key="d8">commercial interests,representation</data>
