    <edge source="Directive (EU) 2016/680" target="Council Framework Decision 2008/977/JHA">
      <data key="d6">10.0</data>
      <data key="d7">Directive (EU) 2016/680 repealed the earlier Council Framework Decision 2008/977/JHA to establish updated data protection standards.</data>
      <data key="d8">data regulations,reform</data>
      <data key="d9">chunk-6ebb4e641a55d31b962b56d6017d2734</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/10/</data>
