      <data key="d10">https://artificialintelligenceact.eu/article/3/&lt;SEP&gt;https://artificialintelligenceact.eu/article/73/&lt;SEP&gt;https://artificialintelligenceact.eu/article/79/&lt;SEP&gt;https://artificialintelligenceact.eu/article/85/</data>
      <data key="d11">1748426903</data>
    </edge>
