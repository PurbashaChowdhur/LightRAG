    </edge>
    <edge source="fundamental rights impact assessment" target="Article 27">
      <data key="d6">8.0</data>
      <data key="d7">Article 27 necessitates the completion of a fundamental rights impact assessment prior to the use of biometric identification systems.</data>
      <data key="d8">legal framework,regulatory compliance</data>
      <data key="d9">chunk-079fbdf24f8b746547b54a3e43daaf33</data>
