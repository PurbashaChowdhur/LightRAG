    </edge>
    <edge source="Publicly Accessible Space" target="Public Roads">
      <data key="d6">10.0</data>
      <data key="d7">Public roads are a fundamental example of publicly accessible spaces available for public use.</data>
      <data key="d8">infrastructure,public access</data>
