      <data key="d11">1748428325</data>
    </edge>
    <edge source="AI System" target="Testing in Real World Conditions">
      <data key="d6">19.0</data>
      <data key="d7">The testing in real-world conditions focuses on evaluating the AI system to ensure it meets necessary regulations and ethical considerations.&lt;SEP&gt;The testing of AI systems in real-world conditions focuses on their safety, efficacy, and compliance with legal standards.</data>
      <data key="d8">compliance,evaluation,practical assessment</data>
      <data key="d9">chunk-17d875a9ff2b02237bb4b9ba04e5b92a&lt;SEP&gt;chunk-4a7fb5abd6ad1ba2e9256fc63dbda4a7</data>
      <data key="d10">https://artificialintelligenceact.eu/article/60/</data>
      <data key="d11">1748428325</data>
    </edge>
    <edge source="AI System" target="Real World Conditions">
      <data key="d6">10.0</data>
