      <data key="d10">https://artificialintelligenceact.eu/article/70/</data>
      <data key="d11">1748426202</data>
    </edge>
    <edge source="SMEs" target="General-Purpose AI Models">
      <data key="d6">8.0</data>
      <data key="d7">SMEs will be encouraged to comply with AI model obligations in a manner that does not impose excessive costs for their use of general-purpose AI models.</data>
      <data key="d8">AI usage,business compliance</data>
      <data key="d9">chunk-3f3abbad4dddf2a8a56efeaa03cc7f28</data>
