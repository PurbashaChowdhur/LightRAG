      <data key="d10">https://artificialintelligenceact.eu/recital/30/</data>
      <data key="d11">1748426149</data>
    </edge>
    <edge source="Biometric Categorisation Systems" target="Sexual Orientation">
      <data key="d6">5.0</data>
      <data key="d7">Biometric categorisation systems might infer sexual orientation based on unique biometric data.</data>
