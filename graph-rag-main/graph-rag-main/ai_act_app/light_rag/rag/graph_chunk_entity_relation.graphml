      <data key="d11">1748426054</data>
    </edge>
    <edge source="general-purpose AI models" target="internal processes">
      <data key="d6">7.0</data>
      <data key="d7">The obligations for general-purpose AI models do not apply when they are used for purely internal processes, thus distinguishing between internal and external applications.</data>
      <data key="d8">internal use,regulatory exemption</data>
