    <edge source="AI Regulatory Sandboxes" target="SMEs">
      <data key="d6">34.0</data>
      <data key="d7">AI Regulatory Sandboxes specifically aim to provide accessible environments for SMEs to innovate and safely experiment with AI technologies.&lt;SEP&gt;AI regulatory sandboxes are designed to facilitate SMEs' participation and compliance with AI regulations, providing necessary tools and resources.&lt;SEP&gt;SMEs, including start-ups, benefit from AI Regulatory Sandboxes to develop and innovate their AI solutions under regulatory oversight.&lt;SEP&gt;SMEs are provided priority access to AI regulatory sandboxes to test their innovations in a controlled environment.</data>
      <data key="d8">compliance support,innovation facilitation,innovation support,innovation testing,market access,regulatory compliance,regulatory environment,regulatory framework</data>
      <data key="d9">chunk-7cb433a13c63064d370f7b39be368c2b&lt;SEP&gt;chunk-4eef4854fd4874faaa253cee7218b476&lt;SEP&gt;chunk-8363b7ff75e2a59a44c744564b484596&lt;SEP&gt;chunk-18b91d6551e6619c2e37a056560c0319</data>
      <data key="d10">https://artificialintelligenceact.eu/article/58/&lt;SEP&gt;https://artificialintelligenceact.eu/article/57/&lt;SEP&gt;https://artificialintelligenceact.eu/article/62/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/139/</data>
      <data key="d11">1748428535</data>
    </edge>
    <edge source="AI Regulatory Sandboxes" target="EU Digital Innovation Hubs">
      <data key="d6">7.0</data>
      <data key="d7">EU Digital Innovation Hubs may assist in the functioning of AI Regulatory Sandboxes by facilitating access to resources and expertise.</data>
      <data key="d8">collaboration,resource support</data>
      <data key="d9">chunk-18b91d6551e6619c2e37a056560c0319</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/139/</data>
      <data key="d11">1748426013</data>
    </edge>
    <edge source="AI Regulatory Sandboxes" target="National Competent Authorities">
      <data key="d6">44.0</data>
      <data key="d7">AI Regulatory Sandboxes are to be supervised and regulated by National Competent Authorities to ensure compliance and mitigate risks.&lt;SEP&gt;National competent authorities establish and supervise AI regulatory sandboxes to facilitate safe AI development.&lt;SEP&gt;National competent authorities have a role in establishing and supervising AI regulatory sandboxes to ensure compliance with relevant laws.&lt;SEP&gt;National Competent Authorities are responsible for establishing and managing AI regulatory sandboxes, ensuring compliance with regulations.&lt;SEP&gt;National Competent Authorities are responsible for supervising the operation of AI Regulatory Sandboxes to ensure compliance and safety.</data>
      <data key="d8">compliance,governance,management,oversight,regulatory oversight,safety compliance,supervision</data>
      <data key="d9">chunk-7cb433a13c63064d370f7b39be368c2b&lt;SEP&gt;chunk-75b723cd62d18d234251f462581cbbf5&lt;SEP&gt;chunk-4eef4854fd4874faaa253cee7218b476&lt;SEP&gt;chunk-18b91d6551e6619c2e37a056560c0319</data>
      <data key="d10">https://artificialintelligenceact.eu/article/57/&lt;SEP&gt;https://artificialintelligenceact.eu/article/58/&lt;SEP&gt;https://artificialintelligenceact.eu/recital/139/</data>
      <data key="d11">1748427363</data>
    </edge>
    <edge source="AI Regulatory Sandboxes" target="AI Innovation">
      <data key="d6">10.0</data>
      <data key="d7">AI Regulatory Sandboxes aim to promote AI Innovation by allowing for safe experimentation and development of AI technologies.</data>
      <data key="d8">experimentation,innovation promotion</data>
      <data key="d9">chunk-18b91d6551e6619c2e37a056560c0319</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/139/</data>
      <data key="d11">1748426013</data>
    </edge>
    <edge source="AI Regulatory Sandboxes" target="Research and Experimentation Labs">
      <data key="d6">7.0</data>
      <data key="d7">Research and Experimentation Labs may work alongside AI Regulatory Sandboxes to ensure innovations are compliant and effectively tested.</data>
      <data key="d8">compliance testing,research collaboration</data>
      <data key="d9">chunk-18b91d6551e6619c2e37a056560c0319</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/139/</data>
      <data key="d11">1748426013</data>
    </edge>
