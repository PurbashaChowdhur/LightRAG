      <data key="d10">https://artificialintelligenceact.eu/article/3/</data>
      <data key="d11">1748426654</data>
    </edge>
    <edge source="Regulatory Supervision" target="Testing in Real-World Conditions">
      <data key="d6">8.0</data>
      <data key="d7">Regulatory supervision governs the conditions under which testing in real-world conditions can occur for AI systems.</data>
