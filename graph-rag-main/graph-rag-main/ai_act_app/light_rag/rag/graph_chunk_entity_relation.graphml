      <data key="d10">https://artificialintelligenceact.eu/article/76/</data>
      <data key="d11">1748427308</data>
    </edge>
    <edge source="market surveillance authority" target="Member States">
      <data key="d6">8.0</data>
      <data key="d7">The market surveillance authority collaborates with Member States to communicate and implement decisions about AI systems involved in market regulation.</data>
      <data key="d8">collaboration,regulatory communication</data>
      <data key="d9">chunk-6fadd3405f1febb84753df655c577486</data>
      <data key="d10">https://artificialintelligenceact.eu/article/76/</data>
      <data key="d11">1748427308</data>
    </edge>
    <edge source="market surveillance authority" target="national law">
      <data key="d6">9.0</data>
      <data key="d7">National law empowers market surveillance authorities to address complaints related to the infringement of rights by AI systems.</data>
      <data key="d8">legal enforcement,oversight</data>
