      <data key="d10">https://artificialintelligenceact.eu/recital/73/</data>
      <data key="d11">1748427848</data>
    </edge>
    <edge source="Law Enforcement" target="Public Interest">
      <data key="d6">8.0</data>
      <data key="d7">"Law enforcement actions are often justified based on the principle of Public Interest, requiring a balance between individual rights and community safety.")</data>
      <data key="d8">community safety,ethical considerations</data>
      <data key="d9">chunk-1d0dcb7cb13665cdf8522e8f92cfb166</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/33/</data>
      <data key="d11">1748427083</data>
    </edge>
    <edge source="Law Enforcement" target="Crime Victims">
      <data key="d6">7.0</data>
      <data key="d7">"Law enforcement agencies often prioritize the identification and assistance of Crime Victims in accordance with regulations focusing on public safety.")</data>
      <data key="d8">enforcement duties,victim support</data>
      <data key="d9">chunk-1d0dcb7cb13665cdf8522e8f92cfb166</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/33/</data>
      <data key="d11">1748427083</data>
    </edge>
    <edge source="Law Enforcement" target="Perpetrators">
      <data key="d6">9.0</data>
      <data key="d7">"Law Enforcement is tasked with identifying and apprehending Perpetrators of crimes to ensure the safety of the public and uphold the law.")</data>
      <data key="d8">criminal justice,public safety</data>
      <data key="d9">chunk-1d0dcb7cb13665cdf8522e8f92cfb166</data>
      <data key="d10">https://artificialintelligenceact.eu/recital/33/</data>
      <data key="d11">1748427083</data>
    </edge>
    <edge source="Law Enforcement" target="Biometric Categorisation Systems">
      <data key="d6">7.0</data>
      <data key="d7">Biometric categorization systems may be employed by law enforcement to identify suspects based on biometric data.</data>
      <data key="d8">criminal investigation,technology use</data>
