      <data key="d10">https://artificialintelligenceact.eu/article/83/</data>
      <data key="d11">1748425969</data>
    </edge>
    <edge source="EU declaration of conformity" target="High-risk AI System">
      <data key="d6">10.0</data>
      <data key="d7">High-risk AI systems must have an EU declaration of conformity to ensure they meet necessary compliance before being offered on the market.</data>
      <data key="d8">product compliance,regulatory requirement</data>
      <data key="d9">chunk-b90a181c1c97be5262cd1f7a3919d6d5</data>
      <data key="d10">https://artificialintelligenceact.eu/article/83/</data>
      <data key="d11">1748425969</data>
    </edge>
    <edge source="high-risk AI system" target="national competent authority">
      <data key="d6">9.0</data>
      <data key="d7">The national competent authority oversees high-risk AI systems to ensure their compliance with regulation and safety standards.</data>
      <data key="d8">compliance monitoring,regulatory oversight</data>
